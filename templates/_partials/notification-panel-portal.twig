{# Viewport sabit bildirim paneli — JS ile body altına taşınır; overflow kesilmez #}
<div id="nxNotiPanel" class="nx-noti-panel-portal" role="dialog" aria-modal="false" aria-labelledby="nxNotiPanelTitle" aria-hidden="true">
    <div class="nx-noti-head">
        <span class="nx-noti-head-title" id="nxNotiPanelTitle">Bildirimler</span>
        <div class="nx-noti-head-right">
            <span class="nx-noti-head-badge" id="nxNotiHeadBadge" hidden></span>
            <button type="button" class="nx-noti-markall" id="nxNotiMarkAll" hidden>Tümünü okundu yap</button>
        </div>
    </div>
    <div class="nx-noti-body slimscroll" id="notificationList">
        <div class="nx-noti-loading text-muted">Yükleniyor…</div>
    </div>
    <div class="nx-noti-foot">
        <a href="/notifications" class="nx-noti-see-all">Tümünü Gör</a>
    </div>
</div>
