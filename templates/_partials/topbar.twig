                    <span class="nx-user-chevron"><i data-feather="chevron-down" class="nx-user-chevron-icon"></i></span>
                </a>
                <div class="dropdown-menu dropdown-menu-end nx-user-dropdown">
                    <div class="nx-dd-shell">
                        <div class="nx-dd-userhead">
                            <div class="nx-dd-avatar-wrap">
                                <img src="{{ site_default_avatar|default('/assets/images/default-avatar.png') }}" alt="" class="rounded-circle nx-dd-avatar" width="32" height="32" onerror="this.src='/assets/images/default-avatar.png'">
                            </div>
                            <div class="nx-dd-user-meta min-w-0">
