                            </div>
                        </div>
                        <div class="nx-dd-scroll">
                            {% include '_partials/user-dropdown-admin-section.twig' %}
                        </div>
                        <div class="nx-dd-footer">
                            <form method="POST" action="/logout" class="mb-0 nx-dd-logout-form">
                                <button type="submit" class="dropdown-item nx-dd-item nx-dd-logout w-100 border-0 text-start">
                                    <i data-feather="log-out" class="nx-dd-icon"></i>
