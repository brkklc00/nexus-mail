                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-outline-primary btn-sm" data-telegram-template-preview-refresh>Önizleme Yenile</button>
                                    <button type="button" class="btn btn-outline-success btn-sm" data-telegram-template-test data-telegram-action>Bu şablonu test gönder</button>
                                </div>
                                <pre class="bg-light border rounded p-2 small mb-0" style="white-space: pre-wrap;" data-telegram-template-preview></pre>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="telegramTabTest">
                        <div class="card"><div class="card-body">
                            <h6>Test Sonucu</h6>
                            <p class="small text-muted mb-2">Bağlantı tabından metni düzenleyip test gönderebilirsiniz. Sonuç aşağıda güncellenir.</p>
                            <div class="small text-muted" data-telegram-status>Son test: - | Durum: - | Son hata: -</div>
                        </div></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-outline-primary" data-telegram-reset data-telegram-action>Varsayılan Şablonları Yükle</button>
                <button type="button" class="btn btn-primary" data-telegram-save data-telegram-action>Kaydet</button>
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Profil Modal -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-end modal-dialog-vertical">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="profileModalLabel">
                    <i data-feather="user" class="icon-sm me-2"></i> Profil Bilgileri
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <img src="{{ site_default_avatar|default('/assets/images/default-avatar.png') }}" alt="user" class="rounded-circle mb-3" style="width: 80px; height: 80px;" onerror="this.src='/assets/images/default-avatar.png'">
                    <h6>{{ user.name ?? 'Kullanıcı' }}</h6>
                    <p class="text-muted small">{{ user.email ?? 'user@example.com' }}</p>
                </div>
                
                <form id="profileForm" method="POST" action="/settings/profile">
                    <div class="mb-3">
                        <label for="profileName" class="form-label">Ad Soyad</label>
                        <input type="text" class="form-control form-control-sm" id="profileName" name="name" value="{{ user.name ?? '' }}" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="profileEmail" class="form-label">E-posta</label>
                        <input type="email" class="form-control form-control-sm" id="profileEmail" name="email" value="{{ user.email ?? '' }}" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="profileUsername" class="form-label">Kullanıcı Adı</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i data-feather="user" class="icon-xs"></i>
                            </span>
                            <input type="text" class="form-control bg-light" id="profileUsername" value="{{ user.username ?? '' }}" readonly>
                            <span class="input-group-text bg-light">
                                <i data-feather="lock" class="icon-xs text-muted"></i>
                            </span>
                        </div>
                        <small class="text-muted">Kullanıcı adı değiştirilemez</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveProfile()">
                    <i data-feather="save" class="icon-xs me-1"></i>
                    Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Profil kaydet
function saveProfile() {
    const form = document.getElementById('profileForm');
    const formData = new FormData(form);
    const submitBtn = event.target;
    
    // Button'u disable et
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kaydediliyor...';
    
    fetch('/settings/profile', {
        method: 'POST',
        body: formData
    })
    .then(res => {
        if (!res.ok) {
            throw new Error('Profil güncellenemedi');
        }
        return res.text();
    })
    .then(() => {
        // Modal'ı kapat
        const modal = bootstrap.Modal.getInstance(document.getElementById('profileModal'));
        if (modal) {
            modal.hide();
        }
        
        // Başarı mesajı (iziToast kullan)
        if (typeof iziToast !== 'undefined') {
            iziToast.success({
                title: 'Başarılı',
                message: 'Profil bilgileriniz güncellendi',
                position: 'topRight'
            });
        }
        
        // Sayfayı yenile
        setTimeout(() => window.location.reload(), 1500);
    })
    .catch(error => {
        // Hata mesajı
        if (typeof iziToast !== 'undefined') {
            iziToast.error({
                title: 'Hata',
                message: error.message,
                position: 'topRight'
            });
        } else {
            alert('Hata: ' + error.message);
        }
        
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-feather="save" class="icon-xs me-1"></i>Kaydet';
        feather.replace();
    });
}

// 2FA Setup - modal açar
function open2FASetup() {
    // Güvenlik modalını kapat
    const secModal = bootstrap.Modal.getInstance(document.getElementById('securityModal'));
    if (secModal) {
        secModal.hide();
    }
    
    // 2FA setup için QR kod oluştur
    fetch('/settings/security/2fa/enable', {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        }
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) {
            throw new Error('2FA başlatılamadı');
        }
        
        // QR Code ve secret'i modal'a yerleştir
        document.getElementById('qrCodeImage').src = data.qr_code;
        document.getElementById('secretText').textContent = data.secret;
        
        // Recovery codes'u modal'da göster
        let codesHTML = '';
        data.recovery_codes.forEach((code, i) => {
            codesHTML += `
                <div class="col-6 mb-2">
                    <div class="bg-light rounded p-2 text-center">
                        <small class="badge bg-secondary">${i+1}</small>
                        <code class="d-block">${code}</code>
                    </div>
                </div>
            `;
        });
        document.getElementById('recoveryCodesContainer').innerHTML = codesHTML;
        
        // Codes'u global'e kaydet
        window.twoFactorRecoveryCodes = data.recovery_codes;
        
        // 2FA modal'ı aç
        const twoFAModal = new bootstrap.Modal(document.getElementById('twoFactorSetupModal'));
        twoFAModal.show();
        
        setTimeout(() => feather.replace(), 100);
    })
    .catch(error => {
        if (typeof iziToast !== 'undefined') {
            iziToast.error({
                title: 'Hata',
                message: '2FA kurulumu başlatılamadı',
                position: 'topRight'
            });
        }
    });
}

// Şifre değiştir - Düzeltilmiş
function changePassword() {
    const form = document.getElementById('passwordForm');
    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const submitBtn = event.target;
    
    // Validation
    if (!currentPassword || !newPassword || !confirmPassword) {
        if (typeof iziToast !== 'undefined') {
            iziToast.warning({
                title: 'Uyarı',
                message: 'Lütfen tüm alanları doldurun',
                position: 'center',
                timeout: 3000
            });
        }
        return;
    }
    
    if (newPassword !== confirmPassword) {
        if (typeof iziToast !== 'undefined') {
            iziToast.warning({
                title: 'Uyarı',
                message: 'Yeni şifreler eşleşmiyor',
                position: 'center',
                timeout: 3000
            });
        }
        return;
    }
    
    if (newPassword.length < 6) {
        if (typeof iziToast !== 'undefined') {
            iziToast.warning({
                title: 'Uyarı',
                message: 'Şifre en az 6 karakter olmalıdır',
                position: 'center',
                timeout: 3000
            });
        }
        return;
    }
    
    // Button'u disable et
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Değiştiriliyor...';
    
    const formData = new FormData(form);
    
    fetch('/settings/security/password', {
        method: 'POST',
        headers: {
            'Accept': 'application/json'
        },
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) {
            throw new Error(data.message || 'Şifre değiştirilemedi');
        }
        
        // Modal'ı kapat
        const modal = bootstrap.Modal.getInstance(document.getElementById('securityModal'));
        if (modal) {
            modal.hide();
        }
        
        // Formu temizle
        form.reset();
        
        // Başarı mesajı
        if (typeof iziToast !== 'undefined') {
            iziToast.success({
                title: 'Başarılı',
                message: 'Şifreniz değiştirildi. Giriş sayfasına yönlendiriliyorsunuz...',
                position: 'topRight',
                timeout: 2000
            });
        }
        
        // Backend session'ı zaten destroy etti, login'e yönlendir
        setTimeout(() => {
            window.location.href = '/login?msg=password_changed';
        }, 2000);
    })
    .catch(error => {
        // Hata mesajı
        if (typeof iziToast !== 'undefined') {
            iziToast.error({
                title: 'Hata',
                message: error.message || 'Mevcut şifreniz hatalı olabilir',
                position: 'center',
                timeout: 5000
            });
        }
        
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-feather="key" class="icon-xs me-1"></i>Şifre Değiştir';
        feather.replace();
    });
}

// 2FA kod doğrula
function verify2FACode() {
    const form = document.getElementById('verify2FAForm');
    const code = document.getElementById('verifyCode').value;
    const submitBtn = event.target;
    
    if (!code || code.length !== 6) {
        if (typeof iziToast !== 'undefined') {
            iziToast.warning({
                title: 'Uyarı',
                message: '6 haneli kod giriniz',
                position: 'center',
                timeout: 3000
            });
        } else {
            alert('6 haneli kod giriniz');
        }
        return;
    }
    
    // Button'u disable et
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Doğrulanıyor...';
    
    const formData = new FormData(form);
    
    fetch('/settings/security/2fa/confirm', {
        method: 'POST',
        headers: {
            'Accept': 'application/json'
        },
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) {
            throw new Error(data.message || 'Kod doğrulanamadı');
        }
        return data;
    })
    .then(() => {
        // Modal'ı kapat
        const modal = bootstrap.Modal.getInstance(document.getElementById('twoFactorSetupModal'));
        if (modal) {
            modal.hide();
        }
        
        // Başarı mesajı
        if (typeof iziToast !== 'undefined') {
            iziToast.success({
                title: 'Başarılı',
                message: '2FA başarıyla etkinleştirildi',
                position: 'topRight'
            });
        }
        
        // Sayfayı yenile
        setTimeout(() => window.location.reload(), 1500);
    })
    .catch(error => {
        // Hata mesajı
        if (typeof iziToast !== 'undefined') {
            iziToast.error({
                title: 'Kod Hatalı',
                message: error.message || 'Lütfen Google Authenticator\'da görünen güncel kodu deneyin',
                position: 'center',
                timeout: 5000
            });
        } else {
            alert('Kod hatalı: ' + error.message);
        }
        
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-feather="check-circle" class="icon-xs me-1"></i>2FA\'yı Etkinleştir';
        feather.replace();
    });
}

// 2FA kodlarını kopyala
function copy2FACodes() {
    if (!window.twoFactorRecoveryCodes) {
        alert('Kodlar yüklenemedi');
        return;
    }
    
    const text = 'NEXUS 2FA KURTARMA KODLARI\n══════════════════════════\n\n' +
                 window.twoFactorRecoveryCodes.map((code, i) => `${i+1}. ${code}`).join('\n') +
                 '\n\n⚠️ Bu kodları güvenli bir yerde saklayın!';
    
    navigator.clipboard.writeText(text).then(() => {
        if (typeof iziToast !== 'undefined') {
            iziToast.success({
                title: 'Kopyalandı',
                message: 'Kurtarma kodları panoya kopyalandı',
                position: 'topRight'
            });
        }
    });
}

// 2FA devre dışı bırak
function disable2FA() {
    if (typeof iziToast !== 'undefined') {
        iziToast.question({
            timeout: 20000,
            close: false,
            overlay: true,
            displayMode: 'once',
            id: 'question',
            zindex: 999999,
            title: 'Onay',
            message: '2FA\'yı devre dışı bırakmak istediğinize emin misiniz? Hesabınız daha az güvenli hale gelecektir.',
            position: 'center',
            buttons: [
                ['<button><b>Evet, Kapat</b></button>', function (instance, toast) {
                    instance.hide({ transitionOut: 'fadeOut' }, toast, 'button');
                    performDisable2FA();
                }, true],
                ['<button>İptal</button>', function (instance, toast) {
                    instance.hide({ transitionOut: 'fadeOut' }, toast, 'button');
                }],
            ]
        });
    } else {
        if (!confirm('2FA\'yı devre dışı bırakmak istediğinize emin misiniz?')) {
            return;
        }
        performDisable2FA();
    }
}

function performDisable2FA() {
    fetch('/settings/security/2fa/disable', {
        method: 'POST',
        headers: {
            'Accept': 'application/json'
        }
    })
    .then(res => {
        if (!res.ok) {
            throw new Error('2FA kapatılamadı');
        }
        return res.json();
    })
    .then(() => {
        // Modal'ı kapat
        const secModal = bootstrap.Modal.getInstance(document.getElementById('securityModal'));
        if (secModal) {
            secModal.hide();
        }
        
        // Başarı mesajı
        if (typeof iziToast !== 'undefined') {
            iziToast.success({
                title: 'Başarılı',
                message: '2FA devre dışı bırakıldı',
                position: 'topRight'
            });
        }
        
        // Sayfayı yenile
        setTimeout(() => window.location.reload(), 1500);
    })
    .catch(error => {
        if (typeof iziToast !== 'undefined') {
            iziToast.error({
                title: 'Hata',
                message: error.message,
                position: 'topRight'
            });
        } else {
            alert('Hata: ' + error.message);
        }
    });
}

// Sadece rakam girişi (2FA verify code)
document.addEventListener('DOMContentLoaded', function() {
    const verifyInput = document.getElementById('verifyCode');
    if (verifyInput) {
        verifyInput.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    }
});
</script>

<!-- Güvenlik Modal - Sağ Taraf -->
<div class="modal fade" id="securityModal" tabindex="-1" aria-labelledby="securityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-end modal-dialog-vertical">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="securityModalLabel">
                    <i data-feather="shield" class="icon-sm me-2"></i> Güvenlik Ayarları
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Şifre Değiştir -->
                <div class="mb-4">
                    <h6 class="mb-3">
                        <i data-feather="lock" class="icon-xs me-2"></i>
                        Şifre Değiştir
                    </h6>
                    <form id="passwordForm">
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label small">Mevcut Şifre</label>
                            <input type="password" class="form-control form-control-sm" id="currentPassword" name="current_password" required>
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label small">Yeni Şifre</label>
                            <input type="password" class="form-control form-control-sm" id="newPassword" name="new_password" required minlength="6">
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label small">Şifre Tekrar</label>
                            <input type="password" class="form-control form-control-sm" id="confirmPassword" name="confirm_password" required minlength="6">
                        </div>
                        <button type="button" class="btn btn-primary btn-sm w-100" onclick="changePassword()">
                            <i data-feather="key" class="icon-xs me-1"></i>
                            Şifre Değiştir
                        </button>
                    </form>
                </div>

                <!-- İki Faktörlü Doğrulama -->
                <div class="mb-4">
                    <h6 class="mb-3">
                        <i data-feather="shield" class="icon-xs me-2"></i>
                        İki Faktörlü Doğrulama
                    </h6>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small">2FA Durumu</span>
                        <span class="badge {{ user.twoFactorSecret ? 'bg-success' : 'bg-secondary' }}">
                            <i data-feather="{{ user.twoFactorSecret ? 'shield' : 'shield-off' }}" class="icon-xs"></i>
                            {{ user.twoFactorSecret ? 'Aktif' : 'Pasif' }}
                        </span>
                    </div>
                    <p class="text-muted small mb-3">Hesabınızı daha güvenli hale getirmek için iki faktörlü doğrulamayı etkinleştirin.</p>
                    {% if user.twoFactorSecret %}
                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="disable2FA()">
                        <i data-feather="shield-off" class="icon-xs me-1"></i>
                        2FA Devre Dışı Bırak
                    </button>
                    {% else %}
                    <button type="button" class="btn btn-outline-primary btn-sm w-100" onclick="open2FASetup()">
                        <i data-feather="shield" class="icon-xs me-1"></i>
                        2FA Kur
                    </button>
                    {% endif %}
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- 2FA Setup Modal -->
<div class="modal fade" id="twoFactorSetupModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary-subtle">
                <h5 class="modal-title">
                    <i data-feather="shield" class="icon-sm me-2"></i>
                    İki Faktörlü Doğrulama Kurulumu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Adımlar -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="mb-3">1. QR Kodu Tarayın</h6>
                        <div class="text-center mb-3">
                            <div class="p-3 bg-white rounded border d-inline-block">
                                <img id="qrCodeImage" src="" alt="QR Code" style="width: 200px; height: 200px;">
                            </div>
                        </div>
                        <div class="alert alert-light border text-center">
                            <small class="text-muted d-block mb-1">Manuel Kod</small>
                            <code id="secretText"></code>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="mb-3">2. Doğrulama Kodunu Girin</h6>
                        <p class="text-muted small mb-3">Google Authenticator, Microsoft Authenticator veya Authy uygulamasında görünen 6 haneli kodu girin:</p>
                        <form id="verify2FAForm" method="POST" action="/settings/security/2fa/confirm">
                            <div class="mb-3">
                                <input type="text" 
                                       class="form-control form-control-lg text-center fw-bold" 
                                       id="verifyCode" 
                                       name="code" 
                                       required 
                                       maxlength="6" 
                                       pattern="[0-9]{6}"
                                       placeholder="● ● ● ● ● ●"
                                       style="font-size: 24px; letter-spacing: 8px;">
                            </div>
                            <button type="button" class="btn btn-primary w-100" onclick="verify2FACode()">
                                <i data-feather="check-circle" class="icon-xs me-1"></i>
                                2FA'yı Etkinleştir
                            </button>
                        </form>
                    </div>
                </div>
                
                <!-- Kurtarma Kodları -->
                <div class="alert alert-warning">
                    <h6 class="alert-heading">
                        <i data-feather="alert-triangle" class="icon-xs me-1"></i>
                        Kurtarma Kodları - Mutlaka Kaydedin!
                    </h6>
                    <p class="small mb-3">Telefonunuzu kaybederseniz bu kodlarla giriş yapabilirsiniz. Her kod 1 kez kullanılabilir.</p>
                    <div class="row" id="recoveryCodesContainer">
                        <!-- JavaScript ile doldurulacak -->
                    </div>
                    <div class="mt-3 text-end">
                        <button type="button" class="btn btn-sm btn-outline-dark" onclick="copy2FACodes()">
                            <i data-feather="copy" class="icon-xs me-1"></i>
                            Kopyala
                        </button>
