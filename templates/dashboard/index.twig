{% extends "_layouts/main.twig" %}

{% block title %}Dashboard - {{ site_title|default('Nexus Mail') }}{% endblock %}

{% block page_title %}
<div class="row">
    <div class="col-12">
        <div class="page-title-box nx-page-head pb-0">
            <div class="d-flex flex-column flex-lg-row align-items-start justify-content-lg-between gap-3">
                <div>
                    <div class="page-title-right mb-2">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/dashboard">Panel</a></li>
                            <li class="breadcrumb-item active">Ana Sayfa</li>
                        </ol>
                    </div>
                    <h4 class="page-title nx-page-title mb-1 text-white fw-semibold">Mail Dashboard</h4>
                    <p class="mb-0 text-white-50">Mail gönderim performansı, SMTP kapasitesi ve günlük kullanım.</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
{% set emailTotal = 0 %}
{% for v in chartData.email|default([]) %}
{% set emailTotal = emailTotal + v %}
{% endfor %}
{% set chartEmpty = emailTotal == 0 %}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-lg-4">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'mail',
            label: 'Mail Bakiyesi',
            value: emailCredit|number_format(0, ',', '.'),
            hint: 'Kullanılabilir gönderim bakiyesi',
            trend: null,
            extra_class: 'nx-dash-kpi--mail'
        } only %}
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'send',
            label: 'Bugün Gönderilen',
            value: usageStats.sent_today|default(0)|number_format(0, ',', '.'),
            hint: 'Bugün teslim kuyruğuna alınan mail',
            trend: null,
            extra_class: 'nx-dash-kpi--mail'
        } only %}
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'layers',
            label: 'Toplam Mail Siparişi',
            value: emailStats.total_orders|default(0)|number_format(0, ',', '.'),
            hint: 'Oluşturulan kampanya siparişleri',
            trend: null,
            extra_class: 'nx-dash-kpi--mail'
        } only %}
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-lg-2">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'check-circle',
            label: 'Başarılı Gönderim',
            value: emailStats.total_delivered|default(0)|number_format(0, ',', '.'),
            hint: 'Teslim edilen mail adedi',
            trend: null,
            extra_class: 'nx-dash-kpi--support'
        } only %}
    </div>
    <div class="col-12 col-md-6 col-lg-2">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'alert-triangle',
            label: 'Hatalı / Bounce',
            value: (emailStats.total_failed|default(0) + emailStats.total_bounced|default(0))|number_format(0, ',', '.'),
            hint: 'Başarısız ve bounce toplamı',
            trend: null,
            extra_class: 'nx-dash-kpi--support'
        } only %}
    </div>
    <div class="col-12 col-md-6 col-lg-2">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'server',
            label: 'Aktif SMTP',
            value: (smtpStats.active|default(0)) ~ ' / ' ~ (smtpStats.total|default(0)),
            hint: 'Aktif SMTP hesap durumu',
            trend: null,
            extra_class: 'nx-dash-kpi--url'
        } only %}
    </div>
    <div class="col-12 col-md-6 col-lg-2">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'activity',
            label: 'Günlük Limit Kullanımı',
            value: (usageStats.sent_today|default(0))|number_format(0, ',', '.') ~ ' / ' ~ (usageStats.limit_today|default(0))|number_format(0, ',', '.'),
            hint: (usageStats.percent|default(0)) ~ '% kullanım',
            trend: null,
            extra_class: 'nx-dash-kpi--support'
        } only %}
    </div>
    <div class="col-12 col-md-6 col-lg-2">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'headphones',
            label: 'Destek Talepleri',
            value: supportStats.open_tickets|default(0)|number_format(0, ',', '.'),
            hint: 'Açık ve bekleyen destek talepleri',
            trend: null,
            extra_class: 'nx-dash-kpi--support'
        } only %}
    </div>
    <div class="col-12 col-md-6 col-lg-2">
        {% include 'dashboard/_partials/kpi-card.twig' with {
            icon: 'link',
            label: 'Kısa URL Performansı',
            value: urlStats.total_clicks|default(0)|number_format(0, ',', '.'),
            hint: (urlStats.total_urls|default(0)|number_format(0, ',', '.')) ~ ' aktif kısa link',
            trend: null,
            extra_class: 'nx-dash-kpi--url'
        } only %}
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card nx-dash-card h-100">
            <div class="card-header border-0">
                <h5 class="mb-0 text-white fw-semibold">Son 7 Gün Mail Gönderim İstatistiği</h5>
            </div>
            <div class="card-body">
                {% if chartEmpty %}
                <div class="text-center py-5">
                    <span class="nx-dash-chart-empty-icon"><i data-feather="bar-chart-2"></i></span>
                    <h6 class="mt-3">Henüz mail gönderim verisi yok.</h6>
                    <a href="/email-orders" class="btn btn-primary btn-sm mt-2">Mail Gönder</a>
                </div>
                {% else %}
                <div style="height: 320px;">
                    <canvas id="mailChart"></canvas>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card nx-dash-card h-100">
            <div class="card-header border-0">
                <h5 class="mb-0 text-white fw-semibold">Hızlı İşlemler</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/email-orders" class="btn btn-primary btn-sm py-2">Mail Gönder</a>
                    <a href="/email-phonebooks" class="btn btn-outline-primary btn-sm py-2">Mail Rehber</a>
                    <a href="/email-templates" class="btn btn-outline-primary btn-sm py-2">Mail Şablonları</a>
                    <a href="/admin/email-orders" class="btn btn-outline-primary btn-sm py-2">Mail Siparişleri</a>
                    <a href="/admin/email-smtp" class="btn btn-outline-primary btn-sm py-2">SMTP Hesapları</a>
                    <a href="/admin/email-sending-settings" class="btn btn-outline-primary btn-sm py-2">Gönderim Hızı ve Limitler</a>
                    <a href="/email-blacklist" class="btn btn-outline-primary btn-sm py-2">Email Kara Liste</a>
                    <a href="/url-shortener" class="btn btn-outline-primary btn-sm py-2">Link Kısaltıcı</a>
                </div>
                <hr>
                <div class="small text-muted">
                    Kısa URL: <strong>{{ urlStats.total_urls|default(0) }}</strong> link /
                    <strong>{{ urlStats.total_clicks|default(0)|number_format(0, ',', '.') }}</strong> tıklama
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-8">
        <div class="card nx-dash-card h-100">
            <div class="card-header border-0">
                <h5 class="mb-0 text-white fw-semibold">Son Mail Siparişleri</h5>
            </div>
            <div class="card-body">
                {% if recentEmailOrders is empty %}
                {% include 'dashboard/_partials/empty-state.twig' with {
                    icon: 'inbox',
                    title: 'Henüz mail siparişi yok',
                    text: 'İlk mail kampanyanızı oluşturun.',
                    action_href: '/email-orders',
                    action_label: 'Mail Gönder'
                } only %}
                {% else %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Konu</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in recentEmailOrders %}
                            <tr>
                                <td>#{{ order.id }}</td>
                                <td class="text-truncate" style="max-width: 280px;">{{ order.subject }}</td>
                                <td><span class="badge bg-light text-dark">{{ order.status.value|default('pending') }}</span></td>
                                <td>{{ order.createdAt|date('d.m.Y') }}</td>
                                <td class="text-end"><a href="/email-orders/{{ order.id }}" class="btn btn-sm btn-light">Detay</a></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card nx-dash-card h-100">
            <div class="card-header border-0">
                <h5 class="mb-0 text-white fw-semibold">Kısa URL Performansı</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                {% if recentUrls is empty %}
                <div class="text-center py-4">
                    <span class="nx-dash-chart-empty-icon"><i data-feather="link-2"></i></span>
                    <h6 class="mt-3 mb-1">Henüz kısa URL verisi yok</h6>
                    <p class="text-muted small mb-3">Link Kısaltıcı ile yeni bir kısa link oluşturup performansı burada takip edebilirsiniz.</p>
                    <a href="/url-shortener" class="btn btn-outline-primary btn-sm">Link Kısaltıcıya Git</a>
                </div>
                {% else %}
                <ul class="list-unstyled mb-0 small">
                    {% for url in recentUrls %}
                    <li class="mb-2">
                        <strong>{{ url.shortCode }}</strong> · {{ url.clickCount|default(0) }} tıklama
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{% if not chartEmpty %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endif %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof feather !== 'undefined') {
        feather.replace();
    }
    {% if not chartEmpty %}
    var canvas = document.getElementById('mailChart');
    if (canvas && typeof Chart !== 'undefined') {
        new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: {
                labels: {{ chartData.dates|json_encode|raw }},
                datasets: [{
                    label: 'Mail',
                    data: {{ chartData.email|json_encode|raw }},
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } },
                    x: { grid: { display: false } }
                }
            }
        });
    }
    {% endif %}
});
</script>
{% endblock %}
