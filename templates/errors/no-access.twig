{% extends '_layouts/main.twig' %}

{% block title %}Erişim Yok - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card mt-5">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-lock text-danger" style="font-size: 72px;"></i>
                    </div>
                    <h3 class="text-danger mb-3">Erişim Yok</h3>
                    <p class="text-muted mb-4">
                        {{ message|default('Bu özelliğe erişim yetkiniz bulunmuyor.') }}
                    </p>
                    
                    {% if feature %}
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>{{ feature }}</strong> özelliğini kullanabilmek için lütfen yönetici ile iletişime geçin.
                        </div>
                    {% endif %}

                    <a href="/" class="btn btn-primary mt-3">
                        <i class="fas fa-home me-2"></i>Ana Sayfaya Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

