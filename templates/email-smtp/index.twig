    testButton.disabled = true;
    testButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Gönderiliyor...';
    
    fetch(`/admin/email-smtp/${currentTestSmtpId}/test`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ test_email: testEmail })
    })
    .then(res => {
        if (!res.ok) {
            throw new Error('Sunucu hatası: ' + res.status);
        }
        return res.json();
    })
    .then(data => {
        if (data.success) {
            resultDiv.innerHTML = `
                <div class="alert alert-success mb-0">
                    <i data-feather="check-circle" class="me-2"></i>
                    <strong>Test Başarılı!</strong><br>
                    ${data.message}
                </div>`;
            feather.replace();
        } else {
            resultDiv.innerHTML = `
                <div class="alert alert-danger mb-0">
                    <i data-feather="x-circle" class="me-2"></i>
                    <strong>Test Başarısız!</strong><br>
                    ${data.message}
                </div>`;
            feather.replace();
        }
    })
    .catch(error => {
        resultDiv.innerHTML = `
            <div class="alert alert-danger mb-0">
                <i data-feather="alert-triangle" class="me-2"></i>
                <strong>Bağlantı Hatası!</strong><br>
                ${error.message}
            </div>`;
        feather.replace();
