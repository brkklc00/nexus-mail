<!-- Yeni SMTP Ekle Modal -->
<div class="modal fade" id="addSmtpModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i data-feather="plus-circle" class="icon-sm me-2 text-primary"></i>
                    Yeni SMTP Hesabı Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/email-smtp" method="POST" id="smtpForm" onsubmit="submitAddForm(event)">
                <div class="modal-body">
                        <div class="row">
                            <!-- Sol Kolon -->
                            <div class="col-12">
                                <h6 class="text-muted mb-3">Genel Bilgiler</h6>
                                
                                <div class="mb-3">
                                    <label for="name" class="form-label">SMTP Adı *</label>
                                    <input type="text" class="form-control" id="name" name="name" required placeholder="Gmail SMTP">
                                </div>

                                <div class="mb-3">
                                    <label for="host" class="form-label">SMTP Host *</label>
                                    <input type="text" class="form-control" id="host" name="host" required placeholder="smtp.gmail.com">
                                </div>

                                <div class="row">
                                    <div class="col-6">
                                        <div class="mb-3">
                                            <label for="port" class="form-label">Port *</label>
                                            <input type="number" class="form-control" id="port" name="port" required value="587">
