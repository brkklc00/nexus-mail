function nxEsmtpVisibleBulkCbs() {
    return Array.from(document.querySelectorAll('.smtp-bulk-cb')).filter(function (cb) {
        const row = cb.closest('.nx-esmtp-sync');
        return row && !row.classList.contains('nx-esmtp-hide') && row.offsetParent !== null;
    });
}
function getSelectedSmtpIds() {
    const ids = Array.from(document.querySelectorAll('.smtp-bulk-cb:checked')).map(function (cb) {
        return parseInt(cb.value, 10);
    }).filter(function (id) { return id > 0; });
    return Array.from(new Set(ids));
}

function updateSmtpBulkDeleteUi() {
    var ids = getSelectedSmtpIds();
    var n = ids.length;
    var btn = document.getElementById('smtpBulkDeleteBtn');
    var btnActive = document.getElementById('smtpBulkActiveBtn');
    var btnPassive = document.getElementById('smtpBulkPassiveBtn');
    if (btnActive) btnActive.disabled = n === 0;
    if (btnPassive) btnPassive.disabled = n === 0;
    if (btn) {
        btn.disabled = n === 0;
        btn.innerHTML = n > 0
            ? '<i data-feather="trash-2" class="icon-xs me-1"></i> Seçilenleri sil (' + n + ')'
            : '<i data-feather="trash-2" class="icon-xs me-1"></i> Seçilenleri sil';
    }
    var total = nxEsmtpVisibleBulkCbs().length;
    var checkedOnPage = nxEsmtpVisibleBulkCbs().filter(function (cb) { return cb.checked; }).length;
    ['smtpSelectAll', 'smtpSelectAllMobile'].forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.indeterminate = checkedOnPage > 0 && checkedOnPage < total;
        el.checked = total > 0 && checkedOnPage === total;
    });
    var bar = document.getElementById('nxEsmtpBulkBar');
    var barText = document.getElementById('nxEsmtpBulkBarText');
    if (bar && barText) {
        if (n > 0) {
            bar.classList.remove('d-none');
            barText.innerHTML = '<strong>' + n + '</strong> SMTP seçildi';
        } else {
            bar.classList.add('d-none');
        }
    }
    if (typeof feather !== 'undefined') feather.replace();
}

function bulkDeleteSmtp() {
    var ids = getSelectedSmtpIds();
    if (ids.length === 0) return;
    if (!confirm(ids.length + ' SMTP hesabını kalıcı olarak silmek istediğinize emin misiniz? Bu işlem geri alınamaz.')) return;
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/email-smtp/bulk-delete';
    ids.forEach(function (id) {
        var inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = 'ids[]';
        inp.value = String(id);
        form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
}

function bulkSetStatus(isActive) {
    var ids = getSelectedSmtpIds();
    if (ids.length === 0) {
        showPageAlert('Önce en az bir SMTP seçin.', 'warning', 'Uyarı');
        return;
    }
    var actionText = isActive ? 'aktif' : 'pasif';
    if (!confirm(ids.length + ' SMTP hesabını ' + actionText + ' yapmak istiyor musunuz?')) return;
    fetch('/admin/email-smtp/bulk-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
        body: ids.map(function (id) { return 'ids[]=' + encodeURIComponent(String(id)); }).join('&') + '&is_active=' + encodeURIComponent(isActive ? '1' : '0')
    })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (!data.success) throw new Error(data.message || 'Toplu durum güncellenemedi');
            ids.forEach(function (id) { updateSmtpStatusUi(id, isActive); });
            document.querySelectorAll('.smtp-bulk-cb:checked').forEach(function (cb) { cb.checked = false; });
            updateSmtpBulkDeleteUi();
            showPageAlert(data.message || 'Durum güncellendi', 'success', 'Başarılı');
        })
        .catch(function (err) {
            showPageAlert(err.message || 'Toplu işlem başarısız', 'error', 'Hata');
        });
}

function archiveSmtp(id) {
    if (!confirm('Bu SMTP hesabını arşivleyip pasif yapmak istiyor musunuz?')) return;
