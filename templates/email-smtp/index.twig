{% extends "_layouts/main.twig" %}

{% block title %}SMTP Yönetimi - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/email-dashboard">Email Yönetimi</a></li>
<li class="breadcrumb-item active">SMTP</li>
{% endblock %}

{% block page_title %}
<div class="row nx-esmtp-page-head">
    <div class="col-12">
        <div class="page-title-box nx-page-head pb-0">
            <div class="d-flex flex-column flex-lg-row align-items-start justify-content-lg-between gap-3">
                <div class="min-w-0">
                    <div class="page-title-right mb-2">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/dashboard">Panel</a></li>
                            <li class="breadcrumb-item"><a href="/email-dashboard">Email Yönetimi</a></li>
                            <li class="breadcrumb-item active" aria-current="page">SMTP</li>
                        </ol>
                    </div>
                    <h4 class="page-title nx-page-title mb-1">SMTP Yönetimi</h4>
                    <p class="nx-page-lead text-muted mb-0">SMTP hesaplarınızı yönetin, durumlarını kontrol edin ve gönderim limitlerini takip edin.</p>
                </div>
                <div class="d-flex flex-wrap align-items-stretch align-items-lg-center gap-2 nx-esmtp-head-actions">
                    <button type="button" class="btn btn-sm nx-esmtp-tool-btn" id="nxEsmtpHeadRefresh" title="Yenile">
                        <i data-feather="refresh-cw" class="nx-esmtp-tool-ic"></i>
                        <span class="d-none d-sm-inline">Yenile</span>
                    </button>
                    <button type="button" class="btn btn-sm nx-esmtp-tool-btn" id="nxEsmtpBulkImportOpen" data-bs-toggle="modal" data-bs-target="#bulkImportSmtpModal" title="Toplu içe aktar">
                        <i data-feather="layers" class="nx-esmtp-tool-ic"></i>
                        <span class="d-none d-sm-inline">Toplu içe aktar</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-primary nx-esmtp-tool-btn nx-esmtp-tool-btn--primary" onclick="showAddModal()">
                        <i data-feather="plus-circle" class="nx-esmtp-tool-ic"></i>
                        <span>SMTP Ekle</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_icon %}{% endblock %}
{% block title_text %}{% endblock %}

{% block styles %}
<style>
.modal-header.bg-success {
    background-color: #198754 !important;
    color: white !important;
}
.modal-header.bg-danger {
    background-color: #dc3545 !important;
    color: white !important;
}
.modal-header.bg-warning {
    background-color: #ffc107 !important;
    color: #000 !important;
}
.modal-header.bg-success .btn-close,
.modal-header.bg-danger .btn-close {
    filter: brightness(0) invert(1);
    opacity: 1;
}
.modal-header.bg-success .modal-title,
.modal-header.bg-danger .modal-title {
    color: white !important;
}
</style>
{% endblock %}

{% block content %}
{% set inactive_smtp = stats.total_smtp > stats.active_smtp ? (stats.total_smtp - stats.active_smtp) : 0 %}
{% set warming_count = smtps|filter(s => s.totalSent < 100)|length %}
{% set healthy_count = smtps|filter(s => s.isActive and s.successRate >= 92 and s.totalFailed < 40)|length %}
{% set risk_count = smtps|filter(s => s.totalSent >= 15 and s.successRate < 85)|length %}
{% set planDailyLimit = sending_config.daily_limit %}
{% set totalDailySent = global_totals.daily_sent|default(0) %}
{% set global_usage_pct = planDailyLimit > 0 ? (totalDailySent / planDailyLimit * 100) : 0 %}
<div class="container-fluid nx-esmtp-page">

    <!-- Sayfa içi uyarılar -->
    {% if success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>
        {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
    {% endif %}
    {% if error %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i data-feather="alert-circle" class="align-self-center icon-xs me-2"></i>
        {{ error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
    {% endif %}
    <div id="pageAlertsContainer"></div>

    <div class="alert alert-info border-0 shadow-sm mb-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <strong>Gönderim hızı ve günlük limit</strong> artık
            <a href="/admin/email-sending-settings" class="alert-link fw-semibold">E-posta gönderim ayarları</a> sayfasından yönetilir.
        </div>
    </div>

    <!-- Kompakt KPI -->
    <div class="row g-2 mb-3 nx-esmtp-kpi-row">
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi">
                <div class="nx-esmtp-kpi-ic"><i data-feather="layers"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Toplam SMTP</span>
                    <span class="nx-esmtp-kpi-val">{{ stats.total_smtp }}</span>
                    <span class="nx-esmtp-kpi-hint">Kayıtlı hesap</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi nx-esmtp-kpi--accent">
                <div class="nx-esmtp-kpi-ic"><i data-feather="check-circle"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Aktif</span>
                    <span class="nx-esmtp-kpi-val">{{ stats.active_smtp }}</span>
                    <span class="nx-esmtp-kpi-hint">Gönderimde</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi">
                <div class="nx-esmtp-kpi-ic"><i data-feather="pause-circle"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Pasif</span>
                    <span class="nx-esmtp-kpi-val">{{ inactive_smtp }}</span>
                    <span class="nx-esmtp-kpi-hint">Devre dışı</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi nx-esmtp-kpi--ok">
                <div class="nx-esmtp-kpi-ic"><i data-feather="activity"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Sağlıklı</span>
                    <span class="nx-esmtp-kpi-val">{{ healthy_count }}</span>
                    <span class="nx-esmtp-kpi-hint">Heuristik</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi nx-esmtp-kpi--warn">
                <div class="nx-esmtp-kpi-ic"><i data-feather="thermometer"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Warmup</span>
                    <span class="nx-esmtp-kpi-val">{{ warming_count }}</span>
                    <span class="nx-esmtp-kpi-hint">&lt; 100 gönderim</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi nx-esmtp-kpi--danger">
                <div class="nx-esmtp-kpi-ic"><i data-feather="alert-triangle"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Risk / düşük başarı</span>
                    <span class="nx-esmtp-kpi-val">{{ risk_count }}</span>
                    <span class="nx-esmtp-kpi-hint">İzleme önerilir</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi">
                <div class="nx-esmtp-kpi-ic"><i data-feather="send"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Bugün</span>
                    <span class="nx-esmtp-kpi-val">{{ stats.today_sent|number_format }}</span>
                    <span class="nx-esmtp-kpi-hint">Gönderilen</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2 col-md-4">
            <div class="nx-esmtp-kpi">
                <div class="nx-esmtp-kpi-ic"><i data-feather="percent"></i></div>
                <div class="nx-esmtp-kpi-body">
                    <span class="nx-esmtp-kpi-label">Ort. başarı</span>
                    <span class="nx-esmtp-kpi-val">{{ stats.avg_success_rate|number_format(1) }}%</span>
                    <span class="nx-esmtp-kpi-hint">Tüm hesaplar</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-4 col-md-8">
            <div class="nx-esmtp-kpi nx-esmtp-kpi--wide">
                <div class="nx-esmtp-kpi-ic"><i data-feather="bar-chart-2"></i></div>
                <div class="nx-esmtp-kpi-body flex-grow-1">
                    <span class="nx-esmtp-kpi-label">Plan günlük limit kullanımı</span>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <div class="progress flex-grow-1 nx-esmtp-kpi-progress">
                            <div class="progress-bar {{ global_usage_pct >= 90 ? 'bg-danger' : (global_usage_pct >= 70 ? 'bg-warning' : 'bg-success') }}" style="width: {{ min(global_usage_pct, 100) }}%"></div>
                        </div>
                        <span class="nx-esmtp-kpi-val mb-0 text-nowrap">{{ totalDailySent|number_format }} / {{ planDailyLimit|number_format }}</span>
                    </div>
                    <span class="nx-esmtp-kpi-hint">Tüm SMTP toplamı · {{ global_usage_pct|number_format(1) }}%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- SMTP listesi -->
    <div class="row">
        <div class="col-12">
            <div class="card nx-esmtp-list-card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2">
                        <div>
                            <h5 class="mb-0 d-flex align-items-center gap-2">
                                <i data-feather="server" class="icon-xs text-primary"></i>
                                SMTP hesapları
                            </h5>
                            <small class="text-muted" id="nxEsmtpListCountLabel">{{ total|default(smtps|length) }} kayıt{% if search %} (sunucu filtresi: “{{ search|e }}”){% endif %}</small>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            {% if smtps|length > 0 %}
                            <button type="button" class="btn btn-outline-success btn-sm nx-esmtp-tool" id="smtpBulkActiveBtn" onclick="bulkSetStatus(true)" disabled>
                                <i data-feather="check-circle" class="icon-xs me-1"></i>
                                <span class="d-none d-sm-inline">Seçilenleri aktif yap</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm nx-esmtp-tool" id="smtpBulkPassiveBtn" onclick="bulkSetStatus(false)" disabled>
                                <i data-feather="pause-circle" class="icon-xs me-1"></i>
                                <span class="d-none d-sm-inline">Seçilenleri pasif yap</span>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm nx-esmtp-tool" id="smtpBulkDeleteBtn" onclick="bulkDeleteSmtp()" disabled title="İşaretli hesapları kalıcı siler">
                                <i data-feather="trash-2" class="icon-xs me-1"></i>
                                <span class="d-none d-sm-inline">Seçilenleri sil</span>
                            </button>
                            {% endif %}
                            <button type="button" class="btn btn-outline-warning btn-sm nx-esmtp-tool" onclick="resetAllLimits()">
                                <i data-feather="rotate-ccw" class="icon-xs me-1"></i>
                                <span class="d-none d-sm-inline">Limitleri sıfırla</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div id="nxEsmtpBulkBar" class="alert alert-dark py-2 px-3 mb-3 d-none nx-esmtp-bulk-bar">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <span class="small mb-0" id="nxEsmtpBulkBarText"><strong>0</strong> SMTP seçildi</span>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-light" onclick="bulkSetStatus(true)">Seçilenleri aktif yap</button>
                                <button type="button" class="btn btn-sm btn-outline-light" onclick="bulkSetStatus(false)">Seçilenleri pasif yap</button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="bulkDeleteSmtp()">Seçilenleri sil</button>
                            </div>
                        </div>
                    </div>

                    <div class="nx-esmtp-toolbar card border mb-3">
                        <div class="card-body py-2 px-3">
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-lg-4">
                                    <div class="input-group input-group-sm nx-esmtp-input-h">
                                        <span class="input-group-text bg-white"><i data-feather="search" class="icon-xs"></i></span>
                                        <input type="text" class="form-control" id="smtpSearchClient" placeholder="İsim, host, kullanıcı, gönderen…" value="{{ search|e('html_attr') }}" autocomplete="off">
                                        <button class="btn btn-outline-secondary" type="button" id="smtpServerSearchBtn" title="Sunucuda ara (isim, host, kullanıcı)">Sunucuda ara</button>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <select class="form-select form-select-sm nx-esmtp-input-h" id="nxEsmtpStatusFilter" title="Durum">
                                        <option value="all" {{ status|default('all') == 'all' ? 'selected' : '' }}>Tüm durumlar</option>
                                        <option value="active" {{ status|default('all') == 'active' ? 'selected' : '' }}>Aktif</option>
                                        <option value="passive" {{ status|default('all') == 'passive' ? 'selected' : '' }}>Pasif</option>
                                        <option value="healthy" {{ status|default('all') == 'healthy' ? 'selected' : '' }}>Sağlıklı</option>
                                        <option value="risk" {{ status|default('all') == 'risk' ? 'selected' : '' }}>Riskli</option>
                                        <option value="warming" {{ status|default('all') == 'warming' ? 'selected' : '' }}>Warmup</option>
                                        <option value="throttled" {{ status|default('all') == 'throttled' ? 'selected' : '' }}>Limit yakın</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <select class="form-select form-select-sm nx-esmtp-input-h" id="nxEsmtpProviderFilter">
                                        <option value="all" {{ provider|default('all') == 'all' ? 'selected' : '' }}>Tüm sağlayıcılar</option>
                                        <option value="alibaba" {{ provider|default('all') == 'alibaba' ? 'selected' : '' }}>Alibaba / Aliyun</option>
                                        <option value="mailgun" {{ provider|default('all') == 'mailgun' ? 'selected' : '' }}>Mailgun</option>
                                        <option value="other" {{ provider|default('all') == 'other' ? 'selected' : '' }}>Özel SMTP</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <select class="form-select form-select-sm nx-esmtp-input-h" id="nxEsmtpSort">
                                        <option value="newest" {{ sort|default('newest') == 'newest' ? 'selected' : '' }}>En yeni</option>
                                        <option value="most_sent" {{ sort|default('newest') == 'most_sent' ? 'selected' : '' }}>En çok gönderim</option>
                                        <option value="error_rate" {{ sort|default('newest') == 'error_rate' ? 'selected' : '' }}>Yüksek hata</option>
                                        <option value="last_used" {{ sort|default('newest') == 'last_used' ? 'selected' : '' }}>Son kullanım</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <select class="form-select form-select-sm nx-esmtp-input-h" id="nxEsmtpPerPage">
                                        <option value="20" {{ per_page|default(20) == 20 ? 'selected' : '' }}>20 / sayfa</option>
                                        <option value="50" {{ per_page|default(20) == 50 ? 'selected' : '' }}>50 / sayfa</option>
                                        <option value="100" {{ per_page|default(20) == 100 ? 'selected' : '' }}>100 / sayfa</option>
                                    </select>
                                </div>
                                <div class="col-12 col-lg-12 col-xl-12">
                                    <div class="d-flex flex-wrap align-items-center gap-2 justify-content-lg-end mt-1 mt-lg-0">
                                        <div class="btn-group btn-group-sm nx-esmtp-view-toggle" role="group" aria-label="Görünüm">
                                            <button type="button" class="btn btn-outline-primary nx-esmtp-view-btn active" id="nxEsmtpViewTable"><i data-feather="list" class="icon-xs me-1"></i>Tablo</button>
                                            <button type="button" class="btn btn-outline-primary nx-esmtp-view-btn" id="nxEsmtpViewCards"><i data-feather="grid" class="icon-xs me-1"></i>Kart</button>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary nx-esmtp-input-h" id="nxEsmtpToolbarRefresh" title="Yenile"><i data-feather="refresh-cw" class="icon-xs"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary nx-esmtp-input-h" id="nxEsmtpClearFilters">Filtreleri temizle</button>
                                        {% if smtps|length > 0 %}
                                        <div class="form-check mb-0 ms-1 d-flex align-items-center">
                                            <input class="form-check-input" type="checkbox" id="smtpSelectAll" title="Görünür satırların tümü">
                                            <label class="form-check-label small text-muted ms-1 mb-0" for="smtpSelectAll">Tümünü seç</label>
                                        </div>
                                        <div class="form-check mb-0 ms-1 d-flex align-items-center d-md-none">
                                            <input class="form-check-input" type="checkbox" id="smtpSelectAllMobile" title="Görünür satırların tümü">
                                            <label class="form-check-label small text-muted ms-1 mb-0" for="smtpSelectAllMobile">Tümü</label>
                                        </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if smtps|length > 0 %}
                    <div id="nxEsmtpTableWrap" class="nx-esmtp-table-shell">
                        <div class="table-responsive nx-esmtp-table-responsive">
                            <table class="table table-hover align-middle mb-0 nx-esmtp-table">
                                <thead class="nx-esmtp-thead">
                                    <tr>
                                        <th style="width:36px;" class="text-center"></th>
                                        <th>SMTP</th>
                                        <th>Sağlayıcı</th>
                                        <th>Durum</th>
                                        <th class="text-end">Limit / gönderim</th>
                                        <th class="text-end">Başarı / hata</th>
                                        <th>Son kullanım</th>
                                        <th>Güncelleme</th>
                                        <th class="text-end" style="min-width:120px;">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody id="smtpTableBody">
                                    {% for smtp in smtps %}
                                    {% set host_l = smtp.host|lower %}
                                    {% if 'aliyuncs' in host_l or 'alibaba' in host_l or 'aliyun' in host_l %}
                                        {% set provider_key = 'alibaba' %}
                                        {% set provider_label = 'Alibaba DM' %}
                                    {% elseif 'mailgun' in host_l %}
                                        {% set provider_key = 'mailgun' %}
                                        {% set provider_label = 'Mailgun' %}
                                    {% else %}
                                        {% set provider_key = 'other' %}
                                        {% set provider_label = 'Özel' %}
                                    {% endif %}
                                    {% set warm = smtp.totalSent < 100 %}
                                    {% set healthy = smtp.isActive and smtp.successRate >= 92 and smtp.totalFailed < 40 %}
                                    {% set risk = smtp.totalSent >= 15 and smtp.successRate < 85 %}
                                    {% set acct_limit = smtp.dailyLimit > 0 ? smtp.dailyLimit : planDailyLimit %}
                                    {% set acct_pct = acct_limit > 0 ? (smtp.dailySent / acct_limit * 100) : 0 %}
                                    {% set throttled_row = global_usage_pct >= 88 or acct_pct >= 90 %}
                                    {% set search_h = (smtp.name ~ ' ' ~ smtp.host ~ ' ' ~ smtp.username ~ ' ' ~ smtp.fromEmail)|lower %}
                                    <tr class="nx-esmtp-sync nx-esmtp-type-tr" data-smtp-id="{{ smtp.id }}"
                                        data-search="{{ search_h|e('html_attr') }}"
                                        data-active="{{ smtp.isActive ? '1' : '0' }}"
                                        data-provider="{{ provider_key }}"
                                        data-warm="{{ warm ? '1' : '0' }}"
                                        data-healthy="{{ healthy ? '1' : '0' }}"
                                        data-risk="{{ risk ? '1' : '0' }}"
                                        data-throttled="{{ throttled_row ? '1' : '0' }}"
                                        data-created="{{ smtp.createdAt|date('U') }}"
                                        data-last-used="{{ smtp.lastUsedAt ? smtp.lastUsedAt|date('U') : 0 }}"
                                        data-last-used-h="{{ (smtp.lastUsedAt ? smtp.lastUsedAt|date('d.m.Y H:i') : '—')|e('html_attr') }}"
                                        data-total-sent="{{ smtp.totalSent }}"
                                        data-total-failed="{{ smtp.totalFailed }}"
                                        data-success-rate="{{ smtp.successRate }}"
                                        data-created-h="{{ smtp.createdAt|date('d.m.Y H:i')|e('html_attr') }}"
                                        data-updated-h="{{ smtp.updatedAt|date('d.m.Y H:i')|e('html_attr') }}">
                                        <td class="text-center">
                                            <input class="form-check-input smtp-bulk-cb" type="checkbox" value="{{ smtp.id }}" id="smtpCb{{ smtp.id }}" aria-label="Seç: {{ smtp.name|e('html_attr') }}">
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-truncate" style="max-width:260px;">{{ smtp.fromEmail }}</div>
                                            <div class="small text-muted text-truncate" style="max-width:220px;">{{ smtp.name }}</div>
                                            <div class="small text-muted font-monospace text-truncate" style="max-width:300px;">{{ smtp.host }}:{{ smtp.port }} · {{ smtp.encryption ?: 'Yok' }}</div>
                                        </td>
                                        <td><span class="badge nx-esmtp-badge-soft">{{ provider_label }}</span></td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                                {% if smtp.isActive %}
                                                    <span class="badge bg-primary-subtle text-primary border nx-state-badge-active">Aktif</span>
                                                {% else %}
                                                    <span class="badge bg-secondary-subtle text-secondary border nx-state-badge-active">Pasif</span>
                                                {% endif %}
                                                {% if healthy %}
                                                    <span class="badge bg-success-subtle text-success border">OK</span>
                                                {% endif %}
                                                {% if risk %}
                                                    <span class="badge bg-danger-subtle text-danger border">Risk</span>
                                                {% endif %}
                                                {% if warm %}
                                                    <span class="badge bg-warning-subtle text-warning border">Warmup</span>
                                                {% endif %}
                                                {% if throttled_row %}
                                                    <span class="badge bg-warning text-dark border">Limit</span>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td class="text-end small">
                                            <div>{{ smtp.minuteLimit }}/dk</div>
                                            <div class="text-muted">{{ smtp.dailySent|number_format }} / {{ acct_limit|number_format }} günlük</div>
                                        </td>
                                        <td class="text-end small">
                                            <div><span class="text-success">{{ smtp.totalSent|number_format }}</span> / <span class="text-danger">{{ smtp.totalFailed|number_format }}</span></div>
                                            <div class="text-muted">{{ smtp.successRate|number_format(1) }}% başarı</div>
                                        </td>
                                        <td class="small text-muted">{{ smtp.lastUsedAt ? smtp.lastUsedAt|date('d.m.Y H:i') : '—' }}</td>
                                        <td class="small text-muted">{{ smtp.updatedAt|date('d.m.Y H:i') }}</td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-primary" title="Detay" onclick="showSmtpDetail({{ smtp.id }})">Detay</button>
                                                <button type="button" class="btn btn-sm btn-outline-info" title="Test Et" onclick="testSmtp({{ smtp.id }})">Test Et</button>
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-light border nx-esmtp-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Diğer"><i data-feather="more-horizontal" class="icon-xs"></i></button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                        <li><button class="dropdown-item" type="button" onclick="showSmtpDetail({{ smtp.id }})"><i data-feather="eye" class="icon-xs me-2"></i>Detay</button></li>
                                                        <li><button class="dropdown-item" type="button" onclick="testSmtp({{ smtp.id }})"><i data-feather="zap" class="icon-xs me-2"></i>Test et</button></li>
                                                        <li><button class="dropdown-item" type="button" onclick="checkDomain({{ smtp.id }})"><i data-feather="globe" class="icon-xs me-2"></i>Domain</button></li>
                                                        <li><button class="dropdown-item" type="button" onclick="editSmtp({{ smtp.id }})"><i data-feather="edit" class="icon-xs me-2"></i>Düzenle</button></li>
                                                        <li><button class="dropdown-item" type="button" onclick="archiveSmtp({{ smtp.id }})"><i data-feather="archive" class="icon-xs me-2"></i>Arşivle (pasif yap)</button></li>
                                                        <li><button class="dropdown-item" type="button" onclick="resetSingleLimit({{ smtp.id }})"><i data-feather="rotate-ccw" class="icon-xs me-2"></i>Limit / throttle sıfırla</button></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><button class="dropdown-item text-danger" type="button" onclick="deleteSmtp({{ smtp.id }})"><i data-feather="trash-2" class="icon-xs me-2"></i>Sil</button></li>
                                                    </ul>
                                                </div>
                                                <div class="form-check form-switch ms-1 mb-0 nx-esmtp-switch">
                                                    <input class="form-check-input" type="checkbox" id="toggle{{ smtp.id }}" {{ smtp.isActive ? 'checked' : '' }} onchange="toggleSmtp({{ smtp.id }}, this)" title="Aktif / pasif">
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="nxEsmtpCardWrap" class="row g-3 nx-esmtp-card-grid d-none">
                        {% for smtp in smtps %}
                        {% set host_l = smtp.host|lower %}
                        {% if 'aliyuncs' in host_l or 'alibaba' in host_l or 'aliyun' in host_l %}
                            {% set provider_key = 'alibaba' %}
                            {% set provider_label = 'Alibaba DM' %}
                        {% elseif 'mailgun' in host_l %}
                            {% set provider_key = 'mailgun' %}
                            {% set provider_label = 'Mailgun' %}
                        {% else %}
                            {% set provider_key = 'other' %}
                            {% set provider_label = 'Özel' %}
                        {% endif %}
                        {% set warm = smtp.totalSent < 100 %}
                        {% set healthy = smtp.isActive and smtp.successRate >= 92 and smtp.totalFailed < 40 %}
                        {% set risk = smtp.totalSent >= 15 and smtp.successRate < 85 %}
                        {% set acct_limit = smtp.dailyLimit > 0 ? smtp.dailyLimit : planDailyLimit %}
                        {% set acct_pct = acct_limit > 0 ? (smtp.dailySent / acct_limit * 100) : 0 %}
                        {% set throttled_row = global_usage_pct >= 88 or acct_pct >= 90 %}
                        {% set search_h = (smtp.name ~ ' ' ~ smtp.host ~ ' ' ~ smtp.username ~ ' ' ~ smtp.fromEmail)|lower %}
                        <div class="col-12 col-md-6 col-xl-4 nx-esmtp-sync" data-smtp-id="{{ smtp.id }}"
                            data-search="{{ search_h|e('html_attr') }}"
                            data-active="{{ smtp.isActive ? '1' : '0' }}"
                            data-provider="{{ provider_key }}"
                            data-warm="{{ warm ? '1' : '0' }}"
                            data-healthy="{{ healthy ? '1' : '0' }}"
                            data-risk="{{ risk ? '1' : '0' }}"
                            data-throttled="{{ throttled_row ? '1' : '0' }}"
                            data-created="{{ smtp.createdAt|date('U') }}"
                            data-last-used="{{ smtp.lastUsedAt ? smtp.lastUsedAt|date('U') : 0 }}"
                            data-last-used-h="{{ (smtp.lastUsedAt ? smtp.lastUsedAt|date('d.m.Y H:i') : '—')|e('html_attr') }}"
                            data-total-sent="{{ smtp.totalSent }}"
                            data-total-failed="{{ smtp.totalFailed }}"
                            data-success-rate="{{ smtp.successRate }}"
                            data-created-h="{{ smtp.createdAt|date('d.m.Y H:i')|e('html_attr') }}"
                            data-updated-h="{{ smtp.updatedAt|date('d.m.Y H:i')|e('html_attr') }}">
                            <div class="card nx-esmtp-compact-card h-100 border shadow-sm">
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <div class="d-flex align-items-start gap-2 min-w-0">
                                            <input class="form-check-input smtp-bulk-cb mt-1" type="checkbox" value="{{ smtp.id }}" id="smtpCbCard{{ smtp.id }}" aria-label="Seç">
                                            <div class="min-w-0">
                                                <div class="fw-semibold text-truncate">{{ smtp.fromEmail }}</div>
                                                <div class="small text-muted text-truncate">{{ smtp.name }}</div>
                                            </div>
                                        </div>
                                        <div class="form-check form-switch flex-shrink-0 mb-0">
                                            <input class="form-check-input" type="checkbox" id="toggleCard{{ smtp.id }}" {{ smtp.isActive ? 'checked' : '' }} onchange="toggleSmtp({{ smtp.id }}, this)">
                                        </div>
                                    </div>
                                    <div class="small text-muted mb-2">{{ smtp.host }}:{{ smtp.port }} · {{ smtp.encryption ?: 'Yok' }}</div>
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <span class="badge nx-esmtp-badge-soft">{{ provider_label }}</span>
                                        {% if smtp.isActive %}
                                            <span class="badge bg-success-subtle text-success border nx-state-badge-active">Aktif</span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary border nx-state-badge-active">Pasif</span>
                                        {% endif %}
                                        {% if healthy %}<span class="badge bg-success-subtle text-success border">OK</span>{% endif %}
                                        {% if risk %}<span class="badge bg-danger-subtle text-danger border">Risk</span>{% endif %}
                                        {% if warm %}<span class="badge bg-warning-subtle text-warning border">Warmup</span>{% endif %}
                                    </div>
                                    <div class="row g-2 small mt-1">
                                        <div class="col-6"><div class="rounded bg-light py-1 px-2"><div class="fw-semibold">{{ smtp.dailySent|number_format }}</div><div class="text-muted" style="font-size:0.72rem;">Günlük gönderim</div></div></div>
                                        <div class="col-6"><div class="rounded bg-light py-1 px-2"><div class="fw-semibold">{{ acct_limit|number_format }}</div><div class="text-muted" style="font-size:0.72rem;">Günlük limit</div></div></div>
                                        <div class="col-6"><div class="rounded bg-light py-1 px-2"><div class="fw-semibold">{{ smtp.totalSent|number_format }}</div><div class="text-muted" style="font-size:0.72rem;">Toplam başarı</div></div></div>
                                        <div class="col-6"><div class="rounded bg-light py-1 px-2"><div class="fw-semibold text-danger">{{ smtp.totalFailed|number_format }}</div><div class="text-muted" style="font-size:0.72rem;">Toplam hata</div></div></div>
                                    </div>
                                    <div class="small text-muted mt-2">Son kullanım: {{ smtp.lastUsedAt ? smtp.lastUsedAt|date('d.m.Y H:i') : '—' }}</div>
                                    <div class="small text-muted">Güncelleme: {{ smtp.updatedAt|date('d.m.Y H:i') }}</div>
                                    <div class="d-flex flex-wrap gap-1 mt-3 pt-2 border-top">
                                        <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1" onclick="showSmtpDetail({{ smtp.id }})">Detay</button>
                                        <button type="button" class="btn btn-sm btn-outline-info" onclick="testSmtp({{ smtp.id }})">Test Et</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="editSmtp({{ smtp.id }})">Düzenle</button>
                                        <button type="button" class="btn btn-sm btn-outline-dark" onclick="archiveSmtp({{ smtp.id }})">Arşivle</button>
                                        <button type="button" class="btn btn-sm btn-outline-warning" onclick="resetSingleLimit({{ smtp.id }})">Limit sıfırla</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteSmtp({{ smtp.id }})">Sil</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    <p class="small text-muted mb-2">Kart ve tablo görünümü arasında üstteki görünüm anahtarlarıyla geçiş yapabilirsiniz.</p>

                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2" id="nxEsmtpPagerWrap">
                        <div class="small text-muted" id="nxEsmtpPagerInfo">
                            {% if total|default(0) > 0 %}
                                {{ ((page - 1) * per_page) + 1 }}–{{ (page * per_page) > total ? total : (page * per_page) }} / {{ total }} kayıt
                            {% else %}
                                Kayıt yok
                            {% endif %}
                        </div>
                        {% if total_pages|default(1) > 1 %}
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="nxEsmtpPagerUl">
                                <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                                    <a class="page-link" href="{{ page <= 1 ? '#' : ('/admin/email-smtp?page=' ~ (page - 1) ~ '&per_page=' ~ per_page ~ '&search=' ~ (search|default('')|e('url')) ~ '&status=' ~ (status|default('')|e('url')) ~ '&provider=' ~ (provider|default('')|e('url')) ~ '&sort=' ~ (sort|default('')|e('url'))) }}">«</a>
                                </li>
                                {% for p in (page - 2)..(page + 2) %}
                                    {% if p >= 1 and p <= total_pages %}
                                    <li class="page-item {{ p == page ? 'active' : '' }}">
                                        <a class="page-link" href="/admin/email-smtp?page={{ p }}&per_page={{ per_page }}&search={{ search|default('')|e('url') }}&status={{ status|default('')|e('url') }}&provider={{ provider|default('')|e('url') }}&sort={{ sort|default('')|e('url') }}">{{ p }}</a>
                                    </li>
                                    {% endif %}
                                {% endfor %}
                                <li class="page-item {{ page >= total_pages ? 'disabled' : '' }}">
                                    <a class="page-link" href="{{ page >= total_pages ? '#' : ('/admin/email-smtp?page=' ~ (page + 1) ~ '&per_page=' ~ per_page ~ '&search=' ~ (search|default('')|e('url')) ~ '&status=' ~ (status|default('')|e('url')) ~ '&provider=' ~ (provider|default('')|e('url')) ~ '&sort=' ~ (sort|default('')|e('url'))) }}">»</a>
                                </li>
                            </ul>
                        </nav>
                        {% endif %}
                    </div>
                    {% else %}
                    <div class="text-center py-5 nx-esmtp-empty">
                        <div class="mb-3 opacity-50"><i data-feather="inbox" style="width:64px;height:64px;"></i></div>
                        <h5 class="text-muted mb-2">Henüz SMTP hesabı eklenmedi</h5>
                        <p class="text-muted small mb-4">Gönderim için bir hesap ekleyin veya toplu içe aktarma kullanın.</p>
                        <button type="button" class="btn btn-primary" onclick="showAddModal()"><i data-feather="plus-circle" class="icon-xs me-1"></i>SMTP Ekle</button>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Alibaba DirectMail Delivery Reports (liste altında) -->
    <div class="card border-0 shadow-sm mb-4 mt-3">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="mb-0">
                    <i data-feather="bar-chart-2" class="icon-xs me-1"></i>
                    Delivery Reports (Alibaba DirectMail)
                </h5>
                <small class="text-muted">Gunluk özet (Alibaba konsolu ile aynı takvim günü: UTC+8 / Asia/Singapore)</small>
            </div>
            <form action="/admin/email-smtp/delivery-reports/sync" method="POST" class="d-flex align-items-center gap-2">
                <select name="days" class="form-select form-select-sm nx-esmtp-input-h">
                    <option value="1">Bugün (UTC+8)</option>
                    <option value="7">Son 7 gun</option>
                    <option value="14" selected>Son 14 gun</option>
                    <option value="30">Son 30 gun</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-primary nx-esmtp-input-h">
                    <i data-feather="refresh-cw" class="icon-xs me-1"></i>
                    Senkronla
                </button>
            </form>
        </div>
        <div class="card-body">
            <div class="alert alert-info py-2 mb-3">
                <small>
                    <i data-feather="info" class="icon-xs me-1"></i>
                    <code>.env</code>:
                    <code>ALIBABA_DM_ACCESS_KEY_ID</code>,
                    <code>ALIBABA_DM_ACCESS_KEY_SECRET</code>,
                    <code>ALIBABA_DM_REGION=ap-southeast-1</code>.
                    İsteğe bağlı: <code>ALIBABA_DM_REPORT_TIMEZONE=Asia/Singapore</code>
                    (takvim günü). Anahtarları asla koda yapıştırmayın.
                </small>
            </div>

            {% if delivery_reports is not empty %}
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th class="text-end">Toplam</th>
                            <th class="text-end">Basarili</th>
                            <th class="text-end">Basarisiz</th>
                            <th class="text-end">Invalid Address</th>
                            <th class="text-end">Success Rate</th>
                            <th class="text-end">Invalid Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in delivery_reports %}
                        <tr>
                            <td>{{ row.report_date }}</td>
                            <td class="text-end">{{ row.total|number_format }}</td>
                            <td class="text-end text-success">{{ row.successful|number_format }}</td>
                            <td class="text-end text-danger">{{ row.failed|number_format }}</td>
                            <td class="text-end text-warning">{{ row.invalid_address|number_format }}</td>
                            <td class="text-end">{{ row.success_rate|number_format(2) }}%</td>
                            <td class="text-end">{{ row.invalid_rate|number_format(2) }}%</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="text-muted">
                Henüz delivery report verisi yok. "Senkronla" butonunu kullanarak Alibaba'dan cekebilirsiniz.
            </div>
            {% endif %}
        </div>
    </div>
