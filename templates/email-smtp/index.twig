// Add modal göster
function showAddModal() {
    document.getElementById('smtpForm').reset();
    const modalEl = document.getElementById('addSmtpModal');
    if (!modalEl) return;
    let m = bootstrap.Modal.getInstance(modalEl);
    if (!m) m = new bootstrap.Modal(modalEl);
    m.show();
    setTimeout(() => feather.replace(), 100);
}

function bulkImportPreviewCount() {
    const raw = document.getElementById('bulk_smtp_lines').value || '';
    const n = raw.split(/\r\n|\n|\r/).filter((l) => {
        const t = l.trim();
        return t.length > 0 && !t.startsWith('#');
    }).length;
    showPageAlert(`${n} veri satırı (yorum ve boşlar hariç).`, 'info', 'Önizleme');
}

function submitBulkImport() {
    const btn = document.getElementById('bulk_import_submit_btn');
    const out = document.getElementById('bulk_import_result');
    const bulkLines = document.getElementById('bulk_smtp_lines').value || '';
    const payload = {
        bulk_lines: bulkLines,
        host: document.getElementById('bulk_smtp_host').value.trim(),
        port: parseInt(document.getElementById('bulk_smtp_port').value, 10) || 465,
        encryption: document.getElementById('bulk_smtp_encryption').value,
        priority: parseInt(document.getElementById('bulk_smtp_priority').value, 10) || 5,
        is_active: document.getElementById('bulk_smtp_active').checked,
        test_after_each: document.getElementById('bulk_smtp_test_each').checked,
    };

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>İşleniyor...';

    fetch('/admin/email-smtp/bulk-import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
    })
        .then((res) => res.json().then((data) => ({ ok: res.ok, status: res.status, data })))
        .then(({ ok, status, data }) => {
            if (!ok || data.success === false) {
                const msg = data.message || `HTTP ${status}`;
                throw new Error(msg);
            }
            const esc = (s) =>
                String(s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            let html = `<div class="alert alert-success"><strong>Tamamlandı.</strong> ${esc(data.message || '')}</div>`;
            if (Array.isArray(data.failed) && data.failed.length) {
                html += '<div class="alert alert-danger small mb-2"><strong>Hatalı satırlar</strong><ul class="mb-0">';
                data.failed.slice(0, 40).forEach((f) => {
                    html += `<li><code>${esc(f.line || '')}</code> — ${esc(f.error || '')}</li>`;
                });
                if (data.failed.length > 40) html += `<li>… ve ${data.failed.length - 40} satır daha</li>`;
                html += '</ul></div>';
            }
            if (Array.isArray(data.skipped) && data.skipped.length) {
                html += `<div class="alert alert-warning small mb-2">Zaten kayıtlı (atlandı): ${data.skipped.length} adet</div>`;
            }
            if (Array.isArray(data.tests) && data.tests.length) {
                html += '<div class="table-responsive"><table class="table table-sm table-bordered mb-0"><thead><tr><th>Email</th><th>Test</th><th>Mesaj</th></tr></thead><tbody>';
                data.tests.forEach((t) => {
                    const okT = t.success === true || t.ok === true;
                    html += `<tr><td>${esc(t.email || '')}</td><td>${okT ? 'OK' : 'Hata'}</td><td class="small">${esc(t.message || '')}</td></tr>`;
                });
                html += '</tbody></table></div>';
            }
            out.innerHTML = html;
            out.classList.remove('d-none');
            showPageAlert(data.message || 'Toplu içe aktarma bitti', 'success', 'Başarılı');
            setTimeout(() => window.location.reload(), 2200);
        })
        .catch((err) => {
            showPageAlert(err.message || 'İstek başarısız', 'error', 'Hata');
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i data-feather="upload" class="icon-xs me-1"></i>İçe aktar';
            feather.replace();
        });
}

