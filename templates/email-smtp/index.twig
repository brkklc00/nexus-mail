// SMTP aktif/pasif toggle (tablo + kart switch senkron)
function toggleSmtp(id, sourceEl) {
    const t1 = document.getElementById('toggle' + id);
    const t2 = document.getElementById('toggleCard' + id);
    const v = sourceEl ? !!sourceEl.checked : (t1 ? t1.checked : !!(t2 && t2.checked));
    if (t1) t1.checked = v;
    if (t2) t2.checked = v;
    fetch(`/admin/email-smtp/${id}/toggle`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ is_active: v })
    })
    .then(res => {
        if (!res.ok) {
            throw new Error('Sunucu hatası');
        }
        return res.json();
    })
    .then(data => {
        if (data.success) {
            updateSmtpStatusUi(id, !!data.is_active);
            showPageAlert(data.message, 'success', 'Başarılı');
        } else {
            throw new Error(data.message);
        }
    })
    .catch(error => {
        showPageAlert(error.message, 'error', 'Hata');
        const vBad = !v;
        if (t1) t1.checked = vBad;
        if (t2) t2.checked = vBad;
    });
}

function updateSmtpStatusUi(id, isActive) {
    document.querySelectorAll('.nx-esmtp-sync[data-smtp-id="' + id + '"]').forEach(function (el) {
        el.setAttribute('data-active', isActive ? '1' : '0');
        var tbodyRow = el.classList.contains('nx-esmtp-type-tr') ? el : null;
        if (tbodyRow) {
            var badges = tbodyRow.querySelector('td:nth-child(4) .d-flex');
            if (badges) {
                var activeBadge = badges.querySelector('.nx-state-badge-active');
                if (activeBadge) {
                    activeBadge.className = isActive
                        ? 'badge bg-primary-subtle text-primary border nx-state-badge-active'
                        : 'badge bg-secondary-subtle text-secondary border nx-state-badge-active';
                    activeBadge.textContent = isActive ? 'Aktif' : 'Pasif';
                }
            }
        } else {
            var cardBadges = el.querySelectorAll('.badge');
            cardBadges.forEach(function (badge) {
                if (badge.classList.contains('nx-state-badge-active')) {
                    badge.className = isActive
                        ? 'badge bg-success-subtle text-success border nx-state-badge-active'
                        : 'badge bg-secondary-subtle text-secondary border nx-state-badge-active';
                    badge.textContent = isActive ? 'Aktif' : 'Pasif';
                }
            });
        }
    });
}

