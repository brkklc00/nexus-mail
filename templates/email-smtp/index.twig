var nxEsmtpState = { view: 'table' };

function nxEsmtpApplyView() {
    var tw = document.getElementById('nxEsmtpTableWrap');
    var cw = document.getElementById('nxEsmtpCardWrap');
    if (!tw || !cw) return;
    var mobile = window.matchMedia('(max-width: 991.98px)').matches;
    if (mobile) {
        tw.classList.add('d-none');
        cw.classList.remove('d-none');
        return;
    }
    if (nxEsmtpState.view === 'cards') {
        tw.classList.add('d-none');
        cw.classList.remove('d-none');
    } else {
        tw.classList.remove('d-none');
        cw.classList.add('d-none');
    }
}

function nxEsmtpCurrentFilters() {
    return {
        search: (document.getElementById('smtpSearchClient') && document.getElementById('smtpSearchClient').value || '').trim(),
        status: (document.getElementById('nxEsmtpStatusFilter') && document.getElementById('nxEsmtpStatusFilter').value) || 'all',
        provider: (document.getElementById('nxEsmtpProviderFilter') && document.getElementById('nxEsmtpProviderFilter').value) || 'all',
        sort: (document.getElementById('nxEsmtpSort') && document.getElementById('nxEsmtpSort').value) || 'newest',
        per_page: (document.getElementById('nxEsmtpPerPage') && document.getElementById('nxEsmtpPerPage').value) || '20'
    };
}

function nxEsmtpApplyServerFilters(resetPage) {
    var f = nxEsmtpCurrentFilters();
    var params = new URLSearchParams(window.location.search || '');
    if (f.search) params.set('search', f.search); else params.delete('search');
    if (f.status && f.status !== 'all') params.set('status', f.status); else params.delete('status');
    if (f.provider && f.provider !== 'all') params.set('provider', f.provider); else params.delete('provider');
    if (f.sort && f.sort !== 'newest') params.set('sort', f.sort); else params.delete('sort');
    if (f.per_page && f.per_page !== '20') params.set('per_page', f.per_page); else params.delete('per_page');
    if (resetPage) params.delete('page');
    window.location.href = '/admin/email-smtp' + (params.toString() ? ('?' + params.toString()) : '');
}

function nxEsmtpInit() {
    try {
        var v = localStorage.getItem('nx-esmtp-view');
        if (v === 'cards' || v === 'table') nxEsmtpState.view = v;
    } catch (e) {}
    var btnT = document.getElementById('nxEsmtpViewTable');
    var btnC = document.getElementById('nxEsmtpViewCards');
    function setActiveView() {
        if (btnT && btnC) {
            btnT.classList.toggle('active', nxEsmtpState.view === 'table');
            btnC.classList.toggle('active', nxEsmtpState.view === 'cards');
        }
        try { localStorage.setItem('nx-esmtp-view', nxEsmtpState.view); } catch (e) {}
        nxEsmtpApplyView();
    }
    if (btnT) btnT.addEventListener('click', function () {
        nxEsmtpState.view = 'table';
        setActiveView();
    });
    if (btnC) btnC.addEventListener('click', function () {
        nxEsmtpState.view = 'cards';
        setActiveView();
    });
    setActiveView();

    var sc = document.getElementById('smtpSearchClient');
    var searchDebounce;
    if (sc) {
        sc.addEventListener('input', function () {
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(function () {
                nxEsmtpApplyServerFilters(true);
            }, 400);
        });
        sc.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                nxEsmtpApplyServerFilters(true);
            }
        });
    }
    ['nxEsmtpStatusFilter', 'nxEsmtpProviderFilter', 'nxEsmtpSort', 'nxEsmtpPerPage'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('change', function () {
            nxEsmtpApplyServerFilters(true);
        });
    });
    var clr = document.getElementById('nxEsmtpClearFilters');
    if (clr) clr.addEventListener('click', function () {
        if (sc) sc.value = '';
        var sf = document.getElementById('nxEsmtpStatusFilter');
        var pf = document.getElementById('nxEsmtpProviderFilter');
        var so = document.getElementById('nxEsmtpSort');
        var pp = document.getElementById('nxEsmtpPerPage');
        if (sf) sf.value = 'all';
        if (pf) pf.value = 'all';
        if (so) so.value = 'newest';
        if (pp) pp.value = '20';
        window.location.href = '/admin/email-smtp';
    });
    var ssb = document.getElementById('smtpServerSearchBtn');
    if (ssb) ssb.addEventListener('click', function () { nxEsmtpApplyServerFilters(true); });
    var tr = document.getElementById('nxEsmtpToolbarRefresh');
    if (tr) tr.addEventListener('click', function () { window.location.reload(); });
    var hr = document.getElementById('nxEsmtpHeadRefresh');
    if (hr) hr.addEventListener('click', function () { window.location.reload(); });
    var resizeT;
    window.addEventListener('resize', function () {
        clearTimeout(resizeT);
        resizeT = setTimeout(function () { nxEsmtpApplyView(); }, 150);
    });

    nxEsmtpApplyView();
    updateSmtpBulkDeleteUi();
}

// Feather icons
document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
    nxEsmtpInit();

    var bulkModalEl = document.getElementById('bulkImportSmtpModal');
    if (bulkModalEl) {
        bulkModalEl.addEventListener('show.bs.modal', function () {
            var r = document.getElementById('bulk_import_result');
            if (r) {
                r.classList.add('d-none');
                r.innerHTML = '';
            }
            setTimeout(function () { feather.replace(); }, 50);
        });
    }

    function bindSelectAll(el) {
        if (!el) return;
        el.addEventListener('change', function () {
            var on = this.checked;
            nxEsmtpVisibleBulkCbs().forEach(function (cb) { cb.checked = on; });
            updateSmtpBulkDeleteUi();
        });
    }
    bindSelectAll(document.getElementById('smtpSelectAll'));
    bindSelectAll(document.getElementById('smtpSelectAllMobile'));

    document.querySelectorAll('.smtp-bulk-cb').forEach(function (cb) {
        cb.addEventListener('change', updateSmtpBulkDeleteUi);
    });
    updateSmtpBulkDeleteUi();
});
</script>
{% endblock %}

