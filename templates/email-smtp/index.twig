<script>
let currentTestSmtpId = null;

// Sayfa içi uyarı göster (iziToast yerine)
function showPageAlert(message, type = 'success', title = '') {
    const container = document.getElementById('pageAlertsContainer');
    if (!container) return;
    const typeMap = { success: 'success', error: 'danger', warning: 'warning', info: 'info' };
    const iconMap = { success: 'check-circle', danger: 'alert-circle', warning: 'alert-triangle', info: 'info' };
    const alertType = typeMap[type] || 'info';
    const icon = iconMap[alertType] || 'info';
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const displayMsg = title ? `<strong>${esc(title)}</strong> ${esc(message)}` : esc(message);
    const alertHtml = `
        <div class="alert alert-${alertType} alert-dismissible fade show" role="alert">
            <i data-feather="${icon}" class="align-self-center icon-xs me-2"></i>
            ${displayMsg}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    `;
    container.insertAdjacentHTML('beforeend', alertHtml);
    feather.replace();
    container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// Detay modal — yalnızca id; veri /edit JSON + satır dataset
function nxEsmtpProviderLabel(host) {
    const h = (host || '').toLowerCase();
    if (h.includes('aliyuncs') || h.includes('alibaba') || h.includes('aliyun')) return 'Alibaba DirectMail';
    if (h.includes('mailgun')) return 'Mailgun';
    return 'Özel SMTP';
}
function nxEsmtpRowDataset(id) {
    const el = document.querySelector('.nx-esmtp-type-tr[data-smtp-id="' + id + '"]') || document.querySelector('.nx-esmtp-sync[data-smtp-id="' + id + '"]');
    return el ? el.dataset : {};
}
function nxEsmtpEsc(s) {
    if (typeof nxEscapeHtml === 'function') return nxEscapeHtml(s);
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function showSmtpDetail(id) {
    const idNum = parseInt(id, 10);
    if (!idNum) return;
    const hid = document.getElementById('detail_current_id');
    if (hid) hid.value = String(idNum);
    const ds = nxEsmtpRowDataset(idNum);
    fetch('/admin/email-smtp/' + idNum + '/edit')
        .then((response) => response.json())
        .then((data) => {
            if (!data || data.success === false || typeof data.id === 'undefined') throw new Error('SMTP hesabı bulunamadı');
            const host = data.host || '';
            const port = data.port != null ? String(data.port) : '';
            const enc = data.encryption === '' || data.encryption == null ? 'Yok' : String(data.encryption);
            document.getElementById('detail_smtp_name').textContent = data.name || 'SMTP';
            document.getElementById('detail_id').textContent = '#' + data.id;
            document.getElementById('detail_provider').innerHTML = '<span class="badge nx-esmtp-badge-soft">' + nxEsmtpEsc(nxEsmtpProviderLabel(host)) + '</span>';
            document.getElementById('detail_host_block').innerHTML = '<code class="small">' + nxEsmtpEsc(host) + ':' + nxEsmtpEsc(port) + '</code> <span class="text-muted">· ' + nxEsmtpEsc(enc) + '</span>';
            document.getElementById('detail_username').textContent = data.username || '—';
            const fn = (data.from_name || '').trim();
            const fe = data.from_email || '';
            document.getElementById('detail_from_line').innerHTML = nxEsmtpEsc(fe) + (fn ? ' <span class="text-muted">(' + nxEsmtpEsc(fn) + ')</span>' : '');
            const pr = data.priority != null ? data.priority : 1;
            document.getElementById('detail_priority_badge').innerHTML = pr === 1
                ? '<span class="badge bg-primary">Öncelik ' + pr + '</span>'
                : '<span class="badge bg-secondary">Öncelik ' + pr + '</span>';
            const active = !!data.is_active;
            document.getElementById('detail_status_badge').innerHTML = active
                ? '<span class="badge bg-primary-subtle text-primary border">Aktif</span>'
                : '<span class="badge bg-secondary-subtle text-secondary border">Pasif</span>';
            const hb = [];
            if (ds.healthy === '1') hb.push('<span class="badge bg-success-subtle text-success border">Sağlıklı</span>');
            if (ds.risk === '1') hb.push('<span class="badge bg-danger-subtle text-danger border">Riskli başarı</span>');
            if (ds.warm === '1') hb.push('<span class="badge bg-warning-subtle text-warning border">Warmup</span>');
            if (ds.throttled === '1') hb.push('<span class="badge bg-warning text-dark border">Limit yakın</span>');
            if (!hb.length) hb.push('<span class="badge bg-light text-muted border">—</span>');
            document.getElementById('detail_health_badge').innerHTML = hb.join(' ');
            document.getElementById('detail_last_used').textContent = ds.lastUsedH || '—';
            document.getElementById('detail_dates').textContent = (ds.createdH || '—') + ' · ' + (ds.updatedH || '—');
            document.getElementById('detail_daily_sent').textContent = (data.daily_sent != null ? data.daily_sent : 0).toLocaleString('tr-TR');
            document.getElementById('detail_daily_limit').textContent = (data.daily_limit != null ? data.daily_limit : 0).toLocaleString('tr-TR');
            document.getElementById('detail_total_sent').textContent = (data.total_sent != null ? data.total_sent : 0).toLocaleString('tr-TR');
            document.getElementById('detail_success_rate').textContent = (Number(data.success_rate) || 0).toFixed(1) + '%';
            document.getElementById('detail_total_failed').textContent = (data.total_failed != null ? data.total_failed : 0).toLocaleString('tr-TR');
            document.getElementById('detail_hourly_sent').textContent = (data.hourly_sent || 0).toLocaleString('tr-TR');
            document.getElementById('detail_hourly_limit').textContent = (data.hourly_limit || 0).toLocaleString('tr-TR');
            document.getElementById('detail_minute_sent').textContent = (data.minute_sent || 0).toLocaleString('tr-TR');
            document.getElementById('detail_minute_limit').textContent = (data.minute_limit || 0).toLocaleString('tr-TR');
            const hint = document.getElementById('detail_test_hint');
            if (hint) hint.classList.remove('d-none');
            const modalEl = document.getElementById('smtpDetailModal');
            let m = bootstrap.Modal.getInstance(modalEl);
            if (!m) m = new bootstrap.Modal(modalEl);
            m.show();
            setTimeout(() => feather.replace(), 80);
        })
        .catch(() => {
            showPageAlert('SMTP detayı yüklenemedi.', 'error', 'Hata');
        });
}
function nxEsmtpDetailTest() {
    const id = parseInt(document.getElementById('detail_current_id').value, 10);
    if (!id) return;
    const m = bootstrap.Modal.getInstance(document.getElementById('smtpDetailModal'));
    if (m) m.hide();
    testSmtp(id);
}
