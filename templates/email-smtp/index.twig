    feather.replace();

    fetch(`/admin/email-smtp/${id}/domain-check`)
        .then(res => {
            if (!res.ok) {
                throw new Error('Domain kontrolü alınamadı');
            }
            return res.json();
        })
        .then(data => {
            if (!data.success) {
                throw new Error(data.message || 'Domain kontrolü başarısız');
            }

            const scoreClass = data.score >= 80 ? 'success' : (data.score >= 50 ? 'warning' : 'danger');
            const yesNo = (ok) => ok
                ? '<span class="badge bg-success-subtle text-success">OK</span>'
                : '<span class="badge bg-danger-subtle text-danger">Eksik</span>';
            const recommendations = (data.recommendations || []).map(item => `<li>${item}</li>`).join('');

            resultDiv.innerHTML = `
                <div class="mb-3">
                    <h6 class="mb-1">${data.smtp_name}</h6>
                    <small class="text-muted">${data.from_email} · ${data.domain}</small>
                </div>
                <div class="mb-3">
                    <label class="form-label mb-1">Domain Sağlık Skoru</label>
                    <div class="progress" style="height: 12px;">
                        <div class="progress-bar bg-${scoreClass}" style="width: ${Math.min(data.score, 100)}%"></div>
                    </div>
                    <small class="text-muted">${data.score}/100</small>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Kontrol</th>
                                <th>Durum</th>
                                <th>Detay</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>SPF</td>
                                <td>${yesNo(data.checks.spf.ok)}</td>
                                <td><small class="text-muted">${(data.checks.spf.records || []).slice(0, 1).join(' | ') || '-'}</small></td>
                            </tr>
                            <tr>
                                <td>DKIM</td>
                                <td>${yesNo(data.checks.dkim.ok)}</td>
                                <td><small class="text-muted">${data.checks.dkim.selector ? 'Selector: ' + data.checks.dkim.selector : '-'}</small></td>
                            </tr>
                            <tr>
                                <td>DMARC</td>
                                <td>${yesNo(data.checks.dmarc.ok)}</td>
                                <td><small class="text-muted">${(data.checks.dmarc.records || []).slice(0, 1).join(' | ') || '-'}</small></td>
                            </tr>
                            <tr>
                                <td>MX</td>
                                <td>${yesNo(data.checks.mx.ok)}</td>
                                <td><small class="text-muted">${data.checks.mx.count || 0} kayıt</small></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <h6 class="mb-2">Öneriler</h6>
                    <ul class="mb-0">${recommendations}</ul>
                </div>
            `;
            feather.replace();
        })
        .catch(error => {
            resultDiv.innerHTML = `
                <div class="alert alert-danger mb-0">
                    <i data-feather="alert-triangle" class="me-2"></i>
                    ${error.message}
                </div>
            `;
            feather.replace();
        });
}

