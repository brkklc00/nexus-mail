{% extends "_layouts/main.twig" %}

{% block title %}Kara Liste - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/email-dashboard">Mail Yönetimi</a></li>
<li class="breadcrumb-item active" aria-current="page">Kara Liste</li>
{% endblock %}

{% block page_title %}
<div class="row nx-orders-page-head">
    <div class="col-12">
        <div class="page-title-box nx-page-head pb-0">
            <div class="d-flex flex-column flex-lg-row align-items-start justify-content-lg-between gap-3">
                <div class="min-w-0">
                    <div class="page-title-right mb-2">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/dashboard">Panel</a></li>
                            <li class="breadcrumb-item"><a href="/email-dashboard">Email</a></li>
                            <li class="breadcrumb-item active">Kara Liste</li>
                        </ol>
                    </div>
                    <h4 class="page-title nx-page-title mb-1">Kara Liste</h4>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm nx-orders-tool-btn nx-orders-tool-btn--page" id="nxBlHeadRefresh" title="Yenile">
                        <i data-feather="refresh-cw" class="nx-orders-tool-ic"></i>
                        <span class="d-none d-sm-inline">Yenile</span>
                    </button>
                    <a href="/email-send" class="btn btn-sm nx-orders-tool-btn nx-orders-tool-btn--page">
                        <i data-feather="send" class="nx-orders-tool-ic"></i>
                        <span class="d-none d-sm-inline">Yeni Gönderim</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_icon %}{% endblock %}
{% block title_text %}{% endblock %}

{% block styles %}
<style>
.nx-bl-toolbar {
    display: grid !important;
    grid-template-columns: minmax(220px, 1fr) 165px 150px 130px 104px 92px 100px 40px !important;
    gap: 10px !important;
    align-items: center;
    padding: 14px !important;
}

.nx-bl-toolbar .btn {
    min-height: 40px;
}

.nx-bl-soft-danger {
    border-color: rgba(220, 38, 38, 0.24) !important;
    color: #b91c1c !important;
    background: #fff7f7 !important;
}

.nx-bl-soft-danger:hover {
    background: #fee2e2 !important;
    border-color: rgba(185, 28, 28, 0.35) !important;
}

.nx-bl-email {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.79rem;
    color: #0f172a;
}

.nx-bl-reason-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.nx-bl-reason-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.18rem 0.52rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.01em;
}

.nx-bl-reason-badge.is-invalid_recipient { background: #fff7ed; color: #c2410c; border: 1px solid #fdba74; }
.nx-bl-reason-badge.is-bounce { background: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5; }
.nx-bl-reason-badge.is-spam { background: #f5f3ff; color: #6d28d9; border: 1px solid #c4b5fd; }
.nx-bl-reason-badge.is-complaint { background: #fdf2f8; color: #be185d; border: 1px solid #f9a8d4; }
.nx-bl-reason-badge.is-manual { background: #eff6ff; color: #1d4ed8; border: 1px solid #93c5fd; }
.nx-bl-reason-badge.is-smtp_error { background: #ecfeff; color: #0e7490; border: 1px solid #67e8f9; }
.nx-bl-reason-badge.is-other { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

.nx-bl-reason-summary {
    font-size: 0.77rem;
    color: #0f172a;
    font-weight: 600;
    line-height: 1.32;
}

.nx-bl-reason-hint {
    font-size: 0.72rem;
    color: #64748b;
    line-height: 1.3;
}

.nx-bl-reason-detail-btn {
    font-size: 0.72rem;
    color: #2563eb;
    border: 0;
    background: transparent;
    padding: 0;
    text-align: left;
    width: fit-content;
}

.nx-bl-reason-full {
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 260px;
    overflow: auto;
    background: #0f172a;
    color: #e2e8f0;
    border-radius: 10px;
    padding: 0.8rem;
    font-size: 0.78rem;
}

@media (max-width: 1399.98px) {
    .nx-bl-toolbar {
        grid-template-columns: minmax(220px, 1fr) 160px 140px 120px 96px 90px 90px 40px !important;
    }
}

@media (max-width: 1199.98px) {
    .nx-bl-toolbar {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }

    .nx-bl-toolbar .nx-orders-icon-refresh {
        justify-self: start;
    }
}

@media (max-width: 767.98px) {
    .nx-bl-toolbar {
        grid-template-columns: 1fr !important;
    }
}
</style>
{% endblock %}

{% block content %}

    {% if success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>
        {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    {% if error %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i data-feather="alert-circle" class="align-self-center icon-xs me-2"></i>
        {{ error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Loading Overlay -->
    <div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 9999; backdrop-filter: blur(5px);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
            <div class="spinner-border text-light mb-3" role="status" style="width: 4rem; height: 4rem; border-width: 0.3rem;">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <h4 class="text-white mb-2" id="loadingText">İşlem Yapılıyor...</h4>
            <p class="text-white-50 mb-3" id="loadingSubtext">Lütfen bekleyin</p>
            <div class="progress mx-auto" style="width: 300px; height: 8px; background: rgba(255,255,255,0.2);">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 100%"></div>
            </div>
        </div>
    </div>

    <div class="nx-orders-page nx-email-page nx-orders-shell">
    <div class="row g-3 nx-orders-kpis mb-3">
        <div class="col-12 col-md-6 col-xl">
            <div class="nx-orders-kpi">
                <div class="nx-orders-kpi-icon nx-orders-kpi-icon--orders"><i data-feather="shield-off"></i></div>
                <div class="nx-orders-kpi-body">
                    <div class="nx-orders-kpi-value">{{ total|number_format(0, ',', '.') }}</div>
                    <div class="nx-orders-kpi-label">Toplam kara liste</div>
                    <div class="nx-orders-kpi-hint">Kayıtlı engellenen adres</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl">
            <div class="nx-orders-kpi">
                <div class="nx-orders-kpi-icon nx-orders-kpi-icon--sent"><i data-feather="calendar"></i></div>
                <div class="nx-orders-kpi-body">
                    <div class="nx-orders-kpi-value">{{ stats.today_total|default(0)|number_format(0, ',', '.') }}</div>
                    <div class="nx-orders-kpi-label">Bugün eklenen</div>
                    <div class="nx-orders-kpi-hint">Tüm kara listede</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl">
            <div class="nx-orders-kpi">
                <div class="nx-orders-kpi-icon nx-orders-kpi-icon--warn"><i data-feather="alert-triangle"></i></div>
                <div class="nx-orders-kpi-body">
                    <div class="nx-orders-kpi-value">{{ stats.invalid_recipient_total|default(0)|number_format(0, ',', '.') }}</div>
                    <div class="nx-orders-kpi-label">Invalid recipient</div>
                    <div class="nx-orders-kpi-hint">En sık sebep tipi</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl">
            <div class="nx-orders-kpi">
                <div class="nx-orders-kpi-icon nx-orders-kpi-icon--credit"><i data-feather="slash"></i></div>
                <div class="nx-orders-kpi-body">
                    <div class="nx-orders-kpi-value">{{ stats.bounce_spam_total|default(0)|number_format(0, ',', '.') }}</div>
                    <div class="nx-orders-kpi-label">Bounce / Spam</div>
                    <div class="nx-orders-kpi-hint">Toplam kayıt</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl">
            <div class="nx-orders-kpi">
                <div class="nx-orders-kpi-icon nx-orders-kpi-icon--credit"><i data-feather="layers"></i></div>
                <div class="nx-orders-kpi-body">
                    <div class="nx-orders-kpi-value">{{ totalPages > 1 ? currentPage ~ ' / ' ~ totalPages : '1' }}</div>
                    <div class="nx-orders-kpi-label">Sayfa</div>
                    <div class="nx-orders-kpi-hint">{{ perPage }} kayıt / sayfa</div>
                </div>
            </div>
        </div>
    </div>

    <div class="nx-orders-cols nx-email-cols">
        <main class="nx-orders-main">
        <div class="card nx-card nx-orders-list-card">
            <div class="nx-orders-card-head nx-orders-card-head--title-only justify-content-between align-items-center flex-wrap gap-2">
                <div class="nx-orders-card-head-main flex-grow-1">
                    <div class="nx-orders-icon-chip"><i data-feather="list"></i></div>
                    <div class="min-w-0">
                        <h4 class="nx-orders-card-title mb-0">Mail kara liste</h4>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button type="button" class="btn btn-sm btn-outline-danger d-none" onclick="deleteSelected()" id="bulkDeleteBtn">
                        <i data-feather="trash-2" class="align-self-center icon-xs me-1"></i>
                        Seçilenleri sil
                    </button>
                    {% if total > 0 %}
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAllConfirm()">
                        <i data-feather="trash" class="align-self-center icon-xs me-1"></i>
                        Tümünü temizle
                    </button>
                    {% endif %}
                </div>
            </div>
            {% if total > 0 or q or selected_reason_type or selected_date_range %}
            <div class="nx-orders-toolbar-strip">
                <form method="GET" action="/email-blacklist" class="nx-orders-list-toolbar orders-toolbar nx-bl-toolbar" id="nxBlacklistFilterForm">
                    <input type="hidden" name="page" value="1">
                    <input type="search" class="form-control form-control-sm nx-orders-search-input" id="nxBlSearch" name="q" value="{{ q|default('') }}" placeholder="Mail adresi veya sebep ara..." autocomplete="off" aria-label="Mail veya sebep ara">
                    <select class="form-select form-select-sm nx-orders-filter-select" id="nxBlReasonType" name="reason_type" aria-label="Sebep tipi">
                        <option value="">Tüm sebepler</option>
                        <option value="bounce" {{ selected_reason_type == 'bounce' ? 'selected' : '' }}>Bounce</option>
                        <option value="invalid_recipient" {{ selected_reason_type == 'invalid_recipient' ? 'selected' : '' }}>Invalid recipient</option>
                        <option value="spam" {{ selected_reason_type == 'spam' ? 'selected' : '' }}>Spam</option>
                        <option value="complaint" {{ selected_reason_type == 'complaint' ? 'selected' : '' }}>Complaint</option>
                        <option value="manual" {{ selected_reason_type == 'manual' ? 'selected' : '' }}>Manual</option>
                        <option value="smtp_error" {{ selected_reason_type == 'smtp_error' ? 'selected' : '' }}>SMTP error</option>
                        <option value="other" {{ selected_reason_type == 'other' ? 'selected' : '' }}>Other</option>
                    </select>
                    <select class="form-select form-select-sm nx-orders-filter-select" id="nxBlDateRange" name="date_range" aria-label="Tarih filtresi">
                        <option value="">Tüm tarihler</option>
                        <option value="today" {{ selected_date_range == 'today' ? 'selected' : '' }}>Bugün</option>
                        <option value="last_7_days" {{ selected_date_range == 'last_7_days' ? 'selected' : '' }}>Son 7 gün</option>
                        <option value="last_30_days" {{ selected_date_range == 'last_30_days' ? 'selected' : '' }}>Son 30 gün</option>
                        <option value="this_month" {{ selected_date_range == 'this_month' ? 'selected' : '' }}>Bu ay</option>
                    </select>
                    <select class="form-select form-select-sm nx-orders-filter-select" id="nxBlSort" name="sort" aria-label="Sıralama">
                        <option value="newest" {{ selected_sort == 'newest' ? 'selected' : '' }}>En yeni</option>
                        <option value="oldest" {{ selected_sort == 'oldest' ? 'selected' : '' }}>En eski</option>
                        <option value="email_az" {{ selected_sort == 'email_az' ? 'selected' : '' }}>Mail A-Z</option>
                        <option value="email_za" {{ selected_sort == 'email_za' ? 'selected' : '' }}>Mail Z-A</option>
                    </select>
                    <select class="form-select form-select-sm nx-orders-filter-select" id="nxBlPerPage" name="per_page" aria-label="Sayfa başı kayıt">
                        <option value="20" {{ perPage == 20 ? 'selected' : '' }}>20 / sayfa</option>
                        <option value="50" {{ perPage == 50 ? 'selected' : '' }}>50 / sayfa</option>
                        <option value="100" {{ perPage == 100 ? 'selected' : '' }}>100 / sayfa</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Filtrele</button>
                    <a href="/email-blacklist" class="btn btn-sm nx-bl-soft-danger">Temizle</a>
                    <button type="button" class="btn nx-orders-icon-refresh" id="nxBlToolbarRefresh" title="Yenile" aria-label="Yenile"><i data-feather="refresh-cw"></i></button>
                </form>
            </div>
            {% endif %}
            <div class="card-body nx-orders-list-body">
                    {% if total == 0 %}
                    <div class="nx-orders-empty text-center py-5 px-3">
                        <div class="nx-orders-empty-icon mb-3"><i data-feather="shield"></i></div>
                        <h5 class="fw-semibold mb-2">Kara liste boş</h5>
                        <p class="text-muted small mb-0">Engellemek istediğiniz adresleri sağdaki formdan ekleyebilirsiniz.</p>
                    </div>
                    {% else %}
                    <form method="POST" action="/email-blacklist/bulk-delete" id="bulkDeleteForm" onsubmit="return handleBulkDelete(event)">
                    <div class="table-responsive nx-orders-table-wrap">
                        <table class="table table-hover mb-0 nx-orders-table" id="nxBlTable">
                            <thead>
                                <tr>
                                    <th width="36">
                                        <input type="checkbox" class="form-check-input" id="selectAll" title="Tümünü seç">
                                    </th>
                                    <th>Mail adresi</th>
                                    <th>Sebep</th>
                                    <th>Eklenme</th>
                                    <th class="text-end nx-orders-col-action">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in blacklistItems %}
                                <tr class="nx-bl-row">
                                    <td>
                                        <input type="checkbox" class="form-check-input row-checkbox" name="ids[]" value="{{ item.id }}">
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="nx-bl-email">{{ item.email }}</span>
                                            <button type="button" class="btn nx-orders-icon-btn" title="Maili kopyala" onclick="copyText('{{ item.email|e('js') }}', 'Mail adresi kopyalandı')">
                                                <i data-feather="copy" class="icon-xs"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="nx-bl-reason-wrap">
                                            <span class="nx-bl-reason-badge is-{{ item.reason_type }}">{{ item.reason_type_label }}</span>
                                            <span class="nx-bl-reason-summary">{{ item.reason_summary }}</span>
                                            <span class="nx-bl-reason-hint">{{ item.reason_hint }}</span>
                                            <button type="button"
                                                class="nx-bl-reason-detail-btn"
                                                onclick="openReasonDetailModal('{{ item.email|e('js') }}', '{{ item.reason_type_label|e('js') }}', '{{ item.created_at|date('d.m.Y H:i')|e('js') }}', '{{ (item.reason ?? 'Sebep belirtilmedi')|e('js') }}')">
                                                Detay
                                            </button>
                                        </div>
                                    </td>
                                    <td><span class="text-muted small">{{ item.created_at|date('d.m.Y H:i') }}</span></td>
                                    <td class="text-end">
                                        <button type="button" class="btn nx-orders-icon-btn" onclick="deleteSingleMail({{ item.id }}, '{{ item.email|e('js') }}')" title="Sil">
                                            <i data-feather="trash-2" class="align-self-center icon-xs"></i>
                                        </button>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    </form>

                    {% if totalPages > 1 %}
                    {% set baseQuery = 'q=' ~ (q|default('')|url_encode) ~ '&reason_type=' ~ (selected_reason_type|default('')|url_encode) ~ '&date_range=' ~ (selected_date_range|default('')|url_encode) ~ '&sort=' ~ (selected_sort|default('newest')|url_encode) ~ '&per_page=' ~ perPage %}
                    <nav class="mt-3 nx-orders-pagination">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ currentPage > 1 ? '/email-blacklist?page=' ~ (currentPage - 1) ~ '&' ~ baseQuery : '#' }}">Önceki</a>
                            </li>
                            {% for page in 1..totalPages %}
                                {% if page == currentPage %}
                                    <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                                {% elseif page == 1 or page == totalPages or (page >= currentPage - 2 and page <= currentPage + 2) %}
                                    <li class="page-item"><a class="page-link" href="/email-blacklist?page={{ page }}&{{ baseQuery }}">{{ page }}</a></li>
                                {% elseif page == currentPage - 3 or page == currentPage + 3 %}
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                {% endif %}
                            {% endfor %}
                            <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ currentPage < totalPages ? '/email-blacklist?page=' ~ (currentPage + 1) ~ '&' ~ baseQuery : '#' }}">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                    {% endif %}
                    {% endif %}
                </div>
            </div>
        </main>

        <aside class="nx-orders-side" id="nx-bl-form">
            <div class="card nx-card nx-orders-form-card">
                <div class="nx-orders-card-head nx-orders-card-head--form nx-orders-card-head--compact">
                    <div class="nx-orders-card-head-main">
                        <div class="nx-orders-icon-chip nx-orders-icon-chip--accent"><i data-feather="shield-off"></i></div>
                        <div>
                            <h4 class="nx-orders-card-title mb-0">Kara liste işlemleri</h4>
                        </div>
                    </div>
                </div>
                <div class="card-body nx-orders-form-body">
                    <!-- Mail Ekleme Formu -->
                    <form action="/email-blacklist" method="POST" onsubmit="return handleBulkSubmit(event)">
                        <div class="mb-3">
                            <label for="emails" class="form-label">Mail Listesi <span class="text-danger">*</span></label>
                            <textarea class="form-control font-monospace" id="emails" name="emails" rows="7" placeholder="Her satıra bir mail adresi:

spam@example.com
abuse@example.com
user@test.com" required></textarea>
                            <small class="text-muted">Her satıra bir mail adresi yazın</small>
                        </div>

                        <div class="mb-3">
                            <label for="file_input" class="form-label">Dosyadan İçe Aktar (Opsiyonel)</label>
                            <input type="file" class="form-control" id="file_input" accept=".txt,.csv,.xlsx,.xls" onchange="handleFileSelect(event)">
                            <small class="text-muted">TXT, CSV, Excel (Max 500 MB)</small>
                            
                            <!-- File Upload Progress -->
                            <div id="fileUploadProgress" style="display: none; margin-top: 10px;">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-primary fw-semibold">
                                        <i data-feather="loader" class="icon-xs spinning me-1"></i>
                                        <span id="fileProgressText">Dosya okunuyor...</span>
                                    </small>
                                    <small class="text-primary fw-semibold" id="fileProgressPercent">0%</small>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%" id="fileProgressBar"></div>
                                </div>
                                <div class="d-flex justify-content-between mt-1">
                                    <small class="text-muted" id="fileProgressCount">0 mail bulundu</small>
                                    <small class="text-muted" id="fileProgressSpeed">0 KB/s</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="reason_type" class="form-label">Sebep tipi</label>
                            <select class="form-select" id="reason_type" name="reason_type">
                                <option value="manual" selected>Manual</option>
                                <option value="bounce">Bounce</option>
                                <option value="spam">Spam</option>
                                <option value="complaint">Complaint</option>
                                <option value="invalid_recipient">Invalid recipient</option>
                                <option value="smtp_error">SMTP error</option>
                                <option value="other">Other</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="reason_custom" class="form-label">Özel sebep (Opsiyonel)</label>
                            <textarea class="form-control" id="reason_custom" name="reason_custom" rows="3" placeholder="İsterseniz özel sebep yazın (örn: 559 Invalid rcptto)"></textarea>
                            <small class="text-muted">Boş bırakırsanız seçilen sebep tipi kaydedilir.</small>
                        </div>

                        <button type="submit" class="btn nx-orders-primary-btn nx-orders-primary-btn--compact w-100">
                            <i data-feather="shield-off" class="align-self-center icon-xs me-1"></i>
                            Kara listeye ekle
                        </button>
                    </form>
                </div>
            </div>
        </aside>
    </div>
    </div>

<!-- Seçilenleri Sil Modal -->
<div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-labelledby="bulkDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="bulkDeleteModalLabel">
                    <i data-feather="alert-triangle" class="align-self-center icon-sm me-2"></i>
                    Seçili Mailler Silinecek
                </h5>
