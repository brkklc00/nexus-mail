<style>
.spinning {
    animation: spin 1s linear infinite;
}
@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.btn-pulse {
    animation: pulse 1s ease-in-out 3;
    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
}
@keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        transform: scale(1);
    }
    50% {
        box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        transform: scale(1.05);
    }
    100% {
        box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        transform: scale(1);
    }
}
</style>

<script>
// Toplu ekleme form
function handleBulkSubmit(event) {
    const emails = document.getElementById('emails').value.trim();
    
    if (!emails) {
        iziToast.warning({
            title: 'Uyarı',
            message: 'Lütfen en az bir mail adresi girin!',
            position: 'topRight'
        });
        event.preventDefault();
        return false;
    }
    
    showLoading('Mail Adresleri Ekleniyor...', 'Lütfen bekleyin...');
    return true;
}

// Toplu silme butonunu göster/gizle
function updateBulkDeleteBtn() {
    const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
    const btn = document.getElementById('bulkDeleteBtn');
    if (checkedCount > 0) {
        btn.style.display = 'inline-block';
        btn.innerHTML = '<i data-feather="trash-2" class="align-self-center icon-xs me-1"></i> Seçilenleri Sil (' + checkedCount + ')';
        feather.replace();
    } else {
        btn.style.display = 'none';
    }
}

// Tekli mail sil (basit confirm ile)
function deleteSingleMail(id, email) {
    if (confirm(email + ' mail adresini kara listeden çıkarmak istediğinize emin misiniz?')) {
        showLoading('Siliniyor...', 'Mail adresi kaldırılıyor...');
        
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/email-blacklist/' + id + '/delete';
        document.body.appendChild(form);
        form.submit();
    }
}

// Seçilenleri sil - Modal ile
function deleteSelected() {
    const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
    if (checkedCount === 0) {
        iziToast.warning({
            title: 'Uyarı',
            message: 'Lütfen silinecek mail adreslerini seçin!',
            position: 'topRight'
        });
        return;
    }
    
    document.getElementById('bulkDeleteCount').textContent = checkedCount;
    document.getElementById('confirmBulkDelete').checked = false;
    document.getElementById('confirmBulkDeleteBtn').disabled = true;
    
    const modal = new bootstrap.Modal(document.getElementById('bulkDeleteModal'));
    modal.show();
    
    setTimeout(() => feather.replace(), 100);
}

function confirmBulkDelete() {
    const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
    showLoading('Siliniyor...', checkedCount + ' mail adresi kaldırılıyor...');
    document.getElementById('bulkDeleteForm').submit();
}

// Bulk delete form handler
function handleBulkDelete(event) {
    return true;
}

// Tümünü temizle - Modal aç
function clearAllConfirm() {
    const modal = new bootstrap.Modal(document.getElementById('clearAllModal'));
    modal.show();
    setTimeout(() => feather.replace(), 100);
}

// Clear all form handler
function handleClearAll(event) {
    showLoading('Tüm Liste Temizleniyor...', 'Tüm kara liste mail adresleri siliniyor...');
    return true;
}

// Loading overlay göster
function showLoading(title, subtitle) {
    document.getElementById('loadingText').textContent = title;
    document.getElementById('loadingSubtext').textContent = subtitle;
    document.getElementById('loadingOverlay').style.display = 'block';
}

// Loading overlay gizle
function hideLoading() {
    document.getElementById('loadingOverlay').style.display = 'none';
}

function showFileProgress(percent, text, count, speed) {
    const progressDiv = document.getElementById('fileUploadProgress');
    const progressBar = document.getElementById('fileProgressBar');
    const progressText = document.getElementById('fileProgressText');
    const progressPercent = document.getElementById('fileProgressPercent');
    const progressCount = document.getElementById('fileProgressCount');
    const progressSpeed = document.getElementById('fileProgressSpeed');
    
    progressDiv.style.display = 'block';
    progressBar.style.width = percent + '%';
    progressText.textContent = text;
    progressPercent.textContent = Math.round(percent) + '%';
    progressCount.textContent = count.toLocaleString('tr-TR') + ' mail bulundu';
    if (speed > 0) {
        progressSpeed.textContent = speed + ' KB/s';
    }
    
    feather.replace();
}

function hideFileProgress() {
    document.getElementById('fileUploadProgress').style.display = 'none';
}


// Optimize edilmiş dosya yükleme (Milyonlarca kayıt için)
async function handleFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;
    
    const maxSize = 500 * 1024 * 1024; // 500 MB
    if (file.size > maxSize) {
        iziToast.error({
            title: 'Hata',
            message: 'Dosya boyutu 500 MB\'dan küçük olmalıdır!',
            position: 'topRight'
        });
        event.target.value = '';
        return;
    }
    
    const startTime = Date.now();
    showFileProgress(0, 'Dosya okunuyor...', 0, 0);
    
    try {
        let emails = [];
        const fileName = file.name.toLowerCase();
        
        if (fileName.endsWith('.txt') || fileName.endsWith('.csv')) {
            emails = await readTextFileOptimized(file, (progress, count) => {
                const elapsed = (Date.now() - startTime) / 1000;
                const speed = elapsed > 0 ? (file.size * progress / 100 / 1024 / elapsed).toFixed(0) : 0;
                showFileProgress(progress, 'Metin dosyası işleniyor...', count, speed);
            });
        } else if (fileName.endsWith('.xlsx') || fileName.endsWith('.xls')) {
            showFileProgress(10, 'Excel dosyası okunuyor...', 0, 0);
            emails = await readExcelFileOptimized(file);
        } else {
            hideFileProgress();
            iziToast.error({
                title: 'Hata',
                message: 'Desteklenmeyen dosya formatı! TXT, CSV veya Excel kullanın.',
                position: 'topRight'
            });
            event.target.value = '';
            return;
        }
        
        // HYPER FAST duplicate removal
        showFileProgress(90, 'Duplicate\'lar temizleniyor...', emails.length, 0);
        const uniqueEmails = [...new Set(emails)];
        
        showFileProgress(95, 'Tamamlanıyor...', uniqueEmails.length, 0);
        
        if (uniqueEmails.length === 0) {
            hideFileProgress();
            iziToast.warning({
                title: 'Uyarı',
                message: 'Dosyada geçerli mail adresi bulunamadı!',
                position: 'topRight'
            });
        } else {
            // Textarea'ya yaz
            const textarea = document.getElementById('emails');
            const existingEmails = textarea.value.trim();
            const combined = existingEmails ? existingEmails + '\n' + uniqueEmails.join('\n') : uniqueEmails.join('\n');
            textarea.value = combined;
            
            showFileProgress(100, 'Tamamlandı!', uniqueEmails.length, 0);
            
            setTimeout(() => {
                hideFileProgress();
                
                // Sayfa içi başarı mesajı
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show';
                alertDiv.innerHTML = `
                    <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>
                    <strong>${uniqueEmails.length.toLocaleString('tr-TR')}</strong> mail adresi yüklendi. "Kara listeye ekle" butonuna basın.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                
                const container = document.querySelector('.container-fluid');
                container.insertBefore(alertDiv, container.firstChild);
                feather.replace();
                
                // Textarea'yı vurgula
                textarea.focus();
                textarea.scrollTop = 0;
                
                // Scroll to top
                window.scrollTo({ top: 0, behavior: 'smooth' });
                
                // Submit butonu vurgula (pulse animasyonu)
                const submitBtn = document.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.classList.add('btn-pulse');
                    setTimeout(() => {
                        submitBtn.classList.remove('btn-pulse');
                    }, 3000);
                }
            }, 500);
        }
    } catch (error) {
        console.error('Dosya okuma hatası:', error);
        hideFileProgress();
        iziToast.error({
            title: 'Hata',
            message: 'Dosya okunamadı: ' + error.message,
            position: 'topRight'
        });
    } finally {
        event.target.value = '';
    }
}

// HYPER SPEED TXT/CSV okuma - Büyük chunk'lar
function readTextFileOptimized(file, progressCallback) {
    return new Promise((resolve, reject) => {
        const chunkSize = 10 * 1024 * 1024; // 10MB chunks (daha büyük = daha hızlı)
        let offset = 0;
        let emails = [];
        let buffer = '';
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        
        const readChunk = () => {
            const slice = file.slice(offset, offset + chunkSize);
            const reader = new FileReader();
            
            reader.onload = (e) => {
                const text = e.target.result;
                buffer += text;
                
                // Process complete lines
                const lines = buffer.split(/[\r\n]+/);
                buffer = lines.pop() || '';
                
                // Ultra fast email extraction
                for (let i = 0; i < lines.length; i++) {
                    const trimmed = lines[i].trim().toLowerCase();
                    if (trimmed.length > 5 && trimmed.indexOf('@') > 0 && emailRegex.test(trimmed)) {
                        emails.push(trimmed);
                    }
                }
                
                offset += chunkSize;
                const progress = Math.min((offset / file.size) * 100, 100);
                progressCallback(progress, emails.length);
                
                if (offset < file.size) {
                    setTimeout(readChunk, 0); // Next chunk immediately
                } else {
                    // Process last buffer
                    if (buffer.trim().length > 5) {
                        const trimmed = buffer.trim().toLowerCase();
                        if (trimmed.indexOf('@') > 0 && emailRegex.test(trimmed)) {
                            emails.push(trimmed);
                        }
                    }
                    resolve(emails);
                }
            };
            
            reader.onerror = reject;
            reader.readAsText(slice);
        };
        
        readChunk();
    });
}

// HYPER SPEED Excel okuma - Optimize edilmiş
function readExcelFileOptimized(file) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
            try {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { 
                    type: 'array',
                    cellText: false,
                    cellDates: false,
                    sheetRows: 0 // Tüm satırları oku
                });
                
                const emails = [];
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                
                // Sadece ilk sheet'i oku (çoğu durumda yeterli)
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                const jsonData = XLSX.utils.sheet_to_json(firstSheet, { 
                    header: 1,
                    defval: '',
                    blankrows: false,
                    raw: true
                });
                
                // Ultra fast processing
                for (let r = 0; r < jsonData.length; r++) {
                    const row = jsonData[r];
                    for (let c = 0; c < row.length; c++) {
                        const cell = row[c];
                        if (cell && typeof cell === 'string') {
                            const trimmed = cell.trim().toLowerCase();
                            if (trimmed.length > 5 && trimmed.indexOf('@') > 0 && emailRegex.test(trimmed)) {
                                emails.push(trimmed);
                            }
                        }
                    }
                }
                
                resolve(emails);
            } catch (error) {
                reject(error);
            }
        };
        reader.onerror = reject;
        reader.readAsArrayBuffer(file);
    });
}

function copyText(value, successMessage) {
    const text = String(value || '').trim();
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
        if (window.NexusToast && typeof window.NexusToast.success === 'function') {
            window.NexusToast.success(successMessage || 'Kopyalandı');
        }
    }).catch(() => {
        if (window.NexusToast && typeof window.NexusToast.warning === 'function') {
            window.NexusToast.warning('Kopyalama başarısız, tekrar deneyin.');
        }
    });
}

function openReasonDetailModal(email, reasonType, createdAt, fullReason) {
    document.getElementById('reasonDetailEmail').textContent = email || '-';
    document.getElementById('reasonDetailType').textContent = reasonType || 'Other';
    document.getElementById('reasonDetailDate').textContent = createdAt || '-';
    document.getElementById('reasonDetailText').textContent = fullReason || 'Sebep belirtilmedi';
    const modal = new bootstrap.Modal(document.getElementById('reasonDetailModal'));
    modal.show();
}

// DOM yüklendikten sonra
document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
    document.getElementById('nxBlToolbarRefresh')?.addEventListener('click', function () { location.reload(); });
    document.getElementById('nxBlHeadRefresh')?.addEventListener('click', function () { location.reload(); });
    document.getElementById('copyReasonBtn')?.addEventListener('click', function () {
        const reason = document.getElementById('reasonDetailText')?.textContent || '';
        copyText(reason, 'Sebep metni kopyalandı');
    });
    document.getElementById('copyReasonEmailBtn')?.addEventListener('click', function () {
        const email = document.getElementById('reasonDetailEmail')?.textContent || '';
        copyText(email, 'Mail adresi kopyalandı');
    });
    
    // Tümünü seç/kaldır
    document.getElementById('selectAll')?.addEventListener('change', function() {
        const checkboxes = document.querySelectorAll('.row-checkbox');
        checkboxes.forEach(cb => cb.checked = this.checked);
        updateBulkDeleteBtn();
    });
    
    // Checkbox değişikliklerini dinle
    document.querySelectorAll('.row-checkbox').forEach(cb => {
        cb.addEventListener('change', updateBulkDeleteBtn);
    });
    
    // Bulk Delete Modal - Checkbox kontrolü
    document.getElementById('confirmBulkDelete')?.addEventListener('change', function() {
        document.getElementById('confirmBulkDeleteBtn').disabled = !this.checked;
    });
    
    // Clear All Modal - Checkbox kontrolü
    document.getElementById('confirmClearAll')?.addEventListener('change', function() {
        document.getElementById('confirmClearAllBtn').disabled = !this.checked;
    });
    
    // Modal kapandığında checkbox'ı sıfırla
    document.getElementById('bulkDeleteModal')?.addEventListener('hidden.bs.modal', function () {
        document.getElementById('confirmBulkDelete').checked = false;
        document.getElementById('confirmBulkDeleteBtn').disabled = true;
    });
    
    document.getElementById('clearAllModal')?.addEventListener('hidden.bs.modal', function () {
        document.getElementById('confirmClearAll').checked = false;
        document.getElementById('confirmClearAllBtn').disabled = true;
    });
    
    // Modal açıldığında feather iconları yenile
    const modals = document.querySelectorAll('.modal');
    modals.forEach(modal => {
        modal.addEventListener('shown.bs.modal', function() {
            feather.replace();
        });
    });
    
    // Alert dismiss için Bootstrap'ı aktif et
    var alertList = document.querySelectorAll('.alert');
    alertList.forEach(function (alertEl) {
        var bsAlert = new bootstrap.Alert(alertEl);
    });
});
</script>
