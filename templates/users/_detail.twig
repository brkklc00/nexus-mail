{# User Detay İçeriği - Modal için #}
<div class="row">
    <div class="col-md-4 text-center border-end">
        <div class="avatar-lg mx-auto mb-3">
            <span class="avatar-title rounded-circle bg-primary-subtle text-primary fs-1">
                {{ user.name|slice(0, 1)|upper }}
            </span>
        </div>
        <h5 class="mb-1">{{ user.name }}</h5>
        <p class="text-muted mb-2">@{{ user.username }}</p>
        
        <span class="badge {{ user.isActive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }} mb-3">
            {{ user.isActive ? 'Aktif' : 'Pasif' }}
        </span>
        
        <div class="mt-3">
            <button type="button" class="btn btn-primary btn-sm w-100 mb-2" 
                    onclick="bootstrap.Modal.getInstance(document.getElementById('userDetailModal')).hide(); setTimeout(function(){ showEditModal({{ user.id }}); }, 300);">
                <i data-feather="edit" class="icon-xs me-1"></i>
                Düzenle
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm w-100" 
                    onclick="bootstrap.Modal.getInstance(document.getElementById('userDetailModal')).hide(); setTimeout(function(){ showDeleteModal({{ user.id }}, '{{ user.name|e('js') }}'); }, 300);">
                <i data-feather="trash-2" class="icon-xs me-1"></i>
                Sil
            </button>
        </div>
    </div>
    
    <div class="col-md-8">
        <h6 class="mb-3">Hesap Bilgileri</h6>
        
        <div class="row mb-3">
            <div class="col-6">
                <small class="text-muted d-block">E-posta</small>
                <strong>{{ user.email }}</strong>
            </div>
            <div class="col-6">
                <small class="text-muted d-block">Kredi Bakiyesi</small>
                <strong class="text-primary fs-5">{{ user.credit.balance|number_format(0, ',', '.') }}</strong>
            </div>
        </div>
        
        <div class="row mb-3">
            <div class="col-6">
                <small class="text-muted d-block">Roller</small>
                {% for role in user.roles %}
                    <span class="badge bg-info-subtle text-info">{{ role.name }}</span>
                {% endfor %}
            </div>
            <div class="col-6">
                <small class="text-muted d-block">2FA Durumu</small>
                {% if user.twoFactorEnabled %}
                    <span class="badge bg-success-subtle text-success">
                        <i data-feather="shield" class="icon-xs"></i> Aktif
                    </span>
                {% else %}
                    <span class="badge bg-secondary-subtle text-secondary">
                        <i data-feather="shield-off" class="icon-xs"></i> Pasif
                    </span>
                {% endif %}
            </div>
        </div>
        
        <div class="row mb-3">
            <div class="col-6">
                <small class="text-muted d-block">Kayıt Tarihi</small>
                <strong>{{ user.createdAt|date('d.m.Y H:i') }}</strong>
            </div>
            <div class="col-6">
                <small class="text-muted d-block">Son Giriş</small>
                <strong>{{ user.lastLoginAt ? user.lastLoginAt|date('d.m.Y H:i') : 'Henüz giriş yapmadı' }}</strong>
            </div>
        </div>

    </div>
</div>

<script>
feather.replace();
</script>
