{% extends '_layouts/main.twig' %}

{% block title %}Yeni Kullanıcı Ekle - {{ site_title|default('Nexus Panel') }}{% endblock %}
{% block title_text %}Yeni Kullanıcı Ekle{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h4 class="card-title">
                            <i data-feather="user-plus" class="align-self-center icon-xs me-2"></i>
                            Yeni Kullanıcı Oluştur
                        </h4>
                    </div>
                    <div class="col-auto">
                        <a href="/users" class="btn btn-sm btn-secondary">
                            <i data-feather="arrow-left" class="align-self-center icon-xs me-1"></i>
                            Geri Dön
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                
                {% if error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i data-feather="alert-triangle" class="align-self-center icon-xs me-2"></i>
                    {{ error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                {% endif %}
                
                <form method="POST" action="/users/create">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="username" class="form-label">Kullanıcı Adı <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="username" name="username" required>
                                <small class="text-muted">Benzersiz kullanıcı adı</small>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="email" class="form-label">E-posta <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="full_name" class="form-label">Ad Soyad <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="full_name" name="full_name" required>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="role_id" class="form-label">Rol <span class="text-danger">*</span></label>
                                <select class="form-select" id="role_id" name="role_id" required>
                                    <option value="">Rol Seçin</option>
                                    {% for role in roles %}
                                    <option value="{{ role.id }}">{{ role.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="password" class="form-label">Şifre <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="password" name="password" required>
                                <small class="text-muted">En az 8 karakter, 1 büyük harf, 1 küçük harf, 1 rakam</small>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="password_confirm" class="form-label">Şifre (Tekrar) <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="password_confirm" name="password_confirm" required>
                            </div>
                        </div>
                    </div>
                    
                    <hr class="my-4">
                    <h5 class="mb-3"><i data-feather="mail" class="align-self-center icon-xs me-2"></i>Email Ayarları</h5>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="email_delivery_percentage" class="form-label">Email Gönderim Yüzdesi</label>
                                <input type="number" class="form-control" id="email_delivery_percentage" name="email_delivery_percentage" 
                                       value="100" min="0" max="100" required>
                                <small class="text-muted">%0-100 arası bir değer girin. Gerçek Email gönderim oranı.</small>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-3 mt-4">
                                <input class="form-check-input" type="checkbox" id="refund_enabled" name="refund_enabled" checked>
                                <label class="form-check-label" for="refund_enabled">
                                    Email İade Sistemi Aktif
                                </label>
                                <small class="d-block text-muted">Başarısız Email'ler iade edilsin mi?</small>
                            </div>
                        </div>
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="is_active" name="is_active" checked>
                                <label class="form-check-label" for="is_active">
                                    Aktif Kullanıcı
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i data-feather="save" class="align-self-center icon-xs me-2"></i>
                                Kullanıcı Oluştur
                            </button>
                            <a href="/users" class="btn btn-secondary ms-2">
                                <i data-feather="x" class="align-self-center icon-xs me-2"></i>
                                İptal
                            </a>
                        </div>
                    </div>
                    
                </form>
                
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
// Feather icons
feather.replace();

// Şifre eşleşme kontrolü
document.querySelector('form').addEventListener('submit', function(e) {
    const password = document.getElementById('password').value;
    const confirm = document.getElementById('password_confirm').value;
    
    if (password !== confirm) {
        e.preventDefault();
        alert('Şifreler eşleşmiyor!');
        return false;
    }
});
</script>
{% endblock %}
