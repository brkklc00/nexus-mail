{% block scripts %}
<script>
feather.replace();

let currentUserId = null;
let searchTimeout = null;
let confirmCallback = null;

/** Tek Modal örneği: ardışık new bootstrap.Modal backdrop/odak hatasına yol açmasın */
function nxUsersGetModal(elementOrId) {
    const el = typeof elementOrId === 'string' ? document.getElementById(elementOrId) : elementOrId;
    if (!el || typeof bootstrap === 'undefined') return null;
    return bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
}

document.addEventListener('DOMContentLoaded', function () {
    var tbl = document.getElementById('nxUsersListTable');
    if (!tbl) return;
    tbl.addEventListener('click', function (ev) {
        var btn = ev.target.closest('.nx-open-balance-modal');
        if (!btn) return;
        var raw = btn.getAttribute('data-nx-bal');
        if (!raw) return;
        var d;
        try {
            d = JSON.parse(raw);
        } catch (e) {
            return;
        }
        showBalanceModal(
            d.id,
            d.name,
            Number(d.mailCredit) || 0
        );
    });
});

// Modal ile onay göster
function showConfirmModal(message, callback) {
    confirmCallback = callback;
    document.getElementById('confirmModalMessage').textContent = message;
    const modal = nxUsersGetModal('confirmModal');
    if (!modal) return;
    modal.show();
    
    // Onay butonuna event listener ekle
    const confirmBtn = document.getElementById('confirmModalBtn');
    const newConfirmBtn = confirmBtn.cloneNode(true);
    confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
    
    newConfirmBtn.addEventListener('click', function() {
        if (confirmCallback) {
            confirmCallback();
        }
        bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide();
    });
    
    setTimeout(() => feather.replace(), 100);
}

// Modal ile alert göster
function showAlertModal(message, type = 'info') {
    const modal = nxUsersGetModal('alertModal');
    if (!modal) return;
    const header = document.getElementById('alertModalHeader');
    const title = document.getElementById('alertModalTitle');
    const messageEl = document.getElementById('alertModalMessage');
    
    messageEl.textContent = message;
    
    // Tip'e göre stil ayarla
    header.className = 'modal-header';
    title.innerHTML = '<i data-feather="info" class="icon-xs me-2"></i> Bilgi';
    
    if (type === 'error' || type === 'danger') {
        header.className = 'modal-header bg-danger text-white';
        title.innerHTML = '<i data-feather="alert-circle" class="icon-xs me-2"></i> Hata';
    } else if (type === 'success') {
        header.className = 'modal-header bg-success text-white';
        title.innerHTML = '<i data-feather="check-circle" class="icon-xs me-2"></i> Başarılı';
    } else if (type === 'warning') {
        header.className = 'modal-header bg-warning text-dark';
        title.innerHTML = '<i data-feather="alert-triangle" class="icon-xs me-2"></i> Uyarı';
    }
    
    modal.show();
    setTimeout(() => feather.replace(), 100);
}

// Arama fonksiyonu (debounced)
function handleSearch(event) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        applyFilters();
    }, 500);
}

// Filtre uygula
function applyFilters() {
    const search = document.getElementById('searchInput').value;
    const status = document.getElementById('statusFilter').value;
    const role = document.getElementById('roleFilter').value;
    const perPage = document.getElementById('perPageSelect').value;
    
    const url = new URL(window.location.href);
    url.searchParams.set('search', search);
    url.searchParams.set('status', status);
    url.searchParams.set('role', role);
    url.searchParams.set('per_page', perPage);
    url.searchParams.set('page', '1'); // Reset to page 1
    
    window.location.href = url.toString();
}

// Sayfa başına kayıt değiştir
function changePerPage() {
    applyFilters();
}

// Sıralama
function sortBy(column) {
    const url = new URL(window.location.href);
    const currentSort = url.searchParams.get('sort');
    const currentDir = url.searchParams.get('dir');
    
    // Aynı kolona tıklandıysa direction'ı değiştir
    if (currentSort === column) {
        url.searchParams.set('dir', currentDir === 'ASC' ? 'DESC' : 'ASC');
    } else {
        url.searchParams.set('sort', column);
        url.searchParams.set('dir', 'DESC');
    }
    
    window.location.href = url.toString();
}

// Tümünü seç/kaldır
function toggleSelectAll(checkbox) {
    const checkboxes = document.querySelectorAll('.user-checkbox');
    checkboxes.forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateBulkActionBar();
}

// Toplu işlem bar'ını güncelle
function updateBulkActionBar() {
    const checkboxes = document.querySelectorAll('.user-checkbox:checked');
    const count = checkboxes.length;
    const bar = document.getElementById('bulkActionBar');
    const countSpan = document.getElementById('selectedCount');
    
    if (count > 0) {
        bar.style.display = 'block';
        countSpan.textContent = count;
    } else {
        bar.style.display = 'none';
        document.getElementById('selectAll').checked = false;
    }
    
    feather.replace();
}

// Toplu işlem
async function bulkAction(action) {
    const checkboxes = document.querySelectorAll('.user-checkbox:checked');
    const userIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
    
    if (userIds.length === 0) {
        showAlertModal('Lütfen en az bir kullanıcı seçin', 'warning');
        return;
    }
    
    const actionNames = {
        'activate': 'aktif etmek',
        'deactivate': 'pasif yapmak',
        'enable_refund': 'iade sistemini aktif etmek',
        'disable_refund': 'iade sistemini devre dışı bırakmak',
        'delete': 'silmek'
    };
    
    const confirmMessage = `${userIds.length} kullanıcıyı ${actionNames[action]} istediğinize emin misiniz?`;
    
    showConfirmModal(confirmMessage, async function() {
        document.getElementById('loadingOverlay').style.display = 'block';
        
        try {
            const response = await fetch('/users/bulk-action', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    action: action,
                    user_ids: userIds
                })
            });
            
            const data = await response.json();
            
            if (data.success) {
                showAlertModal(data.message, 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showAlertModal('Hata: ' + (data.error || 'İşlem başarısız'), 'error');
                document.getElementById('loadingOverlay').style.display = 'none';
            }
        } catch (error) {
            showAlertModal('Bir hata oluştu: ' + error.message, 'error');
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    });
}

// Export to Excel
function exportToExcel() {
    const url = new URL(window.location.href);
    url.pathname = '/users/export';
    // Filtreleri koru
    window.open(url.toString(), '_blank');
}

// User detayını göster
function viewUser(userId) {
    const modal = nxUsersGetModal('userDetailModal');
    if (!modal) return;
    const content = document.getElementById('userDetailContent');
    
    content.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
    modal.show();
    
    fetch('/users/' + userId)
        .then(response => response.text())
        .then(html => {
            content.innerHTML = html;
            feather.replace();
        })
        .catch(error => {
            content.innerHTML = '<div class="alert alert-danger">Hata oluştu</div>';
        });
}

// Bakiye modal göster
function showBalanceModal(userId, userName, mailCredit) {
    mailCredit = Number(mailCredit) || 0;

    currentUserId = userId;
    document.getElementById('balanceModalUserName').textContent = userName;
    
    document.getElementById('currentMailCredit').textContent = mailCredit.toLocaleString('tr-TR');
    
    // Formu resetle
    document.getElementById('balanceForm').reset();
    
    // İlk seçenekleri aktif yap
    document.getElementById('mailCredit').checked = true;
    document.getElementById('add').checked = true;
    
    // Form action'ını güncelle
    updateFormAction();
    
    const modal = nxUsersGetModal('balanceModal');
    if (!modal) return;
    modal.show();
    
    setTimeout(() => feather.replace(), 100);
}

// Form action'ını güncelle
function updateFormAction() {
    let balanceType = document.getElementById('mailCredit')?.value || 'mail_credit';
    const operationType = document.querySelector('input[name="operationType"]:checked')?.value;
    
    if (!balanceType || !operationType) return;
    balanceType = 'mail_credit';
    
    let actionUrl = '';
    let fieldName = '';
    
    if (balanceType === 'mail_credit') {
        fieldName = 'credits';
        actionUrl = operationType === 'add' ? 
            `/users/${currentUserId}/mail-credit/add` : 
            `/users/${currentUserId}/mail-credit/deduct`;
    }
    
    document.getElementById('balanceForm').action = actionUrl;
    
    // Input field name'ini güncelle
    document.getElementById('balanceAmount').setAttribute('name', fieldName);
    
    // Submit butonunu güncelle
    const submitBtn = document.getElementById('submitBtn');
    const operationText = operationType === 'add' ? 'Ekle' : 'Çıkar';
    
    // Bakiye türü metinleri
    const balanceLabels = {
        'mail_credit': 'Mail Kredi'
    };
    
    const balanceText = balanceLabels[balanceType] || balanceType.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase());
    submitBtn.innerHTML = `<i data-feather="check" class="icon-xs me-1"></i> ${balanceText} ${operationText}`;
    
    // Buton rengini güncelle
    submitBtn.className = operationType === 'add' ? 'btn btn-success' : 'btn btn-danger';
    
    feather.replace();
}

// Form submit - loading göster
document.getElementById('createUserForm').addEventListener('submit', function() {
    document.getElementById('loadingOverlay').style.display = 'block';
});

document.getElementById('editUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    document.getElementById('loadingOverlay').style.display = 'block';
    
    const formData = new FormData(this);
    const action = this.action;
    
    try {
        const response = await fetch(action, {
            method: 'POST',
            body: formData
        });
        
        if (response.ok) {
            // Başarılı - sayfayı yenile
            location.reload();
        } else {
            showAlertModal('Bir hata oluştu', 'error');
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    } catch (error) {
        showAlertModal('Bir hata oluştu: ' + error.message, 'error');
        document.getElementById('loadingOverlay').style.display = 'none';
    }
});

document.getElementById('balanceForm').addEventListener('submit', async function(e) {
    document.getElementById('loadingOverlay').style.display = 'block';
});

// Create modal göster
function showCreateModal() {
    document.getElementById('createUserForm').reset();
    const modal = nxUsersGetModal('createUserModal');
    if (!modal) return;
    modal.show();
    
    // Modal açıldıktan sonra feather iconları render et
    setTimeout(() => feather.replace(), 100);
}

// Edit modal göster
function showEditModal(userId) {
    const modal = nxUsersGetModal('editUserModal');
    if (!modal) return;
    modal.show();
    
    // AJAX ile kullanıcı bilgilerini yükle
    fetch('/users/' + userId + '/edit-data')
        .then(response => response.json())
        .then(data => {
            document.getElementById('edit_name').value = data.name;
            document.getElementById('edit_username').value = data.username;
            document.getElementById('edit_email').value = data.email;
            document.getElementById('edit_phone').value = data.phone || '';
            document.getElementById('edit_is_active').checked = data.isActive;
            document.getElementById('edit_refund_enabled').checked = data.refundEnabled;
            document.getElementById('edit_email_delivery_percentage').value = data.emailDeliveryPercentage || 100;
            
            // Rolleri seç
            const rolesSelect = document.getElementById('edit_roles');
            Array.from(rolesSelect.options).forEach(option => {
                option.selected = data.roles.includes(parseInt(option.value));
            });
            
            // Form action'ı ayarla
            document.getElementById('editUserForm').action = '/users/' + userId + '/edit';
            
            feather.replace();
        })
        .catch(error => {
            showAlertModal('Kullanıcı bilgileri yüklenemedi', 'error');
            modal.hide();
        });
}

// Personel Yönetimi Modal Göster
function showManageAccountsModal(userId, userName, isNewAccountManager = false) {
    document.getElementById('accountManagerId').value = userId;
    document.getElementById('accountManagerName').textContent = userName;
    
    // Modal'ı aç
    const modal = nxUsersGetModal('manageAccountsModal');
    if (!modal) return;
    modal.show();
    
    // Yeni hesap yöneticisi ise önce hesap yöneticisi yap
    if (isNewAccountManager) {
        fetch(`/users/${userId}/make-account-manager`, {
            method: 'POST'
        })
        .then(response => {
            if (response.ok) {
                // Başarılı - personel listesini yükle
                loadChildUsers(userId);
                loadAvailableUsers(userId);
            } else {
                showAlertModal('Hesap yöneticisi yapılırken bir hata oluştu', 'error');
                modal.hide();
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlertModal('Bir hata oluştu', 'error');
            modal.hide();
        });
    } else {
        // Zaten hesap yöneticisi - direkt yükle
        loadChildUsers(userId);
        loadAvailableUsers(userId);
    }
    
    setTimeout(() => feather.replace(), 100);
}

// Personel listesini yükle
function loadChildUsers(accountManagerId) {
    const container = document.getElementById('childUsersList');
    const countSpan = document.getElementById('childUsersCount');
    
    container.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Yükleniyor...</span></div></div>';
    
    fetch(`/users/${accountManagerId}/manage-accounts-data`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.childUsers) {
                countSpan.textContent = data.childUsers.length;
                
                if (data.childUsers.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-4">
                            <i data-feather="users" class="icon-lg text-muted mb-2"></i>
                            <p class="text-muted mb-0">Henüz personel hesabı bulunmamaktadır.</p>
                        </div>
                    `;
                } else {
                    let html = '<div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light"><tr><th>Personel</th><th>E-posta</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead><tbody>';
                    
                    data.childUsers.forEach(childUser => {
                        html += `
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-xs me-2">
                                            <span class="avatar-title rounded-circle bg-primary-subtle text-primary">
                                                ${childUser.name.charAt(0).toUpperCase()}
                                            </span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold small">${childUser.name}</div>
                                            <small class="text-muted">@${childUser.username}</small>
                                        </div>
                                    </div>
                                </td>
                                <td><small>${childUser.email}</small></td>
                                <td>
                                    <span class="badge ${childUser.isActive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'}">
                                        ${childUser.isActive ? 'Aktif' : 'Pasif'}
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-soft-danger" 
                                            onclick="removeChildUser(${accountManagerId}, ${childUser.id}, '${childUser.name.replace(/'/g, "\\'")}')"
                                            title="Kaldır">
                                        <i data-feather="user-minus" class="icon-xs"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                    
                    html += '</tbody></table></div>';
                    container.innerHTML = html;
                }
                
                feather.replace();
            } else {
                container.innerHTML = '<div class="alert alert-danger">Personel listesi yüklenemedi.</div>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            container.innerHTML = '<div class="alert alert-danger">Bir hata oluştu.</div>';
        });
}

// Mevcut olmayan personelleri yükle (ekleme için)
function loadAvailableUsers(accountManagerId) {
    const select = document.getElementById('child_user_id');
    select.innerHTML = '<option value="">-- Personel Seçin --</option>';
    
    fetch(`/users/${accountManagerId}/manage-accounts-data`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.availableUsers) {
                data.availableUsers.forEach(user => {
                    const option = document.createElement('option');
                    option.value = user.id;
                    option.textContent = `${user.name} (@${user.username})`;
                    select.appendChild(option);
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
}

// Personel Ekle
document.getElementById('addChildUserForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const accountManagerId = document.getElementById('accountManagerId').value;
    const childUserId = document.getElementById('child_user_id').value;
    
    if (!childUserId) {
        showAlertModal('Lütfen bir personel seçin', 'warning');
        return;
    }
    
    const formData = new FormData();
    formData.append('child_user_id', childUserId);
    
    fetch(`/users/${accountManagerId}/add-child-user`, {
        method: 'POST',
        body: formData
    })
    .then(response => {
        if (response.ok) {
            // Başarılı - listeyi yenile
            loadChildUsers(accountManagerId);
            loadAvailableUsers(accountManagerId);
            
            // Form'u temizle
            document.getElementById('addChildUserForm').reset();
            document.getElementById('accountManagerId').value = accountManagerId;
            
            // Sayfayı yenile (badge'leri güncellemek için)
            setTimeout(() => location.reload(), 500);
        } else {
            showAlertModal('Personel eklenirken bir hata oluştu', 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showAlertModal('Bir hata oluştu', 'error');
    });
});

// Personel Kaldır
function removeChildUser(accountManagerId, childUserId, childUserName) {
    showConfirmModal(`${childUserName} adlı personeli hesap yöneticisinden kaldırmak istediğinize emin misiniz?`, function() {
        fetch(`/users/${accountManagerId}/remove-child-user/${childUserId}`, {
            method: 'POST'
        })
        .then(response => {
            if (response.ok) {
                // Başarılı - listeyi yenile
                loadChildUsers(accountManagerId);
                loadAvailableUsers(accountManagerId);
                
                // Sayfayı yenile (badge'leri güncellemek için)
                setTimeout(() => location.reload(), 500);
            } else {
                showAlertModal('Personel kaldırılırken bir hata oluştu', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showAlertModal('Bir hata oluştu', 'error');
        });
    });
}

// Impersonate onay modal
function showImpersonateConfirm(userId, userName) {
    showConfirmModal(`${userName} adlı kullanıcı adına giriş yapmak istediğinize emin misiniz?`, function() {
        // Form oluştur ve submit et
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/users/${userId}/impersonate`;
        document.body.appendChild(form);
        form.submit();
    });
}

// Radio button değişikliklerini dinle
document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
    
    // Bakiye türü değiştiğinde
    document.querySelectorAll('input[name="balanceType"]').forEach(radio => {
        radio.addEventListener('change', updateFormAction);
    });
    
    // İşlem türü değiştiğinde
    document.querySelectorAll('input[name="operationType"]').forEach(radio => {
        radio.addEventListener('change', updateFormAction);
    });
});

// Kullanıcı silme modal
let deleteUserId = null;
let deleteUserName = null;

function showDeleteModal(userId, userName) {
    deleteUserId = userId;
    deleteUserName = userName;
    
    document.getElementById('delete_user_name').textContent = userName;
    
    // Checkbox'ı sıfırla
    const checkbox = document.getElementById('confirmDeleteUser');
    const btn = document.getElementById('confirmDeleteUserBtn');
    checkbox.checked = false;
    btn.disabled = true;
    
    const modal = nxUsersGetModal('deleteUserModal');
    if (!modal) return;
    modal.show();
    
    setTimeout(() => feather.replace(), 100);
}

// Checkbox değiştiğinde buton aktif et
document.addEventListener('DOMContentLoaded', function() {
    const checkbox = document.getElementById('confirmDeleteUser');
    const btn = document.getElementById('confirmDeleteUserBtn');
    
    if (checkbox && btn) {
        checkbox.addEventListener('change', function() {
            btn.disabled = !this.checked;
        });
        
        btn.addEventListener('click', function() {
            if (deleteUserId) {
                // Form submit
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/users/${deleteUserId}/delete`;
                document.body.appendChild(form);
                form.submit();
            }
        });
    }
});
</script>
{% endblock %}

