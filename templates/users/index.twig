{% extends '_layouts/main.twig' %}

{% block title %}Kullanıcılar - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
<li class="breadcrumb-item active">Kullanıcılar</li>
{% endblock %}

{% block page_icon %}<i data-feather="users" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Kullanıcı Yönetimi{% endblock %}

{% block styles %}
<style>
</style>
{% endblock %}

{% block content %}

{% if _session.flash_success %}
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>
    {{ _session.flash_success }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{% endif %}

<!-- İstatistik Kartları -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Toplam Kullanıcı</p>
                        <h4 class="mb-0">{{ stats.total_users|number_format(0, ',', '.') }}</h4>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="users" class="text-primary" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Aktif Kullanıcı</p>
                        <h4 class="mb-0">{{ stats.active_users|number_format(0, ',', '.') }}</h4>
                        <p class="text-muted mb-0 fs-12">
                            <span class="text-danger">{{ stats.inactive_users }}</span> pasif
                        </p>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="user-check" class="text-success" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Toplam Bakiye</p>
                        <h4 class="mb-0">{{ stats.total_balance|number_format(0, ',', '.') }}</h4>
                        <p class="text-muted mb-0 fs-12">kredi</p>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="dollar-sign" class="text-warning" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Son 30 Gün Mail</p>
                        <h4 class="mb-0">{{ stats.total_email_30d|number_format(0, ',', '.') }}</h4>
                        <p class="text-muted mb-0 fs-12">toplam mail</p>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="message-square" class="text-info" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h4 class="card-title mb-0">
                            <i data-feather="users" class="align-self-center icon-xs me-2"></i>
                            Kullanıcı Listesi
                        </h4>
                        <small class="text-muted">{{ total }} kullanıcı bulundu</small>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-primary" onclick="showCreateModal()">
                            <i data-feather="user-plus" class="icon-xs me-1"></i>
                            Yeni Kullanıcı
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <!-- Arama ve Filtreler -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="position-relative">
                            <input type="text" 
                                   class="form-control" 
                                   id="searchInput" 
                                   placeholder="Ad, kullanıcı adı veya e-posta ile ara..."
                                   value="{{ search }}"
                                   onkeyup="handleSearch(event)">
                            <i data-feather="search" class="position-absolute top-50 end-0 translate-middle-y me-2" style="width: 16px; height: 16px;"></i>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" id="statusFilter" onchange="applyFilters()">
                            <option value="all" {{ statusFilter == 'all' ? 'selected' : '' }}>Tüm Durumlar</option>
                            <option value="active" {{ statusFilter == 'active' ? 'selected' : '' }}>Aktif</option>
                            <option value="inactive" {{ statusFilter == 'inactive' ? 'selected' : '' }}>Pasif</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" id="roleFilter" onchange="applyFilters()">
                            <option value="all" {{ roleFilter == 'all' ? 'selected' : '' }}>Tüm Roller</option>
                            {% for role in roles %}
                            <option value="{{ role.id }}" {{ roleFilter == role.id ? 'selected' : '' }}>{{ role.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" id="perPageSelect" onchange="changePerPage()">
                            <option value="10" {{ perPage == 10 ? 'selected' : '' }}>10 / sayfa</option>
                            <option value="25" {{ perPage == 25 ? 'selected' : '' }}>25 / sayfa</option>
                            <option value="50" {{ perPage == 50 ? 'selected' : '' }}>50 / sayfa</option>
                            <option value="100" {{ perPage == 100 ? 'selected' : '' }}>100 / sayfa</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-success w-100" onclick="exportToExcel()">
                            <i data-feather="download" class="icon-xs me-1"></i>
                            Excel
                        </button>
                    </div>
                </div>

                <!-- Toplu İşlem Bar (gizli olarak başlar) -->
                <div id="bulkActionBar" class="alert alert-info mb-3" style="display: none;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <strong><span id="selectedCount">0</span> kullanıcı seçildi</strong>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-success" onclick="bulkAction('activate')">
                                <i data-feather="check-circle" class="icon-xs me-1"></i> Aktif Et
                            </button>
                            <button type="button" class="btn btn-sm btn-warning" onclick="bulkAction('deactivate')">
                                <i data-feather="x-circle" class="icon-xs me-1"></i> Pasif Et
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="bulkAction('delete')">
                                <i data-feather="trash-2" class="icon-xs me-1"></i> Sil
                            </button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table id="nxUsersListTable" class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">
                                    <input type="checkbox" class="form-check-input" id="selectAll" onchange="toggleSelectAll(this)">
                                </th>
                                <th style="cursor: pointer;" onclick="sortBy('id')">
                                    # 
                                    {% if sortBy == 'id' %}
                                        <i data-feather="{{ sortDir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="icon-xs"></i>
                                    {% endif %}
                                </th>
                                <th style="cursor: pointer;" onclick="sortBy('name')">
                                    Kullanıcı 
                                    {% if sortBy == 'name' %}
                                        <i data-feather="{{ sortDir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="icon-xs"></i>
                                    {% endif %}
                                </th>
                                <th style="cursor: pointer;" onclick="sortBy('email')">
                                    E-posta 
                                    {% if sortBy == 'email' %}
                                        <i data-feather="{{ sortDir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="icon-xs"></i>
                                    {% endif %}
                                </th>
                                <th>Roller</th>
                                <th style="cursor: pointer;" onclick="sortBy('lastLoginAt')">
                                    Son Giriş 
                                    {% if sortBy == 'lastLoginAt' %}
                                        <i data-feather="{{ sortDir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="icon-xs"></i>
                                    {% endif %}
                                </th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                            <tr>
                                <td>
                                    <input type="checkbox" 
                                           class="form-check-input user-checkbox" 
                                           value="{{ user.id }}"
                                           onchange="updateBulkActionBar()">
                                </td>
                                <td><strong>#{{ user.id }}</strong></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-xs me-2">
                                            <span class="avatar-title rounded-circle bg-primary-subtle text-primary">
                                                {{ user.name|slice(0, 1)|upper }}
                                            </span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">{{ user.name }}</div>
                                            <small class="text-muted">@{{ user.username }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                    <span class="badge bg-info-subtle text-info">{{ role.name }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                    {% if user.lastLoginAt %}
                                        <small class="text-muted" title="{{ user.lastLoginAt|date('d.m.Y H:i') }}">
                                            {{ user.lastLoginAt|date('d.m.Y') }}
                                        </small>
                                    {% else %}
                                        <small class="text-muted fst-italic">Hiç giriş yapmadı</small>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge {{ user.isActive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">
                                        {{ user.isActive ? 'Aktif' : 'Pasif' }}
                                    </span>
                                    {% if user.isAccountManager %}
                                    <br><span class="badge bg-primary-subtle text-primary mt-1">
                                        <i data-feather="users" class="icon-xs me-1"></i>
                                        Hesap Yöneticisi
                                    </span>
                                    {% endif %}
                                    {% if user.isChildAccount %}
                                    <br><span class="badge bg-info-subtle text-info mt-1">
                                        <i data-feather="user" class="icon-xs me-1"></i>
                                        Personel
                                    </span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-soft-primary" onclick="viewUser({{ user.id }})" title="Detay">
                                            <i data-feather="eye" class="icon-xs"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-soft-success nx-open-balance-modal"
                                                title="Bakiye"
                                                data-nx-bal="{{ {
                                                    id: user.id,
                                                    name: user.name,
                                                    mailCredit: user.emailCredit|default(0)
                                                }|json_encode|e('html_attr') }}">
                                            <i data-feather="dollar-sign" class="icon-xs"></i>
                                        </button>
                                        {% if user.isActive %}
                                        <button type="button" 
                                                class="btn btn-sm btn-soft-warning" 
                                                title="Kullanıcı Adına Giriş Yap"
                                                onclick="showImpersonateConfirm({{ user.id }}, '{{ user.name|e('js') }}')">
                                            <i data-feather="user-check" class="icon-xs"></i>
                                        </button>
                                        {% endif %}
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-soft-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Diğer İşlemler">
                                                <i data-feather="more-vertical" class="icon-xs"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" href="javascript:void(0)" onclick="showEditModal({{ user.id }})">
                                                        <i data-feather="edit" class="icon-xs me-2"></i> Düzenle
                                                    </a>
                                                </li>
                                                <li>
                                                    <form method="POST" action="/users/{{ user.id }}/toggle" class="m-0">
                                                        <button type="submit" class="dropdown-item">
                                                            <i data-feather="{{ user.isActive ? 'eye-off' : 'eye' }}" class="icon-xs me-2"></i>
                                                            {{ user.isActive ? 'Pasif Yap' : 'Aktif Yap' }}
                                                        </button>
                                                    </form>
                                                </li>
                                                {% if not user.isAccountManager and not user.isChildAccount %}
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick='showManageAccountsModal({{ user.id }}, {{ user.name|json_encode|raw }}, true); return false;'>
                                                        <i data-feather="users" class="icon-xs me-2"></i> Hesap Yöneticisi Yap
                                                    </a>
                                                </li>
                                                {% endif %}
                                                {% if user.isAccountManager %}
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick='showManageAccountsModal({{ user.id }}, {{ user.name|json_encode|raw }}); return false;'>
                                                        <i data-feather="user-plus" class="icon-xs me-2"></i> Personel Yönet
                                                    </a>
                                                </li>
                                                {% endif %}
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="showDeleteModal({{ user.id }}, '{{ user.name|e('js') }}')">
                                                        <i data-feather="trash-2" class="icon-xs me-2"></i> Sil
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i data-feather="inbox" class="icon-lg mb-2"></i>
                                    <p class="mb-0">Henüz kullanıcı bulunmamaktadır.</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                {% if totalPages > 1 %}
                <nav class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" href="/users?page={{ currentPage - 1 }}">Önceki</a>
                        </li>
                        
                        {% for page in 1..totalPages %}
                            {% if page == currentPage %}
                                <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                            {% elseif page == 1 or page == totalPages or (page >= currentPage - 2 and page <= currentPage + 2) %}
                                <li class="page-item"><a class="page-link" href="/users?page={{ page }}">{{ page }}</a></li>
                            {% elseif page == currentPage - 3 or page == currentPage + 3 %}
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            {% endif %}
                        {% endfor %}
                        
                        <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                            <a class="page-link" href="/users?page={{ currentPage + 1 }}">Sonraki</a>
                        </li>
                    </ul>
                </nav>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- User Detay Modal -->
<div class="modal fade" id="userDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i data-feather="user" class="icon-xs me-2"></i>
                    Kullanıcı Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="userDetailContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Kullanıcı Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i data-feather="user-plus" class="icon-xs me-2"></i>
                    Yeni Kullanıcı Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="/users" id="createUserForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="create_name" class="form-label">Ad Soyad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="create_name" name="name" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="create_username" class="form-label">Kullanıcı Adı <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="create_username" name="username" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="create_email" class="form-label">E-posta <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="create_email" name="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="create_phone" class="form-label">Telefon</label>
                            <input type="tel" class="form-control" id="create_phone" name="phone">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="create_password" class="form-label">Şifre <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="create_password" name="password" required minlength="6">
                            <small class="text-muted">En az 6 karakter</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="create_roles" class="form-label">Roller <span class="text-danger">*</span></label>
                            <select class="form-select" id="create_roles" name="roles[]" multiple required>
                                {% for role in roles %}
                                <option value="{{ role.id }}">{{ role.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="create_email_delivery_percentage" class="form-label">Mail Gönderim Yüzdesi (%)</label>
                            <input type="number" class="form-control" id="create_email_delivery_percentage" name="email_delivery_percentage" value="100" min="0" max="100" required>
                            <small class="text-muted">0-100 arası bir değer girin (Default: 100)</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="create_is_active" name="is_active" checked>
                                <label class="form-check-label" for="create_is_active">
                                    Kullanıcı Aktif
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="create_refund_enabled" name="refund_enabled" checked>
                                <label class="form-check-label" for="create_refund_enabled">
                                    Email İade Sistemi Aktif
                                </label>
                                <small class="d-block text-muted">Başarısız email gönderimleri otomatik iade edilsin mi?</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">
                        <i data-feather="check" class="icon-xs me-1"></i>
                        Kullanıcı Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Kullanıcı Düzenle Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i data-feather="edit" class="icon-xs me-2"></i>
                    Kullanıcı Düzenle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" id="editUserForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="edit_name" class="form-label">Ad Soyad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="edit_name" name="name" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="edit_username" class="form-label">Kullanıcı Adı <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="edit_username" name="username" required>
                            <small class="text-muted">Benzersiz kullanıcı adı girin</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="edit_email" class="form-label">E-posta <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="edit_email" name="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="edit_phone" class="form-label">Telefon</label>
                            <input type="tel" class="form-control" id="edit_phone" name="phone">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="edit_password" class="form-label">Yeni Şifre</label>
                            <input type="password" class="form-control" id="edit_password" name="password" minlength="6">
                            <small class="text-muted">Boş bırakılırsa şifre değişmez</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="edit_roles" class="form-label">Roller <span class="text-danger">*</span></label>
                            <select class="form-select" id="edit_roles" name="roles[]" multiple required>
                                {% for role in roles %}
                                <option value="{{ role.id }}">{{ role.name }}</option>
