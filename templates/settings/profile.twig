{% extends '_layouts/main.twig' %}

{% block title %}Profil Ayarları - {{ site_title|default('Nexus Panel') }}{% endblock %}
{% block title_text %}Profil Ayarları{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Profil Bilgileri</h4>
            </div>
            <div class="card-body">
                {% if _session.flash_success %}
                <div class="alert alert-success alert-dismissible fade show">
                    <i data-feather="check-circle"></i> {{ _session.flash_success }}
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
                {% endif %}

                <form method="POST" action="/settings/profile">
                    <input type="hidden" name="_method" value="PUT">
                    
                    <div class="form-group">
                        <label for="name">Ad Soyad</label>
                        <input type="text" class="form-control" id="name" name="name" value="{{ user.name }}" required>
                    </div>

                    <div class="form-group">
                        <label for="email">E-posta</label>
                        <input type="email" class="form-control" id="email" name="email" value="{{ user.email }}" required>
                    </div>

                    <div class="form-group">
                        <label>Kullanıcı Adı</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i data-feather="user" class="icon-xs"></i>
                            </span>
                            <input type="text" class="form-control bg-light" value="{{ user.username }}" readonly>
                            <span class="input-group-text bg-light">
                                <i data-feather="lock" class="icon-xs text-muted"></i>
                            </span>
                        </div>
                        <small class="text-muted">
                            <i data-feather="info" class="icon-xs"></i>
                            Kullanıcı adı güvenlik nedeniyle değiştirilemez
                        </small>
                    </div>

                    <div class="form-group mb-0">
                        <button type="submit" class="btn btn-primary">
                            <i data-feather="save"></i> Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body text-center">
                <img src="/assets/images/users/user-4.jpg" alt="user" class="rounded-circle mb-3" width="100">
                <h5>{{ user.name }}</h5>
                <p class="text-muted">{{ user.username }}</p>
                <p class="mb-0">
                    {% for role in user.roles %}
                    <span class="badge badge-soft-primary">{{ role.name }}</span>
                    {% endfor %}
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

