{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
const creditBalance = {{ email_credit }};

function refreshIcons() {
    setTimeout(() => feather.replace(), 50);
}

// Pool form submit - body yok, sadece pool_count, subject, template_id
function showLoadingPool(event) {
    const form = event ? event.target : null;
    if (form) {
        const poolCount = parseInt(form.querySelector('[name="pool_count"]')?.value) || 0;
        const templateId = form.querySelector('[name="template_id"]')?.value;
        
        if (poolCount <= 0) {
            alert('Lütfen gönderilecek mail sayısını girin!');
            return false;
        }
        if (!templateId) {
            alert('Lütfen bir mail şablonu seçin!');
            return false;
        }
    }
    document.getElementById('loadingOverlay').style.display = 'block';
    return true;
}

function calculateCredits() {
    const select = document.getElementById('phonebook_ids');
    const selectedOptions = Array.from(select.selectedOptions);
    let totalCount = 0;
    
    selectedOptions.forEach(option => {
        totalCount += parseInt(option.dataset.count);
    });
    
    const calcDiv = document.getElementById('credit_calc');
    const badge = document.getElementById('status_badge');
    
    if (totalCount > 0) {
        document.getElementById('selected_count').textContent = totalCount.toLocaleString('tr-TR');
        document.getElementById('required_credit').textContent = totalCount.toLocaleString('tr-TR');
        
        if (totalCount > creditBalance) {
            badge.className = 'badge bg-danger';
            badge.textContent = 'Yetersiz';
        } else {
            badge.className = 'badge bg-success';
            badge.textContent = 'Yeterli';
        }
        
        calcDiv.style.display = 'block';
    } else {
        calcDiv.style.display = 'none';
    }
}

function calculateManualCredits() {
    const textarea = document.getElementById('manual_emails');
    const lines = textarea.value.split('\n').filter(line => line.trim() && line.includes('@'));
    const count = lines.length;
    
    document.getElementById('email_count_display').textContent = count.toLocaleString('tr-TR');
    
    const warningDiv = document.getElementById('credit_warning_manual');
    
    if (count > 0 && count > creditBalance) {
        const shortage = count - creditBalance;
        document.getElementById('required_credit_manual').textContent = count.toLocaleString('tr-TR');
        document.getElementById('shortage_amount').textContent = shortage.toLocaleString('tr-TR');
        warningDiv.style.display = 'block';
    } else {
        warningDiv.style.display = 'none';
    }
}

function calculatePoolCredits() {
    const input = document.getElementById('pool_count');
    const count = parseInt(input.value) || 0;
    
    const calcDiv = document.getElementById('pool_credit_calc');
    const badge = document.getElementById('pool_status_badge');
    
    if (count > 0) {
        document.getElementById('pool_count_display').textContent = count.toLocaleString('tr-TR');
        document.getElementById('pool_required_credit').textContent = count.toLocaleString('tr-TR');
        
        if (count > creditBalance) {
            badge.className = 'badge bg-danger';
            badge.textContent = 'Yetersiz';
            calcDiv.className = 'alert alert-danger mt-2 py-2 px-3';
        } else {
            badge.className = 'badge bg-success';
            badge.textContent = 'Yeterli';
            calcDiv.className = 'alert alert-warning mt-2 py-2 px-3';
        }
        
        calcDiv.style.display = 'block';
    } else {
        calcDiv.style.display = 'none';
    }
}

function showImportModal() {
    new bootstrap.Modal(document.getElementById('importModal')).show();
    feather.replace();
}

function processImport() {
    const file = document.getElementById('importFile').files[0];
    if (!file) {
        alert('Lütfen bir dosya seçin');
        return;
    }

    const progressDiv = document.getElementById('importProgress');
    const progressBar = document.getElementById('importProgressBar');
    const statusText = document.getElementById('importStatus');
    
    progressDiv.style.display = 'block';
    progressBar.style.width = '50%';
    statusText.textContent = 'Dosya işleniyor...';

    const reader = new FileReader();
    
    reader.onload = function(e) {
        const content = e.target.result;
        let emails = [];

        if (file.name.endsWith('.txt') || file.name.endsWith('.csv')) {
            const lines = content.split('\n');
            emails = lines.filter(line => line.trim() && line.includes('@')).map(line => line.trim());
        } else if (file.name.endsWith('.xlsx') || file.name.endsWith('.xls')) {
            const workbook = XLSX.read(content, {type: 'binary'});
            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const data = XLSX.utils.sheet_to_json(firstSheet, {header: 1});
            emails = data.flat().filter(cell => cell && String(cell).includes('@'));
        }

        const textarea = document.getElementById('manual_emails');
        const currentValue = textarea.value.trim();
        const newValue = emails.join('\n');
        
        textarea.value = currentValue ? currentValue + '\n' + newValue : newValue;
        
        progressBar.style.width = '100%';
        progressBar.classList.add('bg-success');
        statusText.textContent = `✓ ${emails.length.toLocaleString('tr-TR')} mail adresi yüklendi`;
        
        calculateManualCredits();
        
        setTimeout(() => {
            bootstrap.Modal.getInstance(document.getElementById('importModal')).hide();
            progressDiv.style.display = 'none';
            progressBar.style.width = '0%';
            progressBar.classList.remove('bg-success');
        }, 1500);
    };

    if (file.name.endsWith('.xlsx') || file.name.endsWith('.xls')) {
        reader.readAsBinaryString(file);
    } else {
        reader.readAsText(file);
    }
}

// Sipariş detayı göster
function viewOrderDetails(orderId) {
    const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
    document.getElementById('modalOrderId').textContent = orderId;
    document.getElementById('orderDetailContent').innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
        </div>
    `;
    modal.show();
    
    fetch(`/email-send/${orderId}/details`)
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const contentType = response.headers.get('content-type');
            if (!contentType || !contentType.includes('application/json')) {
                throw new Error('Sunucu JSON yanıtı döndürmedi');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                renderOrderDetails(data.order, data.emails, data);
            } else {
                console.error('API Error:', data);
                document.getElementById('orderDetailContent').innerHTML = `
                    <div class="alert alert-danger">
                        <i data-feather="alert-circle" class="me-2"></i> 
                        <strong>${data.message || 'Bilinmeyen bir hata oluştu'}</strong>
                        ${data.error ? `<br><small class="text-muted mt-2">Hata detayı: ${data.error}</small>` : ''}
                    </div>
                `;
                feather.replace();
            }
        })
        .catch(error => {
            console.error('Fetch Error:', error);
            document.getElementById('orderDetailContent').innerHTML = `
                <div class="alert alert-danger">
                    <i data-feather="alert-circle" class="me-2"></i> 
                    <strong>Bir hata oluştu:</strong><br>
                    ${error.message}<br>
                    <small class="text-muted mt-2">Lütfen sayfayı yenileyin ve tekrar deneyin.</small>
                </div>
            `;
            feather.replace();
        });
}

// Global değişkenler
let currentOrderData = null;
let currentEmailPage = 1;
const emailsPerPage = 50;

function renderOrderDetails(order, emails, data = {}) {
    // Global'e kaydet (sadece ilk çağrıda currentEmailPage = 1 yap)
    if (!currentOrderData) {
        currentEmailPage = 1;
    }
    currentOrderData = { order, emails, data };
    
    console.log('Rendering page:', currentEmailPage, 'Total emails:', emails.length);
    
    const statusBadges = {
        'pending': '<span class="mail-status-badge is-pending">Bekliyor</span>',
        'pending_approval': '<span class="mail-status-badge is-pending">Bekliyor</span>',
        'processing': '<span class="mail-status-badge is-processing">İşleniyor</span>',
        'sent': '<span class="mail-status-badge is-completed">Tamamlandı</span>',
        'completed': '<span class="mail-status-badge is-completed">Tamamlandı</span>',
        'failed': '<span class="mail-status-badge is-failed">Başarısız</span>',
        'cancelled': '<span class="mail-status-badge is-cancelled">İptal</span>',
        'canceled': '<span class="mail-status-badge is-cancelled">İptal</span>'
    };
    
    const emailStatusBadges = {
        'pending': '<span class="mail-status-badge is-pending">Bekliyor</span>',
        'sent': '<span class="mail-status-badge is-completed">Başarılı</span>',
        'delivered': '<span class="mail-status-badge is-completed">Başarılı</span>',
        'bounced': '<span class="mail-status-badge is-cancelled">Geri Döndü</span>',
        'failed': '<span class="mail-status-badge is-failed">Başarısız</span>'
    };
    
    let html = `
        <div class="row">
            <div class="col-md-6">
                <div class="card border">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-3">
                            <i data-feather="user" class="icon-sm me-1"></i> Kullanıcı Bilgileri
                        </h6>
                        <p><strong>Ad:</strong> ${order.user.name}</p>
                        <p><strong>Email:</strong> ${order.user.email}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-3">
                            <i data-feather="info" class="icon-sm me-1"></i> Sipariş Bilgileri
                        </h6>
                        <p><strong>Durum:</strong> ${statusBadges[order.status]}</p>
                        <p><strong>Oluşturma:</strong> ${order.createdAt}</p>
                        ${order.completedAt ? `<p><strong>Tamamlanma:</strong> ${order.completedAt}</p>` : ''}
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row mt-3">
            <div class="col-md-3">
                <div class="card border">
                    <div class="card-body text-center">
                        <i data-feather="mail" class="icon-md text-muted mb-2"></i>
                        <h3 class="mb-0">${order.total.toLocaleString()}</h3>
                        <p class="text-muted mb-0">Toplam Email</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border">
                    <div class="card-body text-center">
                        <i data-feather="check-circle" class="icon-md text-success mb-2"></i>
                        <h3 class="mb-0 text-success">${order.delivered.toLocaleString()}</h3>
                        <p class="text-muted mb-0">Başarılı</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border">
                    <div class="card-body text-center">
                        <i data-feather="x-circle" class="icon-md text-danger mb-2"></i>
                        <h3 class="mb-0 text-danger">${order.failed.toLocaleString()}</h3>
                        <p class="text-muted mb-0">Başarısız</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border">
                    <div class="card-body text-center">
                        <i data-feather="percent" class="icon-md text-primary mb-2"></i>
                        <h3 class="mb-0 text-primary">${order.total > 0 ? ((order.delivered / order.total) * 100).toFixed(1) : 0}%</h3>
                        <p class="text-muted mb-0">Başarı Oranı</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card border mt-3">
            <div class="card-body">
                <h6 class="card-title text-muted mb-3">
                    <i data-feather="mail" class="icon-sm me-1"></i> Mail İçeriği
                </h6>
                <p><strong>Konu:</strong> ${order.subject}</p>
                <div class="border rounded p-3 mt-2 mail-content-display" style="max-height: 300px;">
                    ${order.body}
                </div>
            </div>
        </div>
    `;
    
    // Email listesi - sadece sistem havuzu değilse göster
    if (!data.isPoolOrder) {
        const totalEmails = emails.length;
        const totalPages = Math.ceil(totalEmails / emailsPerPage);
        const startIdx = (currentEmailPage - 1) * emailsPerPage;
        const endIdx = startIdx + emailsPerPage;
        const paginatedEmails = emails.slice(startIdx, endIdx);
        
        html += `
        <div class="card border mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="card-title text-muted mb-0">
                        <i data-feather="list" class="icon-sm me-1"></i> Email Listesi
                    </h6>
                    <small class="text-muted">
                        ${startIdx + 1}-${Math.min(endIdx, totalEmails)} / ${totalEmails}
                    </small>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Email</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                            </tr>
                        </thead>
                        <tbody>
        `;
        
        if (paginatedEmails.length === 0) {
            html += `
                <tr>
                    <td colspan="3" class="text-center text-muted py-3">Henüz email gönderilmemiş</td>
                </tr>
            `;
        } else {
            paginatedEmails.forEach(email => {
                const statusDisplay = emailStatusBadges[email.status] || `<span class="mail-status-badge is-processing">${email.status}</span>`;
                const dateDisplay = email.deliveredAt || email.sentAt || '-';
                html += `
                    <tr>
                        <td><small>${email.email}</small></td>
                        <td>${statusDisplay}</td>
                        <td><small>${dateDisplay}</small></td>
                    </tr>
                `;
            });
        }
        
        html += `
                        </tbody>
                    </table>
                </div>
        `;
        
        // Sayfalandırma
        if (totalPages > 1) {
            html += `
                <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                    <div>
                        ${currentEmailPage > 1 ? 
                            `<button class="btn btn-sm btn-outline-primary" onclick="changeEmailPage(${currentEmailPage - 1})">
                                « Önceki
                            </button>` : 
                            '<button class="btn btn-sm btn-outline-secondary" disabled>« Önceki</button>'}
                    </div>
                    
                    <span class="text-muted small">Sayfa <strong>${currentEmailPage}</strong> / ${totalPages}</span>
                    
                    <div>
                        ${currentEmailPage < totalPages ? 
                            `<button class="btn btn-sm btn-outline-primary" onclick="changeEmailPage(${currentEmailPage + 1})">
                                Sonraki »
                            </button>` : 
                            '<button class="btn btn-sm btn-outline-secondary" disabled>Sonraki »</button>'}
                    </div>
                </div>
            `;
        }
        
        html += `
            </div>
        </div>
        `;
    } else {
        // Sistem havuzu siparişi için bilgi mesajı
        html += `
        <div class="card border mt-3 bg-light">
            <div class="card-body text-center py-4">
                <i data-feather="lock" class="icon-lg text-muted mb-3"></i>
                <h6 class="text-muted mb-2">Email Listesi Gizli</h6>
                <p class="text-muted small mb-0">
                    Sistem havuzundan gönderilen siparişlerde güvenlik nedeniyle mail listesi görüntülenemez.
                </p>
            </div>
        </div>
        `;
    }
    
    html += `
    `;
    
    document.getElementById('orderDetailContent').innerHTML = html;
    feather.replace();
}

function changeEmailPage(page) {
    if (!currentOrderData) {
        console.error('currentOrderData is null');
        return;
    }
    
    console.log('Changing to page:', page);
    currentEmailPage = page;
    
    renderOrderDetails(
        currentOrderData.order,
        currentOrderData.emails,
        currentOrderData.data
    );
    
    // Scroll to top of modal
    const modalBody = document.querySelector('#orderDetailModal .modal-body');
    if (modalBody) {
        modalBody.scrollTop = 0;
    }
}

function showLoading(event) {
    const form = event ? event.target : null;
    
    if (form) {
        const sendType = form.querySelector('[name="send_type"]')?.value;
        const templateId = form.querySelector('[name="template_id"]')?.value;
        
        if (!templateId) {
            alert('Lütfen bir mail şablonu seçin!');
            return false;
        }
        
        // Rehberden: en az bir rehber seçilmeli
        if (sendType === 'phonebook') {
            const select = form.querySelector('[name="phonebook_ids[]"]');
            const selected = select ? Array.from(select.selectedOptions) : [];
            if (!selected.length) {
                alert('Lütfen en az bir rehber seçin!');
                return false;
            }
        }
        
        // Manuel: en az bir geçerli mail adresi
        if (sendType === 'manual') {
            const textarea = form.querySelector('[name="manual_emails"]');
            const text = textarea ? textarea.value : '';
            const lines = text.split('\n').filter(l => l.trim() && l.includes('@'));
            if (lines.length === 0) {
                alert('Lütfen en az bir geçerli mail adresi girin (her satıra bir mail)!');
                return false;
            }
        }
        
        // Sistem havuzu: pool formu showLoadingPool kullanır, buraya düşmez
    }
    
    document.getElementById('loadingOverlay').style.display = 'block';
    return true;
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();

    const filterForm = document.getElementById('nxEmailOrdersFilterForm');
    const statusFilter = document.getElementById('nxEmailOrderStatusFilter');
    const perPageFilter = document.getElementById('nxEmailOrderPerPage');
    const searchInput = document.getElementById('nxEmailOrderSearch');

    statusFilter?.addEventListener('change', function() {
        filterForm?.requestSubmit();
    });
    perPageFilter?.addEventListener('change', function() {
        filterForm?.requestSubmit();
    });
    searchInput?.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
            filterForm?.requestSubmit();
        }
    });

    document.getElementById('nxEmailOrdersToolbarRefresh')?.addEventListener('click', function() { location.reload(); });
    document.getElementById('nxEmailOrdersHeadRefresh')?.addEventListener('click', function() { location.reload(); });
    
    // URL parametresi ile modal açma (email-transactions'dan gelince)
    const urlParams = new URLSearchParams(window.location.search);
    const modalOrderId = urlParams.get('modal');
    
    if (modalOrderId) {
        // URL'den modal parametresini temizle
        const newUrl = window.location.pathname;
        window.history.replaceState({}, document.title, newUrl);
        
        // Modal aç
        setTimeout(function() {
            viewOrderDetails(parseInt(modalOrderId));
        }, 500);
    }
});
</script>
{% endblock %}
