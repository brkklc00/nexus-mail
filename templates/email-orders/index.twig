{% extends "_layouts/main.twig" %}

{% block title %}Yeni Gönderim - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/email-dashboard">Mail Yönetimi</a></li>
<li class="breadcrumb-item active" aria-current="page">Yeni Gönderim</li>
{% endblock %}

{% block page_title %}
<div class="row nx-orders-page-head">
    <div class="col-12">
        <div class="page-title-box nx-page-head pb-0">
            <div class="d-flex flex-column flex-lg-row align-items-start justify-content-lg-between gap-3">
                <div class="min-w-0">
                    <div class="page-title-right mb-2">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/dashboard">Panel</a></li>
                            <li class="breadcrumb-item"><a href="/email-dashboard">Mail Yönetimi</a></li>
                            <li class="breadcrumb-item active">Yeni Gönderim</li>
                        </ol>
                    </div>
                    <h4 class="page-title nx-page-title mb-1">Yeni Gönderim</h4>
                    <p class="nx-page-lead text-muted mb-0">Mail siparişlerinizi oluşturun, durumlarını takip edin ve gönderim performansını görüntüleyin.</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 nx-orders-toolbar">
                    <button type="button" class="btn btn-sm nx-orders-tool-btn nx-orders-tool-btn--page" id="nxEmailOrdersHeadRefresh" title="Yenile">
                        <i data-feather="refresh-cw" class="nx-orders-tool-ic"></i>
                        <span class="d-none d-sm-inline">Yenile</span>
                    </button>
                    <a href="/email-templates" class="btn btn-sm nx-orders-tool-btn nx-orders-tool-btn--page">
                        <i data-feather="file-text" class="nx-orders-tool-ic"></i>
                        <span class="d-none d-sm-inline">Şablonlar</span>
                    </a>
                    <a href="/email-phonebooks" class="btn btn-sm nx-orders-tool-btn nx-orders-tool-btn--page">
                        <i data-feather="book" class="nx-orders-tool-ic"></i>
                        <span class="d-none d-sm-inline">Rehber</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block page_icon %}{% endblock %}
{% block title_text %}{% endblock %}

{% block styles %}
<style>
    /* Mail içeriği gösterimi için CSS koruması */
    .mail-content-display {
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
        word-break: break-word;
        overflow-x: auto;
        overflow-y: auto;
    }
    
    .mail-content-display img {
        max-width: 100%;
        height: auto;
    }
    
    .mail-content-display table {
        max-width: 100%;
        overflow-x: auto;
        display: block;
    }
    
    /* Modal içeriklerinin taşmasını önle */
    .modal-body {
        overflow-x: hidden;
        word-wrap: break-word;
    }

    .nx-email-col-id {
        width: 72px;
        max-width: 72px;
    }

    .nx-email-col-subject {
        width: 34%;
        min-width: 280px;
    }

    .nx-email-col-num {
        width: 88px;
    }

    .nx-email-order-subject-title {
        font-weight: 600;
        color: #0f172a;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
    }

    .nx-email-order-template-meta {
        display: block;
        margin-top: 0.2rem;
        font-size: 0.75rem;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .nx-orders-pagination {
        border-top: 1px solid #e2e8f0;
        padding-top: 0.85rem;
        margin-top: 0.85rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        justify-content: space-between;
    }

    .nx-orders-pagination-meta {
        font-size: 0.82rem;
        color: #64748b;
    }

    .nx-orders-pagination-nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .nx-orders-pagination-nav .page-link {
        min-width: 2.1rem;
        text-align: center;
    }
    
</style>
{% endblock %}

{% block content %}

    {% if success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-feather="{{ flash_icon|default('check-circle') }}" class="align-self-center icon-xs me-2"></i>
        {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
    {% endif %}

    {% if error %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i data-feather="{{ flash_icon|default('alert-circle') }}" class="align-self-center icon-xs me-2"></i>
        {{ error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
    {% endif %}

    <!-- Loading Overlay -->
    <div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 9999; backdrop-filter: blur(5px);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
            <div class="spinner-border text-light mb-3" role="status" style="width: 4rem; height: 4rem; border-width: 0.3rem;">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <h4 class="text-white mb-2" id="loadingText">Mail Siparişi Oluşturuluyor...</h4>
            <p class="text-white-50 mb-3" id="loadingSubtext">Lütfen bekleyin...</p>
            <div class="progress mx-auto" style="width: 300px; height: 8px; background: rgba(255,255,255,0.2);">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 100%"></div>
            </div>
        </div>
    </div>

    {% set em_delivered = 0 %}
    {% set em_pending = 0 %}
    {% set em_failed = 0 %}
    {% for order in orders %}
        {% set em_delivered = em_delivered + order.delivered %}
        {% if order.status.value in ['pending_approval', 'pending'] %}
            {% set em_pending = em_pending + 1 %}
        {% elseif order.status.value == 'failed' %}
            {% set em_failed = em_failed + 1 %}
        {% endif %}
    {% endfor %}

    <div class="nx-orders-page nx-email-page nx-orders-shell">
    <div class="nx-email-kpis nx-orders-kpis mb-3">
        <div class="nx-orders-kpi nx-email-kpi">
            <div class="nx-orders-kpi-icon nx-orders-kpi-icon--credit"><i data-feather="credit-card"></i></div>
            <div class="nx-orders-kpi-body">
                <div class="nx-orders-kpi-label">Mail bakiyesi</div>
                <div class="nx-orders-kpi-value">{{ email_credit|number_format(0, ',', '.') }}</div>
                <div class="nx-orders-kpi-hint">1 mail = 1 kredi</div>
            </div>
        </div>
        <div class="nx-orders-kpi nx-email-kpi">
            <div class="nx-orders-kpi-icon nx-orders-kpi-icon--orders"><i data-feather="inbox"></i></div>
            <div class="nx-orders-kpi-body">
                <div class="nx-orders-kpi-label">Toplam sipariş</div>
                <div class="nx-orders-kpi-value">{{ orders|length|number_format(0, ',', '.') }}</div>
                <div class="nx-orders-kpi-hint">Bu listedeki kayıtlar</div>
            </div>
        </div>
        <div class="nx-orders-kpi nx-email-kpi">
            <div class="nx-orders-kpi-icon nx-orders-kpi-icon--sent"><i data-feather="check-circle"></i></div>
            <div class="nx-orders-kpi-body">
                <div class="nx-orders-kpi-label">Başarılı gönderim</div>
                <div class="nx-orders-kpi-value">{{ em_delivered|number_format(0, ',', '.') }}</div>
                <div class="nx-orders-kpi-hint">Teslim edilen (tümü)</div>
            </div>
        </div>
        <div class="nx-orders-kpi nx-email-kpi">
            <div class="nx-orders-kpi-icon nx-orders-kpi-icon--warn"><i data-feather="alert-triangle"></i></div>
            <div class="nx-orders-kpi-body">
                <div class="nx-orders-kpi-label">Bekleyen / Hatalı</div>
                <div class="nx-orders-kpi-value nx-email-kpi-dual">
                    <span class="nx-email-kpi-num">{{ em_pending|number_format(0, ',', '.') }}</span>
                    <span class="nx-email-kpi-sep" aria-hidden="true">/</span>
                    <span class="nx-email-kpi-num nx-email-kpi-num--fail">{{ em_failed|number_format(0, ',', '.') }}</span>
                </div>
                <div class="nx-orders-kpi-hint">Sipariş bazında</div>
            </div>
        </div>
    </div>

    <div class="nx-orders-cols nx-email-cols">
        <main class="nx-orders-main">
        <div class="card nx-card nx-orders-list-card">
            <div class="nx-orders-card-head nx-orders-card-head--title-only">
                <div class="nx-orders-card-head-main">
                    <div class="nx-orders-icon-chip"><i data-feather="mail"></i></div>
                    <div>
                        <h4 class="nx-orders-card-title mb-0">Siparişlerim</h4>
                    </div>
                </div>
            </div>
            {% if total > 0 or q or selected_status %}
            <div class="nx-orders-toolbar-strip">
                <form method="GET" action="/email-send" class="nx-orders-list-toolbar orders-toolbar" id="nxEmailOrdersFilterForm">
                    <input type="hidden" name="page" value="1">
                    <input type="search" class="form-control form-control-sm nx-orders-search-input" id="nxEmailOrderSearch" name="q" value="{{ q|default('') }}" placeholder="Sipariş no, konu, durum…" autocomplete="off" aria-label="Siparişlerde ara">
                    <select class="form-select form-select-sm nx-orders-filter-select" id="nxEmailOrderStatusFilter" name="status" aria-label="Durum filtresi">
                        <option value="">Tümü</option>
                        <option value="pending" {{ selected_status == 'pending' ? 'selected' : '' }}>Onay / Bekliyor</option>
                        <option value="processing" {{ selected_status == 'processing' ? 'selected' : '' }}>Gönderiliyor</option>
                        <option value="sent" {{ selected_status == 'sent' ? 'selected' : '' }}>Gönderildi</option>
                        <option value="failed" {{ selected_status == 'failed' ? 'selected' : '' }}>Hatalı</option>
                        <option value="other" {{ selected_status == 'other' ? 'selected' : '' }}>Diğer</option>
                    </select>
                    <select class="form-select form-select-sm nx-orders-filter-select" id="nxEmailOrderPerPage" name="per_page" aria-label="Sayfa başına kayıt">
                        <option value="20" {{ per_page == 20 ? 'selected' : '' }}>20 / sayfa</option>
                        <option value="50" {{ per_page == 50 ? 'selected' : '' }}>50 / sayfa</option>
                        <option value="100" {{ per_page == 100 ? 'selected' : '' }}>100 / sayfa</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Filtrele</button>
                    <button type="button" class="btn nx-orders-icon-refresh" id="nxEmailOrdersToolbarRefresh" title="Listeyi yenile" aria-label="Listeyi yenile">
                        <i data-feather="refresh-cw"></i>
                    </button>
                </form>
            </div>
            {% endif %}
            <div class="card-body nx-orders-list-body">
                {% if orders is empty %}
                <div class="nx-orders-empty text-center py-5 px-3">
                    <div class="nx-orders-empty-icon mb-3"><i data-feather="mail"></i></div>
                    {% if q or selected_status %}
                    <h5 class="fw-semibold mb-2">Filtreye uygun sipariş bulunamadı</h5>
                    <p class="text-muted small mb-4">Arama veya durum filtresini değiştirip tekrar deneyin.</p>
                    {% else %}
                    <h5 class="fw-semibold mb-2">Henüz mail siparişi yok</h5>
                    <p class="text-muted small mb-4">Sağdaki formdan ilk siparişinizi oluşturabilirsiniz.</p>
                    {% endif %}
                    <a href="#nx-new-mail-order" class="btn nx-orders-primary-btn btn-sm">
                        <i data-feather="send" class="align-self-center icon-xs me-1"></i> Mail gönder
                    </a>
                </div>
                {% else %}
                <div class="table-responsive nx-orders-table-wrap nx-email-table-wrap">
                    <table class="table table-hover mb-0 nx-orders-table nx-email-orders-table" id="nxEmailOrdersTable">
                        <thead>
                            <tr>
                                <th class="nx-email-col-id">No</th>
                                <th class="nx-email-col-subject">Konu / Template</th>
                                <th class="nx-email-col-status">Durum</th>
                                <th class="text-end nx-email-col-num">Toplam</th>
                                <th class="text-end nx-email-col-num">OK</th>
                                <th class="text-end nx-email-col-num">Hata</th>
                                <th class="nx-email-col-rate">Oran</th>
                                <th class="nx-email-col-date">Oluşturulma</th>
                                <th class="text-end nx-orders-col-action nx-email-col-action">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                            {% set sv = order.status.value %}
                            {% set stFilter = sv in ['sent','completed'] ? 'sent' : (sv in ['pending_approval','pending'] ? 'pending' : (sv == 'processing' ? 'processing' : (sv == 'failed' ? 'failed' : 'other'))) %}
                            {% set createdStr = order.createdAt|date('d.m.Y H:i') %}
                            {% set tplMeta = order.template ?: (template_meta_by_order_id[order.id] ?? null) %}
                            {% set tplLabel = tplMeta and tplMeta.id ? 'Template: #' ~ tplMeta.id ~ ' - ' ~ (tplMeta.name ?: 'İsimsiz') : 'Template: Eşleşmedi' %}
                            <tr class="nx-email-order-row" data-status="{{ stFilter }}" data-search="#{{ order.id }} {{ order.id }} {{ order.subject|e('html_attr') }} {{ tplLabel|e('html_attr') }} {{ createdStr }}">
                                <td><span class="nx-orders-id">#{{ order.id }}</span></td>
                                <td class="nx-email-td-subject">
                                    <a href="/email-send/{{ order.id }}" class="nx-email-subject-link text-decoration-none" title="{{ order.subject|e('html_attr') }}">
                                        <span class="nx-email-order-subject-title">{{ order.subject }}</span>
                                        <span class="nx-email-order-template-meta" title="{{ tplLabel|e('html_attr') }}">{{ tplLabel }}</span>
                                    </a>
                                </td>
                                <td>
                                    {% if sv == 'pending_approval' %}
                                        <span class="mail-status-badge is-pending">Bekliyor</span>
                                    {% elseif sv == 'pending' %}
                                        <span class="mail-status-badge is-pending">Bekliyor</span>
                                    {% elseif sv == 'processing' %}
                                        <span class="mail-status-badge is-processing">İşleniyor</span>
                                    {% elseif sv == 'sent' or sv == 'completed' %}
                                        <span class="mail-status-badge is-completed">Tamamlandı</span>
                                    {% elseif sv == 'failed' %}
                                        <span class="mail-status-badge is-failed">Başarısız</span>
                                    {% elseif sv == 'cancelled' or sv == 'canceled' %}
                                        <span class="mail-status-badge is-cancelled">İptal</span>
                                    {% else %}
                                        <span class="mail-status-badge is-cancelled">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">{{ order.total|number_format(0, ',', '.') }}</td>
                                <td class="text-end nx-orders-sent">{{ order.delivered|number_format(0, ',', '.') }}</td>
                                <td class="text-end nx-orders-fail">{{ order.failed|number_format(0, ',', '.') }}</td>
                                <td class="nx-email-td-rate">
                                    {% if order.total > 0 %}
                                    <div class="nx-email-rate-cell">
                                        <div class="progress nx-email-rate-bar" role="progressbar" aria-valuenow="{{ order.successRate }}" aria-valuemin="0" aria-valuemax="100" aria-label="Başarı oranı {{ order.successRate }}%">
                                            <div class="progress-bar bg-{{ order.successRate >= 90 ? 'success' : (order.successRate >= 70 ? 'warning' : 'danger') }}" style="width: {{ order.successRate }}%"></div>
                                        </div>
                                        <span class="nx-email-rate-badge {{ order.successRate >= 90 ? 'nx-email-rate-badge--ok' : (order.successRate >= 70 ? 'nx-email-rate-badge--mid' : 'nx-email-rate-badge--low') }}">{{ order.successRate|number_format(1) }}%</span>
                                    </div>
                                    {% else %}
                                    <span class="text-muted small">—</span>
                                    {% endif %}
                                </td>
                                <td class="nx-email-td-date">
                                    <div class="nx-email-date-stack">
                                        <span class="nx-email-date-line">{{ order.createdAt|date('d.m.Y') }}</span>
                                        <span class="nx-email-time-line">{{ order.createdAt|date('H:i') }}</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button type="button" onclick="viewOrderDetails({{ order.id }})" class="btn nx-orders-icon-btn" title="Detay">
                                        <i data-feather="eye" class="icon-xs"></i>
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if total > 0 %}
                {% set startItem = ((page - 1) * per_page) + 1 %}
                {% set endItem = [page * per_page, total]|min %}
                {% set baseQuery = 'q=' ~ (q|default('')|url_encode) ~ '&status=' ~ (selected_status|default('')|url_encode) ~ '&per_page=' ~ per_page %}
                {% set rangeStart = [1, page - 1]|max %}
                {% set rangeEnd = [total_pages, page + 1]|min %}
                <div class="nx-orders-pagination">
                    <div class="nx-orders-pagination-meta">
                        Toplam {{ total|number_format(0, ',', '.') }} sipariş · {{ startItem|number_format(0, ',', '.') }}-{{ endItem|number_format(0, ',', '.') }} · {{ per_page }} / sayfa · Sayfa {{ page }} / {{ total_pages }}
                    </div>
                    {% if total_pages > 1 %}
                    <nav aria-label="Sipariş sayfalama">
                        <ul class="pagination pagination-sm mb-0 nx-orders-pagination-nav">
                            <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ page > 1 ? '/email-send?page=' ~ (page - 1) ~ '&' ~ baseQuery : '#' }}">Önceki</a>
                            </li>

                            {% if rangeStart > 1 %}
                            <li class="page-item"><a class="page-link" href="/email-send?page=1&{{ baseQuery }}">1</a></li>
                            {% if rangeStart > 2 %}
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            {% endif %}
                            {% endif %}

                            {% for p in rangeStart..rangeEnd %}
                            <li class="page-item {{ p == page ? 'active' : '' }}">
                                <a class="page-link" href="/email-send?page={{ p }}&{{ baseQuery }}">{{ p }}</a>
                            </li>
                            {% endfor %}

                            {% if rangeEnd < total_pages %}
                            {% if rangeEnd < (total_pages - 1) %}
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            {% endif %}
                            <li class="page-item"><a class="page-link" href="/email-send?page={{ total_pages }}&{{ baseQuery }}">{{ total_pages }}</a></li>
                            {% endif %}

                            <li class="page-item {{ page >= total_pages ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ page < total_pages ? '/email-send?page=' ~ (page + 1) ~ '&' ~ baseQuery : '#' }}">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                    {% endif %}
                </div>
                {% endif %}
                {% endif %}
            </div>
        </div>
        </main>

        <aside class="nx-orders-side" id="nx-new-mail-order">
        <div class="card nx-card nx-orders-form-card">
            <div class="nx-orders-card-head nx-orders-card-head--form nx-orders-card-head--compact">
                <div class="nx-orders-card-head-main">
                    <div class="nx-orders-icon-chip nx-orders-icon-chip--accent"><i data-feather="send"></i></div>
                    <div>
                        <h4 class="nx-orders-card-title mb-0">Yeni mail siparişi</h4>
                    </div>
                </div>
            </div>
            <div class="card-body nx-orders-form-body">
                    <ul class="nav nx-orders-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" data-bs-toggle="tab" href="#phonebookTab" role="tab" onclick="refreshIcons()">
                                <i data-feather="book" class="nx-orders-tab-ic"></i>
                                <span>Rehberden</span>
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#manualTab" role="tab" onclick="refreshIcons()">
                                <i data-feather="edit-3" class="nx-orders-tab-ic"></i>
                                <span>Manuel</span>
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" data-bs-toggle="tab" href="#poolTab" role="tab" onclick="refreshIcons()">
                                <i data-feather="database" class="nx-orders-tab-ic"></i>
                                <span>Sistem Havuzu</span>
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content nx-orders-tab-panels">
                        <!-- Rehberden Gönder -->
                        <div class="tab-pane fade show active" id="phonebookTab" role="tabpanel">
                            <form method="POST" action="/email-send" onsubmit="return showLoading(event)">
                                <input type="hidden" name="send_type" value="phonebook">
                                
                                <div class="mb-3">
                                    <label for="phonebook_ids" class="form-label">Rehber Seç <span class="text-danger">*</span></label>
                                    <select class="form-select nx-orders-multiselect nx-email-multiselect" id="phonebook_ids" name="phonebook_ids[]" multiple size="5" required onchange="calculateCredits()">
                                        {% for phonebook in phonebooks %}
                                        <option value="{{ phonebook.id }}" data-count="{{ phonebook.totalContacts }}">{{ phonebook.title }} ({{ phonebook.totalContacts }} mail)</option>
                                        {% else %}
                                        <option value="" disabled>Rehber bulunamadı</option>
                                        {% endfor %}
                                    </select>
                                    <small class="text-muted d-block">Birden fazla rehber seçmek için Ctrl/Cmd tuşuna basılı tutun</small>
                                    
                                    <!-- Canlı Hesaplama -->
                                    <div class="alert alert-info mt-2 py-2 px-3" id="credit_calc" style="display:none;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <small class="text-dark">
                                                    <strong>Seçilen Mail:</strong> <span id="selected_count">0</span><br>
                                                    <strong>Gerekli Kredi:</strong> <span id="required_credit">0</span>
                                                </small>
                                            </div>
                                            <div>
                                                <span class="badge bg-success" id="status_badge">Yeterli</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Mail Şablonu - ZORUNLU (body POST'ta gönderilmez, post_max_size önlenir) -->
                                <div class="mb-3">
                                    <label for="template_pb" class="form-label nx-email-template-head">
                                        <span class="nx-email-template-head-l">
                                            <i data-feather="file-text" class="icon-xs me-1"></i>
