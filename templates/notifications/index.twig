{% extends '_layouts/main.twig' %}

{% block title %}Bildirimler - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item active">Bildirimler</li>
{% endblock %}

{% block page_icon %}<i data-feather="bell" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Bildirimler{% endblock %}

{% block styles %}
<style>
/* İstatistik Çizgileri */
.card-body .row.g-3 > div {
    position: relative;
}
@media (min-width: 768px) {
    .card-body .row.g-3 > div:not(:last-child)::after {
        content: '';
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        height: 40px;
        width: 1px;
        background: #e3e6f0;
    }
}

.notification-item {
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    transition: all 0.2s ease;
}

.notification-item:last-child {
    margin-bottom: 0;
}

.notification-item.unread {
    background: #fafbfc;
}

.notification-item:hover {
    background: #f1f3f5;
}

.notification-item p {
    word-wrap: break-word;
    word-break: break-word;
    white-space: normal;
    overflow-wrap: break-word;
    hyphens: auto;
    line-height: 1.4;
}

.notification-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.notification-icon i {
    width: 18px;
    height: 18px;
}

.bg-soft-primary {
    background-color: rgba(114, 124, 245, 0.18);
}

.bg-soft-success {
    background-color: rgba(10, 207, 151, 0.18);
}

.bg-soft-warning {
    background-color: rgba(255, 193, 7, 0.18);
}

.bg-soft-danger {
    background-color: rgba(255, 86, 48, 0.18);
}

.bg-soft-info {
    background-color: rgba(57, 175, 209, 0.18);
}

.bg-soft-secondary {
    background-color: rgba(108, 117, 125, 0.18);
}

.btn-soft-primary {
    color: #727cf5;
    background-color: rgba(114, 124, 245, 0.18);
    border-color: transparent;
}

.btn-soft-primary:hover,
.btn-soft-primary.active {
    color: #fff;
    background-color: #727cf5;
    border-color: #727cf5;
}

.btn-outline-secondary.active {
    background-color: #6c757d;
    border-color: #6c757d;
    color: #fff;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.notification-item {
    animation: fadeIn 0.3s ease;
}
</style>
{% endblock %}

{% block content %}
<div class="container-fluid">

    <!-- Alert Alanı -->
    <div id="alertArea"></div>

    <!-- İstatistikler -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <div class="text-center">
                                <i data-feather="bell" class="text-primary mb-1" style="width: 24px; height: 24px;"></i>
                                <h6 class="fw-bold mb-0">{{ notifications|length }}</h6>
                                <small class="text-muted">Toplam Bildirim</small>
                            </div>
                        </div>
                        
                        <div class="col-md-3 col-sm-6">
                            <div class="text-center">
                                <i data-feather="mail" class="text-warning mb-1" style="width: 24px; height: 24px;"></i>
                                <h6 class="fw-bold mb-0">{{ notifications|filter(n => not n.isRead)|length }}</h6>
                                <small class="text-muted">Okunmamış</small>
                            </div>
                        </div>
                        
                        <div class="col-md-3 col-sm-6">
                            <div class="text-center">
                                <i data-feather="check-circle" class="text-success mb-1" style="width: 24px; height: 24px;"></i>
                                <h6 class="fw-bold mb-0">{{ notifications|filter(n => n.isRead)|length }}</h6>
                                <small class="text-muted">Okundu</small>
                            </div>
                        </div>
                        
                        <div class="col-md-3 col-sm-6">
                            <div class="text-center">
                                <i data-feather="clock" class="text-info mb-1" style="width: 24px; height: 24px;"></i>
                                <h6 class="fw-bold mb-0">{{ notifications|filter(n => n.createdAt|date('Y-m-d') == "now"|date('Y-m-d'))|length }}</h6>
                                <small class="text-muted">Bugün</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="card-title mb-0">Tüm Bildirimler</h4>
                        </div>
                        <div class="col-auto">
                            <div class="btn-group btn-group-sm me-2" role="group">
                                <button type="button" class="btn btn-outline-secondary active" onclick="filterNotifications('all')">
                                    Tümü
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="filterNotifications('unread')">
                                    Okunmamış
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="filterNotifications('read')">
                                    Okundu
                                </button>
                            </div>
                            {% if notifications|filter(n => not n.isRead)|length > 0 %}
                            <button type="button" class="btn btn-sm btn-primary" onclick="markAllAsRead()">
                                <i data-feather="check-double" class="icon-xs me-1"></i> Tümünü Okundu İşaretle
                            </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    {% if notifications|length == 0 %}
                    <!-- Boş Durum -->
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <i data-feather="bell-off" class="text-muted" style="width: 64px; height: 64px;"></i>
                        </div>
                        <h5 class="text-muted mb-2">Henüz bildiriminiz yok</h5>
                        <p class="text-muted small">Yeni bildirimler geldiğinde burada görünecek</p>
                    </div>
                    {% else %}
                    <!-- Bildirimler -->
                    {% for notification in notifications %}
                    {% set iconColor = notification.type == 'success' ? 'success' : (notification.type == 'warning' ? 'warning' : (notification.type == 'danger' ? 'danger' : (notification.type == 'info' ? 'info' : 'primary'))) %}
                    {% set icon = notification.type == 'success' ? 'check-circle' : (notification.type == 'warning' ? 'alert-triangle' : (notification.type == 'danger' ? 'alert-circle' : (notification.type == 'info' ? 'info' : 'bell'))) %}
                    <div class="notification-item {{ notification.isRead ? 'read' : 'unread' }}" 
                         data-status="{{ notification.isRead ? 'read' : 'unread' }}"
                         id="notification-{{ notification.id }}">
                        <div class="d-flex align-items-center">
                            <!-- İkon -->
                            <div class="flex-shrink-0">
                                <div class="notification-icon bg-soft-{{ iconColor }}">
                                    <i data-feather="{{ icon }}" class="align-self-center text-{{ iconColor }}"></i>
                                </div>
                            </div>
                            
                            <!-- İçerik -->
                            <div class="flex-grow-1 ms-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 {{ notification.isRead ? 'text-muted' : '' }}">
                                            {{ notification.title }}
                                            {% if not notification.isRead %}
                                            <span class="badge bg-secondary ms-1" style="font-size: 10px; vertical-align: middle;">Yeni</span>
                                            {% endif %}
                                        </h6>
                                        <p class="mb-1 small text-muted">
                                            {{ notification.message }}
                                        </p>
                                        <div class="text-muted" style="font-size: 11px;">
                                            {{ notification.createdAt|date('d.m.Y H:i') }}
                                            {% if notification.isRead %}
                                            <span class="mx-2">•</span>
                                            <span>Okundu</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    
                                    <!-- Okundu Butonu -->
                                    {% if not notification.isRead %}
                                    <div class="ms-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="markAsRead({{ notification.id }})">
                                            <i data-feather="check" class="icon-xs"></i>
                                        </button>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

</div>

<script>
function markAsRead(notificationId) {
    fetch(`/notifications/${notificationId}/mark-read`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('HTTP ' + response.status);
        }
        return response.json();
    })
    .then(data => {
        if (!data || !data.success) {
            throw new Error('İşlem başarısız');
        }
        
        const notificationEl = document.getElementById(`notification-${notificationId}`);
        if (!notificationEl) {
            // Element bulunamadı ama işlem başarılı, sayfayı yenile
            setTimeout(() => location.reload(), 500);
            return;
        }
        
        // Görsel güncellemeler
        notificationEl.classList.remove('unread');
        notificationEl.classList.add('read');
        notificationEl.dataset.status = 'read';
        
        // Badge'i kaldır
        const newBadge = notificationEl.querySelector('.badge');
        if (newBadge) newBadge.remove();
        
        // Buton'u kaldır
        const button = notificationEl.querySelector('button');
        if (button) button.remove();
        
        // İkon ve arka planı gri yap
        const iconDiv = notificationEl.querySelector('.notification-icon');
        if (iconDiv) {
            iconDiv.className = 'notification-icon bg-soft-secondary';
        }
        const iconElement = notificationEl.querySelector('.notification-icon i');
        if (iconElement) {
            // Icon'u tamamen değiştir - SVG ile
            iconElement.outerHTML = '<i data-feather="check-circle" class="align-self-center text-secondary"></i>';
            // Sadece yeni icon'u yenile
            setTimeout(() => safeFeatherReplace(), 50);
        }
        
        // Text'leri muted yap
        const heading = notificationEl.querySelector('h6');
        const paragraph = notificationEl.querySelector('p');
        if (heading) {
            heading.classList.add('text-muted');
            heading.classList.remove('fw-bold');
        }
        if (paragraph) {
            paragraph.classList.add('text-muted');
        }
        
        // Başarı mesajı göster
        showAlert('success', 'Bildirim okundu olarak işaretlendi');
        
        // İstatistikleri güncelle
        setTimeout(() => location.reload(), 1500);
    })
    .catch(err => {
        showAlert('danger', 'İşlem başarısız oldu');
        console.error('Mark as read error:', err);
    });
}

function markAllAsRead() {
    // Modal ile onay iste
    const modalHtml = `
        <div class="modal fade" id="confirmModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i data-feather="check-circle" class="icon-xs me-2"></i>
                            Onay
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Tüm bildirimleri okundu olarak işaretlemek istediğinize emin misiniz?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="button" class="btn btn-primary" onclick="confirmMarkAllAsRead()">
                            <i data-feather="check" class="icon-xs me-1"></i>
                            Evet, İşaretle
                        </button>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
    modal.show();
    
    document.getElementById('confirmModal').addEventListener('hidden.bs.modal', function () {
        this.remove();
    });
    
    // Güvenli feather replace
    setTimeout(() => safeFeatherReplace(), 100);
}

function confirmMarkAllAsRead() {
    const modal = bootstrap.Modal.getInstance(document.getElementById('confirmModal'));
    modal.hide();
    
    fetch('/notifications/mark-all-read', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('success', 'Tüm bildirimler okundu olarak işaretlendi');
            setTimeout(() => location.reload(), 1500);
        }
    })
    .catch(err => {
        showAlert('danger', 'İşlem başarısız oldu');
    });
}

function filterNotifications(filter) {
    const items = document.querySelectorAll('.notification-item');
    const buttons = document.querySelectorAll('.btn-group .btn');
    
    // Buton aktif durumunu güncelle
    buttons.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    
    // Filtreleme
    items.forEach(item => {
        if (filter === 'all') {
            item.style.display = '';
        } else {
            const status = item.dataset.status;
            item.style.display = status === filter ? '' : 'none';
        }
    });
    
    // Güvenli feather replace
    setTimeout(() => safeFeatherReplace(), 100);
}

function showAlert(type, message) {
    const alertArea = document.getElementById('alertArea');
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'check-circle' : 'alert-circle';
    
    const alertHtml = `
        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
            <i data-feather="${icon}" class="icon-xs me-2"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    alertArea.innerHTML = alertHtml;
    
    // Güvenli feather replace
    setTimeout(() => safeFeatherReplace(), 50);
    
    setTimeout(() => {
        const alert = alertArea.querySelector('.alert');
        if (alert) {
            alert.classList.remove('show');
            setTimeout(() => alertArea.innerHTML = '', 150);
        }
    }, 3000);
}

// Güvenli feather replace fonksiyonu
function safeFeatherReplace() {
    if (typeof feather === 'undefined') return;
    
    try {
        // Önce geçersiz icon'ları temizle
        document.querySelectorAll('[data-feather]').forEach(function(element) {
            const iconName = element.getAttribute('data-feather');
            if (!iconName || !feather.icons[iconName]) {
                element.setAttribute('data-feather', 'bell'); // Varsayılan icon
            }
        });
        
        // Şimdi güvenle replace et
        feather.replace();
    } catch (error) {
        console.warn('Feather icons could not be replaced:', error);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    safeFeatherReplace();
});
</script>

{% endblock %}
