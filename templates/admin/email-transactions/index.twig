{% extends "_layouts/main.twig" %}

{% block title %}Tüm Email İşlemleri - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
<li class="breadcrumb-item">Email</li>
<li class="breadcrumb-item active">Tüm İşlemler</li>
{% endblock %}

{% block page_icon %}<i data-feather="list" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Tüm Email İşlemleri{% endblock %}

{% block content %}
<div class="container-fluid">

    <!-- İstatistikler -->
    <div class="row">
        <div class="col-md-3">
            <div class="card" style="min-height: 120px;">
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <i data-feather="activity" class="text-primary" style="width: 40px; height: 40px;"></i>
                        <div class="ms-3">
                            <h3 class="mb-0">{{ stats.total|number_format }}</h3>
                            <p class="text-muted mb-0">Toplam İşlem</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card" style="min-height: 120px;">
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <i data-feather="arrow-down" class="text-success" style="width: 40px; height: 40px;"></i>
                        <div class="ms-3">
                            <h3 class="mb-0">{{ stats.total_deposit|number_format(2) }} ₺</h3>
                            <p class="text-muted mb-0">Toplam Yükleme</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card" style="min-height: 120px;">
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <i data-feather="arrow-up" class="text-danger" style="width: 40px; height: 40px;"></i>
                        <div class="ms-3">
                            <h3 class="mb-0">{{ stats.total_spent|number_format(2) }} ₺</h3>
                            <p class="text-muted mb-0">Toplam Harcama</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card" style="min-height: 120px;">
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="d-flex align-items-center">
                        <i data-feather="rotate-ccw" class="text-info" style="width: 40px; height: 40px;"></i>
                        <div class="ms-3">
                            <h3 class="mb-0">{{ stats.total_refund|number_format(2) }} ₺</h3>
                            <p class="text-muted mb-0">Toplam İade</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtreler ve Tablo -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <!-- Filtreler -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <input type="text" class="form-control" id="searchInput" placeholder="İşlem ara..." value="{{ search }}" onkeyup="handleSearch()">
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" id="typeFilter" onchange="applyFilters()">
                                <option value="">Tüm Tipler</option>
                                <option value="credit" {{ selected_type == 'credit' ? 'selected' : '' }}>Bakiye Yükle</option>
                                <option value="debit" {{ selected_type == 'debit' ? 'selected' : '' }}>Bakiye Çek</option>
                                <option value="campaign" {{ selected_type == 'campaign' ? 'selected' : '' }}>Kampanya</option>
                                <option value="order" {{ selected_type == 'order' ? 'selected' : '' }}>Sipariş</option>
                                <option value="refund" {{ selected_type == 'refund' ? 'selected' : '' }}>İade</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" id="userFilter" onchange="applyFilters()">
                                <option value="">Tüm Kullanıcılar</option>
                                {% for user in users %}
                                <option value="{{ user.id }}" {{ selected_user == user.id ? 'selected' : '' }}>{{ user.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-secondary w-100" onclick="clearFilters()">
                                <i data-feather="x"></i> Temizle
                            </button>
                        </div>
                    </div>

                    {% if transactions is empty %}
                    <div class="text-center text-muted py-5">
                        <i data-feather="inbox" style="width: 64px; height: 64px;"></i>
                        <h5 class="mt-3">İşlem bulunamadı</h5>
                    </div>
                    {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Kullanıcı</th>
                                    <th>Tip</th>
                                    <th>Tutar</th>
                                    <th>Açıklama</th>
                                    <th>Tarih</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for transaction in transactions %}
                                <tr>
                                    <td>{{ transaction.id }}</td>
                                    <td>
                                        {{ transaction.user.name }}<br>
                                        <small class="text-muted">{{ transaction.user.email }}</small>
                                    </td>
                                    <td>
                                        {% if transaction.type.value == 'credit' or transaction.type.value == 'admin_credit' %}
                                        <span class="badge bg-success">Yükleme</span>
                                        {% elseif transaction.type.value == 'debit' or transaction.type.value == 'admin_debit' %}
                                        <span class="badge bg-danger">Çekme</span>
                                        {% elseif transaction.type.value == 'refund' %}
                                        <span class="badge bg-info">İade</span>
                                        {% elseif transaction.type.value == 'campaign' or transaction.type.value == 'order' %}
                                        <span class="badge bg-warning">Harcama</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <strong class="{{ transaction.amount > 0 ? 'text-success' : 'text-danger' }}">
                                            {{ transaction.amount > 0 ? '+' : '' }}{{ transaction.amount|number_format(2) }} ₺
                                        </strong>
                                    </td>
                                    <td>{{ transaction.description }}</td>
                                    <td>{{ transaction.createdAt|date('d.m.Y H:i:s') }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    {% if total_pages > 1 %}
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center">
                            {% if page > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page - 1 }}&search={{ search }}&type={{ selected_type }}&user_id={{ selected_user }}">Önceki</a>
                            </li>
                            {% endif %}
                            
                            {% for p in 1..total_pages %}
                            {% if p == 1 or p == total_pages or (p >= page - 2 and p <= page + 2) %}
                            <li class="page-item {{ p == page ? 'active' : '' }}">
                                <a class="page-link" href="?page={{ p }}&search={{ search }}&type={{ selected_type }}&user_id={{ selected_user }}">{{ p }}</a>
                            </li>
                            {% elseif p == page - 3 or p == page + 3 %}
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            {% endif %}
                            {% endfor %}
                            
                            {% if page < total_pages %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page + 1 }}&search={{ search }}&type={{ selected_type }}&user_id={{ selected_user }}">Sonraki</a>
                            </li>
                            {% endif %}
                        </ul>
                    </nav>
                    {% endif %}

                    <div class="text-center text-muted mt-3">
                        Toplam {{ total }} işlem bulundu
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function handleSearch() {
    const timer = setTimeout(() => {
        applyFilters();
    }, 500);
}

function applyFilters() {
    const search = document.getElementById('searchInput').value;
    const type = document.getElementById('typeFilter').value;
    const userId = document.getElementById('userFilter').value;
    
    window.location.href = `/admin/email-transactions?search=${encodeURIComponent(search)}&type=${type}&user_id=${userId}`;
}

function clearFilters() {
    window.location.href = '/admin/email-transactions';
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
});
</script>
{% endblock %}

