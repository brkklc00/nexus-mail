{% extends "_layouts/main.twig" %}

{% block title %}Sunucu Yönetimi - {{ site_title|default('Nexus Mail') }}{% endblock %}

{% block page_title %}
<div class="row">
    <div class="col-12">
        <div class="page-title-box nx-page-head pb-0">
            <div class="d-flex flex-column flex-lg-row align-items-start justify-content-lg-between gap-3">
                <div>
                    <div class="page-title-right mb-2">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="/dashboard">Panel</a></li>
                            <li class="breadcrumb-item">Yönetim</li>
                            <li class="breadcrumb-item active">Sunucu Yönetimi</li>
                        </ol>
                    </div>
                    <h4 class="page-title nx-page-title mb-1">Sunucu Yönetimi</h4>
                    <p class="mb-0 text-white-50">Sistem sağlığını, logları, dosyaları ve yedekleri tek ekrandan yönetin.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm nx-orders-tool-btn nx-sm-action-btn" id="smRefreshBtn"><i data-feather="refresh-cw" class="icon-xs me-1"></i>Yenile</button>
                    <button class="btn btn-sm nx-orders-tool-btn nx-sm-action-btn" id="smSystemCheckBtn"><i data-feather="activity" class="icon-xs me-1"></i>Sistem Kontrolü</button>
                    <button class="btn btn-sm nx-orders-tool-btn nx-sm-action-btn" id="smMaintenanceToggleBtn"><i data-feather="tool" class="icon-xs me-1"></i><span id="smMaintenanceToggleText">Bakım Modu</span></button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block styles %}
<style>
.nx-sm-page .card { border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06); }
.nx-sm-card-header { background: linear-gradient(125deg, #071a34 0%, #183b63 100%); color: #fff; border-bottom: 1px solid rgba(255,255,255,.08); border-radius: 16px 16px 0 0; padding: .72rem .95rem; }
.nx-sm-card-title { display: flex; align-items: flex-start; gap: .6rem; margin: 0; font-size: .95rem; font-weight: 700; }
.nx-sm-ic { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.12); flex-shrink: 0; }
.nx-sm-ic svg { width: 16px; height: 16px; }
.nx-sm-kpi { height: 100%; border-radius: 14px; border: 1px solid #e2e8f0; background: #fff; padding: .8rem; }
.nx-sm-kpi-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .45rem; }
.nx-sm-kpi-label { font-size: .76rem; color: #64748b; font-weight: 600; }
.nx-sm-kpi-value { font-size: 1.2rem; font-weight: 700; color: #0f172a; line-height: 1.2; }
.nx-sm-kpi-hint { font-size: .72rem; color: #64748b; }
.nx-sm-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
.nx-sm-dot.ok { background: #16a34a; } .nx-sm-dot.warn { background: #f59e0b; } .nx-sm-dot.bad { background: #ef4444; }
.nx-sm-metric-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .6rem; }
.nx-sm-metric-item { border: 1px solid #e2e8f0; border-radius: 12px; padding: .55rem .65rem; background: #f8fafc; }
.nx-sm-metric-label { display: block; font-size: .7rem; color: #64748b; margin-bottom: .2rem; }
.nx-sm-metric-value { font-size: .82rem; color: #0f172a; font-weight: 700; }
.nx-sm-table td, .nx-sm-table th { vertical-align: middle; font-size: .8rem; }
.nx-sm-table td { padding-top: .55rem; padding-bottom: .55rem; }
.nx-sm-viewer { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: .75rem; background: #020617; color: #e2e8f0; border-radius: 12px; padding: .7rem; max-height: 420px; overflow: auto; white-space: pre-wrap; }
.nx-sm-file-badge { font-size: .67rem; padding: .22rem .45rem; border-radius: 999px; }
.nx-sm-empty { text-align: center; padding: 1.5rem 1rem; color: #64748b; }
.nx-sm-pagination { display: flex; align-items: center; justify-content: space-between; gap: .5rem; font-size: .76rem; color: #475569; margin-top: .6rem; }
.nx-sm-pagination .btn { min-height: 32px; font-size: .75rem; }
@media (max-width: 991.98px){ .nx-sm-metric-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
@media (max-width: 575.98px){ .nx-sm-metric-grid { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid nx-sm-page" id="smApp" data-csrf="{{ csrf_token|e('html_attr') }}">
    <div id="smAlertArea"></div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-lg-4 col-xl">
            <div class="nx-sm-kpi">
                <div class="nx-sm-kpi-head"><span class="nx-sm-kpi-label">CPU Kullanımı</span><span class="nx-sm-dot ok" id="smCpuDot"></span></div>
                <div class="nx-sm-kpi-value" id="smCpuValue">--%</div>
                <div class="progress mt-2" style="height:6px;"><div class="progress-bar" id="smCpuBar" style="width:0%"></div></div>
                <div class="nx-sm-kpi-hint mt-1" id="smCpuHint">-</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4 col-xl">
            <div class="nx-sm-kpi">
                <div class="nx-sm-kpi-head"><span class="nx-sm-kpi-label">RAM Kullanımı</span><span class="nx-sm-dot ok" id="smRamDot"></span></div>
                <div class="nx-sm-kpi-value" id="smRamValue">--%</div>
                <div class="progress mt-2" style="height:6px;"><div class="progress-bar" id="smRamBar" style="width:0%"></div></div>
                <div class="nx-sm-kpi-hint mt-1" id="smRamHint">-</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4 col-xl">
            <div class="nx-sm-kpi">
                <div class="nx-sm-kpi-head"><span class="nx-sm-kpi-label">Disk Kullanımı</span><span class="nx-sm-dot ok" id="smDiskDot"></span></div>
                <div class="nx-sm-kpi-value" id="smDiskValue">--%</div>
                <div class="progress mt-2" style="height:6px;"><div class="progress-bar" id="smDiskBar" style="width:0%"></div></div>
                <div class="nx-sm-kpi-hint mt-1" id="smDiskHint">-</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4 col-xl">
            <div class="nx-sm-kpi">
                <div class="nx-sm-kpi-head"><span class="nx-sm-kpi-label">Veritabanı Boyutu</span><span class="nx-sm-dot ok" id="smDbDot"></span></div>
                <div class="nx-sm-kpi-value" id="smDbValue">--</div>
                <div class="nx-sm-kpi-hint mt-1" id="smDbHint">-</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4 col-xl">
            <div class="nx-sm-kpi">
                <div class="nx-sm-kpi-head"><span class="nx-sm-kpi-label">Sistem Durumu</span><span class="nx-sm-dot ok" id="smStatusDot"></span></div>
                <div class="nx-sm-kpi-value" id="smStatusValue">Stabil</div>
                <div class="nx-sm-kpi-hint mt-1" id="smStatusHint">Son yenileme: -</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="nx-sm-card-header"><h5 class="nx-sm-card-title"><span class="nx-sm-ic"><i data-feather="cpu"></i></span><span>Sistem Bilgileri</span></h5></div>
        <div class="card-body">
            <div class="nx-sm-metric-grid" id="smSystemGrid"></div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="nx-sm-card-header d-flex justify-content-between align-items-start flex-wrap gap-2">
            <h5 class="nx-sm-card-title"><span class="nx-sm-ic"><i data-feather="file-text"></i></span><span>Log Yönetimi</span></h5>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm btn-outline-light" id="smLoadAppLogsBtn">Uygulama Logları</button>
                <button class="btn btn-sm btn-outline-light" id="smLoadWorkerLogsBtn">Worker Logları</button>
                <button class="btn btn-sm btn-outline-light" id="smLoadErrorLogsBtn">Hata Logları</button>
                <button class="btn btn-sm btn-danger" id="smClearAllLogsBtn">Tüm Logları Temizle</button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover nx-sm-table mb-0">
                    <thead>
                        <tr><th>Log Adı</th><th>Boyut</th><th>Son Değişiklik</th><th class="text-end">İşlemler</th></tr>
                    </thead>
                    <tbody id="smLogsTableBody"><tr><td colspan="4" class="nx-sm-empty">Loglar yükleniyor...</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="nx-sm-card-header"><h5 class="nx-sm-card-title"><span class="nx-sm-ic"><i data-feather="wifi"></i></span><span>Network İstatistikleri</span></h5></div>
        <div class="card-body"><div class="row g-2" id="smNetworkList"><div class="col-12 nx-sm-empty">Network verisi yükleniyor...</div></div></div>
    </div>

    <div class="card mb-3">
        <div class="nx-sm-card-header d-flex justify-content-between align-items-start flex-wrap gap-2">
            <h5 class="nx-sm-card-title"><span class="nx-sm-ic"><i data-feather="folder"></i></span><span>Dosya Yöneticisi</span></h5>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm btn-outline-light" id="smUpDirBtn">Üst Dizin</button>
                <button class="btn btn-sm btn-outline-light" id="smCreateFileBtn">Yeni Dosya</button>
                <button class="btn btn-sm btn-outline-light" id="smCreateDirBtn">Yeni Klasör</button>
                <button class="btn btn-sm btn-outline-light" id="smUploadBtn">Dosya Yükle</button>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row gap-2 mb-2">
                <input class="form-control form-control-sm" id="smFileSearch" placeholder="Dosya ara...">
                <input class="form-control form-control-sm" id="smPathBreadcrumb" readonly>
            </div>
            <div class="table-responsive">
                <table class="table table-hover nx-sm-table mb-0">
                    <thead><tr><th>Ad</th><th>Tür</th><th>Boyut</th><th>Son Değişiklik</th><th class="text-end">İşlemler</th></tr></thead>
                    <tbody id="smFilesTableBody"><tr><td colspan="5" class="nx-sm-empty">Dosyalar yükleniyor...</td></tr></tbody>
                </table>
            </div>
            <div class="nx-sm-pagination">
                <span id="smFilesPageInfo">-</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" id="smFilesPrevBtn">Önceki</button>
                    <button class="btn btn-sm btn-outline-secondary" id="smFilesNextBtn">Sonraki</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="nx-sm-card-header"><h5 class="nx-sm-card-title"><span class="nx-sm-ic"><i data-feather="database"></i></span><span>Veritabanı Yedeği</span></h5></div>
                <div class="card-body d-flex flex-column gap-2">
                    <div class="small text-muted">DB Boyutu: <strong id="smDbSizeInline">-</strong></div>
                    <div class="small text-muted">Son yedek: <strong id="smDbLastBackup">-</strong></div>
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <button class="btn btn-sm btn-success" id="smBackupDbBtn">Veritabanı Yedekle</button>
                        <button class="btn btn-sm btn-outline-primary" id="smDownloadLastDbBtn">Son Yedeği İndir</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="nx-sm-card-header"><h5 class="nx-sm-card-title"><span class="nx-sm-ic"><i data-feather="archive"></i></span><span>Dosya Yedeği</span></h5></div>
                <div class="card-body d-flex flex-column gap-2">
                    <div class="small text-muted">Proje Boyutu: <strong id="smProjectSizeInline">-</strong></div>
                    <div class="small text-muted">Son yedek: <strong id="smFileLastBackup">-</strong></div>
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <button class="btn btn-sm btn-primary" id="smBackupFilesBtn">Dosyaları Yedekle</button>
                        <button class="btn btn-sm btn-outline-primary" id="smDownloadLastFilesBtn">Son Yedeği İndir</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="nx-sm-card-header d-flex justify-content-between align-items-center">
            <h5 class="nx-sm-card-title"><span class="nx-sm-ic"><i data-feather="clock"></i></span><span>Yedek Geçmişi</span></h5>
            <button class="btn btn-sm btn-outline-light" id="smLoadBackupsBtn">Yedek Geçmişini Yükle</button>
        </div>
        <div class="card-body">
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#smTabDb" type="button">Veritabanı Yedekleri</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#smTabFiles" type="button">Dosya Yedekleri</button></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="smTabDb"><div id="smBackupDbTableWrap" class="nx-sm-empty">Yedek geçmişini görmek için "Yedek Geçmişini Yükle" butonunu kullanın.</div></div>
                <div class="tab-pane fade" id="smTabFiles"><div id="smBackupFilesTableWrap" class="nx-sm-empty">Yedek geçmişini görmek için "Yedek Geçmişini Yükle" butonunu kullanın.</div></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="smConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header nx-email-modal-head border-0"><h5 class="modal-title text-white" id="smConfirmTitle">Onay</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><p class="mb-0" id="smConfirmMessage"></p></div>
            <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button><button class="btn btn-danger" id="smConfirmActionBtn">Onayla</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="smLogModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header nx-email-modal-head border-0">
                <h5 class="modal-title text-white d-flex align-items-center gap-2"><i data-feather="file-text" class="icon-xs"></i><span id="smLogModalTitle">Log Görüntüleyici</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-column flex-lg-row gap-2 mb-2">
                    <input class="form-control form-control-sm" id="smLogSearch" placeholder="Log içinde ara...">
                    <select class="form-select form-select-sm" id="smLogLineSelect" style="max-width:180px;">
                        <option value="100">Son 100 satır</option>
                        <option value="500">Son 500 satır</option>
                    </select>
                    <div class="form-check form-switch align-self-center ms-1">
                        <input class="form-check-input" type="checkbox" id="smLogAutoScroll" checked><label class="form-check-label small" for="smLogAutoScroll">Auto-scroll</label>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" id="smLogReloadBtn">Yenile</button>
                    <button class="btn btn-sm btn-outline-secondary" id="smLogDownloadBtn">Tamamı indir</button>
                </div>
                <div class="nx-sm-viewer" id="smLogViewer">Yükleniyor...</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="smEditorModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header nx-email-modal-head border-0">
                <h5 class="modal-title text-white d-flex align-items-center gap-2"><i data-feather="edit-3" class="icon-xs"></i><span id="smEditorTitle">Dosya Düzenle</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between mb-2"><small class="text-muted" id="smEditorMeta">-</small><div class="form-check"><input class="form-check-input" type="checkbox" id="smBackupBeforeSave" checked><label class="form-check-label small" for="smBackupBeforeSave">Kaydetmeden önce backup al</label></div></div>
                <textarea class="form-control font-monospace" rows="20" id="smEditorTextarea"></textarea>
            </div>
            <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button><button class="btn btn-primary" id="smEditorSaveBtn">Kaydet</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="smCreateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header nx-email-modal-head border-0"><h5 class="modal-title text-white" id="smCreateTitle">Yeni</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><input class="form-control" id="smCreateName" placeholder="Dosya veya klasör adı"></div>
            <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button><button class="btn btn-primary" id="smCreateSaveBtn">Oluştur</button></div>
        </div>
    </div>
</div>

<input type="file" id="smUploadInput" class="d-none">
{% endblock %}

{% block scripts %}
<script src="/assets/js/system-monitor.js"></script>
{% endblock %}

