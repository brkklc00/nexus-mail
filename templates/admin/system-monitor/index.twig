        '<strong class="text-danger">TÜM LOGLAR TEMİZLENECEK!</strong><br>Bu işlem geri alınamaz. Emin misiniz?',
        () => clearLog('all')
    );
}

function clearLog(type, worker = null) {
    const formData = new FormData();
    formData.append('type', type);
    if (worker) formData.append('worker', worker);
    
    fetch('/admin/system-monitor/clear-logs', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotify(data.message, 'success');
            loadStats(); // Refresh
        } else {
            showNotify(data.message, 'error');
        }
    })
    .catch(error => {
        showNotify('Hata: ' + error.message, 'error');
    });
}

function viewWorkerLog(workerName) {
    document.getElementById('log-worker-name').textContent = workerName;
    document.getElementById('log-viewer-content').innerHTML = '<div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Yükleniyor...</div>';
    
    $('#logViewerModal').modal('show');
    
    fetch(`/admin/system-monitor/worker-log/${workerName}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                let html = '';
                
                if (Object.keys(data.logs).length === 0) {
                    html = '<div class="alert alert-info">Bu worker için log dosyası bulunamadı</div>';
                } else {
                    Object.keys(data.logs).forEach(logFile => {
                        const logContent = data.logs[logFile];
                        html += `
                            <div class="mb-3">
                                <h6 class="font-weight-bold text-primary">
                                    <i class="fas fa-file"></i> ${logFile}
                                </h6>
                                <pre class="bg-dark text-white p-3" style="font-size: 12px; max-height: 400px; overflow-y: auto;">${escapeHtml(logContent)}</pre>
                            </div>
                        `;
                    });
                }
                
                document.getElementById('log-viewer-content').innerHTML = html;
            } else {
                document.getElementById('log-viewer-content').innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
            }
        })
        .catch(error => {
            document.getElementById('log-viewer-content').innerHTML = `<div class="alert alert-danger">Hata: ${error.message}</div>`;
        });
}

function downloadWorkerLog(workerName) {
    window.location.href = `/admin/system-monitor/download-worker-log/${workerName}`;
}

function createDatabaseBackup(event) {
    const btn = event ? event.target : null;
    
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Yedekleniyor...';
    }
    
    console.log('Database backup başlatılıyor...');
    
    fetch('/admin/system-monitor/backup/database', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => {
        console.log('Response status:', response.status);
        return response.text();
    })
    .then(text => {
        console.log('Response text:', text);
        try {
            const data = JSON.parse(text);
            if (data.success) {
                showNotify(
                    `<strong>${data.message}</strong><br><small>Dosya: ${data.file}<br>Boyut: ${data.size}</small>`,
                    'success'
                );
                loadBackups();
            } else {
                showNotify('<strong>Hata!</strong><br>' + data.message, 'error');
            }
        } catch (e) {
            console.error('JSON Parse hatası:', e);
            console.error('Response:', text);
            showNotify('<strong>Sunucu Hatası!</strong><br>JSON yanıt alınamadı. Lütfen console\'u kontrol edin.', 'error');
        }
    })
    .catch(error => {
        console.error('Fetch hatası:', error);
        showNotify('<strong>Bağlantı Hatası!</strong><br>' + error.message, 'error');
    })
    .finally(() => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Veritabanı Yedekle';
        }
    });
}

function createFileBackup(event) {
    const btn = event ? event.target : null;
    
    showConfirm(
        'Dosyalar yedeklenecek. Bu işlem dosya boyutuna bağlı olarak uzun sürebilir.<br>Devam edilsin mi?',
        () => {
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Yedekleniyor...';
            }
            
            fetch('/admin/system-monitor/backup/files', {
                method: 'POST'
            })
            .then(response => response.text())
            .then(text => {
                try {
                    const data = JSON.parse(text);
                    if (data.success) {
                        showNotify(
                            `${data.message}<br><small>Dosya: ${data.file}<br>Boyut: ${data.size}</small>`,
                            'success'
                        );
                        loadBackups();
                    } else {
                        showNotify(data.message, 'error');
                    }
                } catch (e) {
                    console.error('Response:', text);
                    showNotify('Sunucu hatası. Lütfen izinlerinizi kontrol edin ve tekrar giriş yapın.', 'error');
                }
            })
            .catch(error => {
                showNotify('Hata: ' + error.message, 'error');
            })
            .finally(() => {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-save"></i> Dosyaları Yedekle';
                }
            });
        }
    );
}

function downloadBackup(type, fileName) {
    window.location.href = `/admin/system-monitor/download-backup?type=${type}&file=${encodeURIComponent(fileName)}`;
}

function restoreDatabaseBackup(fileName) {
    showConfirm(
        `<strong class="text-danger">DİKKAT!</strong><br>
        <strong>${fileName}</strong> yedek dosyası geri yüklenecek.<br>
        <strong class="text-danger">Mevcut veritabanı tamamen silinecek!</strong><br>
        Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?`,
        () => {
            const formData = new FormData();
            formData.append('file', fileName);
            
            // Loading göster
            showNotify('<i class="fas fa-spinner fa-spin"></i> Veritabanı geri yükleniyor...<br><small>Bu işlem birkaç dakika sürebilir, lütfen bekleyin...</small>', 'info');
            
            fetch('/admin/system-monitor/restore-database', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotify('<strong>Başarılı!</strong><br>' + data.message + '<br><small>Sayfa 3 saniye içinde yenilenecek...</small>', 'success');
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    showNotify('<strong>Hata!</strong><br>' + data.message, 'error');
                }
            })
            .catch(error => {
                showNotify('<strong>Hata!</strong><br>' + error.message, 'error');
            });
        }
    );
}

function deleteBackup(type, fileName) {
    showConfirm(
        `<strong>${fileName}</strong> dosyası silinecek.<br>Bu işlem geri alınamaz. Emin misiniz?`,
        () => {
            const formData = new FormData();
            formData.append('type', type);
            formData.append('file', fileName);
            
            fetch('/admin/system-monitor/delete-backup', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotify(data.message, 'success');
                    loadBackups();
                } else {
                    showNotify(data.message, 'error');
                }
            })
            .catch(error => {
                showNotify('Hata: ' + error.message, 'error');
            });
        }
    );
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Sayfa kapatıldığında interval'i temizle
window.addEventListener('beforeunload', function() {
    if (refreshInterval) {
        clearInterval(refreshInterval);
    }
});
</script>
{% endblock %}

