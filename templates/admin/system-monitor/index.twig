{% extends "_layouts/main.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-server"></i> Sunucu Yönetim Paneli
        </h1>
        <button id="refreshBtn" class="btn btn-primary btn-sm">
            <i class="fas fa-sync-alt"></i> Yenile
        </button>
    </div>

    <!-- Sunucu İstatistikleri -->
    <div class="row">
        <!-- CPU -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                CPU Kullanımı
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="cpu-usage">--%</div>
                            <div class="text-xs text-gray-600 mt-1" id="cpu-cores">- çekirdek</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-microchip fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RAM -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                RAM Kullanımı
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="ram-usage">--%</div>
                            <div class="text-xs text-gray-600 mt-1" id="ram-info">- / -</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-memory fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Disk -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Disk Kullanımı
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="disk-usage">--%</div>
                            <div class="text-xs text-gray-600 mt-1" id="disk-info">- / -</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-hdd fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Veritabanı -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Veritabanı Boyutu
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="db-size">--</div>
                            <div class="text-xs text-gray-600 mt-1" id="db-tables">- tablo</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-database fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sistem Bilgileri (Yatay) -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-info-circle"></i> Sistem Bilgileri
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="text-center p-3 border-right">
                                <small class="text-gray-600 d-block mb-2">Server Uptime</small>
                                <div class="h5 mb-0 font-weight-bold text-primary" id="server-uptime">--</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border-right">
                                <small class="text-gray-600 d-block mb-2">Load Average (1/5/15)</small>
                                <div class="h5 mb-0 font-weight-bold text-success" id="load-average">-- / -- / --</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border-right">
                                <small class="text-gray-600 d-block mb-2">DB Bağlantıları</small>
                                <div class="h5 mb-0 font-weight-bold text-info" id="db-connections">--</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3">
                                <small class="text-gray-600 d-block mb-2">Disk I/O</small>
                                <div class="h6 mb-0 font-weight-bold">
                                    <span class="text-success" id="disk-reads">--</span> / 
                                    <span class="text-danger" id="disk-writes">--</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Log Yönetimi -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-file-alt"></i> Log Yönetimi
                    </h6>
                    <div>
                        <button class="btn btn-warning btn-sm mr-2" onclick="clearAppLogs()">
                            <i class="fas fa-broom"></i> Uygulama Logları
                        </button>
                        <button class="btn btn-danger btn-sm" onclick="clearAllLogs()">
                            <i class="fas fa-trash"></i> Tüm Logları Temizle
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> 
                                <strong>Toplam Log Boyutu:</strong> <span id="total-log-size" class="font-weight-bold">--</span>
                            </div>
                        </div>
                    </div>
                    
                    <h6 class="font-weight-bold text-primary mb-3">Worker Logları:</h6>
                    <div id="worker-logs-list" class="row">
                        <div class="col-12 text-center">
                            <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Network Stats -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-network-wired"></i> Network İstatistikleri
                    </h6>
                </div>
                <div class="card-body">
                    <div id="network-stats" class="row">
                        <div class="col-12 text-center">
                            <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dosya Yöneticisi & Kod Editörü -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-folder-open"></i> Dosya Yöneticisi & Kod Editörü
                    </h6>
                </div>
                <div class="card-body">
                    <!-- Breadcrumb Navigation -->
                    <nav aria-label="breadcrumb" class="mb-3">
                        <ol class="breadcrumb mb-0" id="breadcrumb-nav" style="background-color: #f8f9fa;">
                            <li class="breadcrumb-item"><a href="#" onclick="loadFiles(''); return false;"><i class="fas fa-home"></i> Ana Dizin</a></li>
                        </ol>
                    </nav>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                                </div>
                                <input type="text" class="form-control" id="file-search" placeholder="Dosya ara..." onkeyup="filterFiles(this.value)">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" onclick="document.getElementById('file-search').value=''; filterFiles('');" title="Temizle">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 text-right">
                            <button class="btn btn-outline-secondary btn-sm" onclick="goUpDirectory()" title="Üst Dizin">
                                <i class="fas fa-level-up-alt"></i> Üst Dizin
                            </button>
                            <button class="btn btn-success btn-sm" onclick="showCreateModal('file')">
                                <i class="fas fa-file-medical"></i> Yeni Dosya
                            </button>
                            <button class="btn btn-info btn-sm" onclick="showCreateModal('dir')">
                                <i class="fas fa-folder-plus"></i> Yeni Klasör
                            </button>
                        </div>
                    </div>

                    <div id="file-browser" class="table-responsive" style="max-height: 500px; overflow-y: auto; border: 1px solid #e3e6f0; border-radius: 5px;">
                        <div class="text-center py-4">
                            <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Yedekleme Yönetimi -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-database"></i> Yedekleme Yönetimi
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card border-left-success h-100">
                                <div class="card-body">
                                    <h6 class="font-weight-bold text-success mb-3">
                                        <i class="fas fa-database"></i> Veritabanı Yedekleme
                                    </h6>
                                    <p class="text-sm text-muted mb-3">
                                        Tüm veritabanını yedekler (sıkıştırılmış SQL formatında)
                                    </p>
                                    <button class="btn btn-success btn-block" onclick="createDatabaseBackup(event)">
                                        <i class="fas fa-save"></i> Veritabanı Yedekle
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-left-info h-100">
                                <div class="card-body">
                                    <h6 class="font-weight-bold text-info mb-3">
                                        <i class="fas fa-folder"></i> Dosya Yedekleme
                                    </h6>
                                    <p class="text-sm text-muted mb-3">
                                        Yüklenen dosyaları ve medya içeriklerini yedekler
                                    </p>
                                    <button class="btn btn-info btn-block" onclick="createFileBackup(event)">
                                        <i class="fas fa-save"></i> Dosyaları Yedekle
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Yedek Geçmişi -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-history"></i> Yedek Geçmişi
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs mb-3" id="backupTabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="db-backups-tab" href="#db-backups">
                                <i class="fas fa-database"></i> Veritabanı Yedekleri
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="file-backups-tab" href="#file-backups">
                                <i class="fas fa-folder"></i> Dosya Yedekleri
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="db-backups">
                            <div id="database-backups-list">
                                <div class="text-center text-muted py-3">
                                    <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="file-backups">
                            <div id="file-backups-list">
                                <div class="text-center text-muted py-3">
                                    <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Worker Log Görüntüleyici -->
<div class="modal fade" id="logViewerModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-file-alt"></i> Worker Logları: <span id="log-worker-name"></span>
                </h5>
                <button type="button" class="btn-close" aria-label="Kapat" onclick="closeModal(this)" style="background: transparent; border: none; font-size: 1.8rem; font-weight: 700; line-height: 1; color: #fff; opacity: 1; cursor: pointer; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="log-viewer-content" style="max-height: 500px; overflow-y: auto;">
                    <div class="text-center py-3">
                        <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal(this)">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Kod Editörü -->
<div class="modal fade" id="codeEditorModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document" style="max-width: 95%;">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="fas fa-code"></i> Kod Editörü: <span id="editor-file-name"></span>
                    <span class="badge badge-info ml-2" id="editor-file-ext"></span>
                </h5>
                <button type="button" class="btn-close" aria-label="Kapat" onclick="closeModal(this)" style="background: transparent; border: none; font-size: 1.8rem; font-weight: 700; line-height: 1; color: #fff; opacity: 1; cursor: pointer; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3 bg-light border-bottom">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> 
                                Boyut: <span id="editor-file-size" class="font-weight-bold"></span> | 
                                Değiştirilme: <span id="editor-file-modified" class="font-weight-bold"></span>
                            </small>
                        </div>
                        <div class="col-md-6 text-right">
                            <small class="text-muted">
                                <i class="fas fa-keyboard"></i> 
                                <span id="editor-line-count">0</span> satır | 
                                <span id="editor-char-count">0</span> karakter
                            </small>
                        </div>
                    </div>
                </div>
                <div id="ace-editor" style="width: 100%; height: 600px;"></div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" onclick="closeModal(this)">
                    <i class="fas fa-times"></i> İptal
                </button>
                <button type="button" class="btn btn-success" onclick="saveFileContent(event)">
                    <i class="fas fa-save"></i> Kaydet (Ctrl+S)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Ace Editor CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.5/ace.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.5/ext-language_tools.js"></script>

<!-- Modal: Dosya/Klasör Oluştur -->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="create-modal-title">
                    <i class="fas fa-file-medical"></i> Yeni Dosya
                </h5>
                <button type="button" class="btn-close" aria-label="Kapat" onclick="closeModal(this)" style="background: transparent; border: none; font-size: 1.8rem; font-weight: 700; line-height: 1; color: #fff; opacity: 1; cursor: pointer; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Dosya/Klasör Adı</label>
                    <input type="text" class="form-control" id="create-name" placeholder="örn: config.php veya yeni-klasor">
                </div>
                <input type="hidden" id="create-type" value="file">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal(this)">İptal</button>
                <button type="button" class="btn btn-primary" onclick="createFileOrFolder()">
                    <i class="fas fa-plus"></i> Oluştur
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Onay İsteği -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning"></i> Onay Gerekli
                </h5>
                <button type="button" class="btn-close" aria-label="Kapat" onclick="closeModal(this)" style="background: transparent; border: none; font-size: 1.8rem; font-weight: 700; line-height: 1; color: #fff; opacity: 1; cursor: pointer; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="confirm-message"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal(this)">İptal</button>
                <button type="button" class="btn btn-danger" id="confirm-btn" onclick="executeConfirmedAction()">
                    <i class="fas fa-check"></i> Onayla
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Bildirim/Sonuç -->
<div class="modal fade" id="notifyModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="notify-header">
                <h5 class="modal-title" id="notify-title">
                    <i class="fas fa-info-circle"></i> Bilgi
                </h5>
                <button type="button" class="btn-close" aria-label="Kapat" onclick="closeModal(this)" style="background: transparent; border: none; font-size: 1.8rem; font-weight: 700; line-height: 1; color: #fff; opacity: 1; cursor: pointer; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="notify-message"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal(this)">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
let refreshInterval;

// Modal kapatma helper fonksiyonu
function closeModal(btn) {
    const modal = $(btn).closest('.modal');
    modal.modal('hide');
    
    // Backdrop'u da temizle
    setTimeout(() => {
        $('.modal-backdrop').remove();
        $('body').removeClass('modal-open').css('padding-right', '');
    }, 300);
}

function loadStats() {
    fetch('/admin/system-monitor/stats')
        .then(response => response.json())
        .then(data => {
            updateServerStats(data.server);
            updateDatabaseStats(data.database);
            updateDiskStats(data.disk);
            updateNetworkStats(data.network);
            updateLogStats(data.logs);
        })
        .catch(error => {
            console.error('Stats yüklenirken hata:', error);
        });
}

function loadBackups() {
    fetch('/admin/system-monitor/backups')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                updateBackupsList('database', data.backups.database);
                updateBackupsList('files', data.backups.files);
            }
        })
        .catch(error => {
            console.error('Yedekler yüklenirken hata:', error);
        });
}

function updateBackupsList(type, backups) {
    const listId = type === 'database' ? 'database-backups-list' : 'file-backups-list';
    const list = document.getElementById(listId);
    
    if (!backups || backups.length === 0) {
        list.innerHTML = '<div class="text-center text-muted py-3"><i class="fas fa-inbox"></i> Henüz yedek bulunmuyor</div>';
        return;
    }
    
    let html = '<div class="table-responsive"><table class="table table-sm table-hover">';
    html += '<thead><tr><th>Dosya Adı</th><th>Boyut</th><th>Tarih</th><th>İşlemler</th></tr></thead><tbody>';
    
    backups.forEach(backup => {
        html += `
            <tr>
                <td><i class="fas fa-file-archive"></i> ${backup.name}</td>
                <td>${backup.size}</td>
                <td>${backup.date}</td>
                <td>
                    <div class="btn-group btn-group-sm">
        `;
        
        // Database yedekleri için geri yükleme butonu ekle
        if (type === 'database') {
            html += `
                        <button class="btn btn-outline-success" onclick="restoreDatabaseBackup('${backup.name}')" title="Geri Yükle">
                            <i class="fas fa-undo"></i>
                        </button>
            `;
        }
        
        html += `
                        <button class="btn btn-outline-primary" onclick="downloadBackup('${type}', '${backup.name}')" title="İndir">
                            <i class="fas fa-download"></i>
                        </button>
                        <button class="btn btn-outline-danger" onclick="deleteBackup('${type}', '${backup.name}')" title="Sil">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    });
    
    html += '</tbody></table></div>';
    list.innerHTML = html;
}

function updateServerStats(server) {
    // CPU
    document.getElementById('cpu-usage').textContent = server.cpu.usage + '%';
    document.getElementById('cpu-cores').textContent = server.cpu.cores + ' çekirdek';
    
    // RAM
    document.getElementById('ram-usage').textContent = server.memory.usage_percent + '%';
    document.getElementById('ram-info').textContent = server.memory.used + ' / ' + server.memory.total;
    
    // Uptime
    document.getElementById('server-uptime').textContent = server.uptime.formatted;
    
    // Load Average
    document.getElementById('load-average').textContent = 
        server.cpu.load['1min'] + ' / ' + 
        server.cpu.load['5min'] + ' / ' + 
        server.cpu.load['15min'];
}

