// Modal Helper Functions
function showNotify(message, type = 'info') {
    const modal = $('#notifyModal');
    const header = modal.find('#notify-header');
    const title = modal.find('#notify-title');
    
    // Renk ve ikon ayarla
    header.removeClass('bg-success bg-danger bg-warning bg-info');
    
    if (type === 'success') {
        header.addClass('bg-success text-white');
        title.html('<i class="fas fa-check-circle"></i> Başarılı');
    } else if (type === 'error') {
        header.addClass('bg-danger text-white');
        title.html('<i class="fas fa-times-circle"></i> Hata');
    } else if (type === 'warning') {
        header.addClass('bg-warning text-white');
        title.html('<i class="fas fa-exclamation-triangle"></i> Uyarı');
    } else {
        header.addClass('bg-info text-white');
        title.html('<i class="fas fa-info-circle"></i> Bilgi');
    }
    
    modal.find('#notify-message').html(message);
    modal.modal('show');
}

let confirmedAction = null;

function showConfirm(message, callback) {
    $('#confirm-message').html(message);
    confirmedAction = callback;
    $('#confirmModal').modal('show');
}

function executeConfirmedAction() {
    if (confirmedAction) {
        confirmedAction();
        confirmedAction = null;
    }
    $('#confirmModal').modal('hide');
}

// Dosya Yöneticisi Fonksiyonları
let currentPath = '';
let currentEditingFile = '';
let aceEditor = null;
let allFiles = []; // Arama için tüm dosyaları tut

function loadFiles(path) {
    currentPath = path;
    
    // Breadcrumb güncelle
    updateBreadcrumb(path);
    
    fetch(`/admin/system-monitor/files?path=${encodeURIComponent(path)}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                allFiles = data.items; // Global'e kaydet
                displayFiles(data.items);
            } else {
                showNotify(data.message, 'error');
            }
        })
        .catch(error => {
            showNotify('Dosyalar yüklenirken hata: ' + error.message, 'error');
        });
}

function updateBreadcrumb(path) {
    const breadcrumb = document.getElementById('breadcrumb-nav');
    let html = '<li class="breadcrumb-item"><a href="#" onclick="loadFiles(\'\'); return false;"><i class="fas fa-home"></i> Ana Dizin</a></li>';
    
    if (path) {
        const parts = path.split('/').filter(p => p);
        let currentPath = '';
        
        parts.forEach((part, index) => {
            currentPath += (currentPath ? '/' : '') + part;
            const isLast = index === parts.length - 1;
            
            if (isLast) {
                html += `<li class="breadcrumb-item active" aria-current="page">${part}</li>`;
            } else {
                const pathToLoad = currentPath;
                html += `<li class="breadcrumb-item"><a href="#" onclick="loadFiles('${pathToLoad}'); return false;">${part}</a></li>`;
            }
        });
    }
    
    breadcrumb.innerHTML = html;
}

function filterFiles(searchTerm) {
    if (!searchTerm || searchTerm.trim() === '') {
        displayFiles(allFiles);
        return;
    }
    
    const filtered = allFiles.filter(item => 
        item.name.toLowerCase().includes(searchTerm.toLowerCase())
    );
    
    displayFiles(filtered);
}

function displayFiles(items) {
    const browser = document.getElementById('file-browser');
    
    if (items.length === 0) {
        browser.innerHTML = '<div class="text-center text-muted py-4"><i class="fas fa-inbox"></i> Dosya bulunamadı</div>';
        return;
    }
    
    let html = '<table class="table table-sm table-hover mb-0">';
    html += '<thead class="bg-light"><tr><th width="40%">İsim</th><th width="15%">Boyut</th><th width="20%">Değiştirilme</th><th width="25%">İşlemler</th></tr></thead><tbody>';
    
    items.forEach(item => {
        const icon = item.is_dir ? 'fa-folder text-warning' : getFileIcon(item.extension);
        const clickAction = item.is_dir ? `loadFiles('${item.path}')` : `openFile('${item.path}')`;
        const rowClass = item.is_dir ? 'table-active' : '';
        
        html += `
            <tr class="${rowClass}" data-filename="${item.name.toLowerCase()}">
                <td style="cursor: pointer;" onclick="${clickAction}">
                    <i class="fas ${icon}"></i> <strong>${item.name}</strong>
                </td>
                <td class="text-muted">${item.is_dir ? '<i class="fas fa-folder-open"></i> Klasör' : item.size_formatted}</td>
                <td class="text-muted">${item.modified}</td>
                <td>
                    <div class="btn-group btn-group-sm">
        `;
        
        if (!item.is_dir) {
            html += `
                <button class="btn btn-outline-primary" onclick="openFile('${item.path}')" title="Düzenle">
                    <i class="fas fa-edit"></i> Düzenle
                </button>
            `;
        }
        
        html += `
                        <button class="btn btn-outline-warning" onclick="renameFilePrompt('${item.path}', '${item.name}')" title="Yeniden Adlandır">
                            <i class="fas fa-signature"></i>
                        </button>
                        <button class="btn btn-outline-danger" onclick="deleteFilePrompt('${item.path}', '${item.name}')" title="Sil">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    });
    
    html += '</tbody></table>';
    browser.innerHTML = html;
}

function getFileIcon(extension) {
    const icons = {
        'php': 'fa-file-code text-primary',
        'js': 'fa-file-code text-warning',
        'css': 'fa-file-code text-info',
        'html': 'fa-file-code text-danger',
        'json': 'fa-file-code text-success',
        'xml': 'fa-file-code text-muted',
        'yml': 'fa-file-code text-secondary',
        'yaml': 'fa-file-code text-secondary',
        'sql': 'fa-database text-primary',
        'env': 'fa-cog text-danger',
        'txt': 'fa-file-alt text-muted',
        'md': 'fa-file-alt text-info',
        'log': 'fa-file-alt text-warning',
        'jpg': 'fa-file-image text-success',
        'jpeg': 'fa-file-image text-success',
        'png': 'fa-file-image text-success',
        'gif': 'fa-file-image text-success',
        'pdf': 'fa-file-pdf text-danger',
        'zip': 'fa-file-archive text-warning',
        'tar': 'fa-file-archive text-warning',
        'gz': 'fa-file-archive text-warning',
    };
    
    return icons[extension] || 'fa-file text-muted';
}

function goUpDirectory() {
    if (!currentPath) return;
    
    const parts = currentPath.split('/').filter(p => p);
    parts.pop();
    const newPath = parts.join('/');
    loadFiles(newPath);
}

function openFile(path) {
    currentEditingFile = path;
    const fileName = path.split('/').pop();
    const extension = fileName.split('.').pop().toLowerCase();
    
    document.getElementById('editor-file-name').textContent = fileName;
    document.getElementById('editor-file-ext').textContent = '.' + extension;
    
    // Ace Editor'ı initialize et (henüz yoksa)
    if (!aceEditor) {
        aceEditor = ace.edit("ace-editor");
        aceEditor.setTheme("ace/theme/monokai");
        aceEditor.setOptions({
            enableBasicAutocompletion: true,
            enableLiveAutocompletion: true,
            fontSize: "14px",
            showPrintMargin: false,
            enableSnippets: true
        });
        
        // Ctrl+S ile kaydet
        aceEditor.commands.addCommand({
            name: 'save',
            bindKey: {win: 'Ctrl-S', mac: 'Command-S'},
            exec: function(editor) {
                saveFileContent();
            }
        });
    }
    
    aceEditor.setValue('// Yükleniyor...', -1);
    
    $('#codeEditorModal').modal('show');
    
    fetch(`/admin/system-monitor/file?path=${encodeURIComponent(path)}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Syntax mode'u ayarla
                const mode = getAceMode(extension);
                aceEditor.session.setMode(mode);
                
                // İçeriği yükle
                aceEditor.setValue(data.content, -1);
                aceEditor.clearSelection();
                
                // Meta bilgileri güncelle
                document.getElementById('editor-file-size').textContent = data.size;
                document.getElementById('editor-file-modified').textContent = data.modified;
                
                // Satır ve karakter sayısı
                updateEditorStats();
                aceEditor.session.on('change', updateEditorStats);
                
                // Focus
                aceEditor.focus();
            } else {
                showNotify(data.message, 'error');
                $('#codeEditorModal').modal('hide');
            }
        })
        .catch(error => {
            showNotify('Dosya yüklenirken hata: ' + error.message, 'error');
            $('#codeEditorModal').modal('hide');
        });
}

function getAceMode(extension) {
    const modes = {
        'php': 'ace/mode/php',
        'js': 'ace/mode/javascript',
        'json': 'ace/mode/json',
        'css': 'ace/mode/css',
        'scss': 'ace/mode/scss',
        'html': 'ace/mode/html',
        'xml': 'ace/mode/xml',
        'sql': 'ace/mode/sql',
        'md': 'ace/mode/markdown',
        'yml': 'ace/mode/yaml',
        'yaml': 'ace/mode/yaml',
        'sh': 'ace/mode/sh',
        'txt': 'ace/mode/text',
        'log': 'ace/mode/text',
        'env': 'ace/mode/sh',
        'twig': 'ace/mode/twig'
    };
    
    return modes[extension] || 'ace/mode/text';
}

function updateEditorStats() {
    if (aceEditor) {
        const lineCount = aceEditor.session.getLength();
        const content = aceEditor.getValue();
        const charCount = content.length;
        
        document.getElementById('editor-line-count').textContent = lineCount;
        document.getElementById('editor-char-count').textContent = charCount;
    }
}

function saveFileContent(event) {
    const content = aceEditor ? aceEditor.getValue() : document.getElementById('code-editor').value;
    const btn = event ? event.target : document.querySelector('#codeEditorModal .btn-success');
    
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';
    }
    
    const formData = new FormData();
    formData.append('path', currentEditingFile);
    formData.append('content', content);
    
    fetch('/admin/system-monitor/file/save', {
        method: 'POST',
        body: formData
    })
    .then(response => {
        return response.text().then(text => {
            try {
                const data = JSON.parse(text);
                return { success: response.ok, data: data };
            } catch (e) {
                console.error('Response is not JSON:', text);
                throw new Error('Sunucu hatası: JSON yanıt bekleniyordu ancak HTML döndü.');
            }
        });
    })
    .then(result => {
        const data = result.data;
        if (data.success) {
            showNotify('<strong>Kaydedildi!</strong><br>' + data.message + '<br><small>Yeni boyut: ' + data.size + '</small>', 'success');
            
            // Stats güncelle
            updateEditorStats();
            
            setTimeout(() => {
                $('#codeEditorModal').modal('hide');
                loadFiles(currentPath);
            }, 1000);
        } else {
            showNotify('<strong>Hata!</strong><br>' + data.message, 'error');
        }
    })
    .catch(error => {
        console.error('Save error:', error);
        showNotify('<strong>Kaydetme Hatası!</strong><br>' + error.message, 'error');
    })
    .finally(() => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Kaydet (Ctrl+S)';
        }
    });
}

function showCreateModal(type) {
    document.getElementById('create-type').value = type;
    document.getElementById('create-name').value = '';
    
    const title = type === 'file' ? 'Yeni Dosya' : 'Yeni Klasör';
    const icon = type === 'file' ? 'fa-file-medical' : 'fa-folder-plus';
    
    document.getElementById('create-modal-title').innerHTML = `<i class="fas ${icon}"></i> ${title}`;
    $('#createModal').modal('show');
}

function createFileOrFolder() {
    const name = document.getElementById('create-name').value.trim();
    const type = document.getElementById('create-type').value;
    
    if (!name) {
        showNotify('Lütfen bir isim girin', 'warning');
        return;
    }
    
    const formData = new FormData();
    formData.append('path', currentPath);
    formData.append('name', name);
    formData.append('type', type);
    
    fetch('/admin/system-monitor/file/create', {
        method: 'POST',
        body: formData
    })
    .then(response => response.text())
    .then(text => {
        try {
            const data = JSON.parse(text);
            if (data.success) {
                showNotify(data.message, 'success');
                $('#createModal').modal('hide');
                loadFiles(currentPath);
            } else {
                showNotify(data.message, 'error');
            }
        } catch (e) {
            console.error('Response:', text);
            showNotify('Sunucu hatası. Lütfen izinlerinizi kontrol edin.', 'error');
        }
    })
    .catch(error => {
        showNotify('Oluşturma hatası: ' + error.message, 'error');
    });
}

function deleteFilePrompt(path, name) {
    showConfirm(
        `<strong>${name}</strong> silinecek. Bu işlem geri alınamaz!<br><small class="text-muted">Yol: ${path}</small>`,
