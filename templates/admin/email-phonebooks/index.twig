{% extends "_layouts/main.twig" %}

{% block title %}Tüm Email Rehberleri - Admin - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
<li class="breadcrumb-item">Email</li>
<li class="breadcrumb-item active">Tüm Rehberler</li>
{% endblock %}

{% block page_icon %}<i data-feather="book" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Tüm Email Rehberleri{% endblock %}

{% block content %}
<div class="container-fluid">

    <!-- İstatistikler -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="bg-primary-subtle rounded p-3">
                                <i data-feather="book" class="align-self-center icon-md text-primary"></i>
                            </div>
                        </div>
                        <div class="col">
                            <p class="text-muted mb-0 fw-semibold">Toplam Rehber</p>
                            <h3 class="m-0 text-dark">{{ stats.total|number_format }}</h3>
                            <p class="mb-0 text-truncate text-muted">Sistemde</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="bg-success-subtle rounded p-3">
                                <i data-feather="mail" class="align-self-center icon-md text-success"></i>
                            </div>
                        </div>
                        <div class="col">
                            <p class="text-muted mb-0 fw-semibold">Toplam Email</p>
                            <h3 class="m-0 text-dark">{{ stats.total_emails|number_format }}</h3>
                            <p class="mb-0 text-truncate text-muted">Mail Adresi</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="bg-info-subtle rounded p-3">
                                <i data-feather="users" class="align-self-center icon-md text-info"></i>
                            </div>
                        </div>
                        <div class="col">
                            <p class="text-muted mb-0 fw-semibold">Aktif Kullanıcı</p>
                            <h3 class="m-0 text-dark">{{ stats.active_users }}</h3>
                            <p class="mb-0 text-truncate text-muted">Rehber Sahibi</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Rehber Listesi -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="card-title mb-0">
                                <i data-feather="book-open" class="align-self-center icon-xs me-2"></i>
                                Tüm Email Rehberleri
                            </h4>
                            <small class="text-muted">Toplam {{ total }} rehber</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filtreler -->
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i data-feather="search" class="icon-xs"></i>
                                </span>
                                <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Rehber ara..." value="{{ search }}" onkeyup="handleSearch()">
                            </div>
                        </div>
                        <div class="col-md-5">
                            <select class="form-select" id="userFilter" onchange="applyFilters()">
                                <option value="">Tüm Kullanıcılar</option>
                                {% for user in users %}
                                <option value="{{ user.id }}" {{ selected_user == user.id ? 'selected' : '' }}>
                                    {{ user.name }} ({{ user.email }})
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-secondary w-100" onclick="clearFilters()">
                                <i data-feather="x" class="icon-xs me-1"></i>
                                Temizle
                            </button>
                        </div>
                    </div>

                    {% if phonebooks is empty %}
                    <div class="text-center py-5">
                        <i data-feather="inbox" style="width: 64px; height: 64px;" class="text-muted"></i>
                        <h5 class="mt-3 text-muted">Rehber bulunamadı</h5>
                        <p class="text-muted">Henüz email rehberi oluşturulmamış</p>
                    </div>
                    {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>
                                        <i data-feather="tag" class="icon-xs me-1"></i>
                                        Rehber Adı
                                    </th>
                                    <th>
                                        <i data-feather="user" class="icon-xs me-1"></i>
                                        Kullanıcı
                                    </th>
                                    <th>
                                        <i data-feather="mail" class="icon-xs me-1"></i>
                                        Email Sayısı
                                    </th>
                                    <th>
                                        <i data-feather="calendar" class="icon-xs me-1"></i>
                                        Oluşturulma
                                    </th>
                                    <th class="text-end">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for phonebook in phonebooks %}
                                <tr>
                                    <td>{{ phonebook.id }}</td>
                                    <td><strong>{{ phonebook.title }}</strong></td>
                                    <td>
                                        <div>
                                            {{ phonebook.user.name }}
                                            <br>
                                            <small class="text-muted">{{ phonebook.user.email }}</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-soft-primary text-primary">
                                            {{ phonebook.totalContacts|number_format }} mail
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            {{ phonebook.createdAt|date('d.m.Y H:i') }}
                                        </small>
                                    </td>
                                    <td class="text-end" style="position: relative;">
                                        <a href="/email-phonebooks/{{ phonebook.id }}" class="btn btn-sm btn-soft-primary" title="Görüntüle">
                                            <i data-feather="eye" class="icon-xs"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-soft-success" onclick="showDownloadModal({{ phonebook.id }}, '{{ phonebook.title }}', {{ phonebook.totalContacts }})" title="İndir">
                                            <i data-feather="download" class="icon-xs"></i>
                                        </button>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    {% if total_pages > 1 %}
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            {% if page > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page - 1 }}&search={{ search }}&user_id={{ selected_user }}">
                                    <i data-feather="chevron-left" class="icon-xs"></i>
                                    Önceki
                                </a>
                            </li>
                            {% endif %}
                            
                            {% for p in 1..total_pages %}
                                {% if p == 1 or p == total_pages or (p >= page - 2 and p <= page + 2) %}
                                <li class="page-item {{ p == page ? 'active' : '' }}">
                                    <a class="page-link" href="?page={{ p }}&search={{ search }}&user_id={{ selected_user }}">{{ p }}</a>
                                </li>
                                {% elseif p == page - 3 or p == page + 3 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                                {% endif %}
                            {% endfor %}
                            
                            {% if page < total_pages %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page + 1 }}&search={{ search }}&user_id={{ selected_user }}">
                                    Sonraki
                                    <i data-feather="chevron-right" class="icon-xs"></i>
                                </a>
                            </li>
                            {% endif %}
                        </ul>
                    </nav>
                    {% endif %}

                    <div class="text-center text-muted mt-3">
                        <small>Toplam {{ total }} rehber bulundu (Sayfa {{ page }}/{{ total_pages }})</small>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Rehber İndirme Modal -->
<div class="modal fade" id="downloadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i data-feather="download" class="icon-xs me-2"></i>
                    Rehber İndir
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i data-feather="book" class="icon-xxl text-primary"></i>
                    </div>
                    <h5 id="downloadPhonebookName" class="text-primary"></h5>
                    <p class="text-muted mb-0">
                        <strong id="downloadPhonebookCount"></strong> mail adresi içeren rehberi indirin
                    </p>
                </div>
                
                <div class="d-grid gap-2">
                    <a id="downloadCsvLink" class="btn btn-outline-primary" href="#">
                        <i data-feather="file-text" class="icon-xs me-2"></i>
                        CSV Format (.csv)
                        <small class="d-block text-muted">Excel ile uyumlu, UTF-8</small>
                    </a>
                    <a id="downloadExcelLink" class="btn btn-outline-success" href="#">
                        <i data-feather="file" class="icon-xs me-2"></i>
                        Excel Format (.xlsx)
                        <small class="d-block text-muted">Microsoft Excel</small>
                    </a>
                    <a id="downloadTxtLink" class="btn btn-outline-secondary" href="#">
                        <i data-feather="align-left" class="icon-xs me-2"></i>
                        TXT Format (.txt)
                        <small class="d-block text-muted">Sadece mail adresleri</small>
                    </a>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i data-feather="x" class="icon-xs me-1"></i>
                    Kapat
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let searchTimer;

function handleSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
        applyFilters();
    }, 500);
}

function applyFilters() {
    const search = document.getElementById('searchInput').value;
    const userId = document.getElementById('userFilter').value;
    
    let url = '/admin/email-phonebooks?';
    const params = [];
    
    if (search) {
        params.push(`search=${encodeURIComponent(search)}`);
    }
    if (userId) {
        params.push(`user_id=${userId}`);
    }
    
    window.location.href = url + params.join('&');
}

function clearFilters() {
    window.location.href = '/admin/email-phonebooks';
}

// İndirme modal fonksiyonu
function showDownloadModal(id, title, count) {
    document.getElementById('downloadPhonebookName').textContent = title;
    document.getElementById('downloadPhonebookCount').textContent = count + ' mail';
    
    // Linkleri güncelle (admin rotası - tüm rehberler indirilebilir)
    document.getElementById('downloadCsvLink').href = `/admin/email-phonebooks/${id}/download?format=csv`;
    document.getElementById('downloadExcelLink').href = `/admin/email-phonebooks/${id}/download?format=excel`;
    document.getElementById('downloadTxtLink').href = `/admin/email-phonebooks/${id}/download?format=txt`;
    
    const modal = new bootstrap.Modal(document.getElementById('downloadModal'));
    modal.show();
    
    setTimeout(() => feather.replace(), 100);
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
});
</script>
{% endblock %}
