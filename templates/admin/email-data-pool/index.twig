async function parseApiResponse(response, fallbackMessage) {
    const contentType = String(response.headers.get('content-type') || '').toLowerCase();
    if (contentType.includes('application/json')) {
        return await response.json().catch(() => ({}));
    }

    const rawText = await response.text().catch(() => '');
    const compact = rawText.replace(/\s+/g, ' ').trim();
    if (!compact) {
        return { success: false, message: fallbackMessage };
    }
    if (compact.startsWith('<')) {
        return { success: false, message: fallbackMessage };
    }
    return { success: false, message: compact.slice(0, 220) };
}

function resolveHttpErrorMessage(status, backendMessage, fallbackMessage, contentType = '') {
    if (backendMessage) {
        return backendMessage;
    }
    if (!String(contentType).includes('application/json')) {
        return 'Sunucudan JSON yerine farklı bir yanıt döndü. Oturum süresi dolmuş olabilir.';
    }
    if (status === 401 || status === 403) {
        return 'Oturum veya yetki hatası. Lütfen tekrar giriş yapın.';
    }
    if (status === 404) {
        return 'İlgili endpoint bulunamadı.';
    }
    if (status === 405) {
        return 'HTTP method hatası (405).';
    }
    if (status === 419) {
        return 'Güvenlik doğrulaması (CSRF) başarısız. Sayfayı yenileyin.';
    }
    if (status === 422) {
        return 'Geçersiz işlem parametresi.';
    }
    if (status >= 500) {
        return 'Sunucu hatası oluştu.';
    }
    return fallbackMessage || 'İşlem başarısız oldu.';
}

async function poolFetch(url, options = {}, fallbackMessage = 'İşlem başarısız oldu.') {
    const headers = Object.assign({
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
    }, options.headers || {});
    const response = await fetch(url, Object.assign({}, options, { headers, credentials: 'same-origin' }));
    const contentType = String(response.headers.get('content-type') || '').toLowerCase();
    const data = await parseApiResponse(response, fallbackMessage);
    if (!response.ok || data.success === false) {
        const message = resolveHttpErrorMessage(response.status, data.message, fallbackMessage, contentType);
        console.error('[poolFetch]', {
            url,
            status: response.status,
            contentType,
            response: data
        });
        const error = new Error(message);
        error.status = response.status;
        error.payload = data;
        throw error;
    }
    return data;
}

