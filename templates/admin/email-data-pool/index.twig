{% extends "_layouts/main.twig" %}

{% block title %}Mail Havuzu - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
<li class="breadcrumb-item">Email</li>
<li class="breadcrumb-item active">Mail Havuzu</li>
{% endblock %}

{% block page_icon %}<i data-feather="database" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Mail Havuzu{% endblock %}

{% block styles %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
    :root {
        --nx-surface: #f8fafc;
        --nx-card: #ffffff;
        --nx-border: #e2e8f0;
        --nx-muted: #64748b;
        --nx-title: #0f172a;
        --nx-shadow-sm: 0 6px 18px rgba(15, 23, 42, 0.06);
        --nx-shadow-md: 0 14px 32px rgba(15, 23, 42, 0.09);
    }

    #loadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        background: rgba(26, 32, 44, 0.75);
        backdrop-filter: blur(6px);
    }
    #loadingOverlay.is-visible {
        display: flex !important;
    }
    .pool-list-group .list-group-item.active {
        background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
        border-color: transparent;
        color: #fff;
    }
    .pool-list-group .list-group-item {
        border-left: 0;
        border-right: 0;
        border-top: 0;
        padding: 12px 14px;
        position: relative;
        user-select: none;
    }
    .pool-list-group .list-group-item.draggable-item {
        cursor: grab;
    }
    .pool-list-group .list-group-item.draggable-item:active {
        cursor: grabbing;
    }
    .pool-list-group .list-group-item.drag-over {
        box-shadow: inset 0 -2px 0 #2563eb;
        background: #eff6ff;
    }
    .pool-list-drag-handle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        color: #94a3b8;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        flex: 0 0 auto;
    }
    .pool-list-group .list-group-item.active .pool-list-drag-handle {
        color: rgba(255, 255, 255, 0.88);
        border-color: rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.12);
    }
    .pool-list-item-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }
    .pool-list-item-name {
        font-weight: 600;
        max-width: 190px;
    }
    .pool-list-item-meta {
        margin-top: 6px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }
    .pool-list-item-count {
        font-size: 0.75rem;
        color: #64748b;
    }
    .pool-list-item-badges {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .pool-mini-badge {
        font-size: 0.67rem;
        padding: 0.26rem 0.4rem;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        color: #334155;
        background: #f8fafc;
    }
    .pool-mini-badge.badge-danger {
        color: #b91c1c;
        border-color: #fecaca;
        background: #fef2f2;
    }
    .pool-mini-badge.badge-warning {
        color: #b45309;
        border-color: #fed7aa;
        background: #fff7ed;
    }
    .pool-list-group .list-group-item.active .pool-list-item-count {
        color: rgba(255, 255, 255, 0.85);
    }
    .pool-list-group .list-group-item.active .pool-mini-badge {
        border-color: rgba(255, 255, 255, 0.35);
        color: #fff;
        background: rgba(255, 255, 255, 0.16);
    }
    .pool-list-group .list-group-item.active .badge {
        background: rgba(255, 255, 255, 0.2) !important;
        color: #fff !important;
    }
    .left-pool-list-card {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 180px);
        min-height: 620px;
    }
    .left-pool-list-search {
        flex: 0 0 auto;
    }
    .left-pool-list-body {
        flex: 1 1 auto;
        overflow-y: auto;
        min-height: 0;
    }
    .left-pool-list-footer {
        flex: 0 0 auto;
    }
    .pool-list-empty-state {
        min-height: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: #94a3b8;
        font-size: 0.83rem;
    }
    .cleaner-analysis-meta {
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 12px;
        color: #475569;
        font-size: 0.82rem;
        padding: 8px 10px;
    }
    .tools-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 22px;
        align-items: stretch;
    }
    .pool-ops-tabs {
        border-bottom: 1px solid #dbe4f1;
        padding-bottom: 10px;
        margin-bottom: 14px;
    }
    .pool-ops-tabs .nav-link {
        border: 1px solid transparent;
        border-radius: 12px;
        color: #1f3b67;
        font-weight: 600;
        padding: 9px 14px;
        background: #f8fafc;
        transition: all .15s ease;
    }
    .pool-ops-tabs .nav-link.active {
        color: #fff;
        background: linear-gradient(135deg, #10203d 0%, #1e3a70 100%);
        border-color: #1e3a70;
        box-shadow: 0 6px 14px rgba(15, 23, 42, 0.16);
    }
    .pool-ops-tabs .nav-link:not(.active):hover {
        border-color: #c6d5ea;
        background: #f8fbff;
        transform: translateY(-1px);
    }
    .job-status-badge {
        border-radius: 999px;
        padding: 0.2rem 0.55rem;
        font-weight: 600;
        font-size: 0.72rem;
        text-transform: lowercase;
        letter-spacing: .2px;
    }
    .ops-pane-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #fff;
        box-shadow: var(--nx-shadow-sm);
    }
    .ops-pane-card .card-body {
        padding: 16px 18px;
    }
    .job-history-table th,
    .job-history-table td {
        font-size: 0.8rem;
        vertical-align: middle;
        white-space: nowrap;
    }
    .tool-card {
        border: 1px solid var(--nx-border);
        border-radius: 20px;
        overflow: hidden;
        height: 100%;
        background: var(--nx-card);
        box-shadow: var(--nx-shadow-sm);
        transition: box-shadow .2s ease, transform .2s ease;
    }
    .tool-card:hover {
        box-shadow: var(--nx-shadow-md);
        transform: translateY(-1px);
    }
    .tool-card .card-header {
        background: linear-gradient(135deg, #10203d 0%, #1e3a70 100%);
        color: #fff;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        padding: 14px 18px !important;
    }
    .tool-card .card-header .tool-icon-wrap {
        width: 28px;
        height: 28px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.32);
        background: rgba(255, 255, 255, 0.08);
    }
    .tool-card .card-body {
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        padding: 16px 18px 18px !important;
    }
    .cleaner-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }
    .cleaner-action-section {
        border: 1px solid var(--nx-border);
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        border-radius: 14px;
        padding: 12px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
    .cleaner-action-title {
        font-size: 0.76rem;
        letter-spacing: .02em;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 8px;
        font-weight: 700;
    }
    .cleaner-action-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
    }
    .cleaner-actions .btn {
        min-height: 44px;
        height: auto;
        border-radius: 12px;
        font-weight: 600;
        white-space: normal;
        text-align: left;
        line-height: 1.2;
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 6px;
        padding: 10px 12px;
        opacity: 1 !important;
        transition: all .18s ease;
    }
    .cleaner-actions .btn i {
        flex: 0 0 auto;
    }
    .btn-cleaner-analyze {
        background: linear-gradient(135deg, #0f2a4d 0%, #2563eb 100%);
        color: #fff;
        border: none;
    }
    .btn-cleaner-export {
        background: #f0f7ff;
        color: #1e40af;
        border: 1px solid #c7ddff;
    }
    .btn-cleaner-delete {
        background: #fff4f5;
        color: #e11d48;
        border: 1px solid #fecdd3;
    }
    .btn-cleaner-fix {
        background: #fff9f1;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }
    .btn-cleaner-dup {
        background: #f0fdff;
        color: #0891b2;
        border: 1px solid #a5f3fc;
    }
    .cleaner-actions .btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.1);
    }
    .cleaner-actions .btn:disabled {
        opacity: 0.52 !important;
        filter: grayscale(12%);
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }
    #cleanerProgressWrap {
        background: linear-gradient(180deg, #f8fbff 0%, #f1f5f9 100%);
        border: 1px solid var(--nx-border);
        border-radius: 12px;
        padding: 10px 12px;
    }
    .cleaner-progress {
        height: 8px;
        background: #e2e8f0;
    }
    .cleaner-kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }
    .cleaner-kpi-item {
        min-width: 0;
        min-height: 92px;
        padding: 16px;
        border-radius: 14px;
        border: 1px solid var(--nx-border);
        background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }
    .cleaner-kpi-item .label {
        color: #64748b;
        line-height: 1.25;
        white-space: normal;
        word-break: normal;
        margin-bottom: 8px;
        font-size: 0.8rem;
    }
    .cleaner-kpi-item .value {
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        overflow-wrap: anywhere;
    }
    .cleaner-kpi-gmail .value { color: #059669; }
    .cleaner-kpi-non .value { color: #dc2626; }
    .cleaner-kpi-typo .value { color: #d97706; }
    .cleaner-kpi-dup .value { color: #2563eb; }
    .cleaner-preview-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }
    .cleaner-preview-box {
        border: 1px solid var(--nx-border);
        border-radius: 14px;
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
        min-height: 110px;
        padding: 12px;
        display: flex;
        flex-direction: column;
    }
    .cleaner-preview-title {
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }
    .cleaner-preview-content {
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 12px;
        color: #334155;
        flex: 1;
        max-height: 140px;
        overflow: auto;
    }
    .cleaner-preview-empty {
        margin: auto;
        text-align: center;
        color: #94a3b8;
        font-size: 0.82rem;
    }
    .section-card {
        background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
        border: 1px solid var(--nx-border);
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    }
    .section-card h6 {
        font-weight: 700;
        color: var(--nx-title);
    }
    .section-card .form-control,
    .section-card .form-select {
        height: 42px;
        border-radius: 10px;
    }
    .section-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .section-actions .btn {
        height: 42px;
        border-radius: 12px;
        font-weight: 600;
        min-width: 108px;
    }
    .section-actions .btn:disabled {
        opacity: 0.55 !important;
    }
    .target-badges .badge {
        font-weight: 600;
    }
    .balance-preview-summary {
        border: 1px dashed #bfd2eb;
        border-radius: 12px;
        padding: 10px 12px;
        font-size: 0.82rem;
        color: #334155;
        background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
    }
    .stats-card .card-body {
        min-height: 96px;
        border-radius: 14px;
        background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
        border: 1px solid var(--nx-border);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
    }
    .stats-card .stats-icon {
        width: 36px;
        height: 36px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #1d4ed8;
    }
    .stats-card .card-body p {
        white-space: normal;
        word-break: normal;
    }
    .stats-card h4,
    .stats-card h5,
    .stats-card h6 {
        white-space: nowrap;
        word-break: normal;
        font-variant-numeric: tabular-nums;
    }
    @media (max-width: 991.98px) {
        .left-pool-list-card {
            height: auto;
            min-height: 0;
            max-height: none;
        }
        .left-pool-list-body {
            max-height: 360px;
        }
        .cleaner-actions {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .cleaner-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .cleaner-preview-grid {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 575.98px) {
        .cleaner-actions {
            grid-template-columns: 1fr;
        }
        .cleaner-kpi-grid {
            grid-template-columns: 1fr;
        }
        .cleaner-kpi-item .value {
            font-size: 1.2rem;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>
        {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    {% if error %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i data-feather="alert-circle" class="align-self-center icon-xs me-2"></i>
        {{ error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    {% if current_list_id is null %}
    <div class="alert alert-warning">Havuz listesi bulunamadı. Veritabanı migration’ını çalıştırın (<code>email_data_pool_lists</code>).</div>
    {% else %}
    {% set inactive_count = passive_count|default(total - active_count) %}
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="card h-100 left-pool-list-card">
                <div class="card-header border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">Havuz listeleri</h5>
                            <small class="text-muted">{{ list_total|default(pool_lists|length) }} liste · Tümü <strong>{{ total_all_pools_entries|default(0)|number_format }}</strong> kayıt</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#newListModal" title="Yeni liste">
                            <i data-feather="plus" class="icon-xs"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body border-bottom py-2 left-pool-list-search">
                    <input
                        type="text"
                        id="poolListSearch"
                        class="form-control form-control-sm"
                        placeholder="Liste ara..."
                        value="{{ list_search|default('') }}"
                        autocomplete="off">
                </div>
                <div class="list-group list-group-flush pool-list-group left-pool-list-body">
                    {% for pl in pool_lists %}
                    <a href="/admin/email-data-pool?list_id={{ pl.id }}{% if list_search %}&list_search={{ list_search|url_encode }}{% endif %}"
                       class="list-group-item list-group-item-action draggable-item {% if pl.id == current_list_id %}active{% endif %}"
                       data-list-id="{{ pl.id }}"
                       data-list-name="{{ pl.name|e('html_attr') }}"
                       draggable="true">
                        <div class="pool-list-item-top">
                            <span class="d-flex align-items-center gap-2 min-w-0">
                                <span class="pool-list-drag-handle" title="Sürükle bırak ile sırala">
                                    <i data-feather="menu" class="icon-xs"></i>
                                </span>
                                <span class="pool-list-item-name text-truncate" title="{{ pl.name }}">{{ pl.name }}</span>
                            </span>
                            <span class="badge {% if pl.id == current_list_id %}bg-white text-primary{% else %}bg-soft-secondary text-secondary{% endif %} rounded-pill">{{ pl.entry_count|number_format }}</span>
                        </div>
                        <div class="pool-list-item-meta">
                            <span class="pool-list-item-count">Aktif {{ pl.active_count|number_format }}</span>
                            <span class="pool-list-item-badges">
                                {% if pl.analysis_status == 'completed' and pl.gmail_ratio is not null %}
                                    <span class="pool-mini-badge">Gmail %{{ pl.gmail_ratio|number_format(1, '.', ',') }}</span>
                                {% endif %}
                                {% if pl.invalid_gmail_count|default(0) > 0 %}
                                    <span class="pool-mini-badge badge-warning">Hatalı {{ pl.invalid_gmail_count|number_format }}</span>
                                {% endif %}
                                {% if pl.duplicate_count|default(0) > 0 %}
                                    <span class="pool-mini-badge badge-danger">Dup {{ pl.duplicate_count|number_format }}</span>
                                {% endif %}
                            </span>
                        </div>
                    </a>
                    {% else %}
                    <div class="list-group-item pool-list-empty-state border-0">
                        <i data-feather="inbox" class="icon-sm"></i>
                        <span>Eşleşen liste bulunamadı.</span>
                    </div>
                    {% endfor %}
                </div>
                <div class="card-body border-top pt-3 left-pool-list-footer">
                    <button type="button" class="btn btn-sm btn-soft-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#editListModal">
                        <i data-feather="edit-2" class="icon-xs me-1"></i> Listeyi düzenle
                    </button>
                    <form method="post" action="/admin/email-data-pool/lists/{{ current_list_id }}/delete" class="mb-0" onsubmit="return confirm('Bu listeyi silmek istediğinize emin misiniz? (Liste boş olmalıdır.)');">
                        <button type="submit" class="btn btn-sm btn-soft-danger w-100">
                            <i data-feather="trash-2" class="icon-xs me-1"></i> Listeyi sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="card">
                <div class="card-header border-bottom py-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1 min-w-0">
                            <h5 class="card-title mb-1 text-truncate" title="{{ current_list_name|default('') }}">{{ current_list_name|default('Liste') }}</h5>
                            <p class="text-muted mb-0 small">Bu listedeki adresler tabloda önizlenmez; dışa aktarma ile tam listeyi alın. <strong>Mail çıkar</strong> ile yalnızca bu listeyi veya <em>tüm listeleri</em> hedefleyebilirsiniz.</p>
                        </div>
                        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                                <i data-feather="plus" class="icon-xs me-1"></i> Mail ekle
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#removeModal">
                                <i data-feather="minus" class="icon-xs me-1"></i> Mail çıkar
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-4">
                    {% if total < 1 %}
                    <div class="text-center py-5 px-2">
                        <div class="avatar-lg mx-auto mb-3">
                            <span class="avatar-title rounded-circle bg-soft-primary text-primary" style="width: 80px; height: 80px;">
                                <i data-feather="inbox" style="width: 36px; height: 36px;"></i>
                            </span>
                        </div>
                        <h5 class="text-muted mb-2">Bu listede henüz kayıt yok</h5>
                        <p class="text-muted small mb-4">Manuel veya dosyadan toplu ekleme yapabilirsiniz.</p>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                            <i data-feather="plus" class="icon-xs me-1"></i> Mail ekle
                        </button>
                    </div>
                    {% else %}
                    <div class="row g-3 mb-4" id="topStatsGrid">
                        <div class="col-sm-6 col-xl-4">
                            <div class="card stats-card mb-0 h-100">
                                <div class="card-body">
                                    <p class="text-muted mb-1 small d-flex align-items-center gap-2"><span class="stats-icon"><i data-feather="database" class="icon-xs"></i></span>Toplam Kayıt</p>
                                    <h4 class="mb-0" id="statTopTotal">{{ total|number_format }}</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xl-4">
                            <div class="card stats-card mb-0 h-100 border border-success-subtle">
                                <div class="card-body">
