function filterPoolListItems(term) {
    const query = String(term || '').trim().toLowerCase();
    const items = Array.from(document.querySelectorAll('.pool-list-group .draggable-item'));
    items.forEach(item => {
        const name = String(item.dataset.listName || '').toLowerCase();
        const matched = query === '' || name.includes(query);
        item.style.display = matched ? '' : 'none';
    });
}

async function persistPoolListOrder() {
    const items = Array.from(document.querySelectorAll('.pool-list-group .draggable-item'));
    const order = items
        .map(item => Number(item.dataset.listId || 0))
        .filter(id => Number.isFinite(id) && id > 0);
    if (!order.length) return;

    const body = new URLSearchParams();
    body.set('_csrf', CLEANER_CSRF_TOKEN);
    body.set('order', JSON.stringify(order));

    await poolFetch('/admin/email-data-pool/lists/reorder', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-CSRF-Token': CLEANER_CSRF_TOKEN
        },
        body
    }, 'Liste sıralaması güncellenemedi.');
}

function initPoolListDnD() {
    const listWrap = document.querySelector('.pool-list-group.left-pool-list-body');
    if (!listWrap) return;

    let dragEl = null;

    listWrap.querySelectorAll('.draggable-item').forEach(item => {
        item.addEventListener('dragstart', e => {
            dragEl = item;
            item.classList.add('opacity-75');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', String(item.dataset.listId || ''));
        });

        item.addEventListener('dragover', e => {
            e.preventDefault();
            if (!dragEl || dragEl === item) return;
            item.classList.add('drag-over');
            const rect = item.getBoundingClientRect();
            const before = e.clientY < rect.top + rect.height / 2;
            if (before) {
                listWrap.insertBefore(dragEl, item);
            } else {
                listWrap.insertBefore(dragEl, item.nextSibling);
            }
        });

        item.addEventListener('dragleave', () => {
            item.classList.remove('drag-over');
        });

        item.addEventListener('drop', e => {
            e.preventDefault();
            item.classList.remove('drag-over');
        });

        item.addEventListener('dragend', async () => {
            item.classList.remove('opacity-75');
            listWrap.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
            if (!dragEl) return;
            dragEl = null;
            try {
                await persistPoolListOrder();
                showCleanerToast('success', 'Liste sıralaması güncellendi.');
            } catch (error) {
                showCleanerToast('error', error.message);
            }
        });
    });
}

