        const mode = document.getElementById('globalDedupMode')?.value || 'mark_duplicate';
        const priority = document.getElementById('globalPriorityListIds')?.value || '';
        const body = new URLSearchParams({
            _csrf: CLEANER_CSRF_TOKEN,
            strategy,
            mode,
            priority_list_ids: priority
        });
        const data = await poolFetch('/admin/email-data-pool/global-deduplicate/apply', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-CSRF-Token': CLEANER_CSRF_TOKEN
            },
            body
        }, 'Global temizlik başlatılamadı.');
        const jobId = Number(data?.data?.jobId || data?.job_id || 0);
        if (!jobId) throw new Error(data.message || 'Temizlik job id alınamadı.');
        const done = await waitForGlobalJob(jobId, 'Global mükerrer temizliği çalışıyor...');
