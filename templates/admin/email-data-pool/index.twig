function handleRemoveFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;

    const statusDiv = document.getElementById('removeFileStatus');
    statusDiv.innerHTML = '<div class="alert alert-info">Dosya okunuyor...</div>';

    const fileExt = file.name.split('.').pop().toLowerCase();

    if (fileExt === 'txt' || fileExt === 'csv') {
        readRemoveTextFile(file, fileExt);
    } else if (fileExt === 'xlsx' || fileExt === 'xls') {
        readRemoveExcelFile(file);
    } else {
        statusDiv.innerHTML = '<div class="alert alert-danger">Desteklenmeyen dosya formatı</div>';
    }
}

function readRemoveTextFile(file, type) {
    const reader = new FileReader();
    reader.onload = function(e) {
        const text = e.target.result;
        const lines = text.split('\n');
        
        let emails = [];
        
        // CSV ise header kontrolü yap
        if (type === 'csv' && lines.length > 0) {
            const headers = lines[0].split(/[,\t]/);
            const emailColumnIndex = headers.findIndex(h => 
                h.toLowerCase().includes('recipient') || 
                h.toLowerCase().includes('email')
            );
            
            if (emailColumnIndex !== -1) {
                // Header var, email kolonundan oku
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(/[,\t]/);
                    const email = cols[emailColumnIndex]?.trim();
                    if (email && email.includes('@')) {
                        emails.push(email);
                    }
                }
            } else {
                // Header yok veya bulunamadı, normal parse et
                lines.forEach(line => {
                    line = line.trim();
                    if (line && line.includes('@')) {
                        // Satırda @ varsa email ara
                        const parts = line.split(/[,\t]/);
                        parts.forEach(part => {
                            part = part.trim();
                            if (part && part.includes('@')) {
                                emails.push(part);
                            }
                        });
                    }
                });
            }
        } else {
            // TXT dosyası
            lines.forEach(line => {
                line = line.trim();
                if (line && line.includes('@')) {
                    emails.push(line);
                }
            });
        }

        // Benzersiz yap
        emails = [...new Set(emails)];

        document.getElementById('removeEmails').value = emails.join('\n');
        updateRemoveEmailCount();
        
        document.getElementById('removeFileStatus').innerHTML = `
            <div class="alert alert-success alert-dismissible fade show">
                <i data-feather="check-circle"></i> 
                <strong>Başarılı!</strong> ${emails.length.toLocaleString()} mail adresi yüklendi
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
        feather.replace();
    };
    reader.readAsText(file);
}

function readRemoveExcelFile(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });
            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const jsonData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });
            
            let emails = [];
            const headers = jsonData[0] || [];
            
            // RecipientAddress veya email kolonunu bul
            const emailColumnIndex = headers.findIndex(h => 
                (typeof h === 'string' && (
                    h.toLowerCase().includes('recipient') || 
                    h.toLowerCase().includes('email')
                ))
            );
            
            if (emailColumnIndex !== -1) {
                // Kolon bulundu, o kolondan oku
                for (let i = 1; i < jsonData.length; i++) {
                    const row = jsonData[i];
                    const email = row[emailColumnIndex];
                    if (email && typeof email === 'string' && email.includes('@')) {
                        emails.push(email.trim());
                    }
                }
            } else {
                // Kolon bulunamadı, tüm satırları tara
                for (let i = 1; i < jsonData.length; i++) {
                    const row = jsonData[i];
                    row.forEach(cell => {
                        if (cell && typeof cell === 'string' && cell.includes('@')) {
                            emails.push(cell.trim());
                        }
                    });
                }
            }
            
            // Benzersiz yap
            emails = [...new Set(emails)];
            
            document.getElementById('removeEmails').value = emails.join('\n');
            updateRemoveEmailCount();
            
            document.getElementById('removeFileStatus').innerHTML = `
                <div class="alert alert-success alert-dismissible fade show">
                    <i data-feather="check-circle"></i> 
                    <strong>Başarılı!</strong> ${emails.length.toLocaleString()} mail adresi yüklendi
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
        } catch (error) {
            document.getElementById('removeFileStatus').innerHTML = `
                <div class="alert alert-danger">
                    <i data-feather="x-circle"></i> Dosya okuma hatası: ${error.message}
                </div>`;
            feather.replace();
        }
    };
    reader.readAsArrayBuffer(file);
}

