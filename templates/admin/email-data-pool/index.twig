        if (!jobId) {
            throw new Error(result.message || 'İşlem kuyruğa alınamadı.');
        }
        showCleanerToast('info', result.message || 'Duplicate temizleme işlemi kuyruğa alındı.');
        await waitForBackgroundJob(jobId, 'Duplicate temizleme çalışıyor...');
        showCleanerToast('success', 'Duplicate temizleme işlemi tamamlandı.');
        await loadTopStats(false);
    } catch (error) {
