    const kpiGrid = document.getElementById('cleanerKpiGrid');
    const previewWrap = document.getElementById('cleanerPreviewWrap');
    if (!kpiGrid) return;

    const num = value => Number(value || 0).toLocaleString('tr-TR');
    const completed = cleanerState.analysisStatus === 'completed';
    const running = cleanerState.analysisStatus === 'running';
    const showLive = completed || running;
    document.getElementById('kpiTotal').textContent = showLive ? num(cleanerState.stats.total) : 'Henüz analiz yapılmadı';
    document.getElementById('kpiGmail').textContent = showLive ? num(cleanerState.stats.gmail_count) : '-';
    document.getElementById('kpiNonGmail').textContent = showLive ? num(cleanerState.stats.non_gmail_count) : '-';
    document.getElementById('kpiTypo').textContent = showLive ? num(cleanerState.stats.typo_gmail_count) : '-';
    document.getElementById('kpiDuplicate').textContent = completed ? num(cleanerState.stats.duplicate_count) : (running ? 'Hesaplanıyor...' : '-');
    document.getElementById('kpiDeletable').textContent = showLive ? num(cleanerState.stats.deletable_count) : '-';
    kpiGrid.classList.remove('d-none');
    const analysisMeta = document.getElementById('cleanerAnalysisMeta');
    if (analysisMeta) {
        if (running) {
            const percent = Number(cleanerState.stats.analysis_percent || cleanerState.stats.percent || 0);
            analysisMeta.textContent = `Liste analiz ediliyor... %${Math.max(0, Math.min(100, percent))}`;
        } else if (completed && cleanerState.stats.last_analyzed_at) {
            analysisMeta.textContent = `Son analiz: ${cleanerState.stats.last_analyzed_at}`;
        } else {
            analysisMeta.textContent = 'Henüz analiz yapılmadı.';
        }
    }

    const normalized = (cleanerState.stats.normalized_preview || [])
        .map(item => `${item.from} -> ${item.to}`)
        .join('\n');
    const nonGmail = (cleanerState.stats.non_gmail_preview || []).join('\n');
    document.getElementById('cleanerNormalizedPreview').textContent = normalized;
    document.getElementById('cleanerNonGmailPreview').textContent = nonGmail;
    document.getElementById('cleanerNormalizedEmpty')?.classList.toggle('d-none', normalized !== '');
    document.getElementById('cleanerNonGmailEmpty')?.classList.toggle('d-none', nonGmail !== '');
    if (previewWrap) previewWrap.classList.remove('d-none');
    updateCleanerActionAvailability(cleanerState.stats);
    feather.replace();
}

function updateCleanerActionAvailability(stats) {
    const analyzed = (stats.analysis_status || cleanerState.analysisStatus) === 'completed';
    const map = [
        { id: 'cleanerExportBtn', enabled: analyzed && Number(stats.non_gmail_count || 0) > 0, hint: 'Analiz sonrası Gmail dışı kayıt varsa aktif olur.' },
        { id: 'cleanerExportTypoBtn', enabled: analyzed && Number(stats.typo_gmail_count || 0) > 0, hint: 'Analiz sonrası hatalı Gmail kaydı varsa aktif olur.' },
        { id: 'cleanerExportFullBtn', enabled: CURRENT_POOL_LIST_ID > 0, hint: 'Liste seçildiğinde aktif olur.' },
        { id: 'cleanerDeleteNonGmailBtn', enabled: analyzed && Number(stats.non_gmail_count || 0) > 0, hint: 'Analiz sonrası Gmail dışı kayıt varsa aktif olur.' },
        { id: 'cleanerFixTyposBtn', enabled: analyzed && Number(stats.typo_gmail_count || 0) > 0, hint: 'Analiz sonrası hatalı Gmail kaydı varsa aktif olur.' },
        { id: 'cleanerRemoveDuplicatesBtn', enabled: analyzed && Number(stats.duplicate_count || 0) > 0, hint: 'Analiz sonrası duplicate varsa aktif olur.' }
    ];
    map.forEach(item => {
        const btn = document.getElementById(item.id);
        if (!btn) return;
        btn.disabled = !item.enabled;
        if (!item.enabled) {
            btn.title = item.hint;
        } else {
            btn.removeAttribute('title');
        }
    });
}

function stopAnalysisPolling() {
