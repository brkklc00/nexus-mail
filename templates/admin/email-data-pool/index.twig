function setCleanerButtonsDisabled(disabled) {
    document.querySelectorAll('.cleaner-action-btn, #confirmDeleteNonGmailBtn, #confirmFixTyposBtn, #confirmDuplicateCleanupBtn')
        .forEach(btn => {
