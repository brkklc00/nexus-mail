function summaryToText(summary) {
    const labels = {
        operation_type: 'İşlem tipi',
        source_list: 'Kaynak liste',
        target_list: 'Hedef liste',
        read_records: 'Okunan kayıt',
        added_records: 'Eklenen kayıt',
        moved_records: 'Taşınan kayıt',
        deleted_records: 'Silinen kayıt',
        duplicate_skipped: 'Duplicate atlanan',
        non_gmail_skipped: 'Gmail dışı atlanan',
        typo_fixed: 'Hatalı Gmail düzeltilen',
