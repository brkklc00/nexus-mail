<script>
const CURRENT_POOL_LIST_ID = {{ current_list_id|default(0) }};
const CLEANER_CSRF_TOKEN = '{{ cleaner_csrf|default('')|e('js') }}';
function appendPoolListToForm(form) {
    if (!CURRENT_POOL_LIST_ID) return;
    const h = document.createElement('input');
    h.type = 'hidden';
    h.name = 'pool_list_id';
    h.value = String(CURRENT_POOL_LIST_ID);
    form.appendChild(h);
}

let emailsTextarea = null;

function updateEmailCount() {
    const textarea = document.getElementById('emails');
    const lines = textarea.value.split('\n').filter(line => line.trim() !== '');
    document.getElementById('emailCount').textContent = `${lines.length} mail`;
}

function handleFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;

    const statusDiv = document.getElementById('fileStatus');
    statusDiv.innerHTML = '<div class="alert alert-info">Dosya okunuyor...</div>';

    const fileExt = file.name.split('.').pop().toLowerCase();

    if (fileExt === 'txt' || fileExt === 'csv') {
        readTextFile(file, fileExt);
    } else if (fileExt === 'xlsx' || fileExt === 'xls') {
        readExcelFile(file);
    } else {
        statusDiv.innerHTML = '<div class="alert alert-danger">Desteklenmeyen dosya formatı</div>';
    }
}

function normalizeHeaderName(header) {
    return String(header || '')
        .replace(/^\uFEFF/, '')
        .trim()
        .toLowerCase()
        .replace(/["']/g, '')
        .replace(/[-_\s]/g, '');
}

function detectDelimiterFromText(text) {
    const lines = String(text || '').split(/\r?\n/).filter(l => l.trim() !== '').slice(0, 5);
    if (!lines.length) return ',';
    const candidates = [',', ';', '\t'];
    let best = ',';
    let bestScore = -1;
    for (const c of candidates) {
        let score = 0;
        for (const line of lines) {
            score += line.split(c).length;
        }
        if (score > bestScore) {
            best = c;
            bestScore = score;
        }
    }
    return best;
}

function parseCsvLine(line, delimiter) {
    const out = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
            if (inQuotes && line[i + 1] === '"') {
                cur += '"';
                i++;
            } else {
                inQuotes = !inQuotes;
            }
            continue;
        }
        if (ch === delimiter && !inQuotes) {
            out.push(cur);
            cur = '';
            continue;
        }
        cur += ch;
    }
    out.push(cur);
    return out.map(v => String(v || '').trim());
}

function detectHeaderMap(row) {
    const emailAliases = ['mailadresi', 'email', 'emailadresi', 'e-mail', 'mail', 'eposta', 'e-posta', 'epostaadresi', 'mailaddress', 'recipient', 'address'];
    const nameAliases = ['isim', 'name', 'ad', 'full_name', 'fullname'];
    const statusAliases = ['durum', 'status'];

    let emailIndex = null;
    let nameIndex = null;
    let statusIndex = null;
    let hasHeader = false;

    row.forEach((col, idx) => {
        const normalized = normalizeHeaderName(col);
        if (!normalized) return;
        if (emailIndex === null && emailAliases.map(normalizeHeaderName).includes(normalized)) {
            emailIndex = idx;
            hasHeader = true;
        } else if (nameIndex === null && nameAliases.map(normalizeHeaderName).includes(normalized)) {
            nameIndex = idx;
            hasHeader = true;
        } else if (statusIndex === null && statusAliases.map(normalizeHeaderName).includes(normalized)) {
            statusIndex = idx;
            hasHeader = true;
        }
    });

    return { hasHeader, emailIndex, nameIndex, statusIndex };
}

function isPassiveStatus(value) {
    const status = String(value || '').trim().toLowerCase();
    const passive = ['pasif', 'passive', 'inactive', 'deleted', 'silindi', 'invalid', 'geçersiz', 'gecersiz', '0'];
    return passive.includes(status);
}

function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || '').trim().toLowerCase());
}

function parseRowsToImport(rows, requireHeaderEmailColumn = false) {
    const stats = {
        totalRows: 0,
        validEmail: 0,
        duplicateSkipped: 0,
        invalidSkipped: 0,
        statusSkipped: 0
    };

    if (!rows.length) {
        throw new Error('Dosya boş.');
    }

    const map = detectHeaderMap(rows[0] || []);
    if (map.hasHeader && requireHeaderEmailColumn && map.emailIndex === null) {
        throw new Error('Mail kolonu bulunamadı. Lütfen Mail Adresi, email veya mail başlıklı kolon kullanın.');
    }

    const start = map.hasHeader ? 1 : 0;
    const seen = new Set();
    const records = [];

    for (let i = start; i < rows.length; i++) {
        const row = rows[i];
        if (!row || !row.length) continue;
        stats.totalRows++;

        let email = map.emailIndex !== null ? row[map.emailIndex] : '';
        let name = map.nameIndex !== null ? row[map.nameIndex] : '';
        const status = map.statusIndex !== null ? row[map.statusIndex] : '';

        if (!email) {
            const found = row.find(cell => String(cell || '').includes('@'));
            email = found || '';
        }

        email = String(email || '').trim().toLowerCase();
        name = String(name || '').trim();

        if (!isValidEmail(email)) {
            stats.invalidSkipped++;
            continue;
        }

        if (map.statusIndex !== null && isPassiveStatus(status)) {
            stats.statusSkipped++;
            continue;
        }

        if (seen.has(email)) {
            stats.duplicateSkipped++;
            continue;
        }
        seen.add(email);
        stats.validEmail++;

        records.push(name ? `${email},${name}` : email);
    }

    return { records, stats };
}

function readTextFile(file, type) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const text = String(e.target.result || '').replace(/^\uFEFF/, '');
            const delimiter = type === 'csv' ? detectDelimiterFromText(text) : ',';
            const lines = text.split(/\r?\n/).filter(l => l.trim() !== '');
            const rows = type === 'csv'
                ? lines.map(line => parseCsvLine(line, delimiter))
                : lines.map(line => [line]);

            const result = parseRowsToImport(rows, true);
            document.getElementById('emails').value = result.records.join('\n');
            updateEmailCount();

            document.getElementById('fileStatus').innerHTML = `
                <div class="alert alert-success alert-dismissible fade show">
                    <i data-feather="check-circle"></i>
                    <strong>Import özeti:</strong>
                    Toplam satır ${result.stats.totalRows.toLocaleString('tr-TR')},
                    Geçerli ${result.stats.validEmail.toLocaleString('tr-TR')},
                    Duplicate atlanan ${result.stats.duplicateSkipped.toLocaleString('tr-TR')},
                    Geçersiz atlanan ${result.stats.invalidSkipped.toLocaleString('tr-TR')},
                    Durum nedeniyle atlanan ${result.stats.statusSkipped.toLocaleString('tr-TR')}.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
            document.querySelector('[href="#manualTab"]').click();
        } catch (err) {
            document.getElementById('fileStatus').innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show">
                    <i data-feather="x-circle"></i>
                    ${err.message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
        }
    };
    reader.readAsText(file, 'UTF-8');
}

function readExcelFile(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = new Uint8Array(e.target.result);
