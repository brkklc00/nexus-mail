    document.getElementById('confirmFixTyposBtn')?.addEventListener('click', fixTyposConfirmed);
    document.getElementById('confirmDuplicateCleanupBtn')?.addEventListener('click', removeDuplicatesConfirmed);
    document.getElementById('balanceTargetLimitInput')?.addEventListener('change', () => loadTopStats(false));
    document.getElementById('statGotoNonGmailBtn')?.addEventListener('click', openDeleteNonGmailModal);
    document.getElementById('previewFillBtn')?.addEventListener('click', e => previewFill('list', e.currentTarget));
    document.getElementById('runFillBtn')?.addEventListener('click', e => runFill('list', e.currentTarget));
    document.getElementById('previewManualFillBtn')?.addEventListener('click', e => previewFill('manual', e.currentTarget));
    document.getElementById('runManualFillBtn')?.addEventListener('click', e => runFill('manual', e.currentTarget));
    document.getElementById('previewOverflowBtn')?.addEventListener('click', e => previewOverflow(e.currentTarget));
    document.getElementById('runOverflowBtn')?.addEventListener('click', e => runOverflow(e.currentTarget));
    document.getElementById('previewSplitBtn')?.addEventListener('click', e => previewSplit(e.currentTarget));
    document.getElementById('runSplitBtn')?.addEventListener('click', e => runSplit(e.currentTarget));
    document.getElementById('previewEqualizeBtn')?.addEventListener('click', e => previewEqualize(e.currentTarget));
    document.getElementById('runEqualizeBtn')?.addEventListener('click', e => runEqualize(e.currentTarget));
    document.getElementById('openBalanceHistoryBtn')?.addEventListener('click', () => activatePoolOpsTab('history'));
    document.querySelectorAll('#poolOpsTabNav [data-pool-tab]').forEach(btn => {
        btn.addEventListener('click', () => activatePoolOpsTab(btn.dataset.poolTab || 'overview'));
    });
    document.getElementById('globalAnalyzeAllBtn')?.addEventListener('click', runGlobalAnalyzeAll);
    document.getElementById('globalRefreshStatsBtn')?.addEventListener('click', runGlobalRefreshStats);
    document.getElementById('globalDedupPreviewBtn')?.addEventListener('click', runGlobalDedupPreview);
    document.getElementById('globalDedupApplyBtn')?.addEventListener('click', runGlobalDedupApply);
    document.getElementById('alibabaFetchBtn')?.addEventListener('click', () => startAlibabaJob('fetch', 'Alibaba invalid kayıtları çekiliyor...'));
    document.getElementById('alibabaPreviewBtn')?.addEventListener('click', () => startAlibabaJob('preview', 'Alibaba invalid eşleştirme önizlemesi çalışıyor...'));
    document.getElementById('alibabaCleanBtn')?.addEventListener('click', () => startAlibabaJob('clean', 'Alibaba invalid temizliği çalışıyor...'));
    document.getElementById('alibabaFetchCleanBtn')?.addEventListener('click', () => startAlibabaJob('fetch-clean', 'Alibaba fetch + clean çalışıyor...'));
    document.getElementById('refreshJobHistoryBtn')?.addEventListener('click', () => loadJobHistory());
    document.getElementById('listOpsRefreshStatusBtn')?.addEventListener('click', () => refreshListOpsJobStatus());
    document.getElementById('jobHistoryTypeFilter')?.addEventListener('change', () => loadJobHistory());
    document.getElementById('jobHistoryStatusFilter')?.addEventListener('change', () => loadJobHistory());
    document.getElementById('jobHistoryDateFilter')?.addEventListener('change', () => loadJobHistory());
    document.getElementById('jobHistoryListFilter')?.addEventListener('input', () => loadJobHistory());
    document.getElementById('globalDedupConfirmCheck')?.addEventListener('change', function () {
        const applyBtn = document.getElementById('globalDedupApplyBtn');
        if (!applyBtn) return;
        applyBtn.disabled = !this.checked;
    });
    document.getElementById('globalDedupStrategy')?.addEventListener('change', function () {
        const priorityInput = document.getElementById('globalPriorityListIds');
        if (!priorityInput) return;
        priorityInput.disabled = this.value !== 'keep_priority';
        if (priorityInput.disabled) priorityInput.value = '';
    });
    document.getElementById('alibabaMode')?.addEventListener('change', function () {
        const hardDeleteCheck = document.getElementById('alibabaHardDeleteConfirm');
        if (!hardDeleteCheck) return;
        if (this.value !== 'hard_delete') {
            hardDeleteCheck.checked = false;
        }
    });
    const priorityInput = document.getElementById('globalPriorityListIds');
    if (priorityInput) {
        priorityInput.disabled = true;
    }
    setBalanceButtonsDisabled(false);
    activatePoolOpsTab('overview');
    loadTopStats(false);
    refreshListOpsJobStatus();
});
</script>
{% endblock %}
