function alibabaFormPayload() {
    return {
        start_date: document.getElementById('alibabaStartDate')?.value || '',
        end_date: document.getElementById('alibabaEndDate')?.value || '',
        length: Number(document.getElementById('alibabaLength')?.value || 500),
        scope: document.getElementById('alibabaScope')?.value || 'all_lists',
        selected_pool_id: CURRENT_POOL_LIST_ID || 0,
        mode: document.getElementById('alibabaMode')?.value || 'mark_invalid',
        dry_run: document.getElementById('alibabaDryRun')?.checked ? 1 : 0,
        hard_delete_confirmed: document.getElementById('alibabaHardDeleteConfirm')?.checked ? 1 : 0
    };
}

function setAlibabaProgress(text, percentValue) {
    const wrap = document.getElementById('alibabaProgressWrap');
    const bar = document.getElementById('alibabaProgressBar');
    const label = document.getElementById('alibabaProgressText');
    const percent = document.getElementById('alibabaProgressPercent');
    if (!wrap || !bar || !label || !percent) return;
    const safe = Math.max(0, Math.min(100, Number(percentValue || 0)));
    wrap.classList.remove('d-none');
    label.textContent = text || 'Alibaba job çalışıyor...';
    percent.textContent = `${safe}%`;
    bar.style.width = `${safe}%`;
}

function hideAlibabaProgress() {
    const wrap = document.getElementById('alibabaProgressWrap');
    if (wrap) wrap.classList.add('d-none');
}

function renderAlibabaJobStatus(data) {
    document.getElementById('alibabaFetchedCount').textContent = Number(data?.fetched_count || data?.data?.fetchedCount || 0).toLocaleString('tr-TR');
    document.getElementById('alibabaMatchedCount').textContent = Number(data?.matched_count || data?.data?.matchedCount || 0).toLocaleString('tr-TR');
    document.getElementById('alibabaCleanedCount').textContent = Number(data?.cleaned_count || data?.data?.cleanedCount || 0).toLocaleString('tr-TR');
    document.getElementById('alibabaRetryCount').textContent = Number(data?.retry_count || data?.data?.retryCount || 0).toLocaleString('tr-TR');
    const summary = [
        `Job ID: ${Number(data?.job_id || data?.data?.jobId || 0) || '-'}`,
        `Durum: ${String(data?.status || data?.data?.status || 'queued')}`,
        `Tarih: ${(alibabaFormPayload().start_date || '-') } -> ${(alibabaFormPayload().end_date || '-')}`,
        `Sayfa: ${Number(data?.current_page || data?.data?.currentPage || 0)}`,
        `NextStart: ${String(data?.next_start || data?.data?.nextStart || '-')}`,
        `Hata: ${String(data?.error || '-')}`,
    ].join('\n');
    const statusEl = document.getElementById('alibabaLastStatusText');
    if (statusEl) statusEl.textContent = summary;
}

async function waitForAlibabaJob(jobId, label = 'Alibaba job çalışıyor...') {
    const safeJobId = Number(jobId || 0);
    if (!safeJobId) throw new Error('Geçersiz Alibaba job.');
    const startedAt = Date.now();
    const maxWaitMs = 90 * 60 * 1000;
    while (true) {
        const data = await poolFetch(jobStatusUrl(safeJobId), {}, 'Alibaba job durumu alınamadı.');
        setAlibabaProgress(label, Number(data.percent || data?.data?.percent || 0));
        renderAlibabaJobStatus(data);
        const status = String(data.status || data?.data?.status || 'queued');
        if (status === 'completed') return data;
        if (status === 'failed') throw new Error(data.error || data.message || 'Alibaba job başarısız.');
        if ((Date.now() - startedAt) > maxWaitMs) throw new Error('Alibaba job zaman aşımına uğradı.');
        await new Promise(resolve => setTimeout(resolve, 2500));
    }
}

async function loadAlibabaStatus() {
    try {
        const data = await poolFetch('/admin/email-data-pool/alibaba-invalid/status', {}, 'Alibaba durum bilgisi alınamadı.');
        const s = data?.data || {};
        document.getElementById('alibabaEndpoint').textContent = s.endpoint || 'https://dm.aliyuncs.com/';
        document.getElementById('alibabaAction').textContent = s.action || 'QueryInvalidAddress';
        document.getElementById('alibabaKeyStatus').textContent = s.accessKeyConfigured ? 'Evet' : 'Hayır';
        document.getElementById('alibabaSecretStatus').textContent = s.secretConfigured ? 'Evet' : 'Hayır';
        document.getElementById('alibabaMaskedKey').textContent = s.maskedAccessKeyId || '-';
        if (!document.getElementById('alibabaStartDate').value) {
            const today = new Date();
            const end = today.toISOString().slice(0, 10);
            const start = new Date(today.getTime() - (7 * 24 * 60 * 60 * 1000)).toISOString().slice(0, 10);
            document.getElementById('alibabaStartDate').value = start;
            document.getElementById('alibabaEndDate').value = end;
        }
    } catch (error) {
        showCleanerToast('error', error.message);
    }
}

async function startAlibabaJob(path, label) {
    const payload = alibabaFormPayload();
    if (!payload.start_date || !payload.end_date) {
        showCleanerToast('warning', 'Başlangıç ve bitiş tarihi zorunlu.');
        return;
    }
    if (payload.mode === 'hard_delete' && !payload.hard_delete_confirmed && path !== 'preview' && path !== 'fetch') {
        showCleanerToast('warning', 'Hard delete için onay kutusunu işaretleyin.');
        return;
    }
    const buttonMap = {
        fetch: 'alibabaFetchBtn',
        preview: 'alibabaPreviewBtn',
        clean: 'alibabaCleanBtn',
        'fetch-clean': 'alibabaFetchCleanBtn'
    };
    const btn = document.getElementById(buttonMap[path] || '');
    setButtonLoading(btn, true, 'Kuyruğa alınıyor...');
    try {
        const body = new URLSearchParams({ _csrf: CLEANER_CSRF_TOKEN });
        Object.entries(payload).forEach(([k, v]) => body.append(k, String(v)));
        const data = await poolFetch(`/admin/email-data-pool/alibaba-invalid/${path}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-CSRF-Token': CLEANER_CSRF_TOKEN
            },
            body
        }, 'Alibaba invalid job başlatılamadı.');
        const jobId = Number(data?.data?.jobId || data?.job_id || 0);
        if (!jobId) throw new Error(data.message || 'Job id alınamadı.');
        const done = await waitForAlibabaJob(jobId, label);
        const reportBtn = document.getElementById('alibabaLastReportBtn');
        const reportUrl = String(done?.result?.report_url || done?.result?.download_url || '');
        if (reportBtn && reportUrl) {
            reportBtn.href = reportUrl;
            reportBtn.classList.remove('disabled');
        }
        showCleanerToast('success', 'Alibaba invalid işlemi tamamlandı.');
        await loadTopStats(false);
        await loadJobHistory();
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        setButtonLoading(btn, false);
        hideAlibabaProgress();
    }
}

function renderListOpsJobStatus(job) {
    const statusBadge = document.getElementById('listOpsLastJobStatus');
    const jobIdEl = document.getElementById('listOpsLastJobId');
    const progressEl = document.getElementById('listOpsLastJobProgress');
    if (!statusBadge || !jobIdEl || !progressEl) return;
    const status = String(job?.status || 'idle');
    const badgeClass = status === 'completed' ? 'bg-success' : (status === 'failed' ? 'bg-danger' : (status === 'running' || status === 'queued' ? 'bg-primary' : 'bg-secondary'));
    statusBadge.className = `badge job-status-badge ${badgeClass}`;
    statusBadge.textContent = status;
    jobIdEl.textContent = String(job?.job_id || '-');
    progressEl.textContent = `${Number(job?.processed || 0).toLocaleString('tr-TR')} / ${Number(job?.total || 0).toLocaleString('tr-TR')}`;
}

async function refreshListOpsJobStatus() {
    if (!CURRENT_POOL_LIST_ID) return;
    try {
        const data = await poolFetch(`/admin/email-data-pool/jobs?per_page=1&pool_id=${encodeURIComponent(String(CURRENT_POOL_LIST_ID))}`, {}, 'Liste job durumu alınamadı.');
