function startCleanerProgress(text) {
    const wrap = document.getElementById('cleanerProgressWrap');
    const bar = document.getElementById('cleanerProgressBar');
    const percent = document.getElementById('cleanerProgressPercent');
    const label = document.getElementById('cleanerProgressText');
    if (!wrap || !bar || !percent || !label) return;
    label.textContent = text || 'İşlem sürüyor...';
    wrap.classList.remove('d-none');
    bar.style.width = '0%';
    percent.textContent = '0%';
    let value = 0;
    clearInterval(cleanerState.progressTimer);
    cleanerState.progressTimer = setInterval(() => {
        value = Math.min(92, value + 4);
        bar.style.width = `${value}%`;
        percent.textContent = `${value}%`;
    }, 120);
}

function finishCleanerProgress() {
    const wrap = document.getElementById('cleanerProgressWrap');
    const bar = document.getElementById('cleanerProgressBar');
    const percent = document.getElementById('cleanerProgressPercent');
    clearInterval(cleanerState.progressTimer);
    cleanerState.progressTimer = null;
    if (bar) bar.style.width = '100%';
    if (percent) percent.textContent = '100%';
    setTimeout(() => {
        if (wrap) wrap.classList.add('d-none');
        if (bar) bar.style.width = '0%';
        if (percent) percent.textContent = '0%';
    }, 350);
}

async function cleanerRequest(action, options = {}) {
    const method = options.method || 'GET';
    const headers = Object.assign({}, options.headers || {});
    if (method !== 'GET') {
        headers['Content-Type'] = 'application/x-www-form-urlencoded; charset=UTF-8';
        headers['X-CSRF-Token'] = CLEANER_CSRF_TOKEN;
    }
    const response = await fetch(cleanerUrl(action), {
        method,
        headers,
        body: options.body || null,
        credentials: 'same-origin'
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.success === false) {
        throw new Error(data.message || 'İşlem başarısız oldu.');
    }
    return data;
}

function renderCleanerStats(stats) {
    cleanerState.stats = stats || {};
    const kpiGrid = document.getElementById('cleanerKpiGrid');
    const previewWrap = document.getElementById('cleanerPreviewWrap');
    if (!kpiGrid) return;

    const num = value => Number(value || 0).toLocaleString('tr-TR');
    document.getElementById('kpiTotal').textContent = num(cleanerState.stats.total);
    document.getElementById('kpiGmail').textContent = num(cleanerState.stats.gmail_count);
    document.getElementById('kpiNonGmail').textContent = num(cleanerState.stats.non_gmail_count);
    document.getElementById('kpiTypo').textContent = num(cleanerState.stats.typo_gmail_count);
    document.getElementById('kpiDuplicate').textContent = num(cleanerState.stats.duplicate_count);
    document.getElementById('kpiDeletable').textContent = num(cleanerState.stats.deletable_count);
    kpiGrid.classList.remove('d-none');

    const normalized = (cleanerState.stats.normalized_preview || [])
        .map(item => `${item.from} -> ${item.to}`)
        .join('\n');
    const nonGmail = (cleanerState.stats.non_gmail_preview || []).join('\n');
    document.getElementById('cleanerNormalizedPreview').textContent = normalized || 'Önizleme yok';
    document.getElementById('cleanerNonGmailPreview').textContent = nonGmail || 'Önizleme yok';
    if (previewWrap) previewWrap.classList.remove('d-none');
}

async function runCleanerAnalyze(showSuccess = true) {
    if (!CURRENT_POOL_LIST_ID) return;
    setCleanerButtonsDisabled(true);
    startCleanerProgress('Liste analiz ediliyor...');
    try {
        const stats = await cleanerRequest('analyze');
        renderCleanerStats(stats);
        await loadTopStats(false);
        if (showSuccess) {
            showCleanerToast('success', 'Analiz tamamlandı.');
        }
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setCleanerButtonsDisabled(false);
    }
}

async function ensureCleanerStats() {
    if (!cleanerState.stats) {
        await runCleanerAnalyze(false);
