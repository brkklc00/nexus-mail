async function loadTopStats(showToast = false) {
    if (!CURRENT_POOL_LIST_ID) return;
    try {
        const data = await poolFetch(statsUrl(), {}, 'İstatistik alınamadı.');
        cleanerState.stats = data || {};
        cleanerState.analysisStatus = data.analysis_status || 'idle';
        const total = Number(data.total || 0);
        const gmailCount = Number(data.gmail_count || 0);
        const gmailRatio = Number(data.gmail_ratio || 0).toLocaleString('tr-TR');
        const fmt = v => Number(v || 0).toLocaleString('tr-TR');
        document.getElementById('statTopTotal').textContent = fmt(total);
        const completed = data.analysis_status === 'completed';
        const lastOpEl = document.getElementById('overviewLastOperation');
        if (lastOpEl) {
            lastOpEl.textContent = completed
                ? `Son analiz tamamlandı${data.last_analyzed_at ? ` (${data.last_analyzed_at})` : ''}`
                : (data.analysis_status === 'running' ? 'Analiz çalışıyor' : 'Analiz bekleniyor');
        }
        document.getElementById('statTopGmailRatio').textContent = completed ? `${fmt(gmailCount)} / %${gmailRatio}` : 'Analiz bekliyor';
        document.getElementById('statTopGmailDesc').textContent = completed
            ? `${fmt(total)} kayıt içinde Gmail${data.last_analyzed_at ? ` · Son analiz: ${data.last_analyzed_at}` : ''}`
            : (data.analysis_status === 'running' ? 'Güncelleniyor...' : 'Henüz analiz yapılmadı');
        const runningJob = data.running_job || null;
        const running = data.analysis_status === 'running' && runningJob;
        document.getElementById('statTopNonGmail').textContent = completed
            ? fmt(data.non_gmail_count || 0)
            : (running ? fmt(runningJob.non_gmail_count || 0) : '-');
        document.getElementById('statTopDuplicate').textContent = completed ? fmt(data.duplicate_count || 0) : (running ? 'Hesaplanıyor...' : '-');
        document.getElementById('statTopTypo').textContent = completed
            ? fmt(data.typo_gmail_count || 0)
            : (running ? fmt(runningJob.invalid_gmail_count || 0) : '-');
        const target = data.target_limit;
        const targetProgressEl = document.getElementById('statTopTargetProgress');
        document.getElementById('targetCurrentBadge').textContent = `Mevcut: ${fmt(total)}`;
        if (!target) {
            document.getElementById('statTopTargetMain').textContent = 'Hedef belirlenmedi';
            document.getElementById('statTopTargetMeta').textContent = '-';
            document.getElementById('targetDeltaBadge').textContent = 'Hedef yok';
            if (targetProgressEl) {
                targetProgressEl.style.width = '0%';
                targetProgressEl.className = 'progress-bar bg-secondary';
            }
        } else {
            document.getElementById('statTopTargetMain').textContent = `${fmt(total)} / ${fmt(target)}`;
            const missing = Number(data.missing_to_target || 0);
            const over = Number(data.over_target || 0);
            const fillRate = target > 0 ? ((total / Number(target)) * 100).toFixed(1) : '0.0';
            const boundedFill = Math.max(0, Math.min(100, Number(fillRate)));
            if (targetProgressEl) {
                targetProgressEl.style.width = `${boundedFill}%`;
                targetProgressEl.className = `progress-bar ${over > 0 ? 'bg-warning' : 'bg-success'}`;
            }
            if (over > 0) {
                document.getElementById('statTopTargetMeta').textContent = `%${fillRate} dolu, ${fmt(over)} fazla`;
                document.getElementById('targetDeltaBadge').textContent = `Fazla: ${fmt(over)}`;
            } else {
                document.getElementById('statTopTargetMeta').textContent = `%${fillRate} dolu, ${fmt(missing)} eksik`;
                document.getElementById('targetDeltaBadge').textContent = `Eksik: ${fmt(missing)}`;
            }
        }
        renderCleanerStats(data);
        if (data.analysis_status === 'completed' && !cleanerState.hasShownCachedInfo) {
            cleanerState.hasShownCachedInfo = true;
            showCleanerToast('info', 'Son kaydedilen analiz sonucu gösteriliyor.');
        }
        if (data.running_job && data.running_job.job_id) {
            cleanerState.busy = true;
            startAnalysisPolling(data.running_job.job_id, false);
        } else if (data.analysis_status !== 'running') {
            cleanerState.busy = false;
            stopAnalysisPolling();
            hideCleanerProgress();
            setCleanerButtonsDisabled(false);
        }
        if (showToast) {
            showCleanerToast('success', 'Üst istatistikler güncellendi.');
        }
    } catch (error) {
        if (showToast) {
            showCleanerToast('error', error.message);
        }
    }
}

