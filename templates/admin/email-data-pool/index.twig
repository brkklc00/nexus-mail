async function loadJobHistory() {
    const tbody = document.getElementById('jobHistoryTbody');
    if (!tbody) return;
    try {
        const type = document.getElementById('jobHistoryTypeFilter')?.value || '';
        const status = document.getElementById('jobHistoryStatusFilter')?.value || '';
        const date = document.getElementById('jobHistoryDateFilter')?.value || '';
        const poolId = document.getElementById('jobHistoryListFilter')?.value || '';
        const params = new URLSearchParams({ per_page: '50' });
        if (type) params.set('type', type);
        if (status) params.set('status', status);
        if (poolId) params.set('pool_id', poolId);
        const data = await poolFetch(`/admin/email-data-pool/jobs?${params.toString()}`, {}, 'Job geçmişi alınamadı.');
        const rows = Array.isArray(data.data) ? data.data : [];
        const filteredRows = date
            ? rows.filter(item => String(item.created_at || '').startsWith(date))
            : rows;
        if (!filteredRows.length) {
            tbody.innerHTML = '<tr><td colspan="13" class="text-center text-muted py-3">Kayıt bulunamadı.</td></tr>';
            return;
        }
        tbody.innerHTML = filteredRows.map(item => {
            const status = String(item.status || 'queued');
            const badgeClass = status === 'completed' ? 'bg-success' : (status === 'failed' ? 'bg-danger' : (status === 'running' ? 'bg-primary' : 'bg-secondary'));
            const reportUrl = String(item?.result?.report_url || item?.result?.download_url || '');
            const reportHtml = reportUrl
                ? `<a href="${reportUrl}" class="btn btn-sm btn-soft-secondary py-0 px-2">İndir</a>`
                : '-';
            return `<tr>
                <td>${Number(item.job_id || 0)}</td>
                <td>${item.type || '-'}</td>
                <td>${item.scope === 'global' ? 'Global' : `Liste #${Number(item.list_id || 0)}`}</td>
                <td><span class="badge job-status-badge ${badgeClass}">${status}</span></td>
                <td>${Number(item.total || 0).toLocaleString('tr-TR')}</td>
                <td>${Number(item.processed || 0).toLocaleString('tr-TR')}</td>
                <td>${Number(item.success_count || item.result?.affected_rows || 0).toLocaleString('tr-TR')}</td>
                <td>${Number(item.failed_count || 0).toLocaleString('tr-TR')}</td>
                <td>%${Number(item.percent || 0)}</td>
                <td>${item.started_at || '-'}</td>
                <td>${item.finished_at || '-'}</td>
                <td>${item.error || '-'}</td>
                <td>${reportHtml}</td>
            </tr>`;
        }).join('');
    } catch (error) {
        tbody.innerHTML = `<tr><td colspan="13" class="text-center text-danger py-3">${error.message}</td></tr>`;
    }
}

function activatePoolOpsTab(tabName) {
    const tab = String(tabName || 'overview');
    document.querySelectorAll('#poolOpsTabNav .nav-link').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.poolTab === tab);
    });
    const overviewCard = document.getElementById('overviewPaneCard');
    const toolsWrap = document.getElementById('toolsGridWrap') || document.querySelector('.tools-grid');
    const cleanerCard = document.getElementById('mailCleanerCard');
    const balanceCard = document.getElementById('mailBalanceCard');
    const bulkCard = document.getElementById('globalBulkCard');
    const alibabaCard = document.getElementById('alibabaInvalidCard');
    const historyCard = document.getElementById('jobHistoryCard');
    [overviewCard, bulkCard, alibabaCard, historyCard].forEach(el => el?.classList.add('d-none'));
    [cleanerCard, balanceCard, document.getElementById('listOpsStatusCard')].forEach(el => el?.classList.remove('d-none'));
    if (toolsWrap) toolsWrap.classList.add('d-none');

    if (tab === 'overview') {
        overviewCard?.classList.remove('d-none');
        return;
    }
    if (tab === 'operations') {
        if (toolsWrap) toolsWrap.classList.remove('d-none');
        return;
    }
    if (tab === 'bulk') {
        bulkCard?.classList.remove('d-none');
        return;
    }
    if (tab === 'alibaba') {
        alibabaCard?.classList.remove('d-none');
        loadAlibabaStatus();
        return;
    }
    if (tab === 'history') {
        historyCard?.classList.remove('d-none');
        loadJobHistory();
        return;
    }
}

async function runCleanerAnalyze(showSuccess = true) {
    if (!CURRENT_POOL_LIST_ID || cleanerState.busy) return;
    cleanerState.busy = true;
    cleanerState.analysisStatus = 'running';
    const analyzeBtn = document.getElementById('cleanerAnalyzeBtn');
    setButtonLoading(analyzeBtn, true, 'Analiz ediliyor...');
    setCleanerButtonsDisabled(true);
    startCleanerProgress('Liste analiz ediliyor...');
    try {
        const body = new URLSearchParams({ _csrf: CLEANER_CSRF_TOKEN });
        const data = await poolFetch(analysisStartUrl(), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-CSRF-Token': CLEANER_CSRF_TOKEN
            },
            body
        }, 'Analiz başlatılamadı.');
        const jobId = Number(data.job_id || data?.data?.jobId || 0);
        if (!jobId) {
            throw new Error(data.message || 'Analiz başlatılamadı.');
        }
        if (data.already_running) {
            showCleanerToast('warning', data.message || 'Bu liste için analiz zaten çalışıyor.');
        } else if (showSuccess) {
            showCleanerToast('success', data.message || 'Analiz başlatıldı.');
        }
        startAnalysisPolling(jobId, showSuccess);
    } catch (error) {
        cleanerState.busy = false;
        showCleanerToast('error', error.message);
        hideCleanerProgress();
        setCleanerButtonsDisabled(false);
        setButtonLoading(analyzeBtn, false);
    }
}

async function ensureCleanerStats() {
    if (!cleanerState.stats || cleanerState.stats.analysis_status !== 'completed') {
        throw new Error('Önce analiz tamamlanmalıdır.');
    }
    return cleanerState.stats || {};
}

