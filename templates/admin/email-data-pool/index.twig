async function pollAnalysisStatus(jobId, showSuccessToast = false) {
    const data = await poolFetch(analysisStatusUrl(jobId), {}, 'Analiz durumu okunamadı.');
    cleanerState.analysisJobId = jobId;
    cleanerState.analysisStatus = data.status || 'idle';
    if (data.status === 'queued' || data.status === 'running') {
        const total = Number(data.total || cleanerState.stats.total || 0);
        const gmail = Number(data.gmail_count || 0);
        const nonGmail = Number(data.non_gmail_count || 0);
        const typo = Number(data.invalid_gmail_count || 0);
        cleanerState.stats = Object.assign({}, cleanerState.stats || {}, {
            analysis_status: 'running',
            analysis_percent: Number(data.percent || 0),
            total,
            gmail_count: gmail,
            non_gmail_count: nonGmail,
            typo_gmail_count: typo,
            duplicate_count: Number(data.duplicate_count || 0),
            deletable_count: nonGmail + Number(data.duplicate_count || 0),
            last_analyzed_at: (cleanerState.stats && cleanerState.stats.last_analyzed_at) ? cleanerState.stats.last_analyzed_at : null
        });
        renderCleanerStats(cleanerState.stats);
        setCleanerProgress(data.message || (data.status === 'queued' ? 'Analiz kuyruğa alındı...' : 'Liste analiz ediliyor...'), data.percent || 0);
        return;
    }
    stopAnalysisPolling();
    if (data.status === 'completed') {
        cleanerState.busy = false;
        setButtonLoading(document.getElementById('cleanerAnalyzeBtn'), false);
        finishCleanerProgress();
        setCleanerButtonsDisabled(false);
        await loadTopStats(false);
        if (showSuccessToast) {
            showCleanerToast('success', 'Analiz tamamlandı.');
        }
        return;
    }
    if (data.status === 'failed') {
        cleanerState.busy = false;
        setButtonLoading(document.getElementById('cleanerAnalyzeBtn'), false);
        hideCleanerProgress();
        setCleanerButtonsDisabled(false);
        showCleanerToast('error', data.error || 'Analiz başarısız oldu.');
    }
}

function startAnalysisPolling(jobId, showSuccessToast = false) {
    stopAnalysisPolling();
    cleanerState.analysisJobId = jobId;
    pollAnalysisStatus(jobId, showSuccessToast).catch(error => {
        cleanerState.busy = false;
        hideCleanerProgress();
        setCleanerButtonsDisabled(false);
        setButtonLoading(document.getElementById('cleanerAnalyzeBtn'), false);
        showCleanerToast('error', error.message);
    });
    cleanerState.statusPollTimer = setInterval(() => {
        pollAnalysisStatus(jobId, showSuccessToast).catch(error => {
            stopAnalysisPolling();
            cleanerState.busy = false;
            hideCleanerProgress();
            setCleanerButtonsDisabled(false);
            setButtonLoading(document.getElementById('cleanerAnalyzeBtn'), false);
            showCleanerToast('error', error.message);
        });
    }, 1500);
}

async function waitForBackgroundJob(jobId, label = 'İşlem sürüyor...') {
    const safeJobId = Number(jobId || 0);
    if (!safeJobId) {
        throw new Error('Geçersiz job numarası.');
    }
    const maxWaitMs = 30 * 60 * 1000;
    const startedAt = Date.now();

    while (true) {
        const data = await poolFetch(jobStatusUrl(safeJobId), {}, 'Job durumu alınamadı.');
        const percent = Number(data.percent || data?.data?.percent || 0);
        setCleanerProgress(label, percent);
        const status = String(data.status || data?.data?.status || 'queued');
        if (status === 'completed') {
            refreshListOpsJobStatus();
            finishCleanerProgress();
            return data;
        }
        if (status === 'failed') {
            refreshListOpsJobStatus();
            throw new Error(data.error || data.message || 'Arkaplan işlemi başarısız oldu.');
        }
        if ((Date.now() - startedAt) > maxWaitMs) {
            throw new Error('Arkaplan işlemi zaman aşımına uğradı.');
        }
        await new Promise(resolve => setTimeout(resolve, 2000));
    }
}

