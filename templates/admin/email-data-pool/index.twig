async function loadTopStats(showToast = false) {
    if (!CURRENT_POOL_LIST_ID) return;
    try {
        const response = await fetch(statsUrl(), { credentials: 'same-origin' });
        const data = await response.json();
        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'İstatistik alınamadı.');
        }
        const total = Number(data.total || 0);
        const gmailCount = Number(data.gmail_count || 0);
        const gmailRatio = Number(data.gmail_ratio || 0).toLocaleString('tr-TR');
        const fmt = v => Number(v || 0).toLocaleString('tr-TR');
        document.getElementById('statTopTotal').textContent = fmt(total);
        document.getElementById('statTopGmailRatio').textContent = `${fmt(gmailCount)} / %${gmailRatio}`;
        document.getElementById('statTopGmailDesc').textContent = `${fmt(total)} kayıt içinde Gmail`;
        document.getElementById('statTopNonGmail').textContent = fmt(data.non_gmail_count || 0);
        document.getElementById('statTopDuplicate').textContent = fmt(data.duplicate_count || 0);
        document.getElementById('statTopTypo').textContent = fmt(data.typo_gmail_count || 0);
        const target = data.target_limit;
        if (!target) {
            document.getElementById('statTopTargetMain').textContent = 'Hedef belirlenmedi';
            document.getElementById('statTopTargetMeta').textContent = '-';
        } else {
            document.getElementById('statTopTargetMain').textContent = `${fmt(total)} / ${fmt(target)}`;
            const missing = Number(data.missing_to_target || 0);
            const over = Number(data.over_target || 0);
            const fillRate = target > 0 ? ((total / Number(target)) * 100).toFixed(1) : '0.0';
            if (over > 0) {
                document.getElementById('statTopTargetMeta').textContent = `%${fillRate} dolu, ${fmt(over)} fazla`;
            } else {
                document.getElementById('statTopTargetMeta').textContent = `%${fillRate} dolu, ${fmt(missing)} eksik`;
            }
        }
        if (showToast) {
            showCleanerToast('success', 'Üst istatistikler güncellendi.');
        }
    } catch (error) {
        if (showToast) {
            showCleanerToast('error', error.message);
        }
    }
}

function setBalanceButtonsDisabled(disabled) {
    document.querySelectorAll('.balance-action-btn').forEach(btn => {
        btn.disabled = !CURRENT_POOL_LIST_ID || disabled;
    });
}

function toolsEndpoint(path) {
    return `/admin/email-data-pool/tools/${path}`;
}

async function postTools(path, payload) {
    const body = new URLSearchParams({ _csrf: CLEANER_CSRF_TOKEN });
    Object.entries(payload || {}).forEach(([k, v]) => {
        if (v === null || typeof v === 'undefined') return;
        body.append(k, String(v));
    });
    const response = await fetch(toolsEndpoint(path), {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-CSRF-Token': CLEANER_CSRF_TOKEN
        },
        body,
        credentials: 'same-origin'
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.success === false) {
        throw new Error(data.message || 'İşlem başarısız.');
    }
    return data;
}

function previewToText(data) {
    return Object.entries(data || {})
        .filter(([k]) => k !== 'success')
        .map(([k, v]) => `${k}: ${typeof v === 'number' ? Number(v).toLocaleString('tr-TR') : v}`)
        .join('\n');
}

function summaryToText(summary) {
    const labels = {
        operation_type: 'İşlem tipi',
        source_list: 'Kaynak liste',
        target_list: 'Hedef liste',
        read_records: 'Okunan kayıt',
        added_records: 'Eklenen kayıt',
        moved_records: 'Taşınan kayıt',
        deleted_records: 'Silinen kayıt',
        duplicate_skipped: 'Duplicate atlanan',
        non_gmail_skipped: 'Gmail dışı atlanan',
        typo_fixed: 'Hatalı Gmail düzeltilen',
        leftover_records: 'Kalan fazla kayıt'
    };
    return Object.entries(labels)
        .map(([key, label]) => `${label}: ${typeof summary?.[key] === 'number' ? Number(summary[key]).toLocaleString('tr-TR') : (summary?.[key] ?? '-')}`)
        .join('\n');
}

function openPreviewModal(data) {
    document.getElementById('balancePreviewText').textContent = previewToText(data);
    openModalById('balancePreviewModal');
}

function openResultModal(summary) {
    document.getElementById('balanceResultText').textContent = summaryToText(summary);
    const link = document.getElementById('balanceResultDownloadLink');
    const url = summary?.download_url || '';
    if (url) {
        link.href = url;
        link.classList.remove('d-none');
    } else {
        link.href = '#';
        link.classList.add('d-none');
    }
    openModalById('balanceResultModal');
}

function currentTargetLimit() {
    return Number(document.getElementById('balanceTargetLimitInput')?.value || 0);
}

function getFillPayload(sourceType) {
    return {
        target_list_id: CURRENT_POOL_LIST_ID,
        source_type: sourceType,
        source_list_id: document.getElementById('fillSourceListId')?.value || '',
        target_count: currentTargetLimit(),
        mode: document.getElementById('fillMode')?.value || 'copy',
        clean_gmail_typos: 1,
        only_gmail: 0,
        remove_duplicates: 1,
        leftover_action: sourceType === 'list' ? 'ignore' : 'download',
        source_payload: sourceType === 'list' ? '' : (document.getElementById('fillManualPayload')?.value || '')
    };
}

async function previewFill(sourceType) {
    try {
        setBalanceButtonsDisabled(true);
        const data = await postTools('preview', Object.assign({ tool: 'fill_to_target' }, getFillPayload(sourceType)));
        openPreviewModal(data);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        setBalanceButtonsDisabled(false);
    }
}

async function runFill(sourceType) {
    try {
        if (!confirm('Seçili ayarlarla hedef tamamlama işlemi başlatılsın mı?')) return;
        setBalanceButtonsDisabled(true);
        startCleanerProgress('Hedefe tamamlama çalışıyor...');
        const data = await postTools('fill-to-target', getFillPayload(sourceType));
        openResultModal(data.summary || {});
        await loadTopStats(false);
        await runCleanerAnalyze(false);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setBalanceButtonsDisabled(false);
    }
}

function getOverflowPayload() {
    return {
        source_list_id: CURRENT_POOL_LIST_ID,
        target_count: currentTargetLimit(),
        overflow_target_type: document.getElementById('overflowNewListName')?.value?.trim() ? 'new' : 'existing',
        overflow_target_list_id: document.getElementById('overflowTargetListId')?.value || '',
        new_list_name: document.getElementById('overflowNewListName')?.value || '',
        remove_duplicates: 1
    };
}

async function previewOverflow() {
    try {
        setBalanceButtonsDisabled(true);
        const data = await postTools('preview', Object.assign({ tool: 'move_overflow' }, getOverflowPayload()));
        openPreviewModal(data);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        setBalanceButtonsDisabled(false);
    }
}

async function runOverflow() {
    try {
        const dataPreview = await postTools('preview', Object.assign({ tool: 'move_overflow' }, getOverflowPayload()));
        const overflow = Number(dataPreview.overflow || 0).toLocaleString('tr-TR');
        const targetName = document.getElementById('overflowNewListName')?.value?.trim() || document.getElementById('overflowTargetListId')?.selectedOptions?.[0]?.text || 'hedef liste';
        if (!confirm(`Bu işlem ${overflow} kaydı seçili listeden ${targetName} listesine taşıyacak. Devam edilsin mi?`)) return;
        setBalanceButtonsDisabled(true);
        startCleanerProgress('Fazla kayıtlar aktarılıyor...');
        const data = await postTools('move-overflow', getOverflowPayload());
        openResultModal(data.summary || {});
        await loadTopStats(false);
        await runCleanerAnalyze(false);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setBalanceButtonsDisabled(false);
    }
}

function getSplitPayload() {
    return {
        source_list_id: CURRENT_POOL_LIST_ID,
        chunk_size: Number(document.getElementById('splitChunkSize')?.value || 0),
        new_list_prefix: document.getElementById('splitPrefix')?.value || 'Kampanya',
        mode: document.getElementById('splitMode')?.value || 'copy',
        only_gmail: document.getElementById('splitOnlyGmail')?.checked ? 1 : 0,
        clean_gmail_typos: 1,
        remove_duplicates: 1
    };
}

async function previewSplit() {
    try {
        setBalanceButtonsDisabled(true);
        const data = await postTools('preview', Object.assign({ tool: 'split_list' }, getSplitPayload()));
        openPreviewModal(data);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        setBalanceButtonsDisabled(false);
    }
}

async function runSplit() {
    try {
        if (!confirm('Liste bölme işlemi başlatılsın mı?')) return;
        setBalanceButtonsDisabled(true);
        startCleanerProgress('Liste bölme işlemi çalışıyor...');
        const data = await postTools('split-list', getSplitPayload());
        openResultModal(data.summary || {});
        await loadTopStats(false);
        await runCleanerAnalyze(false);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setBalanceButtonsDisabled(false);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
    const listSearchInput = document.getElementById('poolListSearch');
    if (listSearchInput) {
        let searchTimer = null;
        listSearchInput.addEventListener('input', function () {
            clearTimeout(searchTimer);
            const value = this.value.trim();
            searchTimer = setTimeout(function () {
                const params = new URLSearchParams(window.location.search);
                if (value) {
                    params.set('list_search', value);
                } else {
                    params.delete('list_search');
                }
                params.set('list_page', '1');
                if (CURRENT_POOL_LIST_ID) {
                    params.set('list_id', String(CURRENT_POOL_LIST_ID));
                }
                window.location.href = '/admin/email-data-pool?' + params.toString();
            }, 300);
        });
    }

    ['addModal', 'removeModal', 'newListModal', 'editListModal'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('shown.bs.modal', function () {
                feather.replace();
            });
        }
    });

    setCleanerButtonsDisabled(false);
    document.getElementById('cleanerAnalyzeBtn')?.addEventListener('click', () => runCleanerAnalyze(true));
    document.getElementById('cleanerExportBtn')?.addEventListener('click', exportNonGmail);
    document.getElementById('cleanerDeleteNonGmailBtn')?.addEventListener('click', openDeleteNonGmailModal);
    document.getElementById('cleanerFixTyposBtn')?.addEventListener('click', openFixTyposModal);
    document.getElementById('cleanerRemoveDuplicatesBtn')?.addEventListener('click', openDuplicateModal);
    document.getElementById('confirmDeleteNonGmailBtn')?.addEventListener('click', deleteNonGmailConfirmed);
    document.getElementById('confirmFixTyposBtn')?.addEventListener('click', fixTyposConfirmed);
    document.getElementById('confirmDuplicateCleanupBtn')?.addEventListener('click', removeDuplicatesConfirmed);
    document.getElementById('balanceTargetLimitInput')?.addEventListener('change', () => loadTopStats(false));
    document.getElementById('statGotoNonGmailBtn')?.addEventListener('click', openDeleteNonGmailModal);
    document.getElementById('previewFillBtn')?.addEventListener('click', () => previewFill('list'));
    document.getElementById('runFillBtn')?.addEventListener('click', () => runFill('list'));
    document.getElementById('previewManualFillBtn')?.addEventListener('click', () => previewFill('manual'));
    document.getElementById('runManualFillBtn')?.addEventListener('click', () => runFill('manual'));
    document.getElementById('previewOverflowBtn')?.addEventListener('click', previewOverflow);
    document.getElementById('runOverflowBtn')?.addEventListener('click', runOverflow);
    document.getElementById('previewSplitBtn')?.addEventListener('click', previewSplit);
    document.getElementById('runSplitBtn')?.addEventListener('click', runSplit);
    loadTopStats(false);
    runCleanerAnalyze(false);
});
</script>
{% endblock %}
