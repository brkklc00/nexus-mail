<script>
const CURRENT_POOL_LIST_ID = {{ current_list_id|default(0) }};
const CLEANER_CSRF_TOKEN = '{{ cleaner_csrf|default('')|e('js') }}';
function appendPoolListToForm(form) {
    if (!CURRENT_POOL_LIST_ID) return;
    const h = document.createElement('input');
    h.type = 'hidden';
    h.name = 'pool_list_id';
    h.value = String(CURRENT_POOL_LIST_ID);
    form.appendChild(h);
}

let emailsTextarea = null;

function updateEmailCount() {
    const textarea = document.getElementById('emails');
    const lines = textarea.value.split('\n').filter(line => line.trim() !== '');
    document.getElementById('emailCount').textContent = `${lines.length} mail`;
}

function handleFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;

    const statusDiv = document.getElementById('fileStatus');
    statusDiv.innerHTML = '<div class="alert alert-info">Dosya okunuyor...</div>';

    const fileExt = file.name.split('.').pop().toLowerCase();

    if (fileExt === 'txt' || fileExt === 'csv') {
        readTextFile(file, fileExt);
    } else if (fileExt === 'xlsx' || fileExt === 'xls') {
        readExcelFile(file);
    } else {
        statusDiv.innerHTML = '<div class="alert alert-danger">Desteklenmeyen dosya formatı</div>';
    }
}

function normalizeHeaderName(header) {
    return String(header || '')
        .replace(/^\uFEFF/, '')
        .trim()
        .toLowerCase()
        .replace(/["']/g, '')
        .replace(/[-_\s]/g, '');
}

function detectDelimiterFromText(text) {
    const lines = String(text || '').split(/\r?\n/).filter(l => l.trim() !== '').slice(0, 5);
    if (!lines.length) return ',';
    const candidates = [',', ';', '\t'];
    let best = ',';
    let bestScore = -1;
    for (const c of candidates) {
        let score = 0;
        for (const line of lines) {
            score += line.split(c).length;
        }
        if (score > bestScore) {
            best = c;
            bestScore = score;
        }
    }
    return best;
}

function parseCsvLine(line, delimiter) {
    const out = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
            if (inQuotes && line[i + 1] === '"') {
                cur += '"';
                i++;
            } else {
                inQuotes = !inQuotes;
            }
            continue;
        }
        if (ch === delimiter && !inQuotes) {
            out.push(cur);
            cur = '';
            continue;
        }
        cur += ch;
    }
    out.push(cur);
    return out.map(v => String(v || '').trim());
}

function detectHeaderMap(row) {
    const emailAliases = ['mailadresi', 'email', 'emailadresi', 'e-mail', 'mail', 'eposta', 'e-posta', 'epostaadresi', 'mailaddress', 'recipient', 'address'];
    const nameAliases = ['isim', 'name', 'ad', 'full_name', 'fullname'];
    const statusAliases = ['durum', 'status'];

    let emailIndex = null;
    let nameIndex = null;
    let statusIndex = null;
    let hasHeader = false;

    row.forEach((col, idx) => {
        const normalized = normalizeHeaderName(col);
        if (!normalized) return;
        if (emailIndex === null && emailAliases.map(normalizeHeaderName).includes(normalized)) {
            emailIndex = idx;
            hasHeader = true;
        } else if (nameIndex === null && nameAliases.map(normalizeHeaderName).includes(normalized)) {
            nameIndex = idx;
            hasHeader = true;
        } else if (statusIndex === null && statusAliases.map(normalizeHeaderName).includes(normalized)) {
            statusIndex = idx;
            hasHeader = true;
        }
    });

    return { hasHeader, emailIndex, nameIndex, statusIndex };
}

function isPassiveStatus(value) {
    const status = String(value || '').trim().toLowerCase();
    const passive = ['pasif', 'passive', 'inactive', 'deleted', 'silindi', 'invalid', 'geçersiz', 'gecersiz', '0'];
    return passive.includes(status);
}

function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || '').trim().toLowerCase());
}

function parseRowsToImport(rows, requireHeaderEmailColumn = false) {
    const stats = {
        totalRows: 0,
        validEmail: 0,
        duplicateSkipped: 0,
        invalidSkipped: 0,
        statusSkipped: 0
    };

    if (!rows.length) {
        throw new Error('Dosya boş.');
    }

    const map = detectHeaderMap(rows[0] || []);
    if (map.hasHeader && requireHeaderEmailColumn && map.emailIndex === null) {
        throw new Error('Mail kolonu bulunamadı. Lütfen Mail Adresi, email veya mail başlıklı kolon kullanın.');
    }

    const start = map.hasHeader ? 1 : 0;
    const seen = new Set();
    const records = [];

    for (let i = start; i < rows.length; i++) {
        const row = rows[i];
        if (!row || !row.length) continue;
        stats.totalRows++;

        let email = map.emailIndex !== null ? row[map.emailIndex] : '';
        let name = map.nameIndex !== null ? row[map.nameIndex] : '';
        const status = map.statusIndex !== null ? row[map.statusIndex] : '';

        if (!email) {
            const found = row.find(cell => String(cell || '').includes('@'));
            email = found || '';
        }

        email = String(email || '').trim().toLowerCase();
        name = String(name || '').trim();

        if (!isValidEmail(email)) {
            stats.invalidSkipped++;
            continue;
        }

        if (map.statusIndex !== null && isPassiveStatus(status)) {
            stats.statusSkipped++;
            continue;
        }

        if (seen.has(email)) {
            stats.duplicateSkipped++;
            continue;
        }
        seen.add(email);
        stats.validEmail++;

        records.push(name ? `${email},${name}` : email);
    }

    return { records, stats };
}

function readTextFile(file, type) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const text = String(e.target.result || '').replace(/^\uFEFF/, '');
            const delimiter = type === 'csv' ? detectDelimiterFromText(text) : ',';
            const lines = text.split(/\r?\n/).filter(l => l.trim() !== '');
            const rows = type === 'csv'
                ? lines.map(line => parseCsvLine(line, delimiter))
                : lines.map(line => [line]);

            const result = parseRowsToImport(rows, true);
            document.getElementById('emails').value = result.records.join('\n');
            updateEmailCount();

            document.getElementById('fileStatus').innerHTML = `
                <div class="alert alert-success alert-dismissible fade show">
                    <i data-feather="check-circle"></i>
                    <strong>Import özeti:</strong>
                    Toplam satır ${result.stats.totalRows.toLocaleString('tr-TR')},
                    Geçerli ${result.stats.validEmail.toLocaleString('tr-TR')},
                    Duplicate atlanan ${result.stats.duplicateSkipped.toLocaleString('tr-TR')},
                    Geçersiz atlanan ${result.stats.invalidSkipped.toLocaleString('tr-TR')},
                    Durum nedeniyle atlanan ${result.stats.statusSkipped.toLocaleString('tr-TR')}.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
            document.querySelector('[href="#manualTab"]').click();
        } catch (err) {
            document.getElementById('fileStatus').innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show">
                    <i data-feather="x-circle"></i>
                    ${err.message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
        }
    };
    reader.readAsText(file, 'UTF-8');
}

function readExcelFile(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, {type: 'array'});
            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const rows = XLSX.utils.sheet_to_json(firstSheet, {header: 1, defval: ''});
            const result = parseRowsToImport(rows, true);
            document.getElementById('emails').value = result.records.join('\n');
            updateEmailCount();
            
            document.getElementById('fileStatus').innerHTML = `
                <div class="alert alert-success alert-dismissible fade show">
                    <i data-feather="check-circle"></i>
                    <strong>Import özeti:</strong>
                    Toplam satır ${result.stats.totalRows.toLocaleString('tr-TR')},
                    Geçerli ${result.stats.validEmail.toLocaleString('tr-TR')},
                    Duplicate atlanan ${result.stats.duplicateSkipped.toLocaleString('tr-TR')},
                    Geçersiz atlanan ${result.stats.invalidSkipped.toLocaleString('tr-TR')},
                    Durum nedeniyle atlanan ${result.stats.statusSkipped.toLocaleString('tr-TR')}.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
            
            // Manuel tab'a geç
            document.querySelector('[href="#manualTab"]').click();
        } catch (error) {
            document.getElementById('fileStatus').innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show">
                    <i data-feather="x-circle"></i> 
                    <strong>Hata!</strong> Excel dosyası okunamadı: ${error.message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
        }
    };
    reader.readAsArrayBuffer(file);
}

function showAddLoading() {
    const emails = document.getElementById('emails').value.trim();
    if (!emails) {
        alert('Lütfen en az bir mail adresi girin');
        return false;
    }

    const count = emails.split('\n').filter(l => l.trim()).length;
    document.getElementById('loadingText').textContent = `${count.toLocaleString()} adres ekleniyor…`;
    document.getElementById('loadingSubtext').textContent = 'Lütfen bekleyin';
    const progressBar = document.getElementById('loadingProgress');
    progressBar.style.width = '0%';
    progressBar.textContent = '';
    const overlay = document.getElementById('loadingOverlay');
    overlay.classList.add('is-visible');

    let progress = 0;
    const interval = setInterval(() => {
        progress += 5;
        if (progress >= 90) clearInterval(interval);
        progressBar.style.width = progress + '%';
    }, 100);

    return true;
}

function showRemoveLoading() {
    const ta = document.getElementById('removeEmails');
    const emails = (ta && ta.value.trim()) || '';
    if (!emails) {
        alert('Lütfen en az bir mail adresi girin veya dosyadan yükleyin');
        return false;
    }
    const scopeEl = document.querySelector('input[name="remove_scope"]:checked');
    const scope = scopeEl ? scopeEl.value : 'current_list';
    if (scope === 'all_lists') {
        const ok = confirm(
            'Seçilen adresler TÜM havuz listelerinden silinecek.\n\nAynı mail birden fazla listede kayıtlıysa tüm kopyalar kaldırılır. Devam edilsin mi?'
        );
        if (!ok) return false;
    }
    const count = emails.split('\n').filter(l => l.trim()).length;
    document.getElementById('loadingText').textContent =
        scope === 'all_lists'
            ? `${count.toLocaleString()} adres tüm listelerden çıkarılıyor…`
            : `${count.toLocaleString()} adres bu listeden çıkarılıyor…`;
    document.getElementById('loadingSubtext').textContent = 'Lütfen bekleyin';
    const progressBar = document.getElementById('loadingProgress');
    progressBar.style.width = '0%';
    progressBar.textContent = '';
    document.getElementById('loadingOverlay').classList.add('is-visible');
    let progress = 0;
    const interval = setInterval(() => {
        progress += 5;
        if (progress >= 90) clearInterval(interval);
        progressBar.style.width = progress + '%';
    }, 100);
    return true;
}

function deleteAll() {
    const totalAll = {{ list_total_all|default(0) }};
    if (totalAll === 0) {
        alert('Silinecek mail adresi yok');
        return;
    }
    if (!confirm(`TÜM ${totalAll.toLocaleString('tr-TR')} mail adresini silmek istediğinize EMİN MİSİNİZ?\n\nBu işlem GERİ ALINAMAZ!`)) {
        return;
    }
    if (!confirm('Son uyarı! Bu listedeki tüm kayıtlar silinecek. Onaylıyor musunuz?')) {
        return;
    }
    document.getElementById('loadingText').textContent = 'Liste temizleniyor…';
    document.getElementById('loadingSubtext').textContent = `${totalAll.toLocaleString('tr-TR')} kayıt siliniyor…`;
    document.getElementById('loadingProgress').style.width = '100%';
    document.getElementById('loadingOverlay').classList.add('is-visible');
    
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/email-data-pool/delete-all';
    appendPoolListToForm(form);
    document.body.appendChild(form);
    form.submit();
}

// Remove modal fonksiyonları
function updateRemoveEmailCount() {
    const textarea = document.getElementById('removeEmails');
    const lines = textarea.value.split('\n').filter(line => line.trim() !== '');
    document.getElementById('removeEmailCount').textContent = `${lines.length} mail`;
}

function handleRemoveFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;

    const statusDiv = document.getElementById('removeFileStatus');
    statusDiv.innerHTML = '<div class="alert alert-info">Dosya okunuyor...</div>';

    const fileExt = file.name.split('.').pop().toLowerCase();

    if (fileExt === 'txt' || fileExt === 'csv') {
        readRemoveTextFile(file, fileExt);
    } else if (fileExt === 'xlsx' || fileExt === 'xls') {
        readRemoveExcelFile(file);
    } else {
        statusDiv.innerHTML = '<div class="alert alert-danger">Desteklenmeyen dosya formatı</div>';
    }
}

function readRemoveTextFile(file, type) {
    const reader = new FileReader();
    reader.onload = function(e) {
        const text = e.target.result;
        const lines = text.split('\n');
        
        let emails = [];
        
        // CSV ise header kontrolü yap
        if (type === 'csv' && lines.length > 0) {
            const headers = lines[0].split(/[,\t]/);
            const emailColumnIndex = headers.findIndex(h => 
                h.toLowerCase().includes('recipient') || 
                h.toLowerCase().includes('email')
            );
            
            if (emailColumnIndex !== -1) {
                // Header var, email kolonundan oku
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(/[,\t]/);
                    const email = cols[emailColumnIndex]?.trim();
                    if (email && email.includes('@')) {
                        emails.push(email);
                    }
                }
            } else {
                // Header yok veya bulunamadı, normal parse et
                lines.forEach(line => {
                    line = line.trim();
                    if (line && line.includes('@')) {
                        // Satırda @ varsa email ara
                        const parts = line.split(/[,\t]/);
                        parts.forEach(part => {
                            part = part.trim();
                            if (part && part.includes('@')) {
                                emails.push(part);
                            }
                        });
                    }
                });
            }
        } else {
            // TXT dosyası
            lines.forEach(line => {
                line = line.trim();
                if (line && line.includes('@')) {
                    emails.push(line);
                }
            });
        }

        // Benzersiz yap
        emails = [...new Set(emails)];

        document.getElementById('removeEmails').value = emails.join('\n');
        updateRemoveEmailCount();
        
        document.getElementById('removeFileStatus').innerHTML = `
            <div class="alert alert-success alert-dismissible fade show">
                <i data-feather="check-circle"></i> 
                <strong>Başarılı!</strong> ${emails.length.toLocaleString()} mail adresi yüklendi
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
        feather.replace();
    };
    reader.readAsText(file);
}

function readRemoveExcelFile(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });
            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const jsonData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });
            
            let emails = [];
            const headers = jsonData[0] || [];
            
            // RecipientAddress veya email kolonunu bul
            const emailColumnIndex = headers.findIndex(h => 
                (typeof h === 'string' && (
                    h.toLowerCase().includes('recipient') || 
                    h.toLowerCase().includes('email')
                ))
            );
            
            if (emailColumnIndex !== -1) {
                // Kolon bulundu, o kolondan oku
                for (let i = 1; i < jsonData.length; i++) {
                    const row = jsonData[i];
                    const email = row[emailColumnIndex];
                    if (email && typeof email === 'string' && email.includes('@')) {
                        emails.push(email.trim());
                    }
                }
            } else {
                // Kolon bulunamadı, tüm satırları tara
                for (let i = 1; i < jsonData.length; i++) {
                    const row = jsonData[i];
                    row.forEach(cell => {
                        if (cell && typeof cell === 'string' && cell.includes('@')) {
                            emails.push(cell.trim());
                        }
                    });
                }
            }
            
            // Benzersiz yap
            emails = [...new Set(emails)];
            
            document.getElementById('removeEmails').value = emails.join('\n');
            updateRemoveEmailCount();
            
            document.getElementById('removeFileStatus').innerHTML = `
                <div class="alert alert-success alert-dismissible fade show">
                    <i data-feather="check-circle"></i> 
                    <strong>Başarılı!</strong> ${emails.length.toLocaleString()} mail adresi yüklendi
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            feather.replace();
        } catch (error) {
            document.getElementById('removeFileStatus').innerHTML = `
                <div class="alert alert-danger">
                    <i data-feather="x-circle"></i> Dosya okuma hatası: ${error.message}
                </div>`;
            feather.replace();
        }
    };
    reader.readAsArrayBuffer(file);
}

const cleanerState = {
    stats: null,
    busy: false,
    progressTimer: null
};

function cleanerUrl(action) {
    return `/admin/email-data-pool/${CURRENT_POOL_LIST_ID}/cleaner/${action}`;
}

function showCleanerToast(type, message) {
    if (window.iziToast) {
        if (type === 'success') {
            iziToast.success({ title: 'Başarılı', message, position: 'topRight' });
        } else {
            iziToast.error({ title: 'Hata', message, position: 'topRight' });
        }
        return;
    }
    alert(message);
}

function setCleanerButtonsDisabled(disabled) {
    document.querySelectorAll('.cleaner-action-btn, #confirmDeleteNonGmailBtn, #confirmFixTyposBtn, #confirmDuplicateCleanupBtn')
        .forEach(btn => {
            if (!btn) return;
            if (CURRENT_POOL_LIST_ID) {
                btn.disabled = disabled;
            } else {
                btn.disabled = true;
            }
        });
}

function startCleanerProgress(text) {
    const wrap = document.getElementById('cleanerProgressWrap');
    const bar = document.getElementById('cleanerProgressBar');
    const percent = document.getElementById('cleanerProgressPercent');
    const label = document.getElementById('cleanerProgressText');
    if (!wrap || !bar || !percent || !label) return;
    label.textContent = text || 'İşlem sürüyor...';
    wrap.classList.remove('d-none');
    bar.style.width = '0%';
    percent.textContent = '0%';
    let value = 0;
    clearInterval(cleanerState.progressTimer);
    cleanerState.progressTimer = setInterval(() => {
        value = Math.min(92, value + 4);
        bar.style.width = `${value}%`;
        percent.textContent = `${value}%`;
    }, 120);
}

function finishCleanerProgress() {
    const wrap = document.getElementById('cleanerProgressWrap');
    const bar = document.getElementById('cleanerProgressBar');
    const percent = document.getElementById('cleanerProgressPercent');
    clearInterval(cleanerState.progressTimer);
    cleanerState.progressTimer = null;
    if (bar) bar.style.width = '100%';
    if (percent) percent.textContent = '100%';
    setTimeout(() => {
        if (wrap) wrap.classList.add('d-none');
        if (bar) bar.style.width = '0%';
        if (percent) percent.textContent = '0%';
    }, 350);
}

async function cleanerRequest(action, options = {}) {
    const method = options.method || 'GET';
    const headers = Object.assign({}, options.headers || {});
    if (method !== 'GET') {
        headers['Content-Type'] = 'application/x-www-form-urlencoded; charset=UTF-8';
        headers['X-CSRF-Token'] = CLEANER_CSRF_TOKEN;
    }
    const response = await fetch(cleanerUrl(action), {
        method,
        headers,
        body: options.body || null,
        credentials: 'same-origin'
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || data.success === false) {
        throw new Error(data.message || 'İşlem başarısız oldu.');
    }
    return data;
}

function renderCleanerStats(stats) {
    cleanerState.stats = stats || {};
    const kpiGrid = document.getElementById('cleanerKpiGrid');
    const previewWrap = document.getElementById('cleanerPreviewWrap');
    if (!kpiGrid) return;

    const num = value => Number(value || 0).toLocaleString('tr-TR');
    document.getElementById('kpiTotal').textContent = num(cleanerState.stats.total);
    document.getElementById('kpiGmail').textContent = num(cleanerState.stats.gmail_count);
    document.getElementById('kpiNonGmail').textContent = num(cleanerState.stats.non_gmail_count);
    document.getElementById('kpiTypo').textContent = num(cleanerState.stats.typo_gmail_count);
    document.getElementById('kpiDuplicate').textContent = num(cleanerState.stats.duplicate_count);
    document.getElementById('kpiDeletable').textContent = num(cleanerState.stats.deletable_count);
    kpiGrid.classList.remove('d-none');

    const normalized = (cleanerState.stats.normalized_preview || [])
        .map(item => `${item.from} -> ${item.to}`)
        .join('\n');
    const nonGmail = (cleanerState.stats.non_gmail_preview || []).join('\n');
    document.getElementById('cleanerNormalizedPreview').textContent = normalized || 'Önizleme yok';
    document.getElementById('cleanerNonGmailPreview').textContent = nonGmail || 'Önizleme yok';
    if (previewWrap) previewWrap.classList.remove('d-none');
}

async function runCleanerAnalyze(showSuccess = true) {
    if (!CURRENT_POOL_LIST_ID) return;
    setCleanerButtonsDisabled(true);
    startCleanerProgress('Liste analiz ediliyor...');
    try {
        const stats = await cleanerRequest('analyze');
        renderCleanerStats(stats);
        if (showSuccess) {
            showCleanerToast('success', 'Analiz tamamlandı.');
        }
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setCleanerButtonsDisabled(false);
    }
}

async function ensureCleanerStats() {
    if (!cleanerState.stats) {
        await runCleanerAnalyze(false);
    }
    return cleanerState.stats || {};
}

async function exportNonGmail() {
    if (!CURRENT_POOL_LIST_ID) return;
    window.location.href = cleanerUrl('export-non-gmail');
}

function openModalById(id) {
    const el = document.getElementById(id);
    if (!el) return null;
    const modal = new bootstrap.Modal(el);
    modal.show();
    return modal;
}

async function openDeleteNonGmailModal() {
    const stats = await ensureCleanerStats();
    document.getElementById('deleteNonGmailCount').textContent = Number(stats.non_gmail_count || 0).toLocaleString('tr-TR');
    openModalById('cleanerDeleteModal');
}

async function openFixTyposModal() {
    const stats = await ensureCleanerStats();
    document.getElementById('fixTypoCount').textContent = Number(stats.typo_gmail_count || 0).toLocaleString('tr-TR');
    openModalById('cleanerFixModal');
}

async function openDuplicateModal() {
    const stats = await ensureCleanerStats();
    document.getElementById('duplicateRemoveCount').textContent = Number(stats.duplicate_count || 0).toLocaleString('tr-TR');
    openModalById('cleanerDuplicateModal');
}

async function deleteNonGmailConfirmed() {
    const shouldDownload = document.getElementById('downloadBeforeDelete')?.checked;
    if (shouldDownload) {
        exportNonGmail();
        await new Promise(resolve => setTimeout(resolve, 500));
    }

    setCleanerButtonsDisabled(true);
    startCleanerProgress('Gmail dışı kayıtlar siliniyor...');
    try {
        const body = new URLSearchParams({ _csrf: CLEANER_CSRF_TOKEN });
        const result = await cleanerRequest('delete-non-gmail', { method: 'POST', body });
        bootstrap.Modal.getInstance(document.getElementById('cleanerDeleteModal'))?.hide();
        showCleanerToast('success', `${Number(result.deleted || 0).toLocaleString('tr-TR')} kayıt silindi.`);
        await runCleanerAnalyze(false);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setCleanerButtonsDisabled(false);
    }
}

async function fixTyposConfirmed() {
    setCleanerButtonsDisabled(true);
    startCleanerProgress('Gmail domain hataları düzeltiliyor...');
    try {
        const body = new URLSearchParams({ _csrf: CLEANER_CSRF_TOKEN });
        const result = await cleanerRequest('fix-gmail-typos', { method: 'POST', body });
        bootstrap.Modal.getInstance(document.getElementById('cleanerFixModal'))?.hide();
        showCleanerToast('success', `${Number(result.fixed || 0).toLocaleString('tr-TR')} kayıt düzeltildi, ${Number(result.duplicates_after_fix || 0).toLocaleString('tr-TR')} duplicate kaldırıldı.`);
        await runCleanerAnalyze(false);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setCleanerButtonsDisabled(false);
    }
}

async function removeDuplicatesConfirmed() {
    setCleanerButtonsDisabled(true);
    startCleanerProgress('Duplicate kayıtlar temizleniyor...');
    try {
        const body = new URLSearchParams({ _csrf: CLEANER_CSRF_TOKEN });
        const result = await cleanerRequest('remove-duplicates', { method: 'POST', body });
        bootstrap.Modal.getInstance(document.getElementById('cleanerDuplicateModal'))?.hide();
        showCleanerToast('success', `${Number(result.removed || 0).toLocaleString('tr-TR')} duplicate kayıt silindi.`);
        await runCleanerAnalyze(false);
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        finishCleanerProgress();
        setCleanerButtonsDisabled(false);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
    const listSearchInput = document.getElementById('poolListSearch');
    if (listSearchInput) {
        let searchTimer = null;
        listSearchInput.addEventListener('input', function () {
            clearTimeout(searchTimer);
            const value = this.value.trim();
            searchTimer = setTimeout(function () {
                const params = new URLSearchParams(window.location.search);
                if (value) {
                    params.set('list_search', value);
                } else {
                    params.delete('list_search');
                }
                params.set('list_page', '1');
                if (CURRENT_POOL_LIST_ID) {
                    params.set('list_id', String(CURRENT_POOL_LIST_ID));
                }
                window.location.href = '/admin/email-data-pool?' + params.toString();
            }, 300);
        });
    }

    ['addModal', 'removeModal', 'newListModal', 'editListModal'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('shown.bs.modal', function () {
                feather.replace();
            });
        }
    });

    setCleanerButtonsDisabled(false);
    document.getElementById('cleanerAnalyzeBtn')?.addEventListener('click', () => runCleanerAnalyze(true));
    document.getElementById('cleanerExportBtn')?.addEventListener('click', exportNonGmail);
    document.getElementById('cleanerDeleteNonGmailBtn')?.addEventListener('click', openDeleteNonGmailModal);
    document.getElementById('cleanerFixTyposBtn')?.addEventListener('click', openFixTyposModal);
    document.getElementById('cleanerRemoveDuplicatesBtn')?.addEventListener('click', openDuplicateModal);
    document.getElementById('confirmDeleteNonGmailBtn')?.addEventListener('click', deleteNonGmailConfirmed);
    document.getElementById('confirmFixTyposBtn')?.addEventListener('click', fixTyposConfirmed);
    document.getElementById('confirmDuplicateCleanupBtn')?.addEventListener('click', removeDuplicatesConfirmed);
});
</script>
