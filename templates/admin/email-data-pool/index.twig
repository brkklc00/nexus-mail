{% extends "_layouts/main.twig" %}

{% block title %}Mail Havuzu - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
<li class="breadcrumb-item">Email</li>
<li class="breadcrumb-item active">Mail Havuzu</li>
{% endblock %}

{% block page_icon %}<i data-feather="database" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Mail Havuzu{% endblock %}

{% block styles %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
    #loadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        background: rgba(26, 32, 44, 0.75);
        backdrop-filter: blur(6px);
    }
    #loadingOverlay.is-visible {
        display: flex !important;
    }
    .pool-list-group .list-group-item.active {
        background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
        border-color: transparent;
        color: #fff;
    }
    .pool-list-group .list-group-item.active .badge {
        background: rgba(255, 255, 255, 0.2) !important;
        color: #fff !important;
    }
    .pool-list-scroll {
        max-height: calc(100vh - 320px);
        min-height: 360px;
        overflow-y: auto;
    }
    .cleaner-card {
        border: 1px solid rgba(26, 32, 44, 0.1);
    }
    .cleaner-card .card-header {
        background: linear-gradient(135deg, #16213a 0%, #1f2d4d 100%);
        color: #fff;
    }
    .cleaner-kpi .card {
        border: 0;
        box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08);
    }
    .cleaner-kpi h5 {
        font-size: 1.1rem;
        margin-bottom: 0;
    }
    .cleaner-progress {
        height: 10px;
    }
    @media (max-width: 767.98px) {
        .cleaner-actions .btn {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>
        {{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    {% if error %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i data-feather="alert-circle" class="align-self-center icon-xs me-2"></i>
        {{ error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    {% if current_list_id is null %}
    <div class="alert alert-warning">Havuz listesi bulunamadı. Veritabanı migration’ını çalıştırın (<code>email_data_pool_lists</code>).</div>
    {% else %}
    {% set inactive_count = passive_count|default(total - active_count) %}
    {% set list_pages = (list_total / list_per_page)|round(0, 'ceil') %}
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="card h-100">
                <div class="card-header border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">Havuz listeleri</h5>
                            <small class="text-muted">{{ pool_lists|length }} liste · Tümü <strong>{{ total_all_pools_entries|default(0)|number_format }}</strong> kayıt</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#newListModal" title="Yeni liste">
                            <i data-feather="plus" class="icon-xs"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body border-bottom py-2">
                    <input
                        type="text"
                        id="poolListSearch"
                        class="form-control form-control-sm"
                        placeholder="Liste ara..."
                        value="{{ list_search|default('') }}"
                        autocomplete="off">
                </div>
                <div class="list-group list-group-flush pool-list-group pool-list-scroll">
                    {% for pl in pool_lists %}
                    <a href="/admin/email-data-pool?list_id={{ pl.id }}{% if list_search %}&list_search={{ list_search|url_encode }}{% endif %}{% if list_page > 1 %}&list_page={{ list_page }}{% endif %}"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 {% if pl.id == current_list_id %}active{% endif %}">
                        <span class="text-truncate me-2" title="{{ pl.name }}">{{ pl.name }}</span>
                        <span class="badge {% if pl.id == current_list_id %}bg-white text-primary{% else %}bg-soft-secondary text-secondary{% endif %} rounded-pill">{{ pl.entry_count|number_format }}</span>
                    </a>
                    {% else %}
                    <div class="list-group-item text-muted small">Eşleşen liste bulunamadı.</div>
                    {% endfor %}
                </div>
                {% if list_pages > 1 %}
                <div class="card-body border-top py-2">
                    <div class="d-flex align-items-center justify-content-between small">
                        {% set prev_page = list_page - 1 %}
                        {% set next_page = list_page + 1 %}
                        <a class="btn btn-soft-secondary btn-sm {% if list_page <= 1 %}disabled{% endif %}" href="/admin/email-data-pool?list_id={{ current_list_id }}{% if list_search %}&list_search={{ list_search|url_encode }}{% endif %}&list_page={{ prev_page > 0 ? prev_page : 1 }}">Önceki</a>
                        <span class="text-muted">{{ list_page }} / {{ list_pages }}</span>
                        <a class="btn btn-soft-secondary btn-sm {% if list_page >= list_pages %}disabled{% endif %}" href="/admin/email-data-pool?list_id={{ current_list_id }}{% if list_search %}&list_search={{ list_search|url_encode }}{% endif %}&list_page={{ next_page <= list_pages ? next_page : list_pages }}">Sonraki</a>
                    </div>
                </div>
                {% endif %}
                <div class="card-body border-top pt-3">
                    <button type="button" class="btn btn-sm btn-soft-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#editListModal">
                        <i data-feather="edit-2" class="icon-xs me-1"></i> Listeyi düzenle
                    </button>
                    <form method="post" action="/admin/email-data-pool/lists/{{ current_list_id }}/delete" class="mb-0" onsubmit="return confirm('Bu listeyi silmek istediğinize emin misiniz? (Liste boş olmalıdır.)');">
                        <button type="submit" class="btn btn-sm btn-soft-danger w-100">
                            <i data-feather="trash-2" class="icon-xs me-1"></i> Listeyi sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="card">
                <div class="card-header border-bottom py-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1 min-w-0">
                            <h5 class="card-title mb-1 text-truncate" title="{{ current_list_name|default('') }}">{{ current_list_name|default('Liste') }}</h5>
                            <p class="text-muted mb-0 small">Bu listedeki adresler tabloda önizlenmez; dışa aktarma ile tam listeyi alın. <strong>Mail çıkar</strong> ile yalnızca bu listeyi veya <em>tüm listeleri</em> hedefleyebilirsiniz.</p>
                        </div>
                        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                                <i data-feather="plus" class="icon-xs me-1"></i> Mail ekle
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#removeModal">
                                <i data-feather="minus" class="icon-xs me-1"></i> Mail çıkar
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-4">
                    {% if total < 1 %}
                    <div class="text-center py-5 px-2">
                        <div class="avatar-lg mx-auto mb-3">
                            <span class="avatar-title rounded-circle bg-soft-primary text-primary" style="width: 80px; height: 80px;">
                                <i data-feather="inbox" style="width: 36px; height: 36px;"></i>
                            </span>
                        </div>
                        <h5 class="text-muted mb-2">Bu listede henüz kayıt yok</h5>
                        <p class="text-muted small mb-4">Manuel veya dosyadan toplu ekleme yapabilirsiniz.</p>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                            <i data-feather="plus" class="icon-xs me-1"></i> Mail ekle
                        </button>
                    </div>
                    {% else %}
                    <div class="row g-3 mb-4">
                        <div class="col-sm-4">
                            <div class="card mb-0 h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 me-3">
                                            <div class="avatar-sm rounded-circle bg-soft-primary">
                                                <span class="avatar-title"><i data-feather="database" class="icon-dual-primary icon-xs"></i></span>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <p class="text-muted mb-1 small">Toplam kayıt</p>
                                            <h4 class="mb-0 text-truncate">{{ total|number_format }}</h4>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="card mb-0 h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 me-3">
                                            <div class="avatar-sm rounded-circle bg-soft-success">
                                                <span class="avatar-title"><i data-feather="check-circle" class="icon-dual-success icon-xs"></i></span>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <p class="text-muted mb-1 small">Aktif</p>
                                            <h4 class="mb-0 text-truncate">{{ active_count|number_format }}</h4>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="card mb-0 h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 me-3">
                                            <div class="avatar-sm rounded-circle bg-soft-secondary">
                                                <span class="avatar-title"><i data-feather="pause-circle" class="icon-dual-secondary icon-xs"></i></span>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <p class="text-muted mb-1 small">Pasif</p>
                                            <h4 class="mb-0 text-truncate">{{ inactive_count|number_format }}</h4>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-2 border-top">
                        <p class="small text-muted mb-0">
                            Bu listeden çıkarma veya <strong>tüm havuz listelerinden</strong> silme için <strong>Mail çıkar</strong> içinde kapsam seçin. Listenin tamamı için <strong>Tümünü sil</strong>.
                            {% if updated_count_at %}
                                <br><span class="text-muted">Sayaç güncelleme: {{ updated_count_at }}</span>
                            {% endif %}
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i data-feather="download" class="icon-xs me-1"></i> Dışa aktar
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/admin/email-data-pool/export-txt?list_id={{ current_list_id }}">
                                        <i data-feather="file-minus" class="icon-xs me-2"></i> TXT (sadece email)
                                    </a></li>
                                    <li><a class="dropdown-item" href="/admin/email-data-pool/export-excel?list_id={{ current_list_id }}">
                                        <i data-feather="file" class="icon-xs me-2"></i> Excel
                                    </a></li>
                                    <li><a class="dropdown-item" href="/admin/email-data-pool/export-csv?list_id={{ current_list_id }}">
                                        <i data-feather="file-text" class="icon-xs me-2"></i> CSV
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><span class="dropdown-item-text small text-muted">Büyük listeler için CSV önerilir.</span></li>
                                </ul>
                            </div>
                            <button type="button" class="btn btn-sm btn-soft-danger" onclick="deleteAll()">
                                <i data-feather="trash-2" class="icon-xs me-1"></i> Tümünü sil
                            </button>
                        </div>
                    </div>
                    {% endif %}

                    <div class="card cleaner-card mt-4" id="mailCleanerCard">
                        <div class="card-header py-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <h5 class="mb-0 d-flex align-items-center gap-2">
                                    <i data-feather="shield" class="icon-xs"></i> Mail Temizleme Araçları
                                </h5>
                                <small class="opacity-75">Seçili liste: {{ current_list_name|default('Yok') }}</small>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Bu araçlar yalnızca seçili havuz listesinde çalışır. Analiz otomatik çalışmaz; butonla tetiklenir.</p>
                            <div class="row g-2 cleaner-actions mb-3">
                                <div class="col-md-6 col-lg-4">
                                    <button type="button" class="btn btn-sm btn-primary w-100 cleaner-action-btn" id="cleanerAnalyzeBtn" {% if not current_list_id %}disabled{% endif %}>
                                        <i data-feather="bar-chart-2" class="icon-xs me-1"></i> Analiz Et
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button type="button" class="btn btn-sm btn-soft-secondary w-100 cleaner-action-btn" id="cleanerExportBtn" {% if not current_list_id %}disabled{% endif %}>
                                        <i data-feather="download" class="icon-xs me-1"></i> Gmail Dışı Mailleri İndir
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button type="button" class="btn btn-sm btn-soft-danger w-100 cleaner-action-btn" id="cleanerDeleteNonGmailBtn" {% if not current_list_id %}disabled{% endif %}>
                                        <i data-feather="trash-2" class="icon-xs me-1"></i> Gmail Dışı Mailleri Sil
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button type="button" class="btn btn-sm btn-soft-warning w-100 cleaner-action-btn" id="cleanerFixTyposBtn" {% if not current_list_id %}disabled{% endif %}>
                                        <i data-feather="edit-3" class="icon-xs me-1"></i> Gmail Hatalarını Düzelt
                                    </button>
                                </div>
                                <div class="col-md-6 col-lg-4">
                                    <button type="button" class="btn btn-sm btn-soft-info w-100 cleaner-action-btn" id="cleanerRemoveDuplicatesBtn" {% if not current_list_id %}disabled{% endif %}>
                                        <i data-feather="copy" class="icon-xs me-1"></i> Duplicate Temizle
                                    </button>
                                </div>
                            </div>

                            <div id="cleanerProgressWrap" class="mb-3 d-none">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span id="cleanerProgressText">İşlem sürüyor...</span>
                                    <span id="cleanerProgressPercent">0%</span>
                                </div>
                                <div class="progress cleaner-progress">
                                    <div id="cleanerProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
                                </div>
                            </div>

                            <div class="row g-2 cleaner-kpi d-none" id="cleanerKpiGrid">
                                <div class="col-sm-6 col-lg-4 col-xl-2">
                                    <div class="card h-100">
                                        <div class="card-body py-3">
                                            <p class="text-muted small mb-1">Toplam Kayıt</p>
                                            <h5 id="kpiTotal">0</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4 col-xl-2">
                                    <div class="card h-100 border border-success-subtle">
                                        <div class="card-body py-3">
                                            <p class="text-muted small mb-1">Gmail</p>
                                            <h5 class="text-success" id="kpiGmail">0</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4 col-xl-2">
                                    <div class="card h-100 border border-danger-subtle">
                                        <div class="card-body py-3">
                                            <p class="text-muted small mb-1">Gmail Dışı</p>
                                            <h5 class="text-danger" id="kpiNonGmail">0</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4 col-xl-2">
                                    <div class="card h-100 border border-warning-subtle">
                                        <div class="card-body py-3">
                                            <p class="text-muted small mb-1">Hatalı Gmail Domaini</p>
                                            <h5 class="text-warning" id="kpiTypo">0</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4 col-xl-2">
                                    <div class="card h-100 border border-info-subtle">
                                        <div class="card-body py-3">
                                            <p class="text-muted small mb-1">Duplicate</p>
                                            <h5 class="text-info" id="kpiDuplicate">0</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4 col-xl-2">
                                    <div class="card h-100 border border-secondary-subtle">
                                        <div class="card-body py-3">
                                            <p class="text-muted small mb-1">Silinebilir Kayıt</p>
                                            <h5 class="text-secondary" id="kpiDeletable">0</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="cleanerPreviewWrap" class="mt-3 d-none">
                                <div class="row g-3">
                                    <div class="col-lg-6">
                                        <div class="border rounded p-3 h-100">
                                            <p class="small fw-semibold mb-2">Normalize önizleme</p>
                                            <pre class="small mb-0 text-muted" id="cleanerNormalizedPreview"></pre>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="border rounded p-3 h-100">
                                            <p class="small fw-semibold mb-2">Gmail dışı önizleme</p>
                                            <pre class="small mb-0 text-muted" id="cleanerNonGmailPreview"></pre>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<!-- Yeni liste -->
<div class="modal fade" id="newListModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/admin/email-data-pool/lists">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni veri listesi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Liste adı</label>
                        <input type="text" name="name" class="form-control" required maxlength="255" placeholder="örn. Kampanya A">
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Sıra</label>
                        <input type="number" name="sort_order" class="form-control" value="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Liste düzenle -->
{% if current_list_id %}
<div class="modal fade" id="editListModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/admin/email-data-pool/lists/{{ current_list_id }}/update">
                <div class="modal-header">
                    <h5 class="modal-title">Liste düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    {% for pl in pool_lists %}
                    {% if pl.id == current_list_id %}
                    <div class="mb-3">
                        <label class="form-label">Liste adı</label>
                        <input type="text" name="name" class="form-control" required maxlength="255" value="{{ pl.name }}">
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Sıra</label>
                        <input type="number" name="sort_order" class="form-control" value="{{ pl.sort_order }}">
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

<!-- Loading Overlay -->
<div id="loadingOverlay" class="flex-column" aria-hidden="true">
    <div class="text-center px-3" style="max-width: 420px;">
        <div class="spinner-border text-white mb-3" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 0.3rem;">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
        <h5 class="text-white mb-2" id="loadingText">İşlem yapılıyor…</h5>
        <p class="text-white-50 small mb-3" id="loadingSubtext">Lütfen bekleyin</p>
        <div class="progress mx-auto rounded-pill" style="width: 100%; max-width: 300px; height: 8px; background: rgba(255,255,255,0.15);">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success rounded-pill" id="loadingProgress" role="progressbar" style="width: 0%"></div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title d-flex align-items-center gap-2 mb-0">
                    <i data-feather="plus-circle" class="icon-xs icon-dual-primary"></i> Mail havuzuna ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/email-data-pool" method="POST" id="addForm" onsubmit="return showAddLoading()">
                <input type="hidden" name="pool_list_id" value="{{ current_list_id|default(0) }}">
                <div class="modal-body">
                    <ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#manualTab" role="tab">
                                <i data-feather="edit-3" class="icon-xs me-1"></i> Manuel
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#fileTab" role="tab">
