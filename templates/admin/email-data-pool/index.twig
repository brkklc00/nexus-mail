async function runFill(sourceType, triggerBtn = null) {
    try {
        const previewPayload = sourceType === 'list'
            ? (balancePreviewState.fill_to_target_payload || (await postBalance('complete-preview', getFillPayload(sourceType)))?.data || {})
            : (balancePreviewState.fill_manual_payload || (await postBalance('complete-preview', getFillPayload(sourceType)))?.data || {});
        const willProcess = Number(previewPayload?.willMove || 0);
        if (!confirm(`Seçili ayarlarla hedef tamamlama işlemi başlatılsın mı?\nİşlenecek kayıt: ${willProcess.toLocaleString('tr-TR')}`)) return;
        setButtonLoading(triggerBtn, true, 'Uygulanıyor...');
        setBalanceButtonsDisabled(true);
        startCleanerProgress('Hedefe tamamlama çalışıyor...');
        startOperationProgressTracker({
            mode: 'increase',
            startTotal: Number(previewPayload?.targetCurrent || cleanerState?.stats?.total || 0),
            expectedDelta: willProcess,
            label: 'Hedefe tamamlama çalışıyor'
        });
        const queued = await postBalance('complete-apply', getFillPayload(sourceType));
        const jobId = Number(queued?.data?.jobId || queued?.job_id || 0);
        if (!jobId) throw new Error(queued.message || 'Job başlatılamadı.');
        const done = await waitForBackgroundJob(jobId, 'Hedefe tamamlama işlemi çalışıyor...');
        openResultModal(done.result || {});
        await loadTopStats(false);
        if (sourceType === 'list') {
            balancePreviewState.fill_to_target = false;
            setPreviewSummary('fillPreviewSummary', 'Önizleme bekleniyor.');
        } else {
            balancePreviewState.fill_manual = false;
            setPreviewSummary('manualFillPreviewSummary', 'Önizleme bekleniyor.');
        }
    } catch (error) {
        showCleanerToast('error', error.message);
    } finally {
        stopOperationProgressTracker();
        setButtonLoading(triggerBtn, false);
        finishCleanerProgress();
        setBalanceButtonsDisabled(false);
    }
}

