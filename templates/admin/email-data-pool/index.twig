function startOperationProgressTracker(config = {}) {
    stopOperationProgressTracker();
    const expectedDelta = Math.max(0, Number(config.expectedDelta || 0));
    const startTotal = Math.max(0, Number(config.startTotal || 0));
    const mode = String(config.mode || 'increase');
    const label = String(config.label || 'İşlem çalışıyor...');
    if (expectedDelta < 1) {
        return;
    }

    const tick = async () => {
        try {
            const data = await poolFetch(statsUrl(), {}, 'İşlem ilerleme verisi alınamadı.');
            const currentTotal = Math.max(0, Number(data.total || 0));
            let processed = 0;
            if (mode === 'decrease') {
                processed = Math.max(0, startTotal - currentTotal);
            } else {
                processed = Math.max(0, currentTotal - startTotal);
            }
            const percent = Math.min(99, Math.floor((processed / expectedDelta) * 100));
            setCleanerProgress(`${label} (${processed.toLocaleString('tr-TR')} / ${expectedDelta.toLocaleString('tr-TR')})`, percent);
        } catch (_) {
            // Tracker için sessiz geç: ana işlem akışı zaten hataları gösterecek.
        }
    };

    tick();
    cleanerState.operationProgressTimer = setInterval(tick, 1200);
}

