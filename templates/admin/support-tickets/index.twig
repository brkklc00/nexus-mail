{% extends '_layouts/main.twig' %}

{% block title %}Müşteri Destek Talepleri - Admin Panel - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
<li class="breadcrumb-item active">Destek Talepleri</li>
{% endblock %}

{% block page_icon %}<i data-feather="headphones" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Müşteri Destek Talepleri{% endblock %}

{% block styles %}
<style>
.stat-card {
    transition: transform 0.2s, box-shadow 0.2s;
}
.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
}
</style>
{% endblock %}

{% block content %}

<!-- İstatistikler -->
<div class="row mb-4">
    <div class="col-lg-4 mb-3">
        <div class="card stat-card" style="min-height: 140px;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i data-feather="alert-circle" class="text-success" style="width: 40px; height: 40px;"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Açık Talepler</h6>
                        <h3 class="mb-0">{{ stats.open|number_format(0, ',', '.') }}</h3>
                        <small class="text-success">Yanıt Bekliyor</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card stat-card" style="min-height: 140px;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i data-feather="clock" class="text-warning" style="width: 40px; height: 40px;"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Bekleyen Talepler</h6>
                        <h3 class="mb-0">{{ stats.pending|number_format(0, ',', '.') }}</h3>
                        <small class="text-warning">Müşteri Yanıtında</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card stat-card" style="min-height: 140px;">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i data-feather="check-circle" class="text-secondary" style="width: 40px; height: 40px;"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Kapalı Talepler</h6>
                        <h3 class="mb-0">{{ stats.closed|number_format(0, ',', '.') }}</h3>
                        <small class="text-secondary">Çözüldü</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtre ve Liste -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <h4 class="card-title mb-0">
                            <i data-feather="message-circle" class="icon-xs me-2"></i>
                            Tüm Talepler
                        </h4>
                        <small class="text-muted">Toplam {{ total }} talep</small>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="btn-group" role="group">
                            <a href="/admin/support-tickets" class="btn btn-sm {% if not currentStatus %}btn-primary{% else %}btn-outline-primary{% endif %}">
                                Tümü
                            </a>
                            <a href="/admin/support-tickets?status=open" class="btn btn-sm {% if currentStatus == 'open' %}btn-success{% else %}btn-outline-success{% endif %}">
                                Açık
                            </a>
                            <a href="/admin/support-tickets?status=pending" class="btn btn-sm {% if currentStatus == 'pending' %}btn-warning{% else %}btn-outline-warning{% endif %}">
                                Bekleyen
                            </a>
                            <a href="/admin/support-tickets?status=closed" class="btn btn-sm {% if currentStatus == 'closed' %}btn-secondary{% else %}btn-outline-secondary{% endif %}">
                                Kapalı
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Kullanıcı</th>
                                <th>Konu</th>
                                <th>Durum</th>
                                <th>Son Aktivite</th>
                                <th>Oluşturulma</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ticket in tickets %}
                            <tr>
                                <td><strong>#{{ ticket.id }}</strong></td>
                                <td>
                                    {% if ticket.user %}
                                        <div>
                                            <strong>{{ ticket.user.name }}</strong><br>
                                            <small class="text-muted">{{ ticket.user.email }}</small>
                                        </div>
                                    {% else %}
                                        <span class="text-muted">Kullanıcı bulunamadı</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div>
                                        <strong>{{ ticket.subject }}</strong><br>
                                        <small class="text-muted">{{ ticket.messages|length }} mesaj</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge {{ ticket.status.getBadgeClass() }}">
                                        {{ ticket.status.getLabel() }}
                                    </span>
                                </td>
                                <td>
                                    <small>{{ ticket.lastActivityAt|date('d.m.Y H:i') }}</small>
                                </td>
                                <td>
                                    <small>{{ ticket.createdAt|date('d.m.Y H:i') }}</small>
                                </td>
                                <td class="text-end">
                                    <button type="button" 
                                            class="btn btn-sm btn-primary" 
                                            onclick="viewTicket({{ ticket.id }})"
                                            title="Detayları Görüntüle">
                                        <i data-feather="eye" class="icon-xs"></i>
                                    </button>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i data-feather="inbox" class="icon-lg mb-2"></i>
                                    <p class="mb-0">Henüz talep bulunmamaktadır</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>


                <!-- Pagination -->
                {% if totalPages > 1 %}
                <div class="row mt-3">
                    <div class="col-12">
                        <nav>
                            <ul class="pagination justify-content-center mb-0">
                                {% if currentPage > 1 %}
                                <li class="page-item">
                                    <a class="page-link" href="/admin/support-tickets?page={{ currentPage - 1 }}{% if currentStatus %}&status={{ currentStatus }}{% endif %}">Önceki</a>
                                </li>
                                {% endif %}

                                {% for i in 1..totalPages %}
                                    {% if i == currentPage %}
                                    <li class="page-item active"><a class="page-link" href="#">{{ i }}</a></li>
                                    {% elseif i == 1 or i == totalPages or (i >= currentPage - 2 and i <= currentPage + 2) %}
                                    <li class="page-item"><a class="page-link" href="/admin/support-tickets?page={{ i }}{% if currentStatus %}&status={{ currentStatus }}{% endif %}">{{ i }}</a></li>
                                    {% elseif i == currentPage - 3 or i == currentPage + 3 %}
                                    <li class="page-item disabled"><a class="page-link" href="#">...</a></li>
                                    {% endif %}
                                {% endfor %}

                                {% if currentPage < totalPages %}
                                <li class="page-item">
                                    <a class="page-link" href="/admin/support-tickets?page={{ currentPage + 1 }}{% if currentStatus %}&status={{ currentStatus }}{% endif %}">Sonraki</a>
                                </li>
                                {% endif %}
                            </ul>
                        </nav>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Ticket Detay Modal -->
<div class="modal fade" id="ticketDetailModal" tabindex="-1" aria-labelledby="ticketDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ticketDetailModalLabel">
                    <i data-feather="message-square" class="icon-xs me-2"></i>
                    Talep Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="ticketDetailContent" style="min-height: 400px;">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <p class="mt-3 text-muted">Talep detayları yükleniyor...</p>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/izitoast@1.4.0/dist/js/iziToast.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/izitoast@1.4.0/dist/css/iziToast.min.css">

<script>
feather.replace();

// Success mesajı varsa göster
{% if success %}
iziToast.success({
    title: 'Başarılı',
    message: '{{ success }}',
    position: 'topRight',
    timeout: 5000,
    icon: 'fas fa-check-circle'
});
{% endif %}

// Ticket detayını göster
function viewTicket(ticketId) {
    const modal = new bootstrap.Modal(document.getElementById('ticketDetailModal'));
    const content = document.getElementById('ticketDetailContent');
    
    // Loading göster
    content.innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="mt-3 text-muted">Talep detayları yükleniyor...</p>
        </div>
    `;
    
    modal.show();
    
    // AJAX ile detayı yükle
    fetch('/admin/support-tickets/' + ticketId + '/detail')
        .then(response => {
            if (!response.ok) {
                throw new Error('Talep detayları yüklenemedi');
            }
            return response.text();
        })
        .then(html => {
            content.innerHTML = html;
            feather.replace();
        })
        .catch(error => {
            content.innerHTML = `
                <div class="alert alert-danger m-4">
                    <i data-feather="alert-circle" class="icon-xs me-2"></i>
                    <strong>Hata:</strong> ${error.message}
                </div>
            `;
            feather.replace();
            
            iziToast.error({
                title: 'Hata',
                message: error.message,
                position: 'topRight'
            });
        });
}

// Reply form submit (modal içinden çağrılacak)
function submitReply(ticketId) {
    const form = document.getElementById('replyForm');
    const formData = new FormData(form);
    const submitBtn = form.querySelector('button[type="submit"]');
    
    // Button'u disable et
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Gönderiliyor...';
    
    fetch('/admin/support-tickets/' + ticketId + '/reply', {
        method: 'POST',
        body: formData
    })
    .then(response => {
        if (response.ok) {
            iziToast.success({
                title: 'Başarılı',
                message: 'Cevabınız başarıyla gönderildi',
                position: 'topRight'
            });
            
            // Modal'ı kapat ve sayfayı yenile
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        } else {
            throw new Error('Cevap gönderilemedi');
        }
    })
    .catch(error => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-feather="send" class="icon-xs me-1"></i> Cevap Gönder';
        feather.replace();
        
        iziToast.error({
            title: 'Hata',
            message: error.message,
            position: 'topRight'
        });
    });
    
    return false;
}

// Close ticket (modal içinden çağrılacak)
function closeTicket(ticketId) {
    iziToast.question({
        timeout: 20000,
        close: false,
        overlay: true,
        displayMode: 'once',
        id: 'question',
        zindex: 999999,
        title: 'Emin misiniz?',
        message: 'Bu talebi kapatmak istediğinize emin misiniz?',
        position: 'center',
        buttons: [
            ['<button><b>Evet</b></button>', function (instance, toast) {
                instance.hide({ transitionOut: 'fadeOut' }, toast, 'button');
                
                fetch('/admin/support-tickets/' + ticketId + '/close', {
                    method: 'POST'
                })
                .then(response => {
                    if (response.ok) {
                        iziToast.success({
                            title: 'Başarılı',
                            message: 'Talep başarıyla kapatıldı',
                            position: 'topRight'
                        });
                        
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        throw new Error('Talep kapatılamadı');
                    }
                })
                .catch(error => {
                    iziToast.error({
                        title: 'Hata',
                        message: error.message,
                        position: 'topRight'
                    });
                });
            }, true],
            ['<button>İptal</button>', function (instance, toast) {
                instance.hide({ transitionOut: 'fadeOut' }, toast, 'button');
            }]
        ]
    });
}
</script>
{% endblock %}
