<!-- Detay Modal -->
<div class="modal fade nx-adm-eo-modal-root" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content nx-adm-eo-modal">
            <div class="modal-header nx-adm-eo-modal-head border-0">
                <h5 class="modal-title text-white mb-0 d-flex align-items-center gap-2">
                    <span class="nx-adm-eo-modal-head-ic"><i data-feather="mail"></i></span>
                    Sipariş detayı · #<span id="modalOrderId"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body bg-light p-0" id="orderDetailContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let searchTimer;
const defaultPerPage = '{{ per_page|default(50) }}';
const approvalState = {
    modal: null,
    orderId: null,
    orderTotal: 0,
    isPoolOrder: false,
    selectedDataPoolId: null,
    selectedCustomer: null,
    balanceInfo: null,
    usersPage: 1,
    usersTotalPages: 1,
    usersQuery: '',
    lists: [],
    openKey: 0,
    busy: false,
    contextController: null,
    usersController: null,
    userDetailController: null
};

function approvalStatusBadge(statusRaw) {
    const status = String(statusRaw || '').toLowerCase();
    const map = {
        pending_approval: ['Onay Bekliyor', 'nx-adm-eo-status nx-adm-eo-status--pending_approval'],
        approved: ['Onaylandı', 'nx-adm-eo-status nx-adm-eo-status--sent'],
        pending: ['Kuyrukta', 'nx-adm-eo-status nx-adm-eo-status--pending'],
        completed: ['Tamamlandı', 'nx-adm-eo-status nx-adm-eo-status--completed'],
        rejected: ['Reddedildi', 'nx-adm-eo-status nx-adm-eo-status--failed'],
        failed: ['Başarısız', 'nx-adm-eo-status nx-adm-eo-status--failed']
    };
    const [label, klass] = map[status] || [status || '-', 'nx-adm-eo-status'];
    return `<span class="${klass}">${label}</span>`;
}

function formatTrNumber(value) {
    return Number(value || 0).toLocaleString('tr-TR');
}

function renderSelectedCustomerCard() {
    const card = document.getElementById('approvalSelectedCustomerCard');
    if (!card) return;
    if (!approvalState.selectedCustomer) {
        card.classList.add('d-none');
        card.innerHTML = '';
        return;
    }
    const c = approvalState.selectedCustomer;
    card.classList.remove('d-none');
    card.innerHTML = `
        <div class="fw-semibold">${c.name || '-'}</div>
        <div class="small text-muted">${c.email || '-'}</div>
        <div class="small mt-1">Müşteri ID: <strong>#${c.id || '-'}</strong></div>
        <div class="small">Mevcut bakiye: <strong>${formatTrNumber(c.currentBalance)}</strong></div>
    `;
}

function renderDataPoolMeta() {
    const meta = document.getElementById('approvalDataPoolMeta');
    if (!meta) return;
    const selectedId = Number(document.getElementById('approvalDataListSelect').value || 0);
    if (!selectedId) {
        meta.className = 'nx-adm-eo-data-pool-meta mt-2';
        meta.textContent = approvalState.isPoolOrder
            ? 'Devam etmek için bir veri listesi seçin.'
            : 'Bu sipariş için veri listesi zorunlu değil.';
        return;
    }
    const selected = approvalState.lists.find(item => Number(item.id) === selectedId);
    if (!selected) {
        meta.className = 'nx-adm-eo-data-pool-meta mt-2';
        meta.textContent = 'Seçilen veri listesi bulunamadı.';
        return;
    }
    const activeCount = Number(selected.activeCount || 0);
    const required = Number(approvalState.orderTotal || 0);
    const enough = activeCount >= required || !approvalState.isPoolOrder;
    meta.className = `nx-adm-eo-data-pool-meta mt-2 ${enough ? '' : 'nx-adm-eo-data-pool-meta--warn'}`.trim();
    meta.innerHTML = `
        <div><strong>${selected.name || '-'}</strong></div>
        <div>Aktif kayıt: <strong>${formatTrNumber(activeCount)}</strong></div>
        <div>${enough ? 'Gönderim adedi ile uyumlu.' : 'Seçilen veri listesinde gönderim adedinden daha az aktif kayıt var.'}</div>
    `;
}

function renderApprovalIntent() {
    const intent = document.getElementById('approvalIntentText');
    if (!intent) return;
    const orderId = approvalState.orderId || '-';
    const total = Number(approvalState.orderTotal || 0);
    const customer = approvalState.selectedCustomer;
    const selectedId = Number(document.getElementById('approvalDataListSelect').value || 0);
    const selectedList = approvalState.lists.find(item => Number(item.id) === selectedId);
    const needsList = !!approvalState.isPoolOrder;

    if (!customer || (needsList && !selectedList)) {
        intent.textContent = 'Devam etmek için müşteri ve veri listesi seçmelisin.';
        return;
    }
    if (approvalState.balanceInfo && !approvalState.balanceInfo.canApprove) {
        intent.textContent = 'Bu müşteri bakiyesi gönderim için yeterli değil.';
        return;
    }
    const listText = selectedList ? selectedList.name : 'varsayılan kaynak';
    intent.textContent = `Kampanya #${orderId}, ${customer.name} hesabından ${formatTrNumber(total)} kredi düşülerek ${listText} veri listesiyle gönderim kuyruğuna alınacak.`;
}

function handleSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
        applyFilters();
    }, 500);
}

function applyFilters() {
    const search = document.getElementById('searchInput').value;
    const status = document.getElementById('statusFilter').value;
    const userId = document.getElementById('userFilter').value;
    const sort = '{{ sort }}';
    const dir = '{{ dir }}';
    
    let url = '/admin/email-orders?';
    const params = [];
    
    if (search) {
        params.push(`search=${encodeURIComponent(search)}`);
    }
    if (status) {
        params.push(`status=${status}`);
    }
    if (userId) {
        params.push(`user_id=${userId}`);
    }
    if (sort) {
        params.push(`sort=${sort}`);
    }
    if (dir) {
        params.push(`dir=${dir}`);
    }
    if (defaultPerPage) {
        params.push(`per_page=${defaultPerPage}`);
    }
    
    window.location.href = url + params.join('&');
}

function clearFilters() {
    window.location.href = '/admin/email-orders';
}

function sortBy(field) {
    const currentSort = '{{ sort }}';
    const currentDir = '{{ dir }}';
    const search = document.getElementById('searchInput').value;
    const status = document.getElementById('statusFilter').value;
    const userId = document.getElementById('userFilter').value;
    
    // Aynı sütuna tıklanırsa yönü değiştir
    let newDir = 'DESC';
    if (currentSort === field && currentDir === 'DESC') {
        newDir = 'ASC';
    }
    
    let url = '/admin/email-orders?';
    const params = [];
    
    if (search) {
        params.push(`search=${encodeURIComponent(search)}`);
    }
    if (status) {
        params.push(`status=${status}`);
    }
    if (userId) {
        params.push(`user_id=${userId}`);
    }
    if (defaultPerPage) {
        params.push(`per_page=${defaultPerPage}`);
    }
    params.push(`sort=${field}`);
    params.push(`dir=${newDir}`);
    
    window.location.href = url + params.join('&');
}

function viewOrderDetails(orderId) {
    const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
    document.getElementById('modalOrderId').textContent = orderId;
    document.getElementById('orderDetailContent').innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
        </div>
    `;
    modal.show();
    
    fetch(`/admin/email-orders/${orderId}/details?section=summary`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                renderOrderDetails(data.order);
            } else {
                console.error('API Error:', data);
                document.getElementById('orderDetailContent').innerHTML = `
                    <div class="alert alert-danger">
                        <i data-feather="alert-circle" class="me-2"></i> 
                        <strong>${data.message || 'Bilinmeyen bir hata oluştu'}</strong>
                        ${data.error ? `<br><small class="text-muted mt-2">Hata detayı: ${data.error}</small>` : ''}
                    </div>
                `;
                feather.replace();
            }
        })
        .catch(error => {
            console.error('Fetch Error:', error);
            document.getElementById('orderDetailContent').innerHTML = `
                <div class="alert alert-danger">
                    <i data-feather="alert-circle" class="me-2"></i> 
                    <strong>Bir hata oluştu:</strong><br>
                    ${error.message}<br>
                    <small class="text-muted mt-2">Lütfen sayfayı yenileyin ve tekrar deneyin.</small>
                </div>
            `;
            feather.replace();
        });
}

function editOrderTemplate(orderId) {
    document.getElementById('editOrderId').value = orderId;
    document.getElementById('editModalOrderId').textContent = orderId;
    fetch(`/admin/email-orders/${orderId}/details?section=summary&include_body=1`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('editSubject').value = data.order.subject;
                document.getElementById('editBody').value = data.order.body;
                new bootstrap.Modal(document.getElementById('editTemplateModal')).show();
            }
        });
}

function saveOrderTemplate() {
    const orderId = document.getElementById('editOrderId').value;
    const subject = document.getElementById('editSubject').value;
    const body = document.getElementById('editBody').value;
    fetch(`/admin/email-orders/${orderId}/update-template`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ subject, body })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('editTemplateModal')).hide();
            alert('Şablon güncellendi');
            viewOrderDetails(orderId);
        } else {
            alert('Hata: ' + (data.message || 'Güncellenemedi'));
        }
    });
}

function orderSummaryUrl(orderId) {
    return `/admin/email-orders/${orderId}/details?section=summary`;
}

function customerSearchUrl(page, query) {
    return `/admin/email-orders/customers/search?page=${page}&per_page=100&positive_only=1&q=${encodeURIComponent(query || '')}`;
}

function customerBalanceUrl(id, orderId) {
    return `/admin/email-orders/customers/${id}/balance?order_id=${orderId}`;
}

function dataPoolsUrl(orderId) {
    return `/admin/email-orders/data-pools?order_id=${orderId}`;
}

function approveStartUrl(orderId) {
    return `/admin/email-orders/${orderId}/approve-start`;
}

function parseApiErrorMessage(text, status) {
    let parsed = null;
    try {
        parsed = JSON.parse(text);
    } catch (e) {}
    if (parsed && typeof parsed === 'object' && parsed.message) {
        return String(parsed.message);
    }
    const normalizedText = (text || '').trim().toLowerCase();
    if (normalizedText.startsWith('<!doctype') || normalizedText.startsWith('<html')) {
        return status === 401 || status === 403
            ? 'Oturum süresi dolmuş veya yetkiniz yok. Lütfen tekrar giriş yapın.'
            : 'Sunucu beklenmeyen HTML döndü. Oturum kontrolü yapın.';
    }
    if (status === 401 || status === 403) {
        return 'Oturum süresi dolmuş veya yetkiniz yok.';
    }
    if (status === 404) {
        return 'İstenen API endpoint bulunamadı.';
    }
    if (status === 419) {
        return 'Güvenlik doğrulaması başarısız oldu. Sayfayı yenileyip tekrar deneyin.';
    }
    return 'İstek başarısız oldu.';
}

async function fetchJson(url, options = {}) {
    const timeoutMs = Number(options.timeoutMs || 12000);
    const controller = options.signal ? null : new AbortController();
    let timedOut = false;
    const timeoutId = setTimeout(() => {
        if (controller) {
            timedOut = true;
            controller.abort();
        }
    }, timeoutMs);
    let response;
    try {
        response = await fetch(url, {
            ...options,
            signal: options.signal || (controller ? controller.signal : undefined),
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                ...(options.headers || {})
            }
        });
    } catch (err) {
        if (timedOut) {
            const timeoutError = new Error('İstek zaman aşımına uğradı.');
            timeoutError.status = 408;
            throw timeoutError;
        }
        throw err;
    } finally {
        clearTimeout(timeoutId);
    }

    const text = await response.text();
    let data = null;
    try {
        data = text ? JSON.parse(text) : null;
    } catch (e) {
        if (response.ok) {
            const parseErr = new Error('Sunucudan geçerli JSON alınamadı.');
            parseErr.status = response.status;
            throw parseErr;
        }
    }

    if (!response.ok) {
        const err = new Error((data && data.message) ? data.message : parseApiErrorMessage(text, response.status));
        err.status = response.status;
        err.data = data;
        throw err;
    }

    if (!data || typeof data !== 'object') {
        throw new Error('API yanıtı boş veya geçersiz.');
    }

    return data;
}

function resetApprovalControllers() {
    [approvalState.contextController, approvalState.usersController, approvalState.userDetailController].forEach(ctrl => {
        if (ctrl) {
            try { ctrl.abort(); } catch (e) {}
        }
    });
    approvalState.contextController = null;
    approvalState.usersController = null;
    approvalState.userDetailController = null;
}

function isApprovalViewActive(openKey) {
    return approvalState.openKey === openKey && approvalState.orderId !== null;
}

function approveOrder(orderId, isPoolOrder) {
    if (approvalState.busy) return;
    approvalState.busy = true;
    approvalState.openKey = Date.now();
    resetApprovalControllers();
    approvalState.orderId = orderId;
    approvalState.isPoolOrder = !!isPoolOrder;
    approvalState.orderTotal = 0;
    approvalState.selectedDataPoolId = null;
    approvalState.selectedCustomer = null;
    approvalState.balanceInfo = null;
    approvalState.usersPage = 1;
    approvalState.usersTotalPages = 1;
    approvalState.usersQuery = '';
    approvalState.lists = [];

    document.getElementById('approvalOrderId').value = String(orderId);
    document.getElementById('approvalOrderTotal').value = '0';
    document.getElementById('approvalIsPoolOrder').value = isPoolOrder ? '1' : '0';
    document.getElementById('approvalCustomerSearch').value = '';
    document.getElementById('approvalSummaryLoading').classList.remove('d-none');
    document.getElementById('approvalSummaryLoading').innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sipariş özeti yükleniyor...';
    document.getElementById('approvalSummaryContent').classList.add('d-none');
    document.getElementById('approvalSummaryContent').innerHTML = '';
    document.getElementById('approvalCustomersLoading').innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Müşteriler yükleniyor...';
    document.getElementById('approvalAlertWrap').innerHTML = '';
    document.getElementById('approvalBalanceSummary').textContent = 'Müşteri seçilmedi.';
    document.getElementById('approvalDataListSelect').innerHTML = '<option value="">Veri listeleri yükleniyor...</option>';
    document.getElementById('approvalCustomerSelect').innerHTML = '<option value="">Müşteriler yükleniyor...</option>';
    document.getElementById('approvalConfirmBtn').disabled = true;
    document.getElementById('approvalConfirmBtn').innerHTML = 'Onayla ve Başlat';
    document.getElementById('approvalBalanceBadge').className = 'nx-adm-eo-balance-badge d-none';
    renderSelectedCustomerCard();
    renderDataPoolMeta();
    renderApprovalIntent();

    if (!approvalState.modal) {
        approvalState.modal = new bootstrap.Modal(document.getElementById('approvalModal'));
    }
    approvalState.modal.show();
    setTimeout(() => { approvalState.busy = false; }, 200);

    loadOrderSummary(orderId, approvalState.openKey);
    loadCustomers(1, '', approvalState.openKey);
}

function renderApprovalAlert(message, type = 'warning') {
    const normalizedType = ['danger', 'success', 'info', 'warning'].includes(type) ? type : 'warning';
    document.getElementById('approvalAlertWrap').innerHTML = message
        ? `<div class="alert alert-${normalizedType} py-2 mb-0">${message}</div>`
        : '';
}

function loadOrderSummary(orderId, openKey) {
    approvalState.contextController = new AbortController();
    fetchJson(orderSummaryUrl(orderId), {
        signal: approvalState.contextController.signal
    })
        .then(data => {
            if (!isApprovalViewActive(openKey)) return;
            if (!data.success) {
                renderApprovalAlert(data.message || 'Sipariş özeti alınamadı.');
                return;
            }
            const order = data.order || {};
            const template = order.template || {};
            approvalState.orderTotal = Number(order.total || 0);
            approvalState.isPoolOrder = !!order.is_pool_order;
            document.getElementById('approvalOrderTotal').value = String(approvalState.orderTotal);

            const summaryHtml = `
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div><strong>Sipariş ID:</strong> #${order.id || '-'}</div>
                        <div><strong>Konu:</strong> ${order.subject || '-'}</div>
                        <div><strong>Template:</strong> ${template.name || '-'}${template.id ? ` (TPL #${template.id})` : ''}</div>
                        <div><strong>Tarih:</strong> ${order.createdAt || '-'}</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Gönderim adedi</div>
                        <div class="nx-adm-eo-balance-value">${formatTrNumber(approvalState.orderTotal)}</div>
                        ${approvalStatusBadge(order.status)}
                    </div>
                </div>
            `;
            document.getElementById('approvalSummaryContent').innerHTML = summaryHtml;
            document.getElementById('approvalSummaryLoading').classList.add('d-none');
            document.getElementById('approvalSummaryContent').classList.remove('d-none');

            if (approvalState.isPoolOrder) {
                loadDataPools(orderId, openKey);
            } else {
                approvalState.lists = [];
                approvalState.selectedDataPoolId = null;
                document.getElementById('approvalDataListSelect').innerHTML = '<option value="">Bu sipariş için veri listesi gerekli değil</option>';
                renderDataPoolMeta();
            }

            if (approvalState.selectedCustomer) {
                loadCustomerBalance(approvalState.selectedCustomer.id, openKey);
            } else {
                updateApprovalActionState();
            }
            renderApprovalIntent();
        })
        .catch(err => {
            if (err.name === 'AbortError') return;
            if (!isApprovalViewActive(openKey)) return;
            renderApprovalAlert(err.message || 'Sipariş özeti alınamadı.');
            document.getElementById('approvalSummaryLoading').classList.add('d-none');
        });
}

function loadDataPools(orderId, openKey) {
    fetchJson(dataPoolsUrl(orderId), { timeoutMs: 20000 })
        .then(data => {
            if (!isApprovalViewActive(openKey)) return;
            if (!data.success) {
                renderApprovalAlert(data.message || 'Veri listesi alınamadı.');
                return;
            }
            const payload = data.data || {};
            approvalState.lists = Array.isArray(payload.items) ? payload.items : [];
            approvalState.selectedDataPoolId = Number(payload.selectedId || 0) || null;

            const listSelect = document.getElementById('approvalDataListSelect');
            listSelect.innerHTML = '';
            if (!approvalState.lists.length) {
                listSelect.innerHTML = '<option value="">Liste bulunamadı</option>';
                approvalState.selectedDataPoolId = null;
            } else {
                approvalState.lists.forEach(row => {
                    const opt = document.createElement('option');
                    opt.value = String(row.id);
                    opt.textContent = `${row.name} - ${Number(row.activeCount || 0).toLocaleString('tr-TR')} aktif`;
                    if (approvalState.selectedDataPoolId && Number(row.id) === approvalState.selectedDataPoolId) {
                        opt.selected = true;
                    }
                    listSelect.appendChild(opt);
                });
                if (!approvalState.selectedDataPoolId && listSelect.options.length) {
                    listSelect.options[0].selected = true;
                    approvalState.selectedDataPoolId = Number(listSelect.options[0].value || 0) || null;
                }
            }
            updateApprovalActionState();
            renderDataPoolMeta();
        })
        .catch(err => {
            if (err.name === 'AbortError') return;
            if (!isApprovalViewActive(openKey)) return;
            renderApprovalAlert(err.message || 'Veri listesi alınamadı.');
            document.getElementById('approvalDataListSelect').innerHTML = '<option value="">Liste yüklenemedi</option>';
            approvalState.selectedDataPoolId = null;
            updateApprovalActionState();
            renderDataPoolMeta();
        });
}

function loadCustomers(page = 1, query = '', openKey = approvalState.openKey) {
    approvalState.usersPage = page;
    approvalState.usersQuery = query;
    document.getElementById('approvalCustomersLoading').innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Müşteriler yükleniyor...';
    if (approvalState.usersController) {
        try { approvalState.usersController.abort(); } catch (e) {}
    }
    approvalState.usersController = new AbortController();
    fetchJson(customerSearchUrl(page, query), {
        signal: approvalState.usersController.signal
    })
        .then(data => {
            if (!isApprovalViewActive(openKey)) return;
            if (!data.success) {
                renderApprovalAlert(data.message || 'Müşteriler yüklenemedi.');
                document.getElementById('approvalCustomersLoading').textContent = 'Müşteriler yüklenemedi.';
                return;
            }

            const payload = data.data || {};
            const users = Array.isArray(payload.items) ? payload.items : [];
            const select = document.getElementById('approvalCustomerSelect');
            select.innerHTML = '';
            if (!users.length) {
                select.innerHTML = '<option value="">Bakiyesi olan müşteri bulunamadı</option>';
                approvalState.selectedCustomer = null;
                approvalState.balanceInfo = null;
                document.getElementById('approvalBalanceSummary').textContent = 'Müşteri seçilmedi.';
                renderSelectedCustomerCard();
            } else {
                users.forEach(user => {
                    const balance = Number(user.balance || user.credit || 0);
                    const opt = document.createElement('option');
                    opt.value = String(user.id);
                    opt.dataset.balance = String(balance);
                    opt.dataset.name = user.name || '';
                    opt.dataset.email = user.email || '';
                    opt.textContent = `${user.name || '-'} - ${user.email || '-'} - Bakiye: ${balance.toLocaleString('tr-TR')}`;
                    select.appendChild(opt);
                });
                select.selectedIndex = 0;
                handleCustomerSelection(openKey);
            }

            const pagination = payload.pagination || {};
            approvalState.usersTotalPages = Math.max(1, Math.ceil(Number(pagination.total || users.length || 0) / Number(pagination.perPage || 20)));
            approvalState.usersPage = Number(pagination.page || page);
            document.getElementById('approvalUsersPageInfo').textContent = `Sayfa ${approvalState.usersPage} / ${approvalState.usersTotalPages}`;
            document.getElementById('approvalUsersPrevBtn').disabled = approvalState.usersPage <= 1;
            document.getElementById('approvalUsersNextBtn').disabled = approvalState.usersPage >= approvalState.usersTotalPages;
            document.getElementById('approvalCustomersLoading').textContent = '';
            updateApprovalActionState();
        })
        .catch(err => {
            if (err.name === 'AbortError') return;
            if (!isApprovalViewActive(openKey)) return;
            renderApprovalAlert(err.message || 'Müşteriler yüklenemedi.');
            document.getElementById('approvalCustomersLoading').textContent = 'Müşteriler yüklenemedi.';
        });
}

function handleCustomerSelection(openKey = approvalState.openKey) {
    const select = document.getElementById('approvalCustomerSelect');
    const opt = select.options[select.selectedIndex];
    if (!opt || !opt.value) {
        approvalState.selectedCustomer = null;
        approvalState.balanceInfo = null;
        document.getElementById('approvalBalanceSummary').textContent = 'Müşteri seçilmedi.';
        updateApprovalActionState();
        return;
    }
    const current = Number(opt.dataset.balance || 0);
    approvalState.selectedCustomer = {
        id: Number(opt.value),
        name: opt.dataset.name || '',
        email: opt.dataset.email || '',
        currentBalance: current
    };
    renderSelectedCustomerCard();
    // Hızlı UX: önce listedeki bakiye ile anında özet göster, sonra API ile doğrula.
    const required = Number(approvalState.orderTotal || 0);
    approvalState.balanceInfo = {
        balance: current,
        required,
        remaining: current - required,
        canApprove: (current - required) >= 0
    };
    renderBalanceSummary();
    updateApprovalActionState();
    loadCustomerBalance(approvalState.selectedCustomer.id, openKey);
}

function loadCustomerBalance(customerId, openKey = approvalState.openKey) {
    if (!approvalState.orderId || !customerId) {
        approvalState.balanceInfo = null;
        document.getElementById('approvalBalanceSummary').textContent = 'Müşteri seçilmedi.';
        updateApprovalActionState();
        return;
    }

    if (approvalState.userDetailController) {
        try { approvalState.userDetailController.abort(); } catch (e) {}
    }
    approvalState.userDetailController = new AbortController();
    fetchJson(customerBalanceUrl(customerId, approvalState.orderId), {
        signal: approvalState.userDetailController.signal
    })
        .then(data => {
            if (!isApprovalViewActive(openKey)) return;
            if (!data.success) {
                approvalState.balanceInfo = null;
                renderApprovalAlert(data.message || 'Bakiye özeti alınamadı.');
                document.getElementById('approvalBalanceSummary').textContent = 'Bakiye bilgisi alınamadı.';
                updateApprovalActionState();
                return;
            }

            const balanceData = data.data || {};
            approvalState.balanceInfo = {
                balance: Number(balanceData.balance || 0),
                required: Number(balanceData.required || approvalState.orderTotal || 0),
                remaining: Number(balanceData.remaining || 0),
                canApprove: !!balanceData.canApprove
            };
            approvalState.selectedCustomer.currentBalance = approvalState.balanceInfo.balance;
            renderBalanceSummary();
            updateApprovalActionState();
        })
        .catch(err => {
            if (err.name === 'AbortError') return;
            if (!isApprovalViewActive(openKey)) return;
            approvalState.balanceInfo = null;
            renderApprovalAlert(err.message || 'Bakiye özeti alınamadı.');
            document.getElementById('approvalBalanceSummary').textContent = 'Bakiye bilgisi alınamadı.';
            updateApprovalActionState();
        });
}

function renderBalanceSummary() {
    const badge = document.getElementById('approvalBalanceBadge');
    if (!approvalState.balanceInfo) {
        document.getElementById('approvalBalanceSummary').textContent = 'Bakiye bilgisi alınamadı.';
        if (badge) {
            badge.className = 'nx-adm-eo-balance-badge d-none';
            badge.textContent = '';
        }
        return;
    }
    const current = Number(approvalState.balanceInfo.balance || 0);
    const toDeduct = Number(approvalState.balanceInfo.required || approvalState.orderTotal || 0);
    const remaining = Number(approvalState.balanceInfo.remaining || (current - toDeduct));

    document.getElementById('approvalBalanceSummary').innerHTML = `
        <div class="nx-adm-eo-balance-grid">
            <div class="nx-adm-eo-balance-item">
                <span class="nx-adm-eo-balance-label">Mevcut bakiye</span>
                <span class="nx-adm-eo-balance-value">${formatTrNumber(current)}</span>
            </div>
            <div class="nx-adm-eo-balance-item">
                <span class="nx-adm-eo-balance-label">Düşülecek bakiye</span>
                <span class="nx-adm-eo-balance-value">${formatTrNumber(toDeduct)}</span>
            </div>
            <div class="nx-adm-eo-balance-item">
                <span class="nx-adm-eo-balance-label">Kalan bakiye</span>
                <span class="nx-adm-eo-balance-value ${remaining < 0 ? 'nx-adm-eo-balance-value--bad' : 'nx-adm-eo-balance-value--ok'}">${formatTrNumber(remaining)}</span>
            </div>
        </div>
    `;
    if (badge) {
        badge.className = `nx-adm-eo-balance-badge ${remaining < 0 ? 'nx-adm-eo-balance-badge--bad' : 'nx-adm-eo-balance-badge--ok'}`;
        badge.textContent = remaining < 0 ? 'Yetersiz bakiye' : 'Bakiye yeterli';
    }

    if (remaining < 0) {
        renderApprovalAlert(`Yetersiz mail bakiyesi. Gerekli: ${toDeduct.toLocaleString('tr-TR')}, Mevcut: ${current.toLocaleString('tr-TR')}`);
    } else {
        const currentAlert = document.getElementById('approvalAlertWrap').textContent || '';
        if (currentAlert.includes('Yetersiz mail bakiyesi')) {
            renderApprovalAlert('');
        }
    }
}

function updateApprovalActionState() {
    const btn = document.getElementById('approvalConfirmBtn');
    const listId = Number(document.getElementById('approvalDataListSelect').value || 0) || null;
    approvalState.selectedDataPoolId = listId;
    const hasCustomer = !!approvalState.selectedCustomer;
    const enoughBalance = !!(approvalState.balanceInfo && approvalState.balanceInfo.canApprove);
    let listOk = approvalState.isPoolOrder ? !!approvalState.selectedDataPoolId : true;
    if (approvalState.isPoolOrder && approvalState.selectedDataPoolId) {
        const selectedList = approvalState.lists.find(item => Number(item.id) === approvalState.selectedDataPoolId);
        if (selectedList && Number(selectedList.activeCount || 0) < Number(approvalState.orderTotal || 0)) {
            listOk = false;
            renderApprovalAlert(`Seçilen veri listesinde yeterli aktif kayıt yok. Gerekli: ${Number(approvalState.orderTotal || 0).toLocaleString('tr-TR')}, Mevcut: ${Number(selectedList.activeCount || 0).toLocaleString('tr-TR')}`);
        }
    }
    btn.disabled = !(hasCustomer && enoughBalance && listOk && approvalState.orderTotal > 0);
    renderDataPoolMeta();
    renderApprovalIntent();
}

function submitApprove(orderId) {
    const selectedListId = Number(document.getElementById('approvalDataListSelect').value || 0) || null;
    const payload = {
        orderId: Number(orderId || 0),
        userId: Number(approvalState.selectedCustomer?.id || 0),
        dataPoolId: selectedListId,
        sendCount: Number(approvalState.orderTotal || 0)
    };
    if (approvalState.isPoolOrder && !selectedListId) {
        renderApprovalAlert('Lütfen bir veri listesi seçin.');
        return;
    }
    if (!payload.orderId || !payload.userId || !payload.sendCount) {
        renderApprovalAlert('Onay için gerekli alanlar eksik.');
        return;
    }
    if (!approvalState.balanceInfo || !approvalState.balanceInfo.canApprove) {
        renderApprovalAlert('Yetersiz bakiye nedeniyle onay verilemiyor.');
        return;
    }

    const btn = document.getElementById('approvalConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Bakiye düşülüyor ve gönderim başlatılıyor...';

    fetchJson(approveStartUrl(orderId), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(data => {
        if (data.success) {
            if (approvalState.modal) {
                approvalState.modal.hide();
            }
            alert(data.message || 'Gönderim onaylandı, müşteri bakiyesi düşüldü ve sipariş kuyruğa alındı.');
            location.reload();
        } else {
            renderApprovalAlert(data.message || 'Onaylanamadı.');
            updateApprovalActionState();
            btn.innerHTML = 'Onayla ve Başlat';
        }
    })
    .catch((err) => {
        console.error('Onay hatası:', err);
        renderApprovalAlert(err.message || ('Onay sırasında hata oluştu: ' + err.message));
        updateApprovalActionState();
        btn.innerHTML = 'Onayla ve Başlat';
    });
}

function restartOrder(orderId, isPoolOrder, status) {
    if (isPoolOrder) {
        openPoolRestartModal(orderId);
        return;
    }
    const creditHint = (status === 'cancelled')
        ? 'İptal edilmiş ve hiç gönderim yapılmamışsa ek mail kredisi kesilmez; aksi halde sunucu tekrar kredi keser.'
        : 'Bu kampanya için mail kredisi tekrar kesilecektir (tam gönderim kotası kadar).';
    if (!confirm('Kampanya sıfırdan kuyruğa alınacak ve worker yeniden işleyecek.\n\n' + creditHint + '\n\nDevam edilsin mi?')) {
        return;
    }
    submitRestartCampaign(orderId, null);
}

function openPoolRestartModal(orderId) {
    document.getElementById('poolRestartOrderId').value = orderId;
    const select = document.getElementById('poolRestartListSelect');
    select.innerHTML = '<option value="">Yükleniyor...</option>';
    fetch(`/admin/email-orders/${orderId}/details?section=summary&include_pool_lists=1`)
        .then(r => r.json())
        .then(data => {
            if (!data.success || !data.pool_lists || data.pool_lists.length === 0) {
                select.innerHTML = '';
                alert('Havuz listesi yüklenemedi.');
                return;
            }
            select.innerHTML = '';
            const currentId = data.order.pool_list_id;
            data.pool_lists.forEach(function (row) {
                const opt = document.createElement('option');
                opt.value = row.id;
                opt.textContent = row.name + ' (' + row.active_count.toLocaleString() + ' aktif)';
                if (currentId && row.id === currentId) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });
            if (!currentId && select.options.length) {
                select.options[0].selected = true;
            }
            new bootstrap.Modal(document.getElementById('poolRestartModal')).show();
        })
        .catch(function () {
            alert('Liste bilgisi alınamadı.');
        });
}

function submitRestartCampaign(orderId, poolListId) {
    const body = poolListId ? JSON.stringify({ pool_list_id: poolListId }) : '{}';
    fetch(`/admin/email-orders/${orderId}/restart`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: body
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert(data.message || 'Kampanya yeniden başlatıldı.');
            location.reload();
        } else {
            alert('Hata: ' + (data.message || 'İşlem yapılamadı'));
        }
    })
    .catch(function (err) {
        alert('İstek hatası: ' + err.message);
    });
}

document.getElementById('poolRestartConfirmBtn').addEventListener('click', function () {
    const orderId = parseInt(document.getElementById('poolRestartOrderId').value, 10);
    const listId = parseInt(document.getElementById('poolRestartListSelect').value, 10);
    if (!orderId || !listId) {
        alert('Lütfen bir liste seçin.');
        return;
    }
    if (!confirm('Havuz kampanyası tekrar kuyruğa alınacak. Tamamlanmış/başarısız veya kısmen işlenmiş iptallerde mail kredisi tekrar kesilir. Onaylıyor musunuz?')) {
        return;
    }
    bootstrap.Modal.getInstance(document.getElementById('poolRestartModal')).hide();
    submitRestartCampaign(orderId, listId);
});

function formatDateOnly(value) {
    if (!value) return '-';
    const str = String(value).trim();
    if (/^\d{2}\.\d{2}\.\d{4}$/.test(str)) return str;
    if (/^\d{2}\.\d{2}\.\d{4}\s/.test(str)) return str.split(' ')[0];
    const parsed = new Date(str);
    if (!Number.isNaN(parsed.getTime())) {
        const day = String(parsed.getDate()).padStart(2, '0');
        const month = String(parsed.getMonth() + 1).padStart(2, '0');
        const year = parsed.getFullYear();
        return `${day}.${month}.${year}`;
    }
    return str;
}

function detailSectionContainer(section) {
    const map = {
        recipients: 'nxDetailRecipients',
        logs: 'nxDetailLogs',
        errors: 'nxDetailErrors',
        tracking: 'nxDetailTracking'
    };
    return document.getElementById(map[section]);
}

function loadDetailSection(orderId, section, page = 1) {
    const container = detailSectionContainer(section);
    if (!container) return;
    container.innerHTML = `
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        </div>
    `;

    fetch(`/admin/email-orders/${orderId}/details?section=${section}&page=${page}&per_page=50`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                container.innerHTML = `<div class="alert alert-warning mb-0">Veri yüklenemedi.</div>`;
                return;
            }
            if (section === 'tracking') {
                const t = data.tracking || {};
                container.innerHTML = `
                    <div class="row g-2">
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric"><span class="nx-adm-eo-detail-metric-lab">Toplam</span><span class="nx-adm-eo-detail-metric-val">${(t.total || 0).toLocaleString()}</span></div></div>
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric nx-adm-eo-detail-metric--sent"><span class="nx-adm-eo-detail-metric-lab">Gönderildi</span><span class="nx-adm-eo-detail-metric-val">${(t.sent || 0).toLocaleString()}</span></div></div>
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric nx-adm-eo-detail-metric--ok"><span class="nx-adm-eo-detail-metric-lab">Teslim</span><span class="nx-adm-eo-detail-metric-val">${(t.delivered || 0).toLocaleString()}</span></div></div>
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric nx-adm-eo-detail-metric--fail"><span class="nx-adm-eo-detail-metric-lab">Hata</span><span class="nx-adm-eo-detail-metric-val">${(t.failed || 0).toLocaleString()}</span></div></div>
                    </div>
                    <div class="small text-muted mt-2">Teslim oranı: <strong>${(t.deliveryRate || 0)}%</strong></div>
                `;
                return;
            }

            const items = Array.isArray(data.items) ? data.items : [];
            const pagination = data.pagination || { page: 1, totalPages: 1, total: 0 };
            if (!items.length) {
                container.innerHTML = `<div class="text-muted small py-2">Bu sekme için kayıt bulunamadı.</div>`;
                return;
            }

            let rows = '';
            if (section === 'errors') {
                items.forEach(item => {
                    rows += `<tr><td>${item.email || '-'}</td><td>${item.status || '-'}</td><td>${item.errorMessage || '-'}</td></tr>`;
                });
                container.innerHTML = `
                    <div class="table-responsive nx-adm-eo-detail-table-wrap">
                        <table class="table table-sm mb-0 nx-adm-eo-detail-table">
                            <thead><tr><th>Email</th><th>Durum</th><th>Hata</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                    ${renderDetailPagination(orderId, section, pagination)}
                `;
            } else if (section === 'logs') {
                items.forEach(item => {
                    rows += `<tr><td>${item.email || '-'}</td><td>${item.status || '-'}</td><td>${formatDateOnly(item.sentAt)}</td><td>${formatDateOnly(item.deliveredAt)}</td></tr>`;
                });
                container.innerHTML = `
                    <div class="table-responsive nx-adm-eo-detail-table-wrap">
                        <table class="table table-sm mb-0 nx-adm-eo-detail-table">
                            <thead><tr><th>Email</th><th>Durum</th><th>Gönderim</th><th>Teslim</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                    ${renderDetailPagination(orderId, section, pagination)}
                `;
            } else {
                items.forEach(item => {
                    rows += `<tr><td>${item.email || '-'}</td><td>${item.status || '-'}</td><td>${formatDateOnly(item.sentAt)}</td><td>${formatDateOnly(item.deliveredAt)}</td></tr>`;
                });
                container.innerHTML = `
                    <div class="table-responsive nx-adm-eo-detail-table-wrap">
                        <table class="table table-sm mb-0 nx-adm-eo-detail-table">
                            <thead><tr><th>Email</th><th>Durum</th><th>Gönderim</th><th>Teslimat</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                    ${renderDetailPagination(orderId, section, pagination)}
                `;
            }
        })
        .catch(() => {
            container.innerHTML = `<div class="alert alert-danger mb-0">Veri yüklenirken hata oluştu.</div>`;
        });
}

function renderDetailPagination(orderId, section, pagination) {
    const page = pagination.page || 1;
    const totalPages = pagination.totalPages || 1;
    if (totalPages <= 1) return '';
    return `
        <div class="d-flex align-items-center justify-content-between mt-2">
            <small class="text-muted">Sayfa ${page}/${totalPages}</small>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" ${page <= 1 ? 'disabled' : ''} onclick="loadDetailSection(${orderId}, '${section}', ${page - 1})">Önceki</button>
                <button type="button" class="btn btn-outline-secondary" ${page >= totalPages ? 'disabled' : ''} onclick="loadDetailSection(${orderId}, '${section}', ${page + 1})">Sonraki</button>
            </div>
        </div>
    `;
}

