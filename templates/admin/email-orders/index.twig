        ${order.approval ? `
        <div class="nx-adm-eo-detail-card mt-3">
            <span class="nx-adm-eo-detail-card-label text-uppercase">Onay / Bakiye</span>
            <div class="small"><strong>Müşteri:</strong> ${order.approval.external_customer_name || '-'} / ${order.approval.external_customer_email || '-'}</div>
            <div class="small"><strong>Düşülen bakiye:</strong> ${(order.approval.balance_amount || 0).toLocaleString('tr-TR')}</div>
            <div class="small"><strong>Eski bakiye:</strong> ${order.approval.balance_old_amount !== null ? Number(order.approval.balance_old_amount).toLocaleString('tr-TR') : '-'}</div>
            <div class="small"><strong>Yeni bakiye:</strong> ${order.approval.balance_new_amount !== null ? Number(order.approval.balance_new_amount).toLocaleString('tr-TR') : '-'}</div>
            <div class="small"><strong>Liste:</strong> ${order.approval.selected_data_list_name || '-'}</div>
            <div class="small"><strong>Onaylayan:</strong> ${order.approval.admin_name || '-'}</div>
            <div class="small"><strong>Onay zamanı:</strong> ${order.approval.created_at || '-'}</div>
        </div>` : ''}

        <div class="nx-adm-eo-detail-card mt-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <span class="nx-adm-eo-detail-card-label text-uppercase mb-0">Konu</span>
                <div class="d-flex flex-wrap gap-2">
                    ${order.status === 'pending_approval' ? '<button type="button" class="btn btn-sm btn-outline-primary" onclick="bootstrap.Modal.getInstance(document.getElementById(\'orderDetailModal\')).hide(); editOrderTemplate(' + order.id + ');"><i data-feather="edit-2" class="icon-xs me-1"></i>Düzenle</button>' : ''}
                </div>
            </div>
            <div class="fw-semibold small mb-2">${order.subject}</div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                ${order.status === 'pending_approval' ? '<button type="button" class="btn btn-success btn-sm" onclick="bootstrap.Modal.getInstance(document.getElementById(\'orderDetailModal\')).hide(); approveOrder(' + order.id + ', ' + (order.is_pool_order ? 'true' : 'false') + ');"><i data-feather="check" class="icon-xs me-1"></i>Onayla ve başlat</button>' : ''}
                ${['sent', 'completed', 'failed', 'cancelled'].includes(order.status) ? '<button type="button" class="btn btn-outline-success btn-sm" onclick="bootstrap.Modal.getInstance(document.getElementById(\'orderDetailModal\')).hide(); restartOrder(' + order.id + ', ' + (order.is_pool_order ? 'true' : 'false') + ', \'' + order.status + '\');"><i data-feather="refresh-cw" class="icon-xs me-1"></i>Tekrar başlat</button>' : ''}
            </div>
        </div>

        <div class="nx-adm-eo-detail-card mt-3 mb-0">
            <ul class="nav nav-tabs" id="nxDetailTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#nxDetailRecipients" type="button" role="tab" data-nx-detail-tab="recipients">Alıcılar</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#nxDetailLogs" type="button" role="tab" data-nx-detail-tab="logs">Loglar</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#nxDetailErrors" type="button" role="tab" data-nx-detail-tab="errors">Hatalar</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#nxDetailTracking" type="button" role="tab" data-nx-detail-tab="tracking">Tracking</button>
                </li>
            </ul>
            <div class="tab-content pt-3">
                <div class="tab-pane fade show active" id="nxDetailRecipients" role="tabpanel"></div>
                <div class="tab-pane fade" id="nxDetailLogs" role="tabpanel"></div>
                <div class="tab-pane fade" id="nxDetailErrors" role="tabpanel"></div>
                <div class="tab-pane fade" id="nxDetailTracking" role="tabpanel"></div>
            </div>
        </div>
        </div>
    `;
    
    document.getElementById('orderDetailContent').innerHTML = html;
    feather.replace();

    document.querySelectorAll('[data-nx-detail-tab]').forEach(function (btn) {
        btn.addEventListener('shown.bs.tab', function (event) {
            const section = event.target.getAttribute('data-nx-detail-tab');
            if (section) {
                loadDetailSection(order.id, section, 1);
            }
        });
    });
    loadDetailSection(order.id, 'recipients', 1);
}

function cancelOrder(orderId) {
    if (!confirm('Bu kampanyayı durdurmak istediğinize emin misiniz?')) {
        return;
    }
    
    fetch(`/admin/email-orders/${orderId}/cancel`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Kampanya durduruldu');
            location.reload();
        } else {
            alert('Hata: ' + (data.message || 'Kampanya durdurulamadı'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Bir hata oluştu: ' + error.message);
    });
}

function deleteOrder(orderId) {
    if (!confirm('Bu kampanyayı silmek istediğinize emin misiniz? Bu işlem geri alınamaz!')) {
        return;
    }
    
    fetch(`/admin/email-orders/${orderId}/delete`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Kampanya silindi');
            location.reload();
        } else {
            alert('Hata: ' + (data.message || 'Kampanya silinemedi'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Bir hata oluştu: ' + error.message);
    });
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
    document.getElementById('approvalModal')?.addEventListener('hidden.bs.modal', function () {
        resetApprovalControllers();
        approvalState.openKey = 0;
        approvalState.orderId = null;
        approvalState.selectedDataPoolId = null;
        approvalState.selectedCustomer = null;
        approvalState.balanceInfo = null;
    });

    document.getElementById('approvalCustomerSearchBtn')?.addEventListener('click', function() {
        const query = document.getElementById('approvalCustomerSearch').value || '';
        loadCustomers(1, query);
    });
    document.getElementById('approvalCustomerSearch')?.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            loadCustomers(1, document.getElementById('approvalCustomerSearch').value || '');
        }
    });
    document.getElementById('approvalCustomerSelect')?.addEventListener('change', handleCustomerSelection);
    document.getElementById('approvalDataListSelect')?.addEventListener('change', updateApprovalActionState);
    document.getElementById('approvalUsersPrevBtn')?.addEventListener('click', function() {
        if (approvalState.usersPage > 1) {
            loadCustomers(approvalState.usersPage - 1, approvalState.usersQuery);
        }
    });
    document.getElementById('approvalUsersNextBtn')?.addEventListener('click', function() {
        if (approvalState.usersPage < approvalState.usersTotalPages) {
            loadCustomers(approvalState.usersPage + 1, approvalState.usersQuery);
        }
    });
    document.getElementById('approvalConfirmBtn')?.addEventListener('click', function() {
        if (!approvalState.orderId) return;
        submitApprove(approvalState.orderId);
    });
});
</script>
{% endblock %}