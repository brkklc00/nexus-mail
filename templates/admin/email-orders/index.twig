function formatDateOnly(value) {
    if (!value) return '-';
    const str = String(value).trim();
    if (/^\d{2}\.\d{2}\.\d{4}$/.test(str)) return str;
    if (/^\d{2}\.\d{2}\.\d{4}\s/.test(str)) return str.split(' ')[0];
    const parsed = new Date(str);
    if (!Number.isNaN(parsed.getTime())) {
        const day = String(parsed.getDate()).padStart(2, '0');
        const month = String(parsed.getMonth() + 1).padStart(2, '0');
        const year = parsed.getFullYear();
        return `${day}.${month}.${year}`;
    }
    return str;
}

function detailSectionContainer(section) {
    const map = {
        recipients: 'nxDetailRecipients',
        logs: 'nxDetailLogs',
        errors: 'nxDetailErrors',
        tracking: 'nxDetailTracking'
    };
    return document.getElementById(map[section]);
}

function loadDetailSection(orderId, section, page = 1) {
    const container = detailSectionContainer(section);
    if (!container) return;
    container.innerHTML = `
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        </div>
    `;

    fetch(`/admin/email-orders/${orderId}/details?section=${section}&page=${page}&per_page=50`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                container.innerHTML = `<div class="alert alert-warning mb-0">Veri yüklenemedi.</div>`;
                return;
            }
            if (section === 'tracking') {
                const t = data.tracking || {};
                container.innerHTML = `
                    <div class="row g-2">
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric"><span class="nx-adm-eo-detail-metric-lab">Toplam</span><span class="nx-adm-eo-detail-metric-val">${(t.total || 0).toLocaleString()}</span></div></div>
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric nx-adm-eo-detail-metric--sent"><span class="nx-adm-eo-detail-metric-lab">Gönderildi</span><span class="nx-adm-eo-detail-metric-val">${(t.sent || 0).toLocaleString()}</span></div></div>
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric nx-adm-eo-detail-metric--ok"><span class="nx-adm-eo-detail-metric-lab">Teslim</span><span class="nx-adm-eo-detail-metric-val">${(t.delivered || 0).toLocaleString()}</span></div></div>
                        <div class="col-6 col-md-3"><div class="nx-adm-eo-detail-metric nx-adm-eo-detail-metric--fail"><span class="nx-adm-eo-detail-metric-lab">Hata</span><span class="nx-adm-eo-detail-metric-val">${(t.failed || 0).toLocaleString()}</span></div></div>
                    </div>
                    <div class="small text-muted mt-2">Teslim oranı: <strong>${(t.deliveryRate || 0)}%</strong></div>
                `;
                return;
            }

            const items = Array.isArray(data.items) ? data.items : [];
            const pagination = data.pagination || { page: 1, totalPages: 1, total: 0 };
            if (!items.length) {
                container.innerHTML = `<div class="text-muted small py-2">Bu sekme için kayıt bulunamadı.</div>`;
                return;
            }

            let rows = '';
            if (section === 'errors') {
                items.forEach(item => {
                    rows += `<tr><td>${item.email || '-'}</td><td>${item.status || '-'}</td><td>${item.errorMessage || '-'}</td></tr>`;
                });
                container.innerHTML = `
                    <div class="table-responsive nx-adm-eo-detail-table-wrap">
                        <table class="table table-sm mb-0 nx-adm-eo-detail-table">
                            <thead><tr><th>Email</th><th>Durum</th><th>Hata</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                    ${renderDetailPagination(orderId, section, pagination)}
                `;
            } else if (section === 'logs') {
                items.forEach(item => {
                    rows += `<tr><td>${item.email || '-'}</td><td>${item.status || '-'}</td><td>${formatDateOnly(item.sentAt)}</td><td>${formatDateOnly(item.deliveredAt)}</td></tr>`;
                });
                container.innerHTML = `
                    <div class="table-responsive nx-adm-eo-detail-table-wrap">
                        <table class="table table-sm mb-0 nx-adm-eo-detail-table">
                            <thead><tr><th>Email</th><th>Durum</th><th>Gönderim</th><th>Teslim</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                    ${renderDetailPagination(orderId, section, pagination)}
                `;
            } else {
                items.forEach(item => {
                    rows += `<tr><td>${item.email || '-'}</td><td>${item.status || '-'}</td><td>${formatDateOnly(item.sentAt)}</td><td>${formatDateOnly(item.deliveredAt)}</td></tr>`;
                });
                container.innerHTML = `
                    <div class="table-responsive nx-adm-eo-detail-table-wrap">
                        <table class="table table-sm mb-0 nx-adm-eo-detail-table">
                            <thead><tr><th>Email</th><th>Durum</th><th>Gönderim</th><th>Teslimat</th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                    ${renderDetailPagination(orderId, section, pagination)}
                `;
            }
        })
        .catch(() => {
            container.innerHTML = `<div class="alert alert-danger mb-0">Veri yüklenirken hata oluştu.</div>`;
        });
}

function renderDetailPagination(orderId, section, pagination) {
    const page = pagination.page || 1;
    const totalPages = pagination.totalPages || 1;
    if (totalPages <= 1) return '';
    return `
        <div class="d-flex align-items-center justify-content-between mt-2">
            <small class="text-muted">Sayfa ${page}/${totalPages}</small>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" ${page <= 1 ? 'disabled' : ''} onclick="loadDetailSection(${orderId}, '${section}', ${page - 1})">Önceki</button>
                <button type="button" class="btn btn-outline-secondary" ${page >= totalPages ? 'disabled' : ''} onclick="loadDetailSection(${orderId}, '${section}', ${page + 1})">Sonraki</button>
            </div>
        </div>
    `;
}

