        return;
    }
    
    fetch(`/admin/email-orders/${orderId}/cancel`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Kampanya durduruldu');
            location.reload();
        } else {
            alert('Hata: ' + (data.message || 'Kampanya durdurulamadı'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Bir hata oluştu: ' + error.message);
    });
}

function deleteOrder(orderId) {
    if (!confirm('Bu kampanyayı silmek istediğinize emin misiniz? Bu işlem geri alınamaz!')) {
        return;
    }
    
    fetch(`/admin/email-orders/${orderId}/delete`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Kampanya silindi');
            location.reload();
        } else {
            alert('Hata: ' + (data.message || 'Kampanya silinemedi'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Bir hata oluştu: ' + error.message);
    });
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
});
</script>
