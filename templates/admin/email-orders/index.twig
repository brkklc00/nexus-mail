function approveOrder(orderId, isPoolOrder) {
    if (isPoolOrder) {
        openPoolApproveModal(orderId);
        return;
    }
    if (!confirm('Bu kampanyayı onaylayıp başlatmak istediğinize emin misiniz? Bakiye kesilecek ve worker tarafından işlenecek.')) return;
    submitApprove(orderId, null);
}

function openPoolApproveModal(orderId) {
    document.getElementById('poolApproveOrderId').value = orderId;
    const select = document.getElementById('poolApproveListSelect');
    select.innerHTML = '<option value="">Yükleniyor...</option>';
    fetch(`/admin/email-orders/${orderId}/details?section=summary&include_pool_lists=1`)
        .then(r => r.json())
        .then(data => {
            if (!data.success || !data.pool_lists || data.pool_lists.length === 0) {
                select.innerHTML = '';
                alert('Havuz listesi yüklenemedi. Önce Mail Havuzu sayfasında liste oluşturun.');
                return;
            }
            select.innerHTML = '';
            const defId = data.default_pool_list_id;
            data.pool_lists.forEach(function (row) {
                const opt = document.createElement('option');
                opt.value = row.id;
                opt.textContent = row.name + ' (' + row.active_count.toLocaleString() + ' aktif)';
                if (row.id === defId) opt.selected = true;
                select.appendChild(opt);
            });
            new bootstrap.Modal(document.getElementById('poolApproveModal')).show();
        })
        .catch(function () {
            alert('Liste bilgisi alınamadı.');
        });
}

function submitApprove(orderId, poolListId) {
    const body = poolListId ? JSON.stringify({ pool_list_id: poolListId }) : '{}';
    fetch(`/admin/email-orders/${orderId}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: body
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('Kampanya onaylandı!');
            location.reload();
        } else {
            alert('Hata: ' + (data.message || 'Onaylanamadı'));
        }
    });
}

document.getElementById('poolApproveConfirmBtn').addEventListener('click', function () {
    const orderId = parseInt(document.getElementById('poolApproveOrderId').value, 10);
    const listId = parseInt(document.getElementById('poolApproveListSelect').value, 10);
    if (!orderId || !listId) {
        alert('Lütfen bir liste seçin.');
        return;
    }
    bootstrap.Modal.getInstance(document.getElementById('poolApproveModal')).hide();
    submitApprove(orderId, listId);
});

function restartOrder(orderId, isPoolOrder, status) {
    if (isPoolOrder) {
        openPoolRestartModal(orderId);
        return;
    }
    const creditHint = (status === 'cancelled')
        ? 'İptal edilmiş ve hiç gönderim yapılmamışsa ek mail kredisi kesilmez; aksi halde sunucu tekrar kredi keser.'
        : 'Bu kampanya için mail kredisi tekrar kesilecektir (tam gönderim kotası kadar).';
    if (!confirm('Kampanya sıfırdan kuyruğa alınacak ve worker yeniden işleyecek.\n\n' + creditHint + '\n\nDevam edilsin mi?')) {
        return;
    }
    submitRestartCampaign(orderId, null);
}

function openPoolRestartModal(orderId) {
    document.getElementById('poolRestartOrderId').value = orderId;
    const select = document.getElementById('poolRestartListSelect');
    select.innerHTML = '<option value="">Yükleniyor...</option>';
    fetch(`/admin/email-orders/${orderId}/details?section=summary&include_pool_lists=1`)
        .then(r => r.json())
        .then(data => {
            if (!data.success || !data.pool_lists || data.pool_lists.length === 0) {
                select.innerHTML = '';
                alert('Havuz listesi yüklenemedi.');
                return;
            }
            select.innerHTML = '';
            const currentId = data.order.pool_list_id;
            data.pool_lists.forEach(function (row) {
                const opt = document.createElement('option');
                opt.value = row.id;
                opt.textContent = row.name + ' (' + row.active_count.toLocaleString() + ' aktif)';
