{% extends "_layouts/main.twig" %}

{% block title %}Gönderimler - Admin - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}{% endblock %}

{% block page_icon %}{% endblock %}
{% block title_text %}{% endblock %}

{% block page_title %}
<div class="row nx-adm-eo-page-title-row">
    <div class="col-12">
        <div class="page-title-box nx-page-head nx-adm-eo-page-head pb-0 mb-3">
            <div class="page-title-right mb-2">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/dashboard">Panel</a></li>
                    <li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
                    <li class="breadcrumb-item">Email</li>
                    <li class="breadcrumb-item active" aria-current="page">Gönderimler</li>
                </ol>
            </div>
            <div class="d-flex flex-column flex-lg-row align-items-start justify-content-lg-between gap-3">
                <div class="min-w-0">
                    <h4 class="page-title nx-page-title mb-1">Gönderimler</h4>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 nx-adm-eo-head-actions flex-shrink-0">
                    <button type="button" class="btn btn-sm nx-adm-eo-head-btn" onclick="window.location.reload()" title="Yenile">
                        <i data-feather="refresh-cw" class="nx-adm-eo-head-btn-ic"></i>
                        <span class="d-none d-sm-inline">Yenile</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
{% set nx_adm_eo_has_filters = (search|default('')|trim != '') or (selected_status|default('') != '') or (selected_user|default('') != '') %}

<div class="nx-adm-eo-shell pb-4">
    {% if error is defined and error %}
    <div class="alert alert-warning mb-3" role="alert">
        <i data-feather="alert-triangle" class="icon-xs me-1"></i>
        {{ error }}
    </div>
    {% endif %}

    <div class="nx-adm-eo-stats" aria-label="Sipariş özeti">
        <div class="nx-adm-eo-stat nx-adm-eo-stat--total">
            <div class="nx-adm-eo-stat-inner">
                <span class="nx-adm-eo-stat-ic"><i data-feather="mail"></i></span>
                <div class="nx-adm-eo-stat-body">
                    <span class="nx-adm-eo-stat-label">Toplam Sipariş</span>
                    <span class="nx-adm-eo-stat-value">{{ stats.total|number_format }}</span>
                </div>
            </div>
        </div>
        <div class="nx-adm-eo-stat nx-adm-eo-stat--approval">
            <div class="nx-adm-eo-stat-inner">
                <span class="nx-adm-eo-stat-ic"><i data-feather="user-check"></i></span>
                <div class="nx-adm-eo-stat-body">
                    <span class="nx-adm-eo-stat-label">Onay Bekleyen</span>
                    <span class="nx-adm-eo-stat-value">{{ stats.pending_approval|number_format }}</span>
                </div>
            </div>
        </div>
        <div class="nx-adm-eo-stat nx-adm-eo-stat--pending">
            <div class="nx-adm-eo-stat-inner">
                <span class="nx-adm-eo-stat-ic"><i data-feather="clock"></i></span>
                <div class="nx-adm-eo-stat-body">
                    <span class="nx-adm-eo-stat-label">Bekleyen</span>
                    <span class="nx-adm-eo-stat-value">{{ stats.pending|number_format }}</span>
                </div>
            </div>
        </div>
        <div class="nx-adm-eo-stat nx-adm-eo-stat--processing">
            <div class="nx-adm-eo-stat-inner">
                <span class="nx-adm-eo-stat-ic"><i data-feather="loader"></i></span>
                <div class="nx-adm-eo-stat-body">
                    <span class="nx-adm-eo-stat-label">İşlemde</span>
                    <span class="nx-adm-eo-stat-value">{{ stats.processing|number_format }}</span>
                </div>
            </div>
        </div>
        <div class="nx-adm-eo-stat nx-adm-eo-stat--completed">
            <div class="nx-adm-eo-stat-inner">
                <span class="nx-adm-eo-stat-ic"><i data-feather="check-circle"></i></span>
                <div class="nx-adm-eo-stat-body">
                    <span class="nx-adm-eo-stat-label">Tamamlanan</span>
                    <span class="nx-adm-eo-stat-value">{{ stats.completed|number_format }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card nx-adm-eo-list-card border-0">
        <div class="nx-adm-eo-list-card-head">
            <div class="d-flex align-items-start gap-2 min-w-0">
                <span class="nx-adm-eo-list-card-ic"><i data-feather="mail"></i></span>
                <div class="min-w-0">
                    <h2 class="nx-adm-eo-list-card-title mb-0">Gönderimler</h2>
                </div>
            </div>
        </div>
        <div class="card-body nx-adm-eo-list-card-body border-0">
            <div class="nx-adm-eo-toolbar">
                <div class="nx-adm-eo-toolbar-row">
                    <div class="nx-adm-eo-field nx-adm-eo-field--search">
                        <span class="nx-adm-eo-search-ic" aria-hidden="true"><i data-feather="search"></i></span>
                        <input type="search" class="form-control nx-adm-eo-input" id="searchInput" placeholder="Sipariş ara (konu, kullanıcı, e-posta)…" value="{{ search }}" autocomplete="off" onkeyup="handleSearch()">
                    </div>
                    <div class="nx-adm-eo-field nx-adm-eo-field--select">
                        <select class="form-select nx-adm-eo-select" id="statusFilter" onchange="applyFilters()">
                            <option value="">Tüm durumlar</option>
                            <option value="pending_approval" {{ selected_status == 'pending_approval' ? 'selected' : '' }}>Onay Bekleyen</option>
                            <option value="pending" {{ selected_status == 'pending' ? 'selected' : '' }}>Bekleyen</option>
                            <option value="processing" {{ selected_status == 'processing' ? 'selected' : '' }}>İşlemde</option>
                            <option value="sent" {{ selected_status == 'sent' ? 'selected' : '' }}>Gönderildi</option>
                            <option value="completed" {{ selected_status == 'completed' ? 'selected' : '' }}>Tamamlandı</option>
                            <option value="failed" {{ selected_status == 'failed' ? 'selected' : '' }}>Başarısız</option>
                            <option value="cancelled" {{ selected_status == 'cancelled' ? 'selected' : '' }}>İptal Edildi</option>
                        </select>
                    </div>
                    <div class="nx-adm-eo-field nx-adm-eo-field--select">
                        <select class="form-select nx-adm-eo-select" id="userFilter" onchange="applyFilters()">
                            <option value="">Tüm kullanıcılar</option>
                            {% for user in users %}
                            <option value="{{ user.id }}" {{ selected_user == user.id ? 'selected' : '' }}>
                                {{ user.name }} ({{ user.email }})
                            </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="nx-adm-eo-field nx-adm-eo-field--clear">
                        <button type="button" class="btn nx-adm-eo-clear-btn w-100" onclick="clearFilters()">
                            <i data-feather="x" class="nx-adm-eo-clear-ic"></i>
                            Temizle
                        </button>
                    </div>
                </div>
            </div>

                    {% if orders is empty %}
                    <div class="nx-adm-eo-empty text-center py-5 px-3">
                        <div class="nx-adm-eo-empty-ic"><i data-feather="inbox"></i></div>
                        {% if nx_adm_eo_has_filters %}
                        <h5 class="nx-adm-eo-empty-title">Filtrelere uygun email siparişi bulunamadı</h5>
                        <p class="text-muted small mb-3 mx-auto" style="max-width: 26rem;">Arama veya filtreleri değiştirmeyi deneyin.</p>
                        <button type="button" class="btn btn-sm nx-adm-eo-empty-btn" onclick="clearFilters()">Filtreleri temizle</button>
                        {% else %}
                        <h5 class="nx-adm-eo-empty-title">Henüz email siparişi yok</h5>
                        <p class="text-muted small mb-0 mx-auto" style="max-width: 26rem;">Sistemde kayıtlı kampanya bulunmuyor.</p>
                        {% endif %}
                    </div>
                    {% else %}
                    <div class="table-responsive nx-adm-eo-table-scroll">
                        <table class="table table-sm mb-0 nx-adm-eo-table">
                            <thead>
                                <tr>
                                    <th class="nx-adm-eo-th nx-adm-eo-col-id">
                                        <a href="#" onclick="sortBy('id'); return false;" class="nx-adm-eo-th-sort">
                                            <span>#</span>
                                            {% if sort == 'id' %}<i data-feather="{{ dir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="nx-adm-eo-sort-ic"></i>{% endif %}
                                        </a>
                                    </th>
                                    <th class="nx-adm-eo-th nx-adm-eo-col-user"><span class="nx-adm-eo-th-inner"><i data-feather="user"></i>Kullanıcı</span></th>
                                    <th class="nx-adm-eo-th nx-adm-eo-col-subject"><span class="nx-adm-eo-th-inner"><i data-feather="file-text"></i>Konu / Template</span></th>
                                    <th class="nx-adm-eo-th nx-adm-eo-col-counts">
                                        <a href="#" onclick="sortBy('total'); return false;" class="nx-adm-eo-th-sort">
                                            <span class="nx-adm-eo-th-inner"><i data-feather="bar-chart-2"></i>Sayılar</span>
                                            {% if sort == 'total' %}<i data-feather="{{ dir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="nx-adm-eo-sort-ic"></i>{% endif %}
                                        </a>
                                    </th>
                                    <th class="nx-adm-eo-th nx-adm-eo-col-status"><span class="nx-adm-eo-th-inner"><i data-feather="activity"></i>Durum</span></th>
                                    <th class="nx-adm-eo-th nx-adm-eo-col-date">
                                        <a href="#" onclick="sortBy('createdAt'); return false;" class="nx-adm-eo-th-sort">
                                            <span class="nx-adm-eo-th-inner"><i data-feather="calendar"></i>Tarih</span>
                                            {% if sort == 'createdAt' %}<i data-feather="{{ dir == 'ASC' ? 'chevron-up' : 'chevron-down' }}" class="nx-adm-eo-sort-ic"></i>{% endif %}
                                        </a>
                                    </th>
                                    <th class="nx-adm-eo-th nx-adm-eo-col-actions text-end"><span class="nx-adm-eo-th-inner">İşlem</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in orders %}
                                <tr class="nx-adm-eo-tr">
                                    <td class="nx-adm-eo-td-id fw-semibold">#{{ order.id }}</td>
                                    <td class="nx-adm-eo-td-user">
                                        <div class="nx-adm-eo-user-cell">
                                            <span class="nx-adm-eo-user-name">{{ order.user.name }}</span>
                                            <span class="nx-adm-eo-user-email">{{ order.user.email }}</span>
                                        </div>
                                    </td>
                                    <td class="nx-adm-eo-td-subject">
                                        <div class="nx-adm-eo-subject-stack">
                                            <span class="nx-adm-eo-subject-clamp" title="{{ order.subject|e('html_attr') }}">
                                                {{ order.subject }}
                                            </span>
                                            {% if order.template_id and order.template_name %}
                                            <span class="nx-adm-eo-template-name" title="Template: #{{ order.template_id }} - {{ order.template_name|e('html_attr') }}">Template: #{{ order.template_id }} - {{ order.template_name }}</span>
                                            {% elseif order.template_id %}
                                            <span class="nx-adm-eo-template-name">Template: #{{ order.template_id }}</span>
                                            {% else %}
                                            <span class="nx-adm-eo-template-name">Template: Eşleşmedi</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="nx-adm-eo-td-counts">
                                        <div class="nx-adm-eo-counts">
                                            <span class="nx-adm-eo-count-row">Toplam: <strong>{{ order.total|number_format }}</strong></span>
                                            <span class="nx-adm-eo-count-row">Gönderildi: <strong>{{ order.sent|number_format }}</strong></span>
                                            <span class="nx-adm-eo-count-row">Hata: <strong>{{ order.failed|number_format }}</strong></span>
                                        </div>
                                    </td>
                                    <td class="nx-adm-eo-td-status">
                                        {% if order.status == 'pending_approval' %}
                                        <span class="nx-adm-eo-status nx-adm-eo-status--pending_approval">Onay Bekliyor</span>
                                        {% elseif order.status == 'pending' %}
                                        <span class="nx-adm-eo-status nx-adm-eo-status--pending">Bekliyor</span>
                                        {% elseif order.status == 'processing' %}
                                        <span class="nx-adm-eo-status nx-adm-eo-status--processing">İşleniyor</span>
                                        {% elseif order.status == 'sent' %}
                                        <span class="nx-adm-eo-status nx-adm-eo-status--sent">Gönderildi</span>
                                        {% elseif order.status == 'completed' %}
                                        <span class="nx-adm-eo-status nx-adm-eo-status--completed">Tamamlandı</span>
                                        {% elseif order.status == 'failed' %}
                                        <span class="nx-adm-eo-status nx-adm-eo-status--failed">Başarısız</span>
                                        {% elseif order.status == 'cancelled' %}
                                        <span class="nx-adm-eo-status nx-adm-eo-status--cancelled">İptal Edildi</span>
                                        {% endif %}
                                    </td>
                                    <td class="nx-adm-eo-td-date">
                                        <span class="nx-adm-eo-date-line">{{ order.createdAt|date('d.m.Y') }}</span>
                                    </td>
                                    <td class="text-end nx-adm-eo-td-actions">
                                        <div class="nx-adm-eo-actions" role="group">
                                            <button type="button" onclick="viewOrderDetails({{ order.id }})" class="btn nx-adm-eo-view-btn" title="Görüntüle">
                                                <i data-feather="eye" class="icon-xs"></i>
                                                Görüntüle
                                            </button>
                                            <div class="dropdown">
                                                <button class="btn nx-adm-eo-more-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Diğer işlemler">
                                                    <i data-feather="more-horizontal" class="icon-xs"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end nx-adm-eo-actions-menu">
                                                    {% if order.status == 'pending_approval' %}
                                                    <li><button type="button" class="dropdown-item" onclick="editOrderTemplate({{ order.id }})"><i data-feather="edit-2" class="icon-xs me-2"></i>Düzenle</button></li>
                                                    <li><button type="button" class="dropdown-item" onclick="approveOrder({{ order.id }}, {{ order.sourceType == 'pool' ? 'true' : 'false' }})"><i data-feather="check" class="icon-xs me-2"></i>Onayla</button></li>
                                                    {% endif %}
                                                    {% if order.status == 'pending' or order.status == 'processing' %}
                                                    <li><button type="button" class="dropdown-item" onclick="cancelOrder({{ order.id }})"><i data-feather="pause" class="icon-xs me-2"></i>Duraklat</button></li>
                                                    {% endif %}
                                                    {% if order.status in ['sent', 'completed', 'failed', 'cancelled'] %}
                                                    <li><button type="button" class="dropdown-item" onclick="restartOrder({{ order.id }}, {{ order.sourceType == 'pool' ? 'true' : 'false' }}, '{{ order.status }}')"><i data-feather="refresh-cw" class="icon-xs me-2"></i>Devam Ettir</button></li>
                                                    {% endif %}
                                                    {% if order.status != 'processing' and order.status != 'pending' %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><button type="button" class="dropdown-item text-danger" onclick="deleteOrder({{ order.id }})"><i data-feather="trash-2" class="icon-xs me-2"></i>Sil</button></li>
                                                    {% endif %}
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% if total_pages > 1 %}
                    <nav class="mt-3 nx-adm-eo-pagination" aria-label="Sayfalama">
                        <ul class="pagination justify-content-center mb-0">
                            {% if page > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page - 1 }}&search={{ search }}&status={{ selected_status }}&user_id={{ selected_user }}&sort={{ sort }}&dir={{ dir }}&per_page={{ per_page|default(50) }}">
                                    <i data-feather="chevron-left" class="icon-xs"></i>
                                    Önceki
                                </a>
                            </li>
                            {% endif %}
                            
                            {% for p in 1..total_pages %}
                                {% if p == 1 or p == total_pages or (p >= page - 2 and p <= page + 2) %}
                                <li class="page-item {{ p == page ? 'active' : '' }}">
                                    <a class="page-link" href="?page={{ p }}&search={{ search }}&status={{ selected_status }}&user_id={{ selected_user }}&sort={{ sort }}&dir={{ dir }}&per_page={{ per_page|default(50) }}">{{ p }}</a>
                                </li>
                                {% elseif p == page - 3 or p == page + 3 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                                {% endif %}
                            {% endfor %}
                            
                            {% if page < total_pages %}
                            <li class="page-item">
                                <a class="page-link" href="?page={{ page + 1 }}&search={{ search }}&status={{ selected_status }}&user_id={{ selected_user }}&sort={{ sort }}&dir={{ dir }}&per_page={{ per_page|default(50) }}">
                                    Sonraki
                                    <i data-feather="chevron-right" class="icon-xs"></i>
                                </a>
                            </li>
                            {% endif %}
                        </ul>
                    </nav>
                    {% endif %}

                    <div class="text-center text-muted mt-3 mb-0 nx-adm-eo-list-footer">
                        <small>Toplam {{ total }} sipariş · Sayfa {{ page }}/{{ total_pages }}</small>
                    </div>
                    {% endif %}
        </div>
    </div>

</div>

<!-- Şablon Düzenleme Modal -->
<div class="modal fade nx-adm-eo-modal-root" id="editTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content nx-adm-eo-modal">
            <div class="modal-header nx-adm-eo-modal-head border-0">
                <h5 class="modal-title text-white mb-0 d-flex align-items-center gap-2">
                    <span class="nx-adm-eo-modal-head-ic"><i data-feather="edit-2"></i></span>
                    Şablon düzenle · #<span id="editModalOrderId"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body bg-white p-3 p-md-4">
                <input type="hidden" id="editOrderId">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Konu</label>
                    <input type="text" class="form-control" id="editSubject" placeholder="Email konusu">
                </div>
                <div class="mb-0">
                    <label class="form-label fw-semibold small">İçerik (HTML)</label>
                    <textarea class="form-control" id="editBody" rows="12" placeholder="Email içeriği"></textarea>
                </div>
            </div>
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="saveOrderTemplate()">
                    <i data-feather="save" class="icon-xs me-1"></i>
                    Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Havuz listesi ile onay modal -->
<div class="modal fade nx-adm-eo-modal-root" id="poolApproveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content nx-adm-eo-modal">
            <div class="modal-header nx-adm-eo-modal-head border-0">
                <h5 class="modal-title text-white mb-0">Havuz siparişi onayı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body bg-white p-3 p-md-4">
                <input type="hidden" id="poolApproveOrderId" value="">
                <p class="text-muted small mb-2">Mail adresleri hangi veri listesinden çekilsin?</p>
                <label class="form-label">Veri listesi</label>
                <select class="form-select" id="poolApproveListSelect"></select>
            </div>
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success" id="poolApproveConfirmBtn">Onayla ve başlat</button>
            </div>
        </div>
    </div>
</div>

<!-- Havuz: kampanyayı tekrar başlat -->
<div class="modal fade nx-adm-eo-modal-root" id="poolRestartModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content nx-adm-eo-modal">
            <div class="modal-header nx-adm-eo-modal-head border-0">
                <h5 class="modal-title text-white mb-0">Kampanyayı tekrar başlat (havuz)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body bg-white p-3 p-md-4">
                <input type="hidden" id="poolRestartOrderId" value="">
                <p class="text-muted small mb-2">Adresler hangi veri listesinden çekilsin? (Tamamlanmış kampanyada mail kredisi tekrar kesilir.)</p>
                <label class="form-label">Veri listesi</label>
                <select class="form-select" id="poolRestartListSelect"></select>
            </div>
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success" id="poolRestartConfirmBtn">Tekrar başlat</button>
            </div>
        </div>
    </div>
</div>

<!-- Detay Modal -->
<div class="modal fade nx-adm-eo-modal-root" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content nx-adm-eo-modal">
            <div class="modal-header nx-adm-eo-modal-head border-0">
                <h5 class="modal-title text-white mb-0 d-flex align-items-center gap-2">
                    <span class="nx-adm-eo-modal-head-ic"><i data-feather="mail"></i></span>
                    Sipariş detayı · #<span id="modalOrderId"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body bg-light p-0" id="orderDetailContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let searchTimer;
const defaultPerPage = '{{ per_page|default(50) }}';

function handleSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
        applyFilters();
    }, 500);
}

function applyFilters() {
    const search = document.getElementById('searchInput').value;
    const status = document.getElementById('statusFilter').value;
    const userId = document.getElementById('userFilter').value;
    const sort = '{{ sort }}';
    const dir = '{{ dir }}';
    
    let url = '/admin/email-orders?';
    const params = [];
    
    if (search) {
        params.push(`search=${encodeURIComponent(search)}`);
    }
    if (status) {
        params.push(`status=${status}`);
    }
    if (userId) {
        params.push(`user_id=${userId}`);
    }
    if (sort) {
        params.push(`sort=${sort}`);
    }
    if (dir) {
        params.push(`dir=${dir}`);
    }
    if (defaultPerPage) {
        params.push(`per_page=${defaultPerPage}`);
    }
    
    window.location.href = url + params.join('&');
}

function clearFilters() {
    window.location.href = '/admin/email-orders';
}

function sortBy(field) {
    const currentSort = '{{ sort }}';
    const currentDir = '{{ dir }}';
    const search = document.getElementById('searchInput').value;
    const status = document.getElementById('statusFilter').value;
    const userId = document.getElementById('userFilter').value;
    
    // Aynı sütuna tıklanırsa yönü değiştir
    let newDir = 'DESC';
    if (currentSort === field && currentDir === 'DESC') {
        newDir = 'ASC';
    }
    
    let url = '/admin/email-orders?';
    const params = [];
    
    if (search) {
        params.push(`search=${encodeURIComponent(search)}`);
    }
    if (status) {
        params.push(`status=${status}`);
    }
    if (userId) {
        params.push(`user_id=${userId}`);
    }
    if (defaultPerPage) {
        params.push(`per_page=${defaultPerPage}`);
    }
    params.push(`sort=${field}`);
    params.push(`dir=${newDir}`);
    
    window.location.href = url + params.join('&');
}

