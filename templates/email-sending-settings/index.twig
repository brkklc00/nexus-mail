{% extends "_layouts/main.twig" %}

{% block title %}Hız &amp; Limitler - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Panel</a></li>
<li class="breadcrumb-item"><a href="/email-dashboard">Mail</a></li>
<li class="breadcrumb-item active">Hız &amp; Limitler</li>
{% endblock %}

{% block page_icon %}<i data-feather="sliders" class="icon-dual icon-sm me-2"></i>{% endblock %}
{% block title_text %}Hız &amp; Limitler{% endblock %}

{% block page_lead %}
<p class="nx-es-page-lead">Günde kaç mail atmak istediğinizi girin — hız, worker ve tüm SMTP limitleri otomatik yapılandırılır.</p>
{% endblock %}

{% set daily_sent    = global_totals.daily_sent|default(0) %}
{% set hourly_sent   = global_totals.hourly_sent|default(0) %}
{% set minute_sent   = global_totals.minute_sent|default(0) %}
{% set daily_limit   = config.daily_limit %}
{% set hourly_limit  = config.hourly_limit %}
{% set minute_limit  = config.minute_limit %}
{% set daily_pct     = daily_limit  > 0 ? min(100, (daily_sent  / daily_limit  * 100)|round(1)) : 0 %}
{% set hourly_pct    = hourly_limit > 0 ? min(100, (hourly_sent / hourly_limit * 100)|round(1)) : 0 %}
{% set minute_pct    = minute_limit > 0 ? min(100, (minute_sent / minute_limit * 100)|round(1)) : 0 %}
{% set daily_pct_raw = daily_limit  > 0 ? (daily_sent / daily_limit * 100)|round(1) : 0 %}

{% macro progress_bar_class(pct) %}{% if pct >= 90 %}bg-danger{% elseif pct >= 70 %}bg-warning{% else %}bg-primary{% endif %}{% endmacro %}

{% block content %}
<div class="container-fluid">

    {% if success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>{{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
    {% endif %}
    {% if error %}
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i data-feather="alert-circle" class="align-self-center icon-xs me-2"></i>{{ error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
    {% endif %}

    <div class="row nx-es-layout">

        {# ── Sol kolon ── #}
        <div class="col-xl-9 col-lg-8 d-flex flex-column gap-4">

            {# Kart 1: Günlük Gönderim Hedefi #}
            <div class="card nx-es-main-card mb-0">
                <div class="panel-card-header">
                    <span class="icon-box"><i data-feather="send"></i></span>
                    <div>
                        <h5 class="title">Günlük Gönderim Hedefi</h5>
                        <p class="subtitle small mb-0">Sadece hedefi girin. Hız, worker pacing ve tüm SMTP limitleri otomatik hesaplanır.</p>
                    </div>
                </div>
                <div class="card-body pt-4 pb-4">
                    <form method="post" action="/admin/email-sending-settings/save" id="sendingSettingsForm">

                        <div class="nx-es-hero-wrap">
                            <label class="nx-es-hero-label" for="dailyLimitInput">24 saatte gönderilecek toplam mail</label>
                            <div class="nx-es-hero-row">
                                <input type="number" name="daily_limit" id="dailyLimitInput"
                                       class="form-control nx-es-hero-input"
                                       min="1" max="100000000" required
                                       value="{{ config.daily_limit }}">
                                <span class="nx-es-hero-unit">mail / gün</span>
                            </div>
                        </div>

                        <div class="mt-3 pt-3 border-top">
                            <label class="form-label small fw-semibold text-muted mb-1" for="smtpRotationLimitInput">SMTP Rotasyon Limiti <span class="text-muted fw-normal">(kampanya başına varsayılan)</span></label>
                            <div class="d-flex align-items-center gap-2" style="max-width:300px;">
                                <input type="number" name="smtp_rotation_limit" id="smtpRotationLimitInput"
                                       class="form-control"
                                       min="1" max="10000"
                                       value="{{ config.worker_smtp_rotation_limit|default(500) }}">
                                <span class="text-muted small text-nowrap">mail / SMTP</span>
                            </div>
                            <div class="form-text text-muted">Her SMTP bu kadar mail gönderdikten sonra rotasyona girer. Kampanya onayında üzerine yazılabilir.</div>
                        </div>

                        <div class="nx-es-stat-row mt-3">
                            <div class="nx-es-stat-chip">
                                <span class="nx-es-stat-lbl">Saniyelik hız</span>
                                <span class="nx-es-stat-val" id="summaryRate">≈ {{ config.rate_per_second|number_format(4, ',', '.') }} / sn</span>
                            </div>
                            <div class="nx-es-stat-sep"></div>
                            <div class="nx-es-stat-chip">
                                <span class="nx-es-stat-lbl">Saatlik limit</span>
                                <span class="nx-es-stat-val" id="summaryHourly">≈ {{ config.hourly_limit|number_format(0, ',', '.') }}</span>
                            </div>
                            <div class="nx-es-stat-sep"></div>
                            <div class="nx-es-stat-chip">
                                <span class="nx-es-stat-lbl">Dakikalık limit</span>
                                <span class="nx-es-stat-val" id="summaryMinute">≈ {{ config.minute_limit|number_format(0, ',', '.') }}</span>
                            </div>
                            <div class="nx-es-stat-sep"></div>
                            <div class="nx-es-stat-chip">
                                <span class="nx-es-stat-lbl">Paralel SMTP</span>
                                <span class="nx-es-stat-val nx-es-stat-val--accent">{{ active_smtp_count }} hesap — eş zamanlı</span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-3 pt-4 mt-3 border-top">
                            <button type="submit" class="btn nx-es-save-btn" id="nxEsSaveBtn">
                                <i data-feather="save" class="icon-xs me-1"></i> Kaydet ve Uygula
                            </button>
                            <small class="text-muted">Worker ayarları, hız ve tüm SMTP limitleri otomatik güncellenir.</small>
                        </div>
                    </form>
                </div>
            </div>

            {# Kart 2: Sayaç Sıfırlama #}
            <div class="card nx-es-main-card mb-0">
                <div class="panel-card-header">
                    <span class="icon-box"><i data-feather="rotate-ccw"></i></span>
                    <div>
                        <h5 class="title">Sayaç Sıfırlama</h5>
                        <p class="subtitle small mb-0">Tüm SMTP hesaplarının gönderim sayaçlarını seçerek veya toplu sıfırlayın. Toplam istatistikler korunur.</p>
                    </div>
                </div>
                <div class="card-body pt-4 pb-4">
                    <div class="nx-es-reset-grid">

                        <div class="nx-es-reset-tile">
                            <div class="nx-es-reset-tile-icon" style="background:#eff6ff;color:#2563eb;">
                                <i data-feather="calendar"></i>
                            </div>
                            <div class="nx-es-reset-tile-body">
                                <span class="nx-es-reset-tile-title">Günlük sayaç</span>
                                <span class="nx-es-reset-tile-desc">Bugünkü gönderim sayısını sıfırla</span>
                            </div>
                            <button type="button" class="btn nx-es-reset-tile-btn"
                                    onclick="nxResetSmtp('daily', this)"
                                    data-confirm="Tüm SMTP hesaplarının günlük sayaçları sıfırlanacak. Devam edilsin mi?">
                                <i data-feather="rotate-ccw" class="icon-xs me-1"></i>Sıfırla
                            </button>
                        </div>

                        <div class="nx-es-reset-tile">
                            <div class="nx-es-reset-tile-icon" style="background:#f0fdf4;color:#16a34a;">
                                <i data-feather="clock"></i>
                            </div>
                            <div class="nx-es-reset-tile-body">
                                <span class="nx-es-reset-tile-title">Saatlik sayaç</span>
                                <span class="nx-es-reset-tile-desc">Bu saatteki gönderim sayısını sıfırla</span>
                            </div>
                            <button type="button" class="btn nx-es-reset-tile-btn"
                                    onclick="nxResetSmtp('hourly', this)"
                                    data-confirm="Tüm SMTP hesaplarının saatlik sayaçları sıfırlanacak. Devam edilsin mi?">
                                <i data-feather="rotate-ccw" class="icon-xs me-1"></i>Sıfırla
                            </button>
                        </div>

                        <div class="nx-es-reset-tile">
                            <div class="nx-es-reset-tile-icon" style="background:#fefce8;color:#ca8a04;">
                                <i data-feather="watch"></i>
                            </div>
                            <div class="nx-es-reset-tile-body">
                                <span class="nx-es-reset-tile-title">Dakikalık sayaç</span>
                                <span class="nx-es-reset-tile-desc">Bu dakikadaki gönderim sayısını sıfırla</span>
                            </div>
                            <button type="button" class="btn nx-es-reset-tile-btn"
                                    onclick="nxResetSmtp('minute', this)"
                                    data-confirm="Tüm SMTP hesaplarının dakikalık sayaçları sıfırlanacak. Devam edilsin mi?">
                                <i data-feather="rotate-ccw" class="icon-xs me-1"></i>Sıfırla
                            </button>
                        </div>

                        <div class="nx-es-reset-tile nx-es-reset-tile--danger">
                            <div class="nx-es-reset-tile-icon" style="background:#fef2f2;color:#dc2626;">
                                <i data-feather="alert-triangle"></i>
                            </div>
                            <div class="nx-es-reset-tile-body">
                                <span class="nx-es-reset-tile-title">Toplu sıfırla</span>
                                <span class="nx-es-reset-tile-desc">Günlük + saatlik + dakikalık hepsini sıfırla</span>
                            </div>
                            <button type="button" class="btn nx-es-reset-tile-btn nx-es-reset-tile-btn--danger"
                                    onclick="nxResetSmtp('all', this)"
                                    data-confirm="TÜM SMTP hesaplarının günlük, saatlik ve dakikalık sayaçları sıfırlanacak. Emin misiniz?">
                                <i data-feather="rotate-ccw" class="icon-xs me-1"></i>Tümünü Sıfırla
                            </button>
                        </div>

                    </div>

                    <div id="nxResetFeedback" class="nx-es-reset-feedback d-none mt-3">
                        <i data-feather="check-circle" class="icon-xs me-2"></i>
                        <span id="nxResetFeedbackMsg"></span>
                    </div>
                </div>
            </div>

        </div>

        {# ── Sağ kolon ── #}
        <div class="col-xl-3 col-lg-4 d-flex flex-column gap-3">

            <div class="card nx-es-side-card">
                <div class="panel-card-header">
                    <span class="icon-box"><i data-feather="bar-chart-2"></i></span>
                    <div>
                        <h5 class="title">Bugünkü kullanım</h5>
                        <p class="subtitle small mb-0">Global sayaçlar (tüm SMTP)</p>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="nx-es-usage-row">
                        <div class="nx-es-usage-meta">
                            <span class="nx-es-usage-label"><i data-feather="calendar" class="icon-xs"></i> Günlük</span>
                            <span class="nx-es-usage-value">{{ daily_sent|number_format }} / {{ daily_limit|number_format }}</span>
                        </div>
                        <div class="progress nx-es-usage-progress">
                            <div class="progress-bar rounded-pill {{ _self.progress_bar_class(daily_pct_raw) }}"
                                 role="progressbar" style="width:{{ daily_pct }}%;"></div>
                        </div>
                        {% if daily_pct_raw >= 90 %}
                        <small class="text-danger">Kota limitine yaklaşıldı ({{ daily_pct_raw|number_format(1,'.','') }}%)</small>
                        {% elseif daily_pct_raw >= 70 %}
                        <small class="text-warning">Kullanım yüksek ({{ daily_pct_raw|number_format(1,'.','') }}%)</small>
                        {% endif %}
                    </div>
                    <div class="nx-es-usage-row">
                        <div class="nx-es-usage-meta">
                            <span class="nx-es-usage-label"><i data-feather="clock" class="icon-xs"></i> Saatlik</span>
                            <span class="nx-es-usage-value">{{ hourly_sent|number_format }} / {{ hourly_limit|number_format }}</span>
                        </div>
                        <div class="progress nx-es-usage-progress">
                            <div class="progress-bar rounded-pill {{ _self.progress_bar_class(hourly_pct) }}"
                                 role="progressbar" style="width:{{ hourly_pct }}%;"></div>
                        </div>
                    </div>
                    <div class="nx-es-usage-row mb-0">
                        <div class="nx-es-usage-meta">
                            <span class="nx-es-usage-label"><i data-feather="watch" class="icon-xs"></i> Dakikalık</span>
                            <span class="nx-es-usage-value">{{ minute_sent|number_format }} / {{ minute_limit|number_format }}</span>
                        </div>
                        <div class="progress nx-es-usage-progress">
                            <div class="progress-bar rounded-pill {{ _self.progress_bar_class(minute_pct) }}"
                                 role="progressbar" style="width:{{ minute_pct }}%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card nx-es-side-card">
                <div class="panel-card-header">
                    <span class="icon-box"><i data-feather="package"></i></span>
                    <div>
                        <h5 class="title">Hazır paketler</h5>
                        <p class="subtitle small mb-0">Tek tıkla hedefi seç, Kaydet ile uygula.</p>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <div class="nx-es-preset-grid" id="nxEsPresetGrid">
                        {% for key, p in plans %}
                        <button type="button" class="nx-es-preset-btn"
                                data-daily-limit="{{ p.daily_limit }}"
                                data-effective-rate="{{ p.effective_rate }}">
                            <span class="nx-es-preset-title">{{ p.title }}</span>
                            <span class="nx-es-preset-rate">≈ {{ p.effective_rate|number_format(2, ',', '.') }} mail/sn</span>
                        </button>
                        {% endfor %}
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script>
(function () {
    const EMAIL_MAX_RATE = {{ email_max_rate_per_second|json_encode|raw }};
    const dailyInput  = document.getElementById('dailyLimitInput');
    const settingsForm = document.getElementById('sendingSettingsForm');
    const saveBtn     = document.getElementById('nxEsSaveBtn');
    const summaryRate   = document.getElementById('summaryRate');
    const summaryHourly = document.getElementById('summaryHourly');
    const summaryMinute = document.getElementById('summaryMinute');

    function clampRate(r) {
        if (!isFinite(r) || r <= 0) return 0.01;
        return Math.min(EMAIL_MAX_RATE, Math.max(0.01, Math.round(r * 10000) / 10000));
    }
    function formatNum(n)  { return Math.round(n).toLocaleString('tr-TR'); }
    function formatRate(n) { return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 4 }); }

    function refreshSummary() {
        var d = parseInt(dailyInput.value, 10) || 0;
        if (d < 1) return;
        var rate = clampRate(d / 86400);
        if (summaryRate)   summaryRate.textContent   = '≈ ' + formatRate(rate) + ' / sn';
        if (summaryHourly) summaryHourly.textContent = '≈ ' + formatNum(Math.floor(rate * 3600));
        if (summaryMinute) summaryMinute.textContent = '≈ ' + formatNum(Math.floor(rate * 60));
    }

    if (dailyInput) dailyInput.addEventListener('input', refreshSummary);

    document.querySelectorAll('.nx-es-preset-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var limit = parseInt(btn.getAttribute('data-daily-limit'), 10);
            if (dailyInput && limit > 0) dailyInput.value = String(limit);
            document.querySelectorAll('.nx-es-preset-btn').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            refreshSummary();
        });
    });

    if (settingsForm && saveBtn) {
        settingsForm.addEventListener('submit', function () {
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Uygulanıyor...';
        });
    }

    if (typeof feather !== 'undefined') feather.replace();

    /* ── Sayaç sıfırlama ── */
    window.nxResetSmtp = function (type, btn) {
        var msg = btn.getAttribute('data-confirm') || 'Sayaçlar sıfırlanacak. Devam edilsin mi?';
        if (!confirm(msg)) return;

        var original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';

        fetch('/admin/email-smtp/reset-limits', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'type=' + encodeURIComponent(type)
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success) {
                btn.innerHTML = '<i data-feather="check" class="icon-xs me-1"></i>Sıfırlandı';
                btn.classList.add('nx-es-reset-tile-btn--done');
                var fb = document.getElementById('nxResetFeedback');
                var fm = document.getElementById('nxResetFeedbackMsg');
                if (fb && fm) { fm.textContent = data.message; fb.classList.remove('d-none'); }
                if (typeof feather !== 'undefined') feather.replace();
                setTimeout(function () {
                    btn.disabled = false;
                    btn.innerHTML = original;
                    btn.classList.remove('nx-es-reset-tile-btn--done');
                    if (fb) fb.classList.add('d-none');
                    if (typeof feather !== 'undefined') feather.replace();
                }, 3500);
            } else {
                alert(data.message || 'Sıfırlama başarısız.');
                btn.disabled = false;
                btn.innerHTML = original;
                if (typeof feather !== 'undefined') feather.replace();
            }
        })
        .catch(function () {
            alert('Bağlantı hatası.');
            btn.disabled = false;
            btn.innerHTML = original;
            if (typeof feather !== 'undefined') feather.replace();
        });
    };
})();
</script>
{% endblock %}
