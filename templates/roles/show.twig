{% extends '_layouts/main.twig' %}

{% block title %}{{ role.name }} - Rol Detayları - {{ site_title|default('Nexus Panel') }}{% endblock %}
{% block title_text %}Rol Detayları{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h4 class="card-title">
                            <i data-feather="shield" class="align-self-center icon-xs me-2"></i>
                            {{ role.name }}
                        </h4>
                    </div>
                    <div class="col-auto">
                        {% if role.key != 'admin' and role.key != 'user' %}
                        <a href="/roles/{{ role.id }}/edit" class="btn btn-sm btn-warning">
                            <i data-feather="edit" class="align-self-center icon-xs me-1"></i>
                            Düzenle
                        </a>
                        {% endif %}
                        <a href="/roles" class="btn btn-sm btn-secondary">
                            <i data-feather="arrow-left" class="align-self-center icon-xs me-1"></i>
                            Geri Dön
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <p><strong>Rol Adı:</strong> {{ role.name }}</p>
                        <p><strong>Anahtar:</strong> <code>{{ role.key }}</code></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Açıklama:</strong> {{ role.description ?? '-' }}</p>
                        <p><strong>Kullanıcı Sayısı:</strong> {{ role.users ? role.users|length : 0 }} kullanıcı</p>
                    </div>
                </div>
                
                <hr>
                
                <h5 class="mt-4 mb-3">
                    <i data-feather="key" class="align-self-center icon-xs me-2"></i>
                    Yetkiler ({{ role.permissions|length }})
                </h5>
                
                <div class="row">
                    {% if role.permissions|length > 0 %}
                        {% for permission in role.permissions %}
                        <div class="col-md-4 col-lg-3 mb-3">
                            <div class="card border border-success">
                                <div class="card-body p-3">
                                    <i data-feather="check-circle" class="text-success icon-xs me-1"></i>
                                    <strong>{{ permission.name }}</strong>
                                    <br>
                                    <small class="text-muted">{{ permission.key }}</small>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-info">
                                <i data-feather="info" class="align-self-center icon-xs me-2"></i>
                                Bu role henüz yetki atanmamış
                            </div>
                        </div>
                    {% endif %}
                </div>
                
            </div>
        </div>
    </div>
</div>

{% if role.users and role.users|length > 0 %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">
                    <i data-feather="users" class="align-self-center icon-xs me-2"></i>
                    Bu Role Sahip Kullanıcılar ({{ role.users|length }})
                </h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kullanıcı Adı</th>
                                <th>Ad Soyad</th>
                                <th>E-posta</th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in role.users %}
                            <tr>
                                <td>{{ user.username }}</td>
                                <td>{{ user.fullName }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% if user.isActive %}
                                        <span class="badge bg-success">Aktif</span>
                                    {% else %}
                                        <span class="badge bg-danger">Pasif</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <a href="/users/{{ user.id }}" class="btn btn-sm btn-soft-primary">
                                        <i data-feather="eye" class="align-self-center icon-xs"></i>
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
// Feather icons
feather.replace();
</script>
{% endblock %}
