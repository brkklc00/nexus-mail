{% extends '_layouts/main.twig' %}

{% block title %}Yeni Rol Ekle - {{ site_title|default('Nexus Panel') }}{% endblock %}
{% block title_text %}Yeni Rol Ekle{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h4 class="card-title">
                            <i data-feather="shield" class="align-self-center icon-xs me-2"></i>
                            Yeni Rol Oluştur
                        </h4>
                    </div>
                    <div class="col-auto">
                        <a href="/roles" class="btn btn-sm btn-secondary">
                            <i data-feather="arrow-left" class="align-self-center icon-xs me-1"></i>
                            Geri Dön
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                
                {% if error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i data-feather="alert-triangle" class="align-self-center icon-xs me-2"></i>
                    {{ error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                {% endif %}
                
                <form method="POST" action="/roles/create">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="name" class="form-label">Rol Adı <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="name" name="name" required>
                                <small class="text-muted">Örn: Müşteri, Operatör, Yönetici</small>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="key" class="form-label">Rol Anahtarı <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="key" name="key" required>
                                <small class="text-muted">Örn: customer, operator, manager (küçük harf, boşluksuz)</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <label for="description" class="form-label">Açıklama</label>
                                <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-12">
                            <h5 class="mb-3">Yetkiler</h5>
                            <p class="text-muted">Bu role verilecek yetkileri seçin</p>
                        </div>
                    </div>
                    
                    <div class="row">
                        {% if permissions|length > 0 %}
                            {% for permission in permissions %}
                            <div class="col-md-4 col-lg-3 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="permission_{{ permission.id }}" name="permissions[]" value="{{ permission.id }}">
                                    <label class="form-check-label" for="permission_{{ permission.id }}">
                                        {{ permission.name }}
                                        <small class="d-block text-muted">{{ permission.key }}</small>
                                    </label>
                                </div>
                            </div>
                            {% endfor %}
                        {% else %}
                            <div class="col-12">
                                <p class="text-muted">Henüz yetki bulunmuyor</p>
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i data-feather="save" class="align-self-center icon-xs me-2"></i>
                                Rolü Kaydet
                            </button>
                            <a href="/roles" class="btn btn-secondary ms-2">
                                <i data-feather="x" class="align-self-center icon-xs me-2"></i>
                                İptal
                            </a>
                        </div>
                    </div>
                    
                </form>
                
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
// Feather icons
feather.replace();

// Key otomatik doldurma
document.getElementById('name').addEventListener('input', function(e) {
    const key = e.target.value
        .toLowerCase()
        .replace(/ş/g, 's')
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ı/g, 'i')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c')
        .replace(/[^a-z0-9]/g, '_')
        .replace(/_+/g, '_')
        .replace(/^_|_$/g, '');
    
    if (!document.getElementById('key').value || document.getElementById('key').dataset.auto !== 'false') {
        document.getElementById('key').value = key;
    }
});

document.getElementById('key').addEventListener('input', function() {
    this.dataset.auto = 'false';
});
</script>
{% endblock %}
