{% extends '_layouts/main.twig' %}

{% block title %}Roller & Yetkiler - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block breadcrumb_items %}
<li class="breadcrumb-item"><a href="/dashboard">Yönetici</a></li>
<li class="breadcrumb-item active">Roller & Yetkiler</li>
{% endblock %}

{% block page_icon %}<i data-feather="key" class="icon-dual icon-sm me-2"></i>{% endblock %}

{% block title_text %}Roller & Yetkiler{% endblock %}

{% block content %}

{% if success %}
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <i data-feather="check-circle" class="align-self-center icon-xs me-2"></i>
    {{ success }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{% endif %}

<!-- İstatistik Kartları -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Toplam Rol</p>
                        <h4 class="mb-0">{{ stats.total_roles }}</h4>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="shield" class="text-primary" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Kullanıcılı Roller</p>
                        <h4 class="mb-0">{{ stats.roles_with_users }}</h4>
                        <p class="text-muted mb-0 fs-12">aktif kullanımda</p>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="users" class="text-success" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Sistem Rolleri</p>
                        <h4 class="mb-0">{{ stats.system_roles }}</h4>
                        <p class="text-muted mb-0 fs-12">düzenlenemez</p>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="lock" class="text-warning" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="min-height: 120px;">
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1 text-uppercase fw-semibold fs-13">Toplam Yetki</p>
                        <h4 class="mb-0">{{ stats.total_permissions }}</h4>
                        <p class="text-muted mb-0 fs-12">yetki tanımı</p>
                    </div>
                    <div class="flex-shrink-0">
                        <i data-feather="key" class="text-info" style="width: 40px; height: 40px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h4 class="card-title mb-0">
                            <i data-feather="shield" class="align-self-center icon-xs me-2"></i>
                            Roller & Yetkiler
                        </h4>
                        <small class="text-muted">{{ roles|length }} rol bulundu</small>
                    </div>
                    <div class="col-auto">
                            <button type="button" class="btn btn-primary" onclick="showCreateModal()">
                            <i data-feather="plus" class="icon-xs me-1"></i>
                                Yeni Rol Ekle
                            </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                {# Kart Görünümü #}
                <div class="row g-3">
                            {% for role in roles %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                        <h5 class="mb-1">
                                            <i data-feather="shield" class="icon-xs text-primary me-2"></i>
                                            {{ role.name }}
                                        </h5>
                                            {% if role.isReadonly %}
                                        <span class="badge bg-warning-subtle text-warning">Sistem Rolü</span>
                                        {% else %}
                                        <span class="badge bg-success-subtle text-success">Özel Rol</span>
                                            {% endif %}
                                        </div>
                                    </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <small class="text-muted">
                                        <i data-feather="key" class="icon-xs me-1"></i>
                                        {{ role.permissions|length }} Yetki
                                        </small>
                                        <small class="text-muted">
                                            <i data-feather="users" class="icon-xs me-1"></i>
                                            {{ role.users|length }} Kullanıcı
                                        </small>
                        </div>
                                </div>

                                <div class="btn-group w-100">
                                    {% if _session.is_admin|default(false) %}
                                    <button type="button" class="btn btn-success btn-sm" 
                                            onclick="quickEditPermissions({{ role.id }}, '{{ role.name|e('js') }}')"
                                            title="Yetki Ver/Al">
                                        <i data-feather="key" class="icon-xs me-1"></i>
                                        Yetki Ver/Al
                            </button>
                                    {% endif %}
                                    <button type="button" class="btn btn-info btn-sm" 
                                            onclick="viewRole({{ role.id }})"
                                            title="Detay">
                                        <i data-feather="eye" class="icon-xs me-1"></i>
                                        Detay
                                    </button>
                                    {% if not role.isReadonly and _session.is_admin|default(false) %}
                                    <button type="button" class="btn btn-danger btn-sm" 
                                            onclick="deleteRole({{ role.id }}, '{{ role.name|e('js') }}')"
                                            title="Sil">
                                        <i data-feather="trash-2" class="icon-xs me-1"></i>
                                        Sil
                                    </button>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                            {% else %}
                    <div class="col-12">
                        <div class="text-center text-muted py-5">
                            <i data-feather="inbox" class="icon-lg mb-3"></i>
                                    <p class="mb-0">Henüz rol bulunmamaktadır.</p>
                        </div>
                    </div>
                            {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Yeni Rol Modal (Gruplandırılmış Yetkilerle) -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i data-feather="plus-circle" class="icon-sm me-2 text-primary"></i>
                    Yeni Rol Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="/roles" id="createRoleForm">
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <div class="mb-3">
                        <label for="create_name" class="form-label">Rol Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg" id="create_name" name="name" required placeholder="Örn: Müşteri Temsilcisi">
                </div>
                
                    <div class="mb-3">
                        <label class="form-label">Yetkiler <span class="text-muted">(Modül bazlı)</span></label>
                        <div class="mb-2 d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-success" onclick="selectAllPermissions()">
                                    <i data-feather="check-square" class="icon-xs me-1"></i> Tümünü Seç
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary" onclick="deselectAllPermissions()">
                                    <i data-feather="square" class="icon-xs me-1"></i> Tümünü Kaldır
                                </button>
                                <button type="button" class="btn btn-sm btn-info" onclick="expandAllCreate()">
                                    <i data-feather="maximize-2" class="icon-xs me-1"></i> Tümünü Aç
                                </button>
                                        </div>
                            <div>
                                <small class="text-muted">Seçili: <strong id="createSelectedCount">0</strong> yetki</small>
                        </div>
                    </div>
                    
                        <!-- Modül bazlı gruplandırma -->
                        <div class="accordion" id="permissionsAccordion">
                            {% for module, perms in groupedPermissions %}
                            <div class="accordion-item border mb-2">
                                <h2 class="accordion-header" id="headingCreate{{ loop.index }}">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCreate{{ loop.index }}" aria-expanded="false">
                                        <strong>{{ module }}</strong>
                                        <span class="badge bg-primary ms-2">{{ perms|length }} yetki</span>
                                    </button>
                                </h2>
                                <div id="collapseCreate{{ loop.index }}" class="accordion-collapse collapse" aria-labelledby="headingCreate{{ loop.index }}" data-bs-parent="#permissionsAccordion">
                                    <div class="accordion-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 35%">Yetki</th>
                                                        <th class="text-center" style="width: 10%">
                                                            <input type="checkbox" class="form-check-input" onclick="toggleColumnCreate(this, 'read', {{ loop.index }})" title="Tüm Okuma">
                                                        </th>
                                                        <th class="text-center" style="width: 10%">
                                                            <input type="checkbox" class="form-check-input" onclick="toggleColumnCreate(this, 'create', {{ loop.index }})" title="Tüm Oluşturma">
                                                        </th>
                                                        <th class="text-center" style="width: 10%">
                                                            <input type="checkbox" class="form-check-input" onclick="toggleColumnCreate(this, 'update', {{ loop.index }})" title="Tüm Güncelleme">
                                                        </th>
                                                        <th class="text-center" style="width: 10%">
                                                            <input type="checkbox" class="form-check-input" onclick="toggleColumnCreate(this, 'delete', {{ loop.index }})" title="Tüm Silme">
                                                        </th>
                                                        <th class="text-center" style="width: 25%">Hızlı Seç</th>
                                                    </tr>
                                                    <tr>
                                                        <th></th>
                                                        <th class="text-center"><small class="text-muted">Okuma</small></th>
                                                        <th class="text-center"><small class="text-muted">Oluşturma</small></th>
                                                        <th class="text-center"><small class="text-muted">Güncelleme</small></th>
                                                        <th class="text-center"><small class="text-muted">Silme</small></th>
                                                        <th class="text-center"><small class="text-muted">Presetler</small></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for permission in perms %}
                                                    <tr class="perm-row-create-{{ loop.parent.loop.index }}">
                                                        <td>
                                                            <strong>{{ permission.name }}</strong>
                                                            <br><small class="text-muted font-monospace">{{ permission.key }}</small>
                                                        </td>
                                                        <td class="text-center">
                                                            <input type="checkbox" class="form-check-input permission-checkbox perm-read-create-{{ loop.parent.loop.index }}" 
                                                                   name="permissions[{{ permission.id }}][read]" value="1">
                                                        </td>
                                                        <td class="text-center">
                                                            <input type="checkbox" class="form-check-input permission-checkbox perm-create-create-{{ loop.parent.loop.index }}" 
                                                                   name="permissions[{{ permission.id }}][create]" value="1">
                                                        </td>
                                                        <td class="text-center">
                                                            <input type="checkbox" class="form-check-input permission-checkbox perm-update-create-{{ loop.parent.loop.index }}" 
                                                                   name="permissions[{{ permission.id }}][update]" value="1">
                                                        </td>
                                                        <td class="text-center">
                                                            <input type="checkbox" class="form-check-input permission-checkbox perm-delete-create-{{ loop.parent.loop.index }}" 
                                                                   name="permissions[{{ permission.id }}][delete]" value="1">
                                                        </td>
                                                        <td class="text-center">
                                                            <div class="btn-group btn-group-sm" role="group">
                                                                <button type="button" class="btn btn-outline-success btn-sm" onclick="setRowPermissionsCreate({{ loop.parent.loop.index }}, {{ loop.index0 }}, 'all')" title="Tüm Yetkiler">Tümü</button>
                                                                <button type="button" class="btn btn-outline-info btn-sm" onclick="setRowPermissionsCreate({{ loop.parent.loop.index }}, {{ loop.index0 }}, 'read')" title="Sadece Okuma">Okuma</button>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setRowPermissionsCreate({{ loop.parent.loop.index }}, {{ loop.index0 }}, 'none')" title="Yetki Yok">Yok</button>
                                        </div>
                                                        </td>
                                                    </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                    </div>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                                        </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i data-feather="x" class="icon-xs me-1"></i>
                        İptal
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i data-feather="check" class="icon-xs me-1"></i>
                        Rol Oluştur
                    </button>
                                    </div>
            </form>
                                    </div>
                                </div>
                            </div>

<!-- Rol Detay Modal -->
<div class="modal fade" id="roleDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i data-feather="shield" class="icon-sm me-2 text-info"></i>
                    Rol Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
            <div class="modal-body" id="roleDetailContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i data-feather="x" class="icon-xs me-1"></i>
                    Kapat
                </button>
                <button type="button" class="btn btn-primary" id="editFromDetailBtn" onclick="editRoleFromDetail()">
                    <i data-feather="edit" class="icon-xs me-1"></i>
                    Düzenle
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Yetki Yönetimi Modal -->
<div class="modal fade" id="permissionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i data-feather="key" class="icon-sm me-2 text-success"></i>
                    Yetki Yönetimi
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <div class="alert alert-info border-0">
                            <i data-feather="info" class="icon-xs me-2"></i>
                            <strong>Bilgi:</strong> Sistem yetkilerini buradan yönetebilirsiniz. Yeni yetki ekleyebilir veya mevcut yetkileri düzenleyebilirsiniz.
                    </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <button type="button" class="btn btn-primary" onclick="showAddPermissionForm()">
                            <i data-feather="plus" class="icon-xs me-1"></i>
                            Yeni Yetki Ekle
                        </button>
                    </div>
                </div>
                
                <!-- Yeni Yetki Ekleme Formu -->
                <div id="addPermissionForm" style="display: none;" class="mb-4">
                    <div class="card border-primary">
                        <div class="card-header bg-primary-subtle">
                            <h6 class="mb-0 text-primary">Yeni Yetki Ekle</h6>
                </div>
                        <div class="card-body">
                            <form id="newPermissionForm" onsubmit="return saveNewPermission(event)">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Yetki Adı <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="new_perm_name" required placeholder="Örn: Email Şablon Yönetimi">
                    </div>
                </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Yetki Anahtarı <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control font-monospace" id="new_perm_key" required placeholder="Örn: email_template_manage">
                                            <small class="text-muted">Küçük harf, tire ve alt çizgi kullanın</small>
            </div>
        </div>
    </div>
                                <div class="text-end">
                                    <button type="button" class="btn btn-secondary" onclick="hideAddPermissionForm()">İptal</button>
                                    <button type="submit" class="btn btn-success">
                                        <i data-feather="save" class="icon-xs me-1"></i>
                                        Yetki Ekle
                                    </button>
</div>
                            </form>
            </div>
                    </div>
                        </div>
                        
                <!-- Mevcut Yetkiler Listesi -->
                <div class="accordion" id="permissionsManagementAccordion">
                            {% for module, perms in groupedPermissions %}
                    <div class="accordion-item border mb-2">
                                <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#permMgmt{{ loop.index }}">
                                        <strong>{{ module }}</strong>
                                <span class="badge bg-primary ms-2">{{ perms|length }} yetki</span>
                                    </button>
                                </h2>
                        <div id="permMgmt{{ loop.index }}" class="accordion-collapse collapse">
                            <div class="accordion-body p-0">
                                        <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                <th style="width: 10%">#ID</th>
                                                <th style="width: 35%">Yetki Adı</th>
                                                <th style="width: 35%">Anahtar</th>
                                                <th class="text-end" style="width: 20%">İşlem</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for permission in perms %}
                                            <tr id="perm-row-{{ permission.id }}">
                                                <td><strong>#{{ permission.id }}</strong></td>
                                                <td>
                                                    <span class="perm-name-display">{{ permission.name }}</span>
                                                    <input type="text" class="form-control form-control-sm perm-name-edit" style="display:none;" value="{{ permission.name }}">
                                                        </td>
                                                <td>
                                                    <code class="perm-key-display">{{ permission.key }}</code>
                                                    <input type="text" class="form-control form-control-sm font-monospace perm-key-edit" style="display:none;" value="{{ permission.key }}">
                                                        </td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm perm-actions">
                                                        <button type="button" class="btn btn-outline-warning" onclick="editPermission({{ permission.id }})" title="Düzenle">
                                                            <i data-feather="edit" class="icon-xs"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger" onclick="deletePermission({{ permission.id }}, '{{ permission.name|e('js') }}')" title="Sil">
                                                            <i data-feather="trash-2" class="icon-xs"></i>
                                                        </button>
                                                    </div>
                                                    <div class="btn-group btn-group-sm perm-edit-actions" style="display:none;">
                                                        <button type="button" class="btn btn-success" onclick="savePermission({{ permission.id }})" title="Kaydet">
                                                            <i data-feather="check" class="icon-xs"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-secondary" onclick="cancelEditPermission({{ permission.id }})" title="İptal">
                                                            <i data-feather="x" class="icon-xs"></i>
                                                        </button>
                                                    </div>
                                                        </td>
                                                    </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
    </div>
</div>

<!-- Hızlı Yetki Ver/Al Modal -->
<div class="modal fade" id="quickPermissionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title">
                    <i data-feather="key" class="icon-sm me-2 text-success"></i>
                    Yetki Ver/Al
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" id="quickPermissionsForm">
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    {# Rol Adı Düzenleme Alanı #}
                    <div class="card bg-light border-0 mb-3">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold mb-0">
                                        <i data-feather="shield" class="icon-xs me-1"></i>
                                        Rol Adı
                                    </label>
                    </div>
                                <div class="col-md-9">
                                    <input type="text" class="form-control form-control-lg" id="quickEditRoleNameInput" name="name" required placeholder="Rol adını girin...">
                                    <small class="text-muted">Rol adını değiştirmek için düzenleyin</small>
                </div>
                            </div>
                        </div>
                    </div>
                    <!-- İstatistikler -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center py-2">
                                    <h3 class="mb-0 text-primary" id="quickSelectedCount">0</h3>
                                    <small class="text-muted">Seçili Yetki</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center py-2">
                                    <h3 class="mb-0 text-info" id="quickReadCount">0</h3>
                                    <small class="text-muted">Okuma</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center py-2">
                                    <h3 class="mb-0 text-success" id="quickWriteCount">0</h3>
