        } else {
            iziToast.error({
                title: 'Hata',
                message: data.error || 'Yetki güncellenemedi',
                position: 'topRight'
            });
        }
    } catch (error) {
        iziToast.error({
            title: 'Hata',
            message: error.message,
            position: 'topRight'
        });
    }
}

// Yetki sil
function deletePermission(permId, permName) {
    iziToast.question({
        timeout: false,
        close: false,
        overlay: true,
        displayMode: 'once',
        id: 'deletePermission',
        zindex: 999,
