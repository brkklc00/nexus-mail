// Tüm yetkileri seç
function selectAllPermissions() {
    document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = true);
    updateCreateStats();
}

// Tüm yetkileri kaldır
function deselectAllPermissions() {
    document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = false);
    updateCreateStats();
}

// Tüm accordion'ları aç (Create modal)
function expandAllCreate() {
    document.querySelectorAll('#permissionsAccordion .accordion-collapse').forEach(collapse => {
        const bsCollapse = new bootstrap.Collapse(collapse, { toggle: false });
        bsCollapse.show();
    });
}

// Create modal istatistiklerini güncelle
function updateCreateStats() {
    const permissionIds = new Set();
    document.querySelectorAll('input[type="checkbox"].permission-checkbox:checked').forEach(cb => {
        const match = cb.name.match(/permissions\[(\d+)\]/);
        if (match) permissionIds.add(match[1]);
    });
    document.getElementById('createSelectedCount').textContent = permissionIds.size;
}

// Sütun toggle (Create modal için)
function toggleColumnCreate(checkbox, action, moduleIndex) {
    const checkboxes = document.querySelectorAll(`.perm-${action}-create-${moduleIndex}`);
    checkboxes.forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateCreateStats();
}

// Satır yetkileri ayarla (Create modal için)
function setRowPermissionsCreate(moduleIndex, rowIndex, preset) {
    const row = document.querySelectorAll(`.perm-row-create-${moduleIndex}`)[rowIndex];
    if (!row) return;
    
    const checkboxes = row.querySelectorAll('input[type="checkbox"].permission-checkbox');
    
    switch(preset) {
        case 'all':
            checkboxes.forEach(cb => cb.checked = true);
            break;
        case 'read':
            checkboxes.forEach((cb, idx) => {
                cb.checked = (idx === 0);
            });
            break;
        case 'none':
            checkboxes.forEach(cb => cb.checked = false);
            break;
    }
    updateCreateStats();
}

// Yetkileri render et (Edit modal için)
function renderEditPermissions(groupedPermissions, rolePermissions) {
    const container = document.getElementById('editPermissionsContainer');
    
    let html = '<div class="accordion" id="editPermissionsAccordion">';
    let moduleIndex = 0;
    
    for (const [module, perms] of Object.entries(groupedPermissions)) {
        moduleIndex++;
        html += `
            <div class="accordion-item border mb-2">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#editCollapse${moduleIndex}">
                        <strong>${module}</strong>
                        <span class="badge bg-primary ms-2">${perms.length} yetki</span>
                    </button>
                </h2>
                <div id="editCollapse${moduleIndex}" class="accordion-collapse collapse">
                    <div class="accordion-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%">Yetki</th>
                                        <th class="text-center" style="width: 10%">
                                            <input type="checkbox" class="form-check-input" onclick="toggleEditColumn(this, 'read', ${moduleIndex})" title="Tüm Okuma">
                                        </th>
                                        <th class="text-center" style="width: 10%">
                                            <input type="checkbox" class="form-check-input" onclick="toggleEditColumn(this, 'create', ${moduleIndex})" title="Tüm Oluşturma">
                                        </th>
                                        <th class="text-center" style="width: 10%">
                                            <input type="checkbox" class="form-check-input" onclick="toggleEditColumn(this, 'update', ${moduleIndex})" title="Tüm Güncelleme">
                                        </th>
                                        <th class="text-center" style="width: 10%">
                                            <input type="checkbox" class="form-check-input" onclick="toggleEditColumn(this, 'delete', ${moduleIndex})" title="Tüm Silme">
                                        </th>
                                        <th class="text-center" style="width: 25%">Hızlı Seç</th>
                                    </tr>
                                    <tr>
                                        <th></th>
                                        <th class="text-center"><small class="text-muted">Okuma</small></th>
                                        <th class="text-center"><small class="text-muted">Oluşturma</small></th>
                                        <th class="text-center"><small class="text-muted">Güncelleme</small></th>
                                        <th class="text-center"><small class="text-muted">Silme</small></th>
