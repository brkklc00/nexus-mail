// Global değişken - şu an düzenlenen rol ID
let currentEditRoleId = null;

// Rol detayını göster
function viewRole(roleId) {
    currentEditRoleId = roleId;
    const modal = new bootstrap.Modal(document.getElementById('roleDetailModal'));
    const content = document.getElementById('roleDetailContent');
    const editBtn = document.getElementById('editFromDetailBtn');
    
    content.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
    modal.show();
    
    fetch('/roles/' + roleId)
        .then(response => {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            return response.text();
        })
        .then(html => {
            content.innerHTML = html;
            
            // Readonly kontrolü
            const isReadonly = html.includes('Sistem Rolü') || html.includes('düzenlenemez');
            if (editBtn) {
                editBtn.style.display = isReadonly ? 'none' : 'inline-block';
            }
            
            // İkonları yenile
            for(let i = 0; i < 10; i++) {
                setTimeout(initFeatherIcons, i * 100);
            }
        })
        .catch(error => {
            console.error('Rol detay hatası:', error);
            content.innerHTML = '<div class="alert alert-danger"><strong>Hata:</strong> ' + error.message + '</div>';
        });
}

// Rol düzenle modal aç
async function editRole(roleId) {
    currentEditRoleId = roleId;
    
    const modal = new bootstrap.Modal(document.getElementById('editRoleModal'));
    const container = document.getElementById('editPermissionsContainer');
    
    // Loading göster
    container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="text-muted mt-2">Yükleniyor...</p></div>';
    
    modal.show();
    
    try {
        // Rol bilgilerini fetch et
        const response = await fetch(`/roles/${roleId}/edit-data`);
        const data = await response.json();
        
        if (data.success) {
            // Rol adını doldur
            document.getElementById('edit_name').value = data.role.name;
            
            // Form action'ı ayarla
            document.getElementById('editRoleForm').action = `/roles/${roleId}/edit`;
            
            // Yetkileri render et
            renderEditPermissions(data.groupedPermissions, data.role.permissions);
            
            // İstatistikleri güncelle
            updateEditStats();
            
            // Icon'ları yenile
            for(let i = 0; i < 5; i++) {
                setTimeout(initFeatherIcons, i * 100);
            }
        } else {
            iziToast.error({
                title: 'Hata',
                message: 'Rol bilgileri yüklenemedi',
                position: 'topRight'
            });
        }
    } catch (error) {
        iziToast.error({
            title: 'Hata',
            message: error.message,
            position: 'topRight'
        });
        container.innerHTML = '<div class="alert alert-danger">Rol yüklenemedi!</div>';
    }
}

// Detaydan düzenle
function editRoleFromDetail() {
    const roleId = currentEditRoleId;
    const detailModal = bootstrap.Modal.getInstance(document.getElementById('roleDetailModal'));
    if (detailModal) detailModal.hide();
    
    setTimeout(() => {
        editRole(roleId);
    }, 300);
}

// Tüm yetkileri göster (liste preview)
function showAllPermissions(roleId, roleName) {
