{% block scripts %}
<script>
// Loading overlay fonksiyonları
function showLoading() {
    const overlay = document.getElementById('loadingOverlay');
    if (overlay) {
        overlay.style.display = 'flex';
    }
}

function hideLoading() {
    const overlay = document.getElementById('loadingOverlay');
    if (overlay) {
        overlay.style.display = 'none';
    }
}

// Feather icons'u güvenli şekilde yükle
function initFeatherIcons() {
    if (typeof feather !== 'undefined') {
        try {
            // Manuel olarak sadece var olan ikonları render et
            const icons = document.querySelectorAll('[data-feather]');
            icons.forEach(iconElement => {
                const iconName = iconElement.getAttribute('data-feather');
                
                // Eğer ikon tanımlıysa render et
                if (iconName && feather.icons[iconName]) {
                    try {
                        const svg = feather.icons[iconName].toSvg({
                            class: iconElement.className,
                            'stroke-width': iconElement.getAttribute('stroke-width') || 2
                        });
                        
                        // SVG'yi element'e ekle
                        const temp = document.createElement('div');
                        temp.innerHTML = svg;
                        const svgElement = temp.firstChild;
                        
                        // Orijinal attributeleri kopyala
                        Array.from(iconElement.attributes).forEach(attr => {
                            if (attr.name !== 'data-feather' && !svgElement.hasAttribute(attr.name)) {
                                svgElement.setAttribute(attr.name, attr.value);
                            }
                        });
                        
                        iconElement.parentNode.replaceChild(svgElement, iconElement);
                    } catch(e) {
                        // Bu ikon için hata, diğerlerine devam et
                    }
                }
            });
        } catch(e) {
            // Genel hata, sessizce devam et
        }
    }
}

// Sayfa yüklendiğinde birçok kez dene
document.addEventListener('DOMContentLoaded', function() {
    initFeatherIcons();
    setTimeout(initFeatherIcons, 50);
    setTimeout(initFeatherIcons, 100);
    setTimeout(initFeatherIcons, 200);
    setTimeout(initFeatherIcons, 500);
    setTimeout(initFeatherIcons, 1000);
});

// Hemen çalıştır
setTimeout(initFeatherIcons, 0);
setTimeout(initFeatherIcons, 10);
setTimeout(initFeatherIcons, 50);

// Window load'da da çalıştır
window.addEventListener('load', function() {
    initFeatherIcons();
    setTimeout(initFeatherIcons, 100);
    setTimeout(initFeatherIcons, 500);
});

// DOM değişikliklerinde
let featherTimeout = null;
const observer = new MutationObserver(() => {
    clearTimeout(featherTimeout);
    featherTimeout = setTimeout(initFeatherIcons, 30);
});
observer.observe(document.body, {
    childList: true,
    subtree: true
});

// ========================================
// YETKİ YÖNETİMİ FONKSİYONLARI
// ========================================

// Yetki yönetimi modal aç
function showPermissionsModal() {
    const modal = new bootstrap.Modal(document.getElementById('permissionsModal'));
    modal.show();
    setTimeout(() => initFeatherIcons(), 100);
}

// Yeni yetki ekleme formu göster/gizle
function showAddPermissionForm() {
    document.getElementById('addPermissionForm').style.display = 'block';
    document.getElementById('new_perm_name').focus();
    
    // Key input validation
    const keyInput = document.getElementById('new_perm_key');
    keyInput.addEventListener('input', function(e) {
        // Sadece küçük harf, rakam, tire ve alt çizgi
        this.value = this.value.toLowerCase().replace(/[^a-z0-9_-]/g, '');
    });
    
    // Name'den otomatik key oluştur
    const nameInput = document.getElementById('new_perm_name');
    nameInput.addEventListener('input', function(e) {
        if (!keyInput.value || keyInput.dataset.autoGenerated === 'true') {
            const key = this.value
                .toLowerCase()
                .replace(/ğ/g, 'g')
                .replace(/ü/g, 'u')
                .replace(/ş/g, 's')
                .replace(/ı/g, 'i')
                .replace(/ö/g, 'o')
                .replace(/ç/g, 'c')
                .replace(/[^a-z0-9]+/g, '_')
                .replace(/^_+|_+$/g, '');
            keyInput.value = key;
            keyInput.dataset.autoGenerated = 'true';
        }
    });
    
    keyInput.addEventListener('focus', function() {
        this.dataset.autoGenerated = 'false';
    });
}

function hideAddPermissionForm() {
    document.getElementById('addPermissionForm').style.display = 'none';
    document.getElementById('newPermissionForm').reset();
}

// Yeni yetki kaydet
async function saveNewPermission(event) {
    event.preventDefault();
    
    const name = document.getElementById('new_perm_name').value;
    const key = document.getElementById('new_perm_key').value;
    
    try {
        const response = await fetch('/permissions', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ name, key })
        });
        
        const data = await response.json();
        
        if (data.success) {
            iziToast.success({
                title: 'Başarılı',
                message: 'Yeni yetki eklendi!',
                position: 'topRight'
            });
            setTimeout(() => location.reload(), 1000);
    } else {
            iziToast.error({
                title: 'Hata',
                message: data.error || 'Yetki eklenemedi',
                position: 'topRight'
            });
        }
    } catch (error) {
        iziToast.error({
            title: 'Hata',
            message: error.message,
            position: 'topRight'
        });
    }
    
    return false;
}

// Yetki düzenle
function editPermission(permId) {
    const row = document.getElementById(`perm-row-${permId}`);
    
    // Display'leri gizle, input'ları göster
    row.querySelectorAll('.perm-name-display, .perm-key-display').forEach(el => el.style.display = 'none');
    row.querySelectorAll('.perm-name-edit, .perm-key-edit').forEach(el => el.style.display = 'block');
    
    // Butonları değiştir
    row.querySelector('.perm-actions').style.display = 'none';
    row.querySelector('.perm-edit-actions').style.display = 'inline-block';
    
    setTimeout(() => initFeatherIcons(), 50);
}

// Yetki düzenlemeyi iptal et
function cancelEditPermission(permId) {
    const row = document.getElementById(`perm-row-${permId}`);
    
    // Input'ları gizle, display'leri göster
    row.querySelectorAll('.perm-name-edit, .perm-key-edit').forEach(el => el.style.display = 'none');
    row.querySelectorAll('.perm-name-display, .perm-key-display').forEach(el => el.style.display = 'inline');
    
    // Butonları değiştir
    row.querySelector('.perm-edit-actions').style.display = 'none';
    row.querySelector('.perm-actions').style.display = 'inline-block';
    
    setTimeout(() => initFeatherIcons(), 50);
}

// Yetki kaydet
async function savePermission(permId) {
    const row = document.getElementById(`perm-row-${permId}`);
