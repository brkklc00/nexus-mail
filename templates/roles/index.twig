                    </td>
                    <td class="text-center">
                        <input class="form-check-input edit-checkbox edit-perm-create-${moduleIndex}" type="checkbox" 
                               name="permissions[${perm.id}][create]" value="1" ${hasCreate ? 'checked' : ''} onchange="updateEditStats()">
                    </td>
                    <td class="text-center">
                        <input class="form-check-input edit-checkbox edit-perm-update-${moduleIndex}" type="checkbox" 
                               name="permissions[${perm.id}][update]" value="1" ${hasUpdate ? 'checked' : ''} onchange="updateEditStats()">
                    </td>
                    <td class="text-center">
                        <input class="form-check-input edit-checkbox edit-perm-delete-${moduleIndex}" type="checkbox" 
                               name="permissions[${perm.id}][delete]" value="1" ${hasDelete ? 'checked' : ''} onchange="updateEditStats()">
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="setEditRowPermissions(${moduleIndex}, ${permIndex}, 'all')">Tümü</button>
                            <button type="button" class="btn btn-outline-info btn-sm" onclick="setEditRowPermissions(${moduleIndex}, ${permIndex}, 'read')">Okuma</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setEditRowPermissions(${moduleIndex}, ${permIndex}, 'none')">Yok</button>
                        </div>
                    </td>
                </tr>`;
            });
            
        html += `</tbody></table></div></div></div></div>`;
    }
    
    html += '</div>';
    container.innerHTML = html;
}

// Edit modal istatistiklerini güncelle
function updateEditStats() {
    const permissionIds = new Set();
    document.querySelectorAll('input[type="checkbox"].edit-checkbox:checked').forEach(cb => {
        const match = cb.name.match(/permissions\[(\d+)\]/);
        if (match) permissionIds.add(match[1]);
    });
    
    const readCount = document.querySelectorAll('input[name*="[read]"].edit-checkbox:checked').length;
    const createCount = document.querySelectorAll('input[name*="[create]"].edit-checkbox:checked').length;
    const updateCount = document.querySelectorAll('input[name*="[update]"].edit-checkbox:checked').length;
    const deleteCount = document.querySelectorAll('input[name*="[delete]"].edit-checkbox:checked').length;
    
    document.getElementById('editSelectedPermCount').textContent = permissionIds.size;
    document.getElementById('editReadCount').textContent = readCount;
    document.getElementById('editWriteCount').textContent = Math.max(createCount, updateCount);
    document.getElementById('editDeleteCount').textContent = deleteCount;
}

// Edit modal tüm seç/kaldır
function selectAllEditPermissions() {
    document.querySelectorAll('.edit-checkbox').forEach(cb => cb.checked = true);
    updateEditStats();
}

function deselectAllEditPermissions() {
    document.querySelectorAll('.edit-checkbox').forEach(cb => cb.checked = false);
    updateEditStats();
}

function expandAllEdit() {
    document.querySelectorAll('#editPermissionsAccordion .accordion-collapse').forEach(collapse => {
        const bsCollapse = new bootstrap.Collapse(collapse, { toggle: false });
        bsCollapse.show();
    });
}

// Edit modal sütun toggle
function toggleEditColumn(checkbox, action, moduleIndex) {
    document.querySelectorAll(`.edit-perm-${action}-${moduleIndex}`).forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateEditStats();
}

// Edit modal satır preset
function setEditRowPermissions(moduleIndex, rowIndex, preset) {
    const row = document.querySelectorAll(`.edit-perm-row-${moduleIndex}`)[rowIndex];
    if (!row) return;
    
    const checkboxes = row.querySelectorAll('input[type="checkbox"]');
    
    switch(preset) {
        case 'all':
            checkboxes.forEach(cb => cb.checked = true);
            break;
        case 'read':
            checkboxes.forEach((cb, idx) => cb.checked = (idx === 0));
            break;
        case 'none':
            checkboxes.forEach(cb => cb.checked = false);
            break;
    }
    updateEditStats();
}

