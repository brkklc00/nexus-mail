// Quick accordion'ları aç/kapat toggle
let quickAccordionsExpanded = false;
function toggleQuickAccordions() {
    const collapses = document.querySelectorAll('#quickPermissionsAccordion .accordion-collapse');
    const toggleText = document.getElementById('quickAccordionToggleText');
    
    collapses.forEach(collapse => {
        const bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapse, { toggle: false });
        if (quickAccordionsExpanded) {
            bsCollapse.hide();
        } else {
            bsCollapse.show();
        }
    });
    
    quickAccordionsExpanded = !quickAccordionsExpanded;
    toggleText.textContent = quickAccordionsExpanded ? 'Tümünü Kapat' : 'Tümünü Aç';
    
    setTimeout(() => initFeatherIcons(), 100);
}

// Quick modal - sütun toggle
function toggleQuickColumn(checkbox, action, moduleIndex) {
    document.querySelectorAll(`.quick-${action}-${moduleIndex}`).forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateQuickStats();
}

// Quick modal - satır preset
function setQuickRow(moduleIndex, rowIndex, preset) {
    const row = document.querySelectorAll(`.quick-perm-row-${moduleIndex}`)[rowIndex];
    if (!row) return;
    
    const checkboxes = row.querySelectorAll('input[type="checkbox"]');
    
    switch(preset) {
        case 'all':
            checkboxes.forEach(cb => cb.checked = true);
            break;
        case 'read':
            checkboxes.forEach((cb, idx) => cb.checked = (idx === 0));
            break;
        case 'none':
            checkboxes.forEach(cb => cb.checked = false);
            break;
    }
    updateQuickStats();
}

// Form submit - loading göster
document.getElementById('createRoleForm').addEventListener('submit', function() {
    showLoading();
});

// Quick form submit
document.getElementById('quickPermissionsForm')?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    showLoading();
    
    const formData = new FormData(this);
    const action = this.action;
    
    fetch(action, {
        method: 'POST',
        body: formData
    })
        .then(response => {
        if (response.redirected) {
            window.location.href = response.url;
        } else {
            return response.json();
        }
    })
    .then(data => {
        if (data && data.success === false) {
            iziToast.error({
                title: 'Hata',
                message: data.error || 'Yetkiler kaydedilemedi',
                position: 'topRight'
            });
            hideLoading();
        } else {
            iziToast.success({
                title: 'Başarılı',
                message: 'Yetkiler güncellendi!',
                position: 'topRight'
            });
            setTimeout(() => location.reload(), 1000);
            }
        })
        .catch(error => {
        iziToast.error({
            title: 'Hata',
            message: error.message,
            position: 'topRight'
        });
        hideLoading();
    });
    
    return false;
});

</script>
