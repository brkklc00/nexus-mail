            const hasRead = rolePerm?.can_read || false;
            const hasCreate = rolePerm?.can_create || false;
            const hasUpdate = rolePerm?.can_update || false;
            const hasDelete = rolePerm?.can_delete || false;
            
            html += `
                <tr class="edit-perm-row-${moduleIndex}">
                    <td>
                        <strong>${perm.name}</strong>
                        <br><small class="text-muted font-monospace">${perm.key}</small>
