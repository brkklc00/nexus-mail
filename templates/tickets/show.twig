{% extends '_layouts/main.twig' %}

{% block title %}Destek Talebi #{{ ticket.id }} - {{ site_title|default('Nexus Panel') }}{% endblock %}
{% block title_text %}Destek Talebi Detayları{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h4 class="card-title mb-0">
                            {{ ticket.subject }}
                        </h4>
                        <small class="text-muted">Talep #{{ ticket.id }}</small>
                    </div>
                    <div class="col-auto">
                        {% if ticket.status == 'open' %}
                            <span class="badge bg-success">Açık</span>
                        {% elseif ticket.status == 'in_progress' %}
                            <span class="badge bg-warning">İşlemde</span>
                        {% elseif ticket.status == 'closed' %}
                            <span class="badge bg-secondary">Kapalı</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="card-body">
                
                {# Mesajlar #}
                {% if ticket.messages|length > 0 %}
                    {% for message in ticket.messages %}
                    <div class="message-item mb-3 {% if message.user.id == user.id %}text-end{% endif %}">
                        <div class="d-inline-block text-start" style="max-width: 75%;">
                            <div class="card {% if message.user.id == user.id %}bg-primary text-white{% else %}border{% endif %}">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <strong class="me-2">{{ message.user.fullName }}</strong>
                                        <small class="{% if message.user.id == user.id %}text-white-50{% else %}text-muted{% endif %}">
                                            {{ message.createdAt|date('d.m.Y H:i') }}
                                        </small>
                                    </div>
                                    <p class="mb-0">{{ message.message|nl2br }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-info">
                        <i data-feather="info" class="align-self-center icon-xs me-2"></i>
                        Henüz mesaj bulunmuyor
                    </div>
                {% endif %}
                
                {# Yeni Mesaj Formu #}
                {% if ticket.status != 'closed' %}
                <hr>
                <form method="POST" action="/tickets/{{ ticket.id }}/reply">
                    <div class="mb-3">
                        <label for="message" class="form-label">Cevabınız</label>
                        <textarea class="form-control" id="message" name="message" rows="4" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i data-feather="send" class="align-self-center icon-xs me-2"></i>
                        Gönder
                    </button>
                </form>
                {% else %}
                <div class="alert alert-secondary mt-3">
                    <i data-feather="lock" class="align-self-center icon-xs me-2"></i>
                    Bu talep kapatılmıştır
                </div>
                {% endif %}
                
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Talep Bilgileri</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong>Oluşturan:</strong><br>
                    {{ ticket.user.fullName }}
                </p>
                <p class="mb-2">
                    <strong>Oluşturma Tarihi:</strong><br>
                    {{ ticket.createdAt|date('d.m.Y H:i') }}
                </p>
                <p class="mb-2">
                    <strong>Son Güncelleme:</strong><br>
                    {{ ticket.updatedAt ? ticket.updatedAt|date('d.m.Y H:i') : '-' }}
                </p>
                <p class="mb-0">
                    <strong>Durum:</strong><br>
                    {% if ticket.status == 'open' %}
                        <span class="badge bg-success">Açık</span>
                    {% elseif ticket.status == 'in_progress' %}
                        <span class="badge bg-warning">İşlemde</span>
                    {% elseif ticket.status == 'closed' %}
                        <span class="badge bg-secondary">Kapalı</span>
                    {% endif %}
                </p>
            </div>
        </div>
        
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">İşlemler</h5>
            </div>
            <div class="card-body">
                {% if ticket.status != 'closed' %}
                <form method="POST" action="/tickets/{{ ticket.id }}/close" class="d-grid mb-2">
                    <button type="submit" class="btn btn-warning" onclick="return confirm('Talebi kapatmak istediğinizden emin misiniz?')">
                        <i data-feather="x-circle" class="align-self-center icon-xs me-1"></i>
                        Talebi Kapat
                    </button>
                </form>
                {% endif %}
                <a href="/tickets" class="btn btn-secondary d-grid">
                    <i data-feather="arrow-left" class="align-self-center icon-xs me-1"></i>
                    Tüm Taleplere Dön
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
// Feather icons
feather.replace();

// Sayfa yüklendiğinde en alta kaydır
window.addEventListener('load', function() {
    const messages = document.querySelector('.card-body');
    if (messages) {
        messages.scrollTop = messages.scrollHeight;
    }
});
</script>
{% endblock %}
