{# Ticket detay — modal içeriği (AJAX). class ticket-detail korunur. #}
<div class="ticket-detail nx-ticket-detail-modal">
    <div class="nx-ticket-detail-meta card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-start">
                <div class="col-md-8">
                    <div class="text-muted small mb-1">Talep numarası</div>
                    <div class="fw-bold fs-5 text-dark mb-2">#{{ ticket.id }} · {{ ticket.subject }}</div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        {% set sv = ticket.status.value %}
                        <span class="nx-ticket-status nx-ticket-status--{{ sv }}">
                            {% if sv == 'pending' %}Yanıt Bekleyen{% else %}{{ ticket.status.getLabel() }}{% endif %}
                        </span>
                        <span class="small text-muted">{{ ticket.messages|length }} mesaj</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="nx-ticket-detail-dates">
                        <div class="mb-2">
                            <span class="nx-ticket-detail-k">Oluşturulma</span>
                            <span class="nx-ticket-detail-v">{{ ticket.createdAt|date('d.m.Y H:i') }}</span>
                        </div>
                        <div class="mb-0">
                            <span class="nx-ticket-detail-k">Son aktivite</span>
                            <span class="nx-ticket-detail-v">{{ ticket.lastActivityAt|date('d.m.Y H:i') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="nx-ticket-timeline-dot"></span>
        <h3 class="h6 fw-semibold mb-0 text-uppercase small text-muted nx-ticket-timeline-title">Mesajlar</h3>
    </div>

    <div class="nx-ticket-messages-scroll nx-ticket-conversation">
        {% for message in ticket.messages %}
            {% set fromUser = message.userId == ticket.userId %}
            {% if fromUser %}
                <div class="nx-conv-row nx-conv-row--user">
                    <div class="nx-conv-bubble nx-conv-bubble--user">
                        <div class="nx-conv-bubble-label text-white-50 small mb-1">Siz</div>
                        <div class="nx-conv-text text-white">{{ message.body|nl2br }}</div>
                        <div class="nx-conv-time text-white-50">{{ message.createdAt|date('d.m.Y H:i') }}</div>
                    </div>
                </div>
            {% else %}
                <div class="nx-conv-row nx-conv-row--staff">
                    <div class="nx-conv-avatar" aria-hidden="true">
                        <i data-feather="headphones"></i>
                    </div>
                    <div class="nx-conv-bubble nx-conv-bubble--staff">
                        <div class="nx-conv-bubble-label text-primary small fw-semibold mb-1">Destek ekibi</div>
                        <div class="nx-conv-text text-dark">{{ message.body|nl2br }}</div>
                        <div class="nx-conv-time text-muted">{{ message.createdAt|date('d.m.Y H:i') }}</div>
                    </div>
                </div>
            {% endif %}
        {% else %}
            <p class="text-muted small mb-0">Henüz mesaj yok.</p>
        {% endfor %}
    </div>

    {% if ticket.status.value != 'closed' %}
    <div class="mt-4 pt-3 border-top">
        <div class="card border-0 nx-reply-card shadow-sm">
            <div class="card-body p-3 p-md-4">
                <form id="replyForm" onsubmit="submitReply({{ ticket.id }}); return false;">
                    <label for="reply_message" class="form-label fw-semibold nx-label">
                        Yanıtınız <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control nx-input-premium mb-3"
                              id="reply_message"
                              name="message"
                              rows="4"
                              required
                              placeholder="Mesajınızı yazın..."></textarea>
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between align-items-stretch align-items-sm-center">
                        <button type="submit" class="btn nx-btn-ticket-submit px-4" id="nxReplySubmitBtn">
                            <span class="nx-btn-ticket-inner d-inline-flex align-items-center gap-2">
                                <i data-feather="send" class="nx-btn-ticket-ic"></i>
                                Cevap Gönder
                            </span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary border" onclick="showCloseTicketModal({{ ticket.id }})">
                            <i data-feather="x-circle" class="icon-xs me-1"></i>
                            Talebi Kapat
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {% else %}
    <div class="alert alert-secondary border-0 shadow-sm d-flex align-items-center gap-2 mt-4 mb-0">
        <i data-feather="check-circle" class="icon-sm flex-shrink-0"></i>
        <span><strong>Bu talep kapatılmıştır.</strong> Yeni mesaj gönderilemez.</span>
    </div>
    {% endif %}
</div>
