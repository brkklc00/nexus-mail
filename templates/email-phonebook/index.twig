// Email Phonebook Detail Modal
function viewEmailPhonebook(id, title, page = 1) {
    const modalEl = document.getElementById('emailPhonebookDetailModal');
    const modalBody = modalEl.querySelector('.modal-body-content');
    
    // Loading göster
    modalBody.innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="text-muted">Mail listesi yükleniyor...</p>
        </div>
    `;
    
    const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
    modalInstance.show();
    
    // AJAX ile içerik yükle
    fetch(`/email-phonebooks/${id}/detail?page=${page}`)
        .then(res => res.text())
        .then(html => {
            modalBody.innerHTML = html;
            feather.replace();
        })
        .catch(err => {
            modalBody.innerHTML = `
                <div class="alert alert-danger">
                    <i data-feather="alert-circle" class="icon-xs me-2"></i>
                    Yükleme hatası: ${err.message}
                </div>
            `;
            feather.replace();
        });
}

function loadEmailPhonebookPage(id, title, page) {
    viewEmailPhonebook(id, title, page);
}

// Modal açıldığında icon'ları yenile
document.querySelectorAll('.modal').forEach(modal => {
    modal.addEventListener('shown.bs.modal', function () {
        feather.replace();
    });
});

function nxPbApplyFilter() {
    const q = (document.getElementById('nxPbSearch')?.value || '').toLowerCase().trim();
    document.querySelectorAll('.nx-pb-row').forEach(function (row) {
        const hay = (row.getAttribute('data-search') || '').toLowerCase();
        row.style.display = !q || hay.includes(q) ? '' : 'none';
    });
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
    document.getElementById('nxPbSearch')?.addEventListener('input', nxPbApplyFilter);
    document.getElementById('nxPbToolbarRefresh')?.addEventListener('click', function () { location.reload(); });
    document.getElementById('nxPbHeadRefresh')?.addEventListener('click', function () { location.reload(); });
});
