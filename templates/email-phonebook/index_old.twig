{% extends "_layouts/main.twig" %}

{% block title %}Mail Rehberim - {{ site_title|default('Nexus Panel') }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <a href="/email-phonebooks/create" class="btn btn-primary">
                        <i data-feather="plus"></i> Yeni Rehber
                    </a>
                </div>
                <h4 class="page-title">Mail Rehberim</h4>
            </div>
        </div>
    </div>

    <div class="row">
        {% if phonebooks is empty %}
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i data-feather="inbox" style="width: 64px; height: 64px;" class="text-muted"></i>
                    <h5 class="mt-3">Henüz rehber oluşturmadınız</h5>
                    <p class="text-muted">Mail listeleri oluşturup mail kampanyalarında kullanabilirsiniz</p>
                    <a href="/email-phonebooks/create" class="btn btn-primary mt-2">
                        <i data-feather="plus"></i> İlk Rehberi Oluştur
                    </a>
                </div>
            </div>
        </div>
        {% else %}
        {% for phonebook in phonebooks %}
        <div class="col-md-6 col-xl-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-title mb-1">{{ phonebook.title }}</h5>
                            {% if phonebook.description %}
                            <p class="text-muted small mb-0">{{ phonebook.description }}</p>
                            {% endif %}
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown">
                                <i data-feather="more-vertical"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/email-phonebooks/{{ phonebook.id }}">
                                    <i data-feather="eye"></i> Görüntüle
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="#" onclick="deletePhonebook({{ phonebook.id }})">
                                    <i data-feather="trash-2"></i> Sil
                                </a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="row text-center">
                        <div class="col-6">
                            <h3 class="mb-0">{{ phonebook.totalContacts|number_format }}</h3>
                            <p class="text-muted mb-0 small">Mail Adresi</p>
                        </div>
                        <div class="col-6">
                            <h3 class="mb-0">{{ phonebook.createdAt|date('d.m.Y') }}</h3>
                            <p class="text-muted mb-0 small">Oluşturma</p>
                        </div>
                    </div>

                    <div class="mt-3">
                        <a href="/email-phonebooks/{{ phonebook.id }}" class="btn btn-outline-primary btn-sm w-100">
                            <i data-feather="list"></i> Mailleri Görüntüle
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
        {% endif %}
    </div>
</div>

<script>
function deletePhonebook(id) {
    if (!confirm('Bu rehberi silmek istediğinize emin misiniz?')) {
        return;
    }
    
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/email-phonebooks/${id}/delete`;
    document.body.appendChild(form);
    form.submit();
}

document.addEventListener('DOMContentLoaded', function() {
    feather.replace();
});
</script>
{% endblock %}

