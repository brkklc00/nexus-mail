#!/usr/bin/env bash
# RAM ve CPU'ya göre Nginx + PHP-FPM limitlerini yükseltir (504 / büyük havuz upload).
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

MEM_MB=$(free -m 2>/dev/null | awk '/^Mem:/ {print $2}' || echo 4096)
CPU=$(nproc 2>/dev/null || echo 2)

if [ "$MEM_MB" -ge 65536 ]; then
  BODY="2048M"; MEM="4096M"; TIMEOUT="1800"; CHILDREN=80
  OPCACHE_MEM=512; REALPATH_CACHE="8192k"
elif [ "$MEM_MB" -ge 16384 ]; then
  BODY="2048M"; MEM="4096M"; TIMEOUT="1800"; CHILDREN=60
  OPCACHE_MEM=512; REALPATH_CACHE="8192k"
elif [ "$MEM_MB" -ge 8192 ]; then
  BODY="1024M"; MEM="2048M"; TIMEOUT="900"; CHILDREN=40
  OPCACHE_MEM=256; REALPATH_CACHE="4096k"
elif [ "$MEM_MB" -ge 4096 ]; then
  BODY="1024M"; MEM="1024M"; TIMEOUT="900"; CHILDREN=25
  OPCACHE_MEM=192; REALPATH_CACHE="4096k"
else
  BODY="512M"; MEM="512M"; TIMEOUT="600"; CHILDREN=15
  OPCACHE_MEM=128; REALPATH_CACHE="2048k"
fi

MAX_BY_CPU=$((CPU * 12))
if [ "$CHILDREN" -gt "$MAX_BY_CPU" ]; then CHILDREN=$MAX_BY_CPU; fi

FPM_INI="/etc/php/8.3/fpm/php.ini"
FPM_POOL="/etc/php/8.3/fpm/pool.d/www.conf"

set_ini_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  local line="${key} = ${value}"
  [ -f "$file" ] || return 0
  if grep -qE "^[[:space:]]*;?[[:space:]]*${key}[[:space:]]*=" "$file"; then
    sed -i -E "s/^[[:space:]]*;?[[:space:]]*${key}[[:space:]]*=.*/${line}/" "$file" || true
  else
    echo "$line" >> "$file"
  fi
}

is_nexus_nginx_site() {
  local site="$1"
  local base
  base=$(basename "$site")
  [[ "$site" == *.bak* ]] && return 1

  if [[ "$site" == */conf.d/* ]]; then
    grep -qE 'client_max_body_size|fastcgi_read_timeout|nexus|hub-nexus|mail-pool|nexus-mail' "$site" 2>/dev/null
    return $?
  fi

  if [[ "$base" == "default" ]]; then
    grep -qE 'nexus-mail|/var/www/nexus|hub-nexus' "$site" 2>/dev/null || return 1
  fi

  grep -qE 'nexus-mail|/var/www/nexus|hub-nexus' "$site" 2>/dev/null
}

update_nginx_site() {
  local site="$1"
  echo "Nginx site güncelleniyor: $site"
  if grep -q 'client_max_body_size' "$site"; then
    sed -i "s/client_max_body_size.*/client_max_body_size ${BODY};/" "$site"
  elif grep -q 'server_name' "$site"; then
    sed -i "/server_name/a\\    client_max_body_size ${BODY};" "$site"
  else
    sed -i "/server {/a\\    client_max_body_size ${BODY};" "$site"
  fi
  if ! grep -q fastcgi_read_timeout "$site"; then
    sed -i "/client_max_body_size/a\\    fastcgi_read_timeout ${TIMEOUT}s;\\n    fastcgi_send_timeout ${TIMEOUT}s;\\n    send_timeout ${TIMEOUT}s;" "$site"
  else
    sed -i "s/fastcgi_read_timeout.*/fastcgi_read_timeout ${TIMEOUT}s;/" "$site"
    sed -i "s/fastcgi_send_timeout.*/fastcgi_send_timeout ${TIMEOUT}s;/" "$site"
  fi
  if ! grep -q 'fastcgi_buffers' "$site"; then
    sed -i "/fastcgi_read_timeout/a\\    fastcgi_buffers 32 32k;\\n    fastcgi_buffer_size 64k;\\n    fastcgi_busy_buffers_size 128k;" "$site" 2>/dev/null || true
  fi
}

echo "Sunucu: RAM=${MEM_MB}MB CPU=${CPU} → body=${BODY} timeout=${TIMEOUT}s children=${CHILDREN}"

for key in upload_max_filesize post_max_size memory_limit max_execution_time max_input_time max_input_vars; do
  case "$key" in
    upload_max_filesize) set_ini_value "$FPM_INI" "$key" "$BODY" ;;
    post_max_size) set_ini_value "$FPM_INI" "$key" "$BODY" ;;
    memory_limit) set_ini_value "$FPM_INI" "$key" "$MEM" ;;
    max_execution_time|max_input_time) set_ini_value "$FPM_INI" "$key" "$TIMEOUT" ;;
    max_input_vars) set_ini_value "$FPM_INI" "$key" "20000" ;;
  esac
done

if [ -f "$FPM_POOL" ]; then
  set_ini_value "$FPM_POOL" "request_terminate_timeout" "$TIMEOUT"
  set_ini_value "$FPM_POOL" "pm.max_children" "$CHILDREN"
  set_ini_value "$FPM_POOL" "pm.start_servers" "$((CHILDREN / 4 + 1))"
  set_ini_value "$FPM_POOL" "pm.min_spare_servers" "$((CHILDREN / 8 + 1))"
  set_ini_value "$FPM_POOL" "pm.max_spare_servers" "$((CHILDREN / 2))"
fi

if [ -f "$FPM_INI" ]; then
  echo "OPcache ayarlanıyor (memory=${OPCACHE_MEM}MB)..."
  set_ini_value "$FPM_INI" "opcache.enable" "1"
  set_ini_value "$FPM_INI" "opcache.enable_cli" "0"
  set_ini_value "$FPM_INI" "opcache.memory_consumption" "$OPCACHE_MEM"
  set_ini_value "$FPM_INI" "opcache.interned_strings_buffer" "32"
  set_ini_value "$FPM_INI" "opcache.max_accelerated_files" "30000"
  set_ini_value "$FPM_INI" "opcache.validate_timestamps" "1"
  set_ini_value "$FPM_INI" "opcache.revalidate_freq" "2"
  set_ini_value "$FPM_INI" "opcache.save_comments" "1"
  set_ini_value "$FPM_INI" "opcache.jit" "1255"
  set_ini_value "$FPM_INI" "opcache.jit_buffer_size" "128M"
  set_ini_value "$FPM_INI" "realpath_cache_size" "$REALPATH_CACHE"
  set_ini_value "$FPM_INI" "realpath_cache_ttl" "600"
fi

sed -i '/^client_max_body_size 2048M;$/d' /etc/nginx/nginx.conf 2>/dev/null || true
sed -i '/^client_max_body_size 1024M;$/d' /etc/nginx/nginx.conf 2>/dev/null || true

declare -A NGINX_SEEN=()
NGINX_DIRS=(/etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d)
for DIR in "${NGINX_DIRS[@]}"; do
  [ -d "$DIR" ] || continue
  for SITE in "$DIR"/*; do
    [ -f "$SITE" ] || continue
    REAL_SITE=$(readlink -f "$SITE" 2>/dev/null || echo "$SITE")
    [ -n "${NGINX_SEEN[$REAL_SITE]:-}" ] && continue
    NGINX_SEEN[$REAL_SITE]=1
    is_nexus_nginx_site "$SITE" || continue
    update_nginx_site "$SITE"
  done
done

systemctl reload php8.3-fpm

if nginx -t; then
  systemctl reload nginx
  echo "OK — limitler uygulandı. Doğrulama: sudo php bin/server-audit"
else
  echo "HATA: nginx -t başarısız — PHP-FPM güncellendi, nginx reload EDİLMEDİ."
  echo "Muhtemel neden: sites-enabled/default içinde duplicate 'gzip on;' (tune'un eski sürümü eklemiş olabilir)."
  echo "Düzelt: grep -n 'gzip on' /etc/nginx/sites-enabled/default  → fazla satırı sil, sonra: sudo nginx -t && sudo systemctl reload nginx"
  exit 1
fi

echo "Deploy sonrası OPcache temizlemek için: sudo systemctl reload php8.3-fpm"
