#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

// Load environment
// GitHub Actions'ta .env dosyası olmayabilir, bu durumda environment variable'ları kullan
$envFile = __DIR__ . '/../.env';
if (file_exists($envFile)) {
    try {
        $dotenv = Dotenv\Dotenv::createImmutable(__DIR__ . '/..');
        $dotenv->load();
    } catch (Exception $e) {
        // .env dosyası yüklenemezse devam et (environment variable'ları kullanılacak)
        echo "⚠️  .env dosyası yüklenemedi, environment variable'ları kullanılıyor: " . $e->getMessage() . "\n";
    }
} else {
    echo "ℹ️  .env dosyası bulunamadı, environment variable'ları kullanılıyor\n";
}

// Database şifresi kontrolü
if (empty($_ENV['DB_PASSWORD'] ?? '')) {
    echo "❌ HATA: DB_PASSWORD environment variable'ı boş veya tanımlı değil!\n";
    echo "   GitHub Actions kullanıyorsanız, DB_PASSWORD'u secret olarak tanımlayın.\n";
    echo "   Yerel sunucuda ise .env dosyasında DB_PASSWORD=şifre şeklinde tanımlayın.\n";
    exit(1);
}

// Build DI container
$containerBuilder = new DI\ContainerBuilder();
$containerBuilder->addDefinitions(__DIR__ . '/../config/container.php');
$container = $containerBuilder->build();

// Get Doctrine Connection
$em = $container->get('Doctrine\ORM\EntityManager');
$connection = $em->getConnection();

echo "🔄 Running database migrations...\n\n";

// Migration dizinini tara
$migrationDir = __DIR__ . '/../database/migrations';
$migrationFiles = glob($migrationDir . '/Version*.php');

if (empty($migrationFiles)) {
    echo "ℹ️  No migrations found.\n";
    exit(0);
}

// Migration tracking tablosunu oluştur
try {
    $connection->executeStatement("
        CREATE TABLE IF NOT EXISTS migrations (
            version VARCHAR(255) PRIMARY KEY,
            executed_at DATETIME NOT NULL
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
    ");
} catch (\Exception $e) {
    echo "❌ Error creating migrations table: " . $e->getMessage() . "\n";
    exit(1);
}

// Çalıştırılmış migration'ları al
$executedMigrations = [];
try {
    $result = $connection->fetchAllAssociative("SELECT version FROM migrations");
    foreach ($result as $row) {
        $executedMigrations[] = $row['version'];
    }
} catch (\Exception $e) {
    echo "❌ Error reading migrations: " . $e->getMessage() . "\n";
    exit(1);
}

// Dosyaları sırala
sort($migrationFiles);

$executedCount = 0;
$skippedCount = 0;

foreach ($migrationFiles as $file) {
    $filename = basename($file, '.php');
    
    // Zaten çalıştırılmış mı?
    if (in_array($filename, $executedMigrations)) {
        echo "⏭️  Skipping {$filename} (already executed)\n";
        $skippedCount++;
        continue;
    }
    
    echo "▶️  Executing {$filename}...\n";
    
    try {
        // Migration class'ını yükle
        require_once $file;
        
        $className = "Database\\Migrations\\{$filename}";
        
        if (!class_exists($className)) {
            echo "⚠️  Warning: Class {$className} not found in {$file}\n";
            continue;
        }
        
        // Reflection ile class'ı kontrol et
        $reflection = new \ReflectionClass($className);
        
        // Doctrine AbstractMigration mi kontrol et
        $isDoctrineMigration = $reflection->isSubclassOf('Doctrine\Migrations\AbstractMigration');
        
        if ($isDoctrineMigration) {
            echo "   ⏭️  Skipping Doctrine migration (use doctrine:migrations:migrate)\n";
            $skippedCount++;
            continue;
        }
        
        // Basit migration (bizim format)
        $migration = new $className();
        
        if (!method_exists($migration, 'up')) {
            echo "⚠️  Warning: Method 'up' not found in {$className}\n";
            continue;
        }
        
        // Transaction başlat
        $connection->beginTransaction();
        
        try {
            // Migration'ı çalıştır
            $migration->up($connection);
            
            // Migration'ı kaydet
            $connection->executeStatement(
                "INSERT INTO migrations (version, executed_at) VALUES (?, NOW())",
                [$filename]
            );
            
            // Transaction aktifse commit yap
            if ($connection->isTransactionActive()) {
                try {
                    $connection->commit();
                } catch (\Exception $commitEx) {
                    // DDL işlemleri auto-commit yapabilir (MySQL), bu durumda commit hatası görmezden gel
                    if (!str_contains($commitEx->getMessage(), 'no active transaction')) {
                        throw $commitEx;
                    }
                }
            }
            echo "   ✅ Success!\n";
            $executedCount++;
            
        } catch (\Exception $e) {
            // Transaction aktifse rollback yap
            if ($connection->isTransactionActive()) {
                try {
                    $connection->rollBack();
                } catch (\Exception $rollbackEx) {
                    // Rollback hatası görmezden gel
                }
            }
            throw $e;
        }
        
    } catch (\Exception $e) {
        echo "   ❌ Error: " . $e->getMessage() . "\n";
        echo "   Stack trace: " . $e->getTraceAsString() . "\n";
        exit(1);
    }
}

echo "\n";
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
echo "📊 Summary:\n";
echo "   • Executed: {$executedCount} migrations\n";
echo "   • Skipped:  {$skippedCount} migrations\n";
echo "   • Total:    " . count($migrationFiles) . " migrations\n";
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";

if ($executedCount > 0) {
    echo "✅ All migrations completed successfully!\n";
} else {
    echo "ℹ️  Database is up to date.\n";
}

exit(0);

