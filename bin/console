#!/usr/bin/env php
<?php

declare(strict_types=1);

use Symfony\Component\Console\Application;
use DI\ContainerBuilder;

require __DIR__ . '/../vendor/autoload.php';

require_once __DIR__ . '/../config/load-env.php';
nexus_ensure_env_loaded();

// Build DI container
$containerBuilder = new ContainerBuilder();
$containerBuilder->addDefinitions(__DIR__ . '/../config/container.php');
$container = $containerBuilder->build();

// Create console application
$appTitle = $_ENV['SITE_TITLE'] ?? 'Nexus Panel';
$application = new Application($appTitle . ' Console', '1.0.0');

// Register commands
$application->add(new \App\Support\Console\InstallCommand($container));
$application->add(new \App\Support\Console\MigrateCommand($container));
$application->add(new \App\Support\Console\ResetPasswordCommand($container));
$application->add(new \App\Support\Console\SetAdminEmailCreditCommand($container));
$application->add(new \App\Support\Console\DataPoolJobsWorkCommand($container));

$application->run();

