APP_ENV=production
APP_URL=https://nexus-mail.local
AUTH_SECRET=change-me-auth-secret
TRACKING_SECRET=change-me-tracking-secret

DATABASE_URL=mysql://user:password@127.0.0.1:3306/nexus_mail
REDIS_URL=redis://127.0.0.1:6379

API_BASE_URL=http://localhost/api
API_TOKEN=change-me-api-token

MAIL_WORKER_ENABLED=true
MAIL_WORKER_BATCH_SIZE=500
MAIL_WORKER_TICK_MS=1000
EMAIL_WORKER_ID=email-worker-1
EMAIL_POLL_INTERVAL=5000
EMAIL_MAX_RETRIES=3
EMAIL_CLAIM_TTL_SECONDS=900
EMAIL_STUCK_TTL_HOURS=6
EMAIL_CLEANUP_INTERVAL_MS=120000
WORKER_RESULT_MODE=direct-db
WORKER_DB_POOL_LIMIT=16
RESULT_FLUSH_SIZE=1000
RESULT_FLUSH_INTERVAL_MS=5000
WORKER_HEALTH_PORT=0

# Email data pool/export tuning
EMAIL_POOL_EXPORT_MEMORY_LIMIT=1024M
EMAIL_POOL_CSV_EXPORT_BATCH=20000
EMAIL_POOL_TXT_EXPORT_BATCH=50000
EMAIL_POOL_ANALYSIS_CHUNK_SIZE=25000
DATA_POOL_JOB_BATCH_SIZE=10000
DATA_POOL_JOB_SLEEP_MS=100
DATA_POOL_JOB_MAX_RUNTIME=300
DATA_POOL_EXPORT_PATH=storage/exports
DATA_POOL_MAX_PARALLEL_JOBS=2

SMTP_DEFAULT_HOST=smtp.example.com
SMTP_DEFAULT_PORT=587
SMTP_DEFAULT_ENCRYPTION=tls
SMTP_DEFAULT_FROM_NAME=Nexus Mail
SMTP_DEFAULT_FROM_EMAIL=no-reply@example.com

ALIBABA_DIRECTMAIL_ACCESS_KEY_ID=
ALIBABA_DIRECTMAIL_ACCESS_KEY_SECRET=
ALIBABA_DIRECTMAIL_REGION=ap-southeast-1
ALIBABA_DIRECTMAIL_ACCOUNT_NAME=
ALIBABA_DM_REGION=ap-southeast-1
ALIBABA_DM_ACCESS_KEY_ID=
ALIBABA_DM_ACCESS_KEY_SECRET=
ALIBABA_DM_REPORT_TIMEZONE=Asia/Singapore
EXTERNAL_API_BASE_URL=https://hub-nexus.com
EXTERNAL_API_KEY=
EXTERNAL_API_KEY_NAME=partner_site
EXTERNAL_API_RATE_LIMIT=120
EXTERNAL_API_RATE_WINDOW=60

LINK_SHORTENER_DOMAIN=https://lnk.example.com
LINK_SHORTENER_LENGTH=7

EMAIL_DB_HOST=127.0.0.1
EMAIL_DB_PORT=3306
EMAIL_DB_USER=root
EMAIL_DB_PASSWORD=
EMAIL_DB_NAME=nexus_mail
